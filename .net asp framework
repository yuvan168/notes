### Custom Middleware Examples

**Example 1: Request Logging Middleware**

```csharp
// Purpose: Log every incoming request and outgoing response
public class RequestLoggingMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger<RequestLoggingMiddleware> _logger;
    
    // Constructor: Called once when middleware is registered
    public RequestLoggingMiddleware(RequestDelegate next, ILogger<RequestLoggingMiddleware> logger)
    {
        _next = next;        // Next middleware in chain
        _logger = logger;    // Logging service
    }
    
    // InvokeAsync: Called for each request
    public async Task InvokeAsync(HttpContext context)
    {
        var request = context.Request;
        
        // Log incoming request
        _logger.LogInformation(
            $"📨 Request: {request.Method} {request.Path}\n" +
            $"   Headers: {string.Join(", ", request.Headers.Keys)}\n" +
            $"   Query: {request.QueryString}");
        
        // Call next middleware
        await _next(context);
        
        var response = context.Response;
        
        // Log outgoing response
        _logger.LogInformation(
            $"📤 Response: Status {response.StatusCode} for {request.Path}");
    }
}

// Register in Program.cs
app.UseMiddleware<RequestLoggingMiddleware>();
```

**Example 2: Request Timing Middleware**

```csharp
// Purpose: Measure how long each request takes
public class RequestTimingMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger<RequestTimingMiddleware> _logger;
    
    public RequestTimingMiddleware(RequestDelegate next, ILogger<RequestTimingMiddleware> logger)
    {
        _next = next;
        _logger = logger;
    }
    
    public async Task InvokeAsync(HttpContext context)
    {
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        
        // Call next middleware
        await _next(context);
        
        stopwatch.Stop();
        
        // Log execution time
        var elapsed = stopwatch.ElapsedMilliseconds;
        var threshold = 1000;  // 1 second
        
        if (elapsed > threshold)
        {
            _logger.LogWarning(
                $"⚠️ Slow request: {context.Request.Path} took {elapsed}ms");
        }
        else
        {
            _logger.LogInformation(
                $"✅ {context.Request.Path} completed in {elapsed}ms");
        }
    }
}

// Register
app.UseMiddleware<RequestTimingMiddleware>();
```

**Example 3: Custom Headers Middleware**

```csharp
// Purpose: Add security headers to all responses
public class SecurityHeadersMiddleware
{
    private readonly RequestDelegate _next;
    
    public SecurityHeadersMiddleware(RequestDelegate next)
    {
        _next = next;
    }
    
    public async Task InvokeAsync(HttpContext context)
    {
        // Add security headers to response
        context.Response.Headers.Add("X-Content-Type-Options", "nosniff");
        context.Response.Headers.Add("X-Frame-Options", "DENY");
        context.Response.Headers.Add("X-XSS-Protection", "1; mode=block");
        
        await _next(context);
    }
}

app.UseMiddleware<SecurityHeadersMiddleware>();
```

**Example 4: Error Handling Middleware**

```csharp
// Purpose: Catch all exceptions and return proper error response
public class ErrorHandlingMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger<ErrorHandlingMiddleware> _logger;
    
    public ErrorHandlingMiddleware(RequestDelegate next, ILogger<ErrorHandlingMiddleware> logger)
    {
        _next = next;
        _logger = logger;
    }
    
    public async Task InvokeAsync(HttpContext context)
    {
        try
        {
            await _next(context);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Unhandled exception occurred");
            
            context.Response.ContentType = "application/json";
            context.Response.StatusCode = StatusCodes.Status500InternalServerError;
            
            var response = new
            {
                message = "An error occurred",
                error = ex.Message,
                timestamp = DateTime.UtcNow
            };
            
            await context.Response.WriteAsJsonAsync(response);
        }
    }
}

app.UseMiddleware<ErrorHandlingMiddleware>();
```

**Example 5: Authentication Token Validation Middleware**

```csharp
// Purpose: Validate JWT token from request headers
public class TokenValidationMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger<TokenValidationMiddleware> _logger;
    
    public TokenValidationMiddleware(RequestDelegate next, ILogger<TokenValidationMiddleware> logger)
    {
        _next = next;
        _logger = logger;
    }
    
    public async Task InvokeAsync(HttpContext context, ITokenService tokenService)
    {
        // Get token from Authorization header
        var token = context.Request.Headers["Authorization"]
            .ToString()
            .Replace("Bearer ", "");
        
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                // Validate token
                var principal = tokenService.ValidateToken(token);
                context.User = principal;
                _logger.LogInformation($"Token validated for user: {principal.Identity?.Name}");
            }
            catch (Exception ex)
            {
                _logger.LogWarning($"Token validation failed: {ex.Message}");
            }
        }
        
        await _next(context);
    }
}

app.UseMiddleware<TokenValidationMiddleware>();
```

**Key Points:**
- Middleware order matters: Register in correct sequence
- Each middleware calls `await _next(context)` to pass to next
- Can read request before calling next
- Can modify response after calling next
- Can prevent calling next to short-circuit pipeline

