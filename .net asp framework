## SOLID Principles in ASP.NET Core

### 1. Single Responsibility Principle (SRP)

```csharp
// ❌ BAD - Multiple responsibilities
public class UserService
{
    public async Task CreateUserAsync(CreateUserDto dto)
    {
        // Validates data
        if (string.IsNullOrEmpty(dto.Email)) throw new Exception("Email required");
        
        // Sends email
        var smtpClient = new SmtpClient();
        await smtpClient.SendMailAsync(dto.Email, "Welcome!");
        
        // Saves to database
        var user = new User { Email = dto.Email };
        _dbContext.Users.Add(user);
        await _dbContext.SaveChangesAsync();
        
        // Generates token
        var token = JWT.Generate(user.Id);
        
        // Logs
        File.WriteAllText("log.txt", $"User created: {user.Id}");
    }
}

// ✅ GOOD - Single responsibility each
public class UserValidator
{
    public void Validate(CreateUserDto dto)
    {
        if (string.IsNullOrEmpty(dto.Email)) throw new Exception("Email required");
    }
}

public class UserRepository
{
    public async Task SaveAsync(User user)
    {
        _dbContext.Users.Add(user);
        await _dbContext.SaveChangesAsync();
    }
}

public class EmailService
{
    public async Task SendWelcomeEmailAsync(string email)
    {
        await _smtpClient.SendMailAsync(email, "Welcome!");
    }
}

public class TokenService
{
    public string GenerateToken(int userId)
    {
        return JWT.Generate(userId);
    }
}

public class Logger
{
    public void Log(string message)
    {
        File.WriteAllText("log.txt", message);
    }
}

public class UserService
{
    private readonly UserValidator _validator;
    private readonly UserRepository _repository;
    private readonly EmailService _emailService;
    private readonly TokenService _tokenService;
    private readonly Logger _logger;
    
    public async Task CreateUserAsync(CreateUserDto dto)
    {
        _validator.Validate(dto);
        var user = new User { Email = dto.Email };
        await _repository.SaveAsync(user);
        await _emailService.SendWelcomeEmailAsync(user.Email);
        var token = _tokenService.GenerateToken(user.Id);
        _logger.Log($"User created: {user.Id}");
    }
}
```

### 2. Open/Closed Principle (OCP)

```csharp
// ❌ BAD - Need to modify code to add new feature
public class NotificationSender
{
    public void Send(string type, string message)
    {
        if (type == "Email")
            SendEmail(message);
        else if (type == "SMS")
            SendSms(message);
        else if (type == "Push")
            SendPushNotification(message);
        // Need to modify this method every time we add new notification type!
    }
}

// ✅ GOOD - Extend, don't modify
public interface INotificationSender
{
    Task SendAsync(string message);
}

public class EmailSender : INotificationSender
{
    public async Task SendAsync(string message) => await SendEmailAsync(message);
}

public class SmsSender : INotificationSender
{
    public async Task SendAsync(string message) => await SendSmsAsync(message);
}

public class PushNotificationSender : INotificationSender
{
    public async Task SendAsync(string message) => await SendPushAsync(message);
}

// Adding new type doesn't require modification
public class SlackSender : INotificationSender
{
    public async Task SendAsync(string message) => await SendSlackAsync(message);
}

// Register as plugin
builder.Services.AddScoped<INotificationSender, SlackSender>();
```

### 3. Liskov Substitution Principle (LSP)

```csharp
// ❌ BAD - Derived class breaks contract
public interface ILogger
{
    void Log(string message);
}

public class FileLogger : ILogger
{
    public void Log(string message)
    {
        File.WriteAllText("log.txt", message);
    }
}

public class NullLogger : ILogger
{
    public void Log(string message)
    {
        // Does nothing - violates contract!
        // Caller expects logging to happen
    }
}

// ✅ GOOD - Subclass can be used anywhere base class is used
public class ConsoleLogger : ILogger
{
    public void Log(string message) => Console.WriteLine(message);
}

public class FileLogger : ILogger
{
    public void Log(string message) => File.WriteAllText("log.txt", message);
}

public class CompositeLogger : ILogger
{
    private readonly List<ILogger> _loggers;
    
    public void Log(string message)
    {
        foreach (var logger in _loggers)
            logger.Log(message);
    }
}

// Any can be substituted
ILogger logger = new FileLogger();
logger.Log("Test");  // Works

logger = new ConsoleLogger();
logger.Log("Test");  // Still works

logger = new CompositeLogger(...);
logger.Log("Test");  // Still works
```

### 4. Interface Segregation Principle (ISP)

```csharp
// ❌ BAD - Large interface clients don't need
public interface IUserRepository
{
    Task<User> GetByIdAsync(int id);
    Task SaveAsync(User user);
    Task DeleteAsync(int id);
    Task<List<User>> GetAllAsync();
    Task<List<User>> SearchAsync(string keyword);
    Task<List<User>> GetByRoleAsync(string role);
    Task<bool> ExistsAsync(int id);
    // ... many more methods
}

// Client only needs GetByIdAsync but implements whole interface
public class UserController
{
    private readonly IUserRepository _repo;
    
    public async Task<IActionResult> GetUser(int id)
    {
        return Ok(await _repo.GetByIdAsync(id));  // Only uses this one method
    }
}

// ✅ GOOD - Segregated interfaces
public interface IUserFinder
{
    Task<User> GetByIdAsync(int id);
}

public interface IUserSaver
{
    Task SaveAsync(User user);
}

public interface IUserDeleter
{
    Task DeleteAsync(int id);
}

public class UserController
{
    private readonly IUserFinder _finder;
    
    public UserController(IUserFinder finder)
    {
        _finder = finder;
    }
    
    public async Task<IActionResult> GetUser(int id)
    {
        return Ok(await _finder.GetByIdAsync(id));
    }
}
```

### 5. Dependency Inversion Principle (DIP)

```csharp
// ❌ BAD - Depends on concrete classes
public class OrderService
{
    private readonly SqlDatabase _db = new SqlDatabase();      // Concrete
    private readonly SmtpEmailSender _email = new SmtpEmailSender();  // Concrete
    
    public async Task ProcessOrderAsync(Order order)
    {
        await _db.SaveAsync(order);
        await _email.SendAsync(order.Email, "Order confirmed");
    }
}

// ✅ GOOD - Depends on abstractions
public interface IDatabase { Task SaveAsync(Order order); }
public interface IEmailService { Task SendAsync(string to, string message); }

public class OrderService
{
    private readonly IDatabase _db;
    private readonly IEmailService _email;
    
    // Depends on interfaces (abstractions)
    public OrderService(IDatabase db, IEmailService email)
    {
        _db = db;
        _email = email;
    }
    
    public async Task ProcessOrderAsync(Order order)
    {
        await _db.SaveAsync(order);
        await _email.SendAsync(order.Email, "Order confirmed");
    }
}

// Can use any implementation
builder.Services.AddScoped<IDatabase, SqlDatabase>();
builder.Services.AddScoped<IDatabase, MongoDatabase>();  // Different implementation
```

