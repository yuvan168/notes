        var product = new Product { Name = dto.Name, Price = dto.Price };
        await _repository.SaveAsync(product);
        
        // Send notification
        await _emailService.SendAsync(
            "admin@company.com",
            "New Product Created",
            $"Product: {product.Name}");
        
        // Cache result
        _cache.Set($"product_{product.Id}", product, TimeSpan.FromHours(1));
        
        return product;
    }
}

