    public ProductService(
        IProductRepository repository,
        IEmailService emailService,
        ICache cache)
    {
        _repository = repository;
        _emailService = emailService;
        _cache = cache;
    }
    
    public async Task<Product> CreateProductAsync(CreateProductDto dto)
    {
