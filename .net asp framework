public class MemoryCacheService : ICache
{
    private readonly Dictionary<string, (object, DateTime)> _cache = new();
    
    public void Set(string key, object value, TimeSpan expiration)
    {
        _cache[key] = (value, DateTime.UtcNow.Add(expiration));
    }
    
    public object Get(string key)
    {
        if (_cache.TryGetValue(key, out var item))
        {
            if (DateTime.UtcNow < item.Item2)
                return item.Item1;
            _cache.Remove(key);
        }
        return null;
    }
}

