## MVC Architecture <a name="mvc"></a>

### Model-View-Controller Pattern

```
Request
   ↓
Routing
   ↓
Controller Action → Model ← Database
   ↓
View (HTML) ← Model
   ↓
Response
```

### Controller Complete Example with Theory

**What is a Controller?**
A controller is a C# class that:
- Receives HTTP requests from clients
- Calls business logic (services)
- Returns responses (HTML views, JSON, redirects)
- Acts as intermediary between request and business logic

```csharp
[Route("api/[controller]")]  // Base URL: /api/products
[ApiController]              // Tells ASP.NET this is an API controller
public class ProductsController : ControllerBase
{
    // Dependency Injection: Service injected via constructor
    private readonly IProductService _productService;
    private readonly ILogger<ProductsController> _logger;
    
    // Constructor: Called when controller is instantiated
    public ProductsController(
        IProductService productService, 
        ILogger<ProductsController> logger)
    {
        _productService = productService;
        _logger = logger;
    }
    
    // ============================================
    // GET REQUESTS (Retrieve data - Safe, no side effects)
    // ============================================
    
    // GET /api/products
    // Purpose: Get all products
    [HttpGet]
    public async Task<IActionResult> GetAll()
    {
        try
        {
            _logger.LogInformation("Getting all products");
            var products = await _productService.GetAllAsync();
            
            if (!products.Any())
                return NoContent();  // 204 - No products found
            
            return Ok(products);     // 200 - Success with data
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting products");
            return StatusCode(500, "Internal server error");
        }
    }
    
    // GET /api/products/5
    // Purpose: Get specific product by ID
    [HttpGet("{id}")]
    public async Task<IActionResult> GetById(int id)
    {
        _logger.LogInformation($"Getting product {id}");
        
        if (id <= 0)
            return BadRequest("Invalid product ID");
        
        var product = await _productService.GetByIdAsync(id);
        
        if (product == null)
            return NotFound($"Product {id} not found");  // 404
        
        return Ok(product);  // 200
    }
    
    // GET /api/products/search?keyword=laptop
    // Purpose: Search products
    [HttpGet("search")]
    public async Task<IActionResult> Search([FromQuery] string keyword)
    {
        if (string.IsNullOrWhiteSpace(keyword))
            return BadRequest("Keyword required");
        
        var results = await _productService.SearchAsync(keyword);
        return Ok(results);
    }
    
    // ============================================
    // POST REQUESTS (Create new data)
    // ============================================
    
    // POST /api/products
    // Body: { "name": "Laptop", "price": 999 }
    // Purpose: Create new product
    [HttpPost]
    public async Task<IActionResult> Create([FromBody] CreateProductDto dto)
    {
        // Validation
        if (dto == null)
            return BadRequest("Product data required");
        
        if (string.IsNullOrWhiteSpace(dto.Name))
            return BadRequest("Product name required");
        
        if (dto.Price <= 0)
            return BadRequest("Price must be greater than 0");
        
        // Business logic
        var product = await _productService.CreateAsync(dto);
        
        // Return 201 Created with location header
        return CreatedAtAction(
            nameof(GetById),                    // Method to call to retrieve it
            new { id = product.Id },           // Route values
            product);                          // Response body
    }
    
    // ============================================
    // PUT REQUESTS (Update existing data)
    // ============================================
    
    // PUT /api/products/5
    // Body: { "name": "Updated Laptop", "price": 1099 }
    // Purpose: Update existing product
    [HttpPut("{id}")]
    public async Task<IActionResult> Update(int id, [FromBody] UpdateProductDto dto)
    {
        if (id <= 0)
            return BadRequest("Invalid product ID");
        
        if (dto == null)
            return BadRequest("Update data required");
        
        // Check if product exists
        var existing = await _productService.GetByIdAsync(id);
        if (existing == null)
            return NotFound($"Product {id} not found");
        
        // Update
        await _productService.UpdateAsync(id, dto);
        
        // Return 204 No Content (successful but no body)
        return NoContent();
    }
    
    // PATCH /api/products/5 (Partial update)
    [HttpPatch("{id}")]
    public async Task<IActionResult> PartialUpdate(int id, [FromBody] JsonPatchDocument<UpdateProductDto> patchDoc)
    {
        var existing = await _productService.GetByIdAsync(id);
        if (existing == null)
            return NotFound();
        
        var updateDto = new UpdateProductDto { Name = existing.Name, Price = existing.Price };
        patchDoc.ApplyTo(updateDto);
        
        await _productService.UpdateAsync(id, updateDto);
        return NoContent();
    }
    
    // ============================================
    // DELETE REQUESTS (Remove data)
    // ============================================
    
    // DELETE /api/products/5
    // Purpose: Delete product
    [HttpDelete("{id}")]
    public async Task<IActionResult> Delete(int id)
    {
        if (id <= 0)
            return BadRequest("Invalid product ID");
        
        var existing = await _productService.GetByIdAsync(id);
        if (existing == null)
            return NotFound();
        
        await _productService.DeleteAsync(id);
        
        // 204 No Content (successful deletion)
        return NoContent();
    }
    
    // DELETE /api/products (Batch delete)
    [HttpDelete("batch")]
    public async Task<IActionResult> DeleteBatch([FromBody] int[] ids)
    {
        if (ids == null || ids.Length == 0)
            return BadRequest("At least one ID required");
        
        await _productService.DeleteMultipleAsync(ids);
        return Ok(new { deleted = ids.Length });
    }
}
```

**Key Points:**
- `[HttpGet/Post/Put/Delete]`: Attribute tells ASP.NET which HTTP method to handle
- `{id}`: Route parameter extracted from URL
- `[FromBody]`: Extract data from request body
- `[FromQuery]`: Extract from query string (?keyword=laptop)
- `IActionResult`: Return type allows different response types
- `await`: Non-blocking async call to service
```

