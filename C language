// Method 2: Recursive
void reverse_recursive(char *str, int i, int j) {
    if (i >= j) return;
    
    char temp = str[i];
    str[i] = str[j];
    str[j] = temp;
    
    reverse_recursive(str, i + 1, j - 1);
}

