### Scenario 2: Interview Question - Write a function
**Question:** Write a function that removes duplicates from an array, maintaining order.

```c
int remove_duplicates(int *arr, int size) {
    if (size <= 1) return size;
    
    int write_pos = 1;  // Position to write next unique element
    
    for (int read_pos = 1; read_pos < size; read_pos++) {
        int is_duplicate = 0;
        
        // Check if current element exists before this position
        for (int j = 0; j < write_pos; j++) {
            if (arr[read_pos] == arr[j]) {
                is_duplicate = 1;
                break;
            }
        }
        
        if (!is_duplicate) {
            arr[write_pos++] = arr[read_pos];
        }
    }
    
    return write_pos;
}

// Usage:
int main() {
    int arr[] = {1, 2, 2, 3, 1, 4, 2};
    int size = 7;
    
    int new_size = remove_duplicates(arr, size);
    
    for (int i = 0; i < new_size; i++) {
        printf("%d ", arr[i]);  // 1 2 3 4
    }
    printf("\n");
    
    return 0;
}

// Complexity: O(n²) - can optimize with hash table to O(n)
```

