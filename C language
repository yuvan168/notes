## Control Flow

### If-Else Statements

```c
int age = 20;

// Simple if
if (age >= 18) {
    printf("You are an adult\n");
}

// If-else
if (age < 13) {
    printf("Child\n");
} else if (age < 18) {
    printf("Teenager\n");
} else {
    printf("Adult\n");
}

// Omit braces for single statement (not recommended)
if (age >= 18)
    printf("Adult\n");

// Common mistake
if (age = 18) {          // ❌ Assignment, not comparison!
    // This always executes
}
```

### Switch Statement

```c
int day = 3;
char *day_name;

switch (day) {
    case 1:
        day_name = "Monday";
        break;              // Don't forget!
    case 2:
        day_name = "Tuesday";
        break;
    case 3:
    case 4:                 // Multiple cases
        day_name = "Wednesday or Thursday";
        break;
    default:
        day_name = "Other";
}

// Without break (fall-through)
switch (day) {
    case 1:
        printf("Start\n");  // Falls through
    case 2:
        printf("Middle\n"); // If day is 1, prints both
        break;
    case 3:
        printf("End\n");
}
```

### Loops

**While Loop:**
```c
int count = 0;
while (count < 5) {
    printf("%d\n", count);
    count++;
}

// Do-while (executes at least once)
do {
    printf("Enter positive number: ");
    int num;
    scanf("%d", &num);
} while (num <= 0);     // Checks condition after execution
```

**For Loop:**
```c
// Standard for loop
for (int i = 0; i < 5; i++) {
    printf("%d\n", i);
}

// Equivalent while loop
int i = 0;
while (i < 5) {
    printf("%d\n", i);
    i++;
}

// No initialization
int j = 0;
for (; j < 5; j++) {
    printf("%d\n", j);
}

// Multiple variables
for (int i = 0, j = 10; i < 5; i++, j--) {
    printf("i=%d, j=%d\n", i, j);
}

// Infinite loop (needs break)
for (;;) {
    printf("Infinite\n");
    break;  // Exit
}
```

### Break & Continue

```c
// Break - exits loop immediately
for (int i = 0; i < 10; i++) {
    if (i == 5) {
        break;      // Exits loop when i = 5
    }
    printf("%d\n", i);  // Prints 0,1,2,3,4
}

// Continue - skips rest of iteration
for (int i = 0; i < 5; i++) {
    if (i == 2) {
        continue;   // Skips i = 2
    }
    printf("%d\n", i);  // Prints 0,1,3,4
}

// Breaking nested loops (use goto for multiple levels)
for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
        if (i == 1 && j == 1) {
            goto exit_loops;
        }
    }
}
exit_loops:
printf("Exited nested loops\n");
```

### Goto Statement

```c
// Generally discouraged (can make code hard to follow)
int i = 0;
start:
printf("%d\n", i);
i++;
if (i < 5)
    goto start;

// Acceptable use: error handling
FILE *file = fopen("data.txt", "r");
if (!file) {
    printf("Cannot open file\n");
    goto error;
}

// ... process file ...

fclose(file);
error:
    // cleanup
```

