## Operators

### Arithmetic Operators

```c
int a = 10, b = 3;

int sum = a + b;           // 13 (addition)
int diff = a - b;          // 7 (subtraction)
int product = a * b;       // 30 (multiplication)
int quotient = a / b;      // 3 (integer division, truncates)
int remainder = a % b;     // 1 (modulo)
int power = 2 ^ 3;         // NOT exponentiation! Use pow()

// Unary operators
int neg = -a;              // -10
int pos = +a;              // 10
```

### Comparison Operators

```c
int a = 10, b = 20;

a == b;                    // false (equal to)
a != b;                    // true (not equal to)
a < b;                     // true (less than)
a <= b;                    // true (less than or equal)
a > b;                     // false (greater than)
a >= b;                    // false (greater than or equal)

// Common mistake
if (a = b) { }             // ❌ Assignment, not comparison!
if (a == b) { }            // ✓ Correct comparison
```

### Logical Operators

```c
int a = 1 (true), b = 0 (false);

a && b;                    // false (AND - both must be true)
a || b;                    // true (OR - at least one true)
!a;                        // false (NOT - inverts)
!(a && b);                 // true (NOT AND)

// Short-circuit evaluation
if (a && expensive_function()) {
    // expensive_function() only called if a is true
}

if (b || expensive_function()) {
    // expensive_function() only called if b is false
}
```

### Bitwise Operators

```c
unsigned char a = 5;       // 0101 in binary
unsigned char b = 3;       // 0011 in binary

a & b;                     // 1 (0001) - AND
a | b;                     // 7 (0111) - OR
a ^ b;                     // 6 (0110) - XOR
~a;                        // 250 (1010, inverted) - NOT
a << 1;                    // 10 (1010) - left shift
a >> 1;                    // 2 (0010) - right shift

// Practical uses
#define BIT_SET(x, n) ((x) |= (1 << (n)))
#define BIT_CLEAR(x, n) ((x) &= ~(1 << (n)))
#define BIT_CHECK(x, n) ((x) & (1 << (n)))
```

### Assignment Operators

```c
int x = 10;

x += 5;                    // x = x + 5;       (15)
x -= 3;                    // x = x - 3;       (12)
x *= 2;                    // x = x * 2;       (24)
x /= 4;                    // x = x / 4;       (6)
x %= 3;                    // x = x % 3;       (0)
x &= 0xFF;                 // x = x & 0xFF;
