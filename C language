### Q24: Implement a simple parser/tokenizer
```c
#include <ctype.h>
#include <string.h>

typedef struct {
    char tokens[100][50];
    int count;
} Tokens;

Tokens tokenize(const char *input) {
    Tokens t = {0};
    char current[50];
    int j = 0;
    
    for (int i = 0; input[i]; i++) {
        char c = input[i];
        
        if (isspace(c)) {
            if (j > 0) {
                current[j] = '\0';
                strcpy(t.tokens[t.count++], current);
                j = 0;
            }
        } else if (strchr("()+-*/", c)) {
            if (j > 0) {
                current[j] = '\0';
                strcpy(t.tokens[t.count++], current);
                j = 0;
            }
            current[0] = c;
            current[1] = '\0';
            strcpy(t.tokens[t.count++], current);
        } else {
            current[j++] = c;
        }
    }
    
    if (j > 0) {
        current[j] = '\0';
        strcpy(t.tokens[t.count++], current);
    }
    
    return t;
}

