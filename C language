### Common Memory Issues

```c
// Memory leak: allocated but not freed
void function() {
    int *ptr = malloc(sizeof(int));
    // Function ends, ptr not freed
}  // Memory lost!

// Solution: Always free
void function() {
    int *ptr = malloc(sizeof(int));
    // ... use ptr ...
    free(ptr);
}

// Dangling pointer: using freed memory
int *ptr = malloc(sizeof(int));
free(ptr);
*ptr = 10;                     // ❌ Undefined behavior!

// Use-after-free
int *ptr = malloc(sizeof(int));
free(ptr);
int x = *ptr;                  // ❌ Reading freed memory!

// Double free
int *ptr = malloc(sizeof(int));
free(ptr);
free(ptr);                     // ❌ Undefined behavior!
```

### Memory Best Practices

```c
// 1. Always check malloc result
int *ptr = malloc(sizeof(int));
if (ptr == NULL) {
    perror("malloc");
    return;
}

// 2. Free exactly once
free(ptr);

// 3. Avoid dangling pointers
ptr = NULL;

// 4. Don't free stack variables
int x = 10;
free(&x);                      // ❌ Wrong!

// 5. Use sizeof() to handle types
struct Person {
    char name[50];
    int age;
};
struct Person *p = malloc(sizeof(struct Person));

// 6. Common pattern (allocate array)
int *arr = malloc(100 * sizeof(int));
for (int i = 0; i < 100; i++) {
    arr[i] = i;
}
free(arr);
```

