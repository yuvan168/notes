**String Manipulation Example:**
```c
#include <stdio.h>
#include <string.h>

int main() {
    char str[100] = "Hello World";
    
    // Length
    printf("Length: %lu\n", strlen(str));
    
    // Reverse (manual)
    for (int i = strlen(str) - 1; i >= 0; i--) {
        printf("%c", str[i]);  // dlroW olleH
    }
    printf("\n");
    
    // Find character
    char *ptr = strchr(str, 'W');
    if (ptr) {
        printf("Found at position: %ld\n", ptr - str);
    }
    
    // Replace character
    for (int i = 0; str[i]; i++) {
        if (str[i] == ' ')
            str[i] = '_';
    }
    printf("%s\n", str);       // Hello_World
    
    return 0;
}
```

