### Q21: Design a dynamic array (vector) in C
```c
#include <stdlib.h>
#include <string.h>

typedef struct {
    int *data;
    int size;        // Current number of elements
    int capacity;    // Allocated space
} Vector;

Vector* vector_create(int initial_capacity) {
    Vector *v = malloc(sizeof(Vector));
    v->capacity = initial_capacity > 0 ? initial_capacity : 10;
    v->size = 0;
    v->data = malloc(v->capacity * sizeof(int));
    return v;
}

void vector_push(Vector *v, int value) {
    if (v->size == v->capacity) {
        v->capacity *= 2;  // Double capacity
        int *new_data = realloc(v->data, v->capacity * sizeof(int));
        if (!new_data) {
            printf("Memory allocation failed\n");
            return;
        }
        v->data = new_data;
    }
    v->data[v->size++] = value;
}

int vector_pop(Vector *v) {
    if (v->size > 0) {
        return v->data[--v->size];
    }
    return -1;  // Error indicator
}

int vector_get(Vector *v, int index) {
    if (index >= 0 && index < v->size) {
        return v->data[index];
    }
    return -1;
}

void vector_free(Vector *v) {
    if (v) {
        free(v->data);
        free(v);
    }
}

// Usage
int main() {
    Vector *v = vector_create(5);
    
    for (int i = 0; i < 20; i++) {
        vector_push(v, i * 2);
    }
    
    printf("Size: %d, Capacity: %d\n", v->size, v->capacity);
    
    for (int i = 0; i < v->size; i++) {
        printf("%d ", vector_get(v, i));
    }
    printf("\n");
    
    vector_free(v);
    return 0;
}
```

**Key Concepts:**
- Amortized O(1) insertion
- Doubling capacity when needed
- Proper memory management
- Edge case handling

