v.push_back(1);
v.push_back(2);
cout << v[0];  // Fast random access
v.insert(v.begin(), 0);  // Slow - O(n) operation

// Deque - Use when: Need front/back insertion, random access
deque<int> dq;
dq.push_back(1);
dq.push_front(0);  // Fast - O(1)
cout << dq[0];     // Fast random access
dq.insert(dq.begin(), 0);  // Still slow - O(n)

// List - Use when: Need frequent insertion/deletion, don't need random access
list<int> lst;
lst.push_back(1);
lst.push_front(0);  // Fast - O(1)
auto it = lst.begin();
lst.insert(it, 0);  // Fast - O(1)
cout << *it;        // Works, but no direct indexing
```

