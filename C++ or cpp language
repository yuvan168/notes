#### DSA-3: Reverse String

**Question**: Reverse a string in-place.

**Answer**:
```cpp
// O(n) time, O(1) space - Two pointer approach
void reverseString(string& s) {
    int left = 0, right = s.length() - 1;
    
    while (left < right) {
        swap(s[left], s[right]);
        left++;
        right--;
    }
}

// Example
string s = "hello";
reverseString(s);
cout << s;  // "olleh"

// For char array
void reverseArray(vector<char>& s) {
    int left = 0, right = s.size() - 1;
    while (left < right) {
        swap(s[left++], s[right--]);
    }
}
