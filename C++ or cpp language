    Shape(double x, double y) : x(x), y(y) { }
    
    virtual void draw() = 0;           // Pure virtual
    virtual ~Shape() { }
    
    double getX() const { return x; }  // Concrete method
};

class Circle : public Shape {
public:
    Circle(double x, double y) : Shape(x, y) { }
    void draw() override { cout << "Drawing circle" << endl; }
};

// Pure interface: All methods virtual, no implementation
class Drawable {
public:
    virtual void draw() = 0;
    virtual void rotate(double angle) = 0;
    virtual ~Drawable() { }
};

class Square : public Drawable {
public:
    void draw() override { cout << "Drawing square" << endl; }
    void rotate(double angle) override { }
};

// Cannot instantiate abstract classes
// Shape s;  // ERROR: pure virtual function not overridden
Circle c(0, 0);  // OK: all virtual functions overridden
```

**Differences**:
- Abstract class: Can have member data and implementation
- Interface: Pure virtual methods only (design pattern)
- C++ uses virtual functions to simulate interfaces

