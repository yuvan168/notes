### Constructors - Complete Guide

**Constructor Types and Order of Execution**:

```cpp
class Complex {
private:
    double real, imag;

public:
    // 1. Default constructor (no parameters)
    Complex() {
        real = 0;
        imag = 0;
    }
    
    // 2. Parameterized constructor
    Complex(double r, double i) {
        real = r;
        imag = i;
    }
    
    // 3. Copy constructor (called when object copied)
    Complex(const Complex& c) {
        real = c.real;
        imag = c.imag;
    }
    
    // 4. Move constructor (C++11, called when object moved)
    Complex(Complex&& c) noexcept {
        real = c.real;
        imag = c.imag;
        c.real = 0;
        c.imag = 0;
    }
    
    // Initializer list version (preferred, C++11)
    Complex(double r = 0, double i = 0) : real(r), imag(i) { }
    
    // Delegating constructor (C++11, calls another constructor)
    Complex() : Complex(0, 0) { }
};

int main() {
    Complex c1;                    // Default constructor
    Complex c2(3, 4);              // Parameterized constructor
    Complex c3 = c2;               // Copy constructor
    Complex c4 = move(c2);         // Move constructor
    Complex c5{3, 4};              // Uniform initialization
}
```

