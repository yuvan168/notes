#### DSA-7: Maximum Subarray (Kadane's Algorithm)

**Question**: Find subarray with maximum sum.

**Answer**:
```cpp
// O(n) time, O(1) space - Kadane's Algorithm
int maxSubArray(vector<int>& nums) {
    int maxSum = nums[0];
    int currentSum = nums[0];
    
    for (int i = 1; i < nums.size(); i++) {
        currentSum = max(nums[i], currentSum + nums[i]);
        maxSum = max(maxSum, currentSum);
    }
    
    return maxSum;
}

// With subarray tracking
pair<int, pair<int, int>> maxSubArrayWithIndices(vector<int>& nums) {
    int maxSum = nums[0];
    int currentSum = nums[0];
    int start = 0, end = 0, tempStart = 0;
    
    for (int i = 1; i < nums.size(); i++) {
        if (currentSum < 0) {
            currentSum = nums[i];
            tempStart = i;
        } else {
            currentSum += nums[i];
        }
        
        if (currentSum > maxSum) {
            maxSum = currentSum;
            start = tempStart;
            end = i;
        }
    }
    
    return {maxSum, {start, end}};
}

// Examples
vector<int> nums = {-2, 1, -3, 4, -1, 2, 1, -5, 4};
cout << maxSubArray(nums);  // 6 (subarray [4, -1, 2, 1])

// Time: O(n) vs O(n³) brute force or O(n²) divide-and-conquer
```

