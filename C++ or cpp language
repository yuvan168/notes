#### DSA-10: Coin Change (DP Optimization)

**Question**: Find minimum coins needed to make amount.

**Answer**:
```cpp
// O(amount * coins.size()) time, O(amount) space
int coinChange(vector<int>& coins, int amount) {
    vector<int> dp(amount + 1, INT_MAX);
    dp[0] = 0;  // Base case: 0 amount needs 0 coins
    
    for (int i = 1; i <= amount; i++) {
        for (int coin : coins) {
            if (coin <= i && dp[i - coin] != INT_MAX) {
                dp[i] = min(dp[i], dp[i - coin] + 1);
            }
        }
    }
    
    return dp[amount] == INT_MAX ? -1 : dp[amount];
}

// Example
vector<int> coins = {1, 2, 5};
cout << coinChange(coins, 5);   // 1 (one 5-coin)
cout << coinChange(coins, 11);  // 3 (one 5-coin + three 2-coins)

// Comparison
// Brute force: O(3^amount) - try all combinations
// DP: O(amount * n) - much better!
```

