### Function Parameters

**Parameter Passing Modes Theory**:

1. **Pass by Value**: Copy of parameter created
   - Safe, parameter changes don't affect original
   - Expensive for large objects
   - All primitive types use this by default

2. **Pass by Reference**: Reference to original parameter
   - Changes affect original variable
   - Efficient for large objects
   - Enables output parameters

3. **Pass by Const Reference**: Best practice for input parameters
   - No copy overhead
   - Parameter cannot be modified
   - Prevents accidental changes

```cpp
// 1. Pass by value - copy of parameter
void modifyValue(int x) {
    x = 100;  // Only modifies local copy
}

int main() {
    int original = 50;
    modifyValue(original);
    cout << original;  // Still 50
}

// 2. Pass by reference - reference to original
void modifyByRef(int& x) {
    x = 100;  // Modifies original
}

int main() {
    int original = 50;
    modifyByRef(original);
    cout << original;  // Now 100
}

// 3. Pass by const reference - for input parameters (preferred)
void printValue(const int& x) {
    cout << x << endl;
    // x = 200;  // ERROR - cannot modify const reference
}

// 4. Pass complex objects
class LargeObject {
    vector<int> data;
public:
    LargeObject(int size) : data(size) {}
};

// Bad: Copies entire object
void processBad(LargeObject obj) { }

// Good: Reference, no copy
void processGood(const LargeObject& obj) { }

// Usage
int main() {
    LargeObject huge(1000000);
    processBad(huge);   // Very slow - copies huge object
    processGood(huge);  // Very fast - just reference
}

// 5. Default parameters (must be at end of parameter list)
int power(int base, int exponent = 2) {
    int result = 1;
    for (int i = 0; i < exponent; i++) {
        result *= base;
    }
    return result;
}

int main() {
    cout << power(3);      // exponent = 2, result = 9
    cout << power(3, 3);   // exponent = 3, result = 27
}

// 6. Variadic parameters (variable number of arguments)
// C-style: using ...
void printNumbers(int count, ...) {
    va_list args;
    va_start(args, count);
    for (int i = 0; i < count; i++) {
        cout << va_arg(args, int) << " ";
    }
    va_end(args);
}

int main() {
    printNumbers(3, 10, 20, 30);  // Prints: 10 20 30
}

// C++11-style: Variadic templates (type-safe)
template<typename... Args>
void printAll(Args... args) {
    // Requires recursive unpacking
}
```

**Best Practices for Parameters**:
```cpp
// For input parameters
void func1(const int& x);           // Scalar type: const reference
void func2(const string& str);      // Object: const reference
void func3(const vector<int>& v);   // Container: const reference

// For output parameters
void func4(int& result);            // Output: reference
void func5(string& output);         // Output: reference

// For input-output parameters
void func6(vector<int>& data);      // Modify existing: reference

// Avoid for large objects
void funcBad(LargeObject obj);      // Don't! Copies entire object
void funcGood(const LargeObject& obj); // Do this instead

// Array parameters (always decay to pointers)
