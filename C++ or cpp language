// Practical example
class DatabaseConnection {
public:
    void query(string sql) { }
    ~DatabaseConnection() { cout << "Connection closed" << endl; }
};

void example1() {
    auto conn = make_shared<DatabaseConnection>();
    // ... use connection
}  // Automatically closed

vector<shared_ptr<DatabaseConnection>> connections;
for (int i = 0; i < 10; i++) {
    connections.push_back(make_shared<DatabaseConnection>());
}
// All connections automatically deleted when vector cleared
```

**Comparison**:
| Feature | unique_ptr | shared_ptr |
|---------|-----------|-----------|
| Ownership | Exclusive | Shared |
| Copy | No | Yes |
| Move | Yes | Yes |
| Overhead | None | Reference count (8 bytes + atomic) |
| Use When | Clear ownership | Multiple owners |

