#### DSA-5: Binary Search

**Question**: Find target in sorted array.

**Answer**:
```cpp
// O(log n) time, O(1) space - Iterative
int binarySearch(vector<int>& arr, int target) {
    int left = 0, right = arr.size() - 1;
    
    while (left <= right) {
        int mid = left + (right - left) / 2;  // Avoid overflow
        
        if (arr[mid] == target) {
            return mid;
        } else if (arr[mid] < target) {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }
    
    return -1;  // Not found
}

// O(log n) time, O(log n) space - Recursive
int binarySearchRec(vector<int>& arr, int target, int left, int right) {
    if (left > right) return -1;
    
    int mid = left + (right - left) / 2;
    if (arr[mid] == target) {
        return mid;
    } else if (arr[mid] < target) {
        return binarySearchRec(arr, target, mid + 1, right);
    } else {
        return binarySearchRec(arr, target, left, mid - 1);
    }
}

// Examples
vector<int> nums = {1, 3, 5, 7, 9};
cout << binarySearch(nums, 7);   // 3
cout << binarySearch(nums, 10);  // -1

// Time complexity: log₂(1,000,000) ≈ 20 operations vs 1M for linear
```

