// O(n) time, O(1) space - Two pointer approach
int removeDuplicates(vector<int>& nums) {
    if (nums.empty()) return 0;
    
    int j = 0;  // Position for next unique element
    
    for (int i = 1; i < nums.size(); i++) {
        if (nums[i] != nums[j]) {
            j++;
            nums[j] = nums[i];
        }
    }
    
    return j + 1;
}

