#### Q9: What's the difference between passing by value, reference, and const reference?

**Answer**:
```cpp
// Pass by value: Copies the parameter
void modifyValue(int x) {
    x = 100;  // Only modifies local copy
}

int main() {
    int original = 42;
    modifyValue(original);
    cout << original;  // 42 (unchanged)
}

// Pass by reference: References the original
void modifyByRef(int& x) {
    x = 100;  // Modifies original
}

int main() {
    int original = 42;
    modifyByRef(original);
    cout << original;  // 100 (modified)
}

// Pass by const reference: Cannot modify, no copy
void readValue(const int& x) {
    cout << x;
    // x = 100;  // ERROR: cannot modify
}

// For large objects
class LargeData {
    vector<int> data;  // 1 million elements
public:
    // Bad: Copies entire object
    void processBad(LargeData obj) { }
    
    // Good: Reference, no copy
    void processGood(const LargeData& obj) { }
};

LargeData huge;
processBad(huge);   // Slow: 1M elements copied
processGood(huge);  // Fast: just reference
```

**Rule of Thumb**:
- Small types (int, double, char): pass by value
- Large objects: pass by const reference
- Need to modify: pass by reference
- Return from function: return by value (move semantics handles it)

