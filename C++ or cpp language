template <typename T>
class Vector {
private:
    T* data;
    int capacity;
    int size;
    
    void resize() {
        T* newData = new T[capacity * 2];
        for (int i = 0; i < size; i++) {
            newData[i] = data[i];
        }
        delete[] data;
        data = newData;
        capacity *= 2;
    }

public:
    Vector() : data(nullptr), capacity(0), size(0) {}
    
    ~Vector() {
        delete[] data;
    }
    
    void push_back(T value) {
        if (size >= capacity) {
            capacity = (capacity == 0) ? 1 : capacity;
            resize();
        }
        data[size++] = value;
    }
    
    T& operator[](int index) {
        return data[index];
    }
    
    int getSize() const {
        return size;
    }
};
