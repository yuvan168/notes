#### Q4: Explain move semantics and when to use std::move

**Answer**:
```cpp
// Without move: expensive deep copy
class Vector {
    int* data;
public:
    Vector(const Vector& other) {
        data = new int[1000000];
        memcpy(data, other.data, 1000000 * sizeof(int));  // Slow!
    }
};

Vector v1 = createVector();  // Calls copy constructor (inefficient)

// With move: efficient transfer
class Vector {
    int* data;
public:
    Vector(Vector&& other) noexcept {
        data = other.data;         // Transfer ownership
        other.data = nullptr;      // Leave source empty
    }
};

Vector v2 = createVector();  // Calls move constructor (efficient)
