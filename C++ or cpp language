#### DSA-4: Valid Parentheses

**Question**: Check if parentheses are balanced.

**Answer**:
```cpp
// O(n) time, O(n) space - Using stack
bool isValid(string s) {
    stack<char> st;
    unordered_map<char, char> pairs = {
        {')', '('},
        {'}', '{'},
        {']', '['}
    };
    
    for (char c : s) {
        if (pairs.count(c)) {  // Closing bracket
            if (st.empty() || st.top() != pairs[c]) {
                return false;
            }
            st.pop();
        } else {  // Opening bracket
            st.push(c);
        }
    }
    
    return st.empty();
}

// Examples
cout << isValid("()");         // true
cout << isValid("()[]{}");     // true
cout << isValid("([)]");       // false
cout << isValid("{[");         // false
```

