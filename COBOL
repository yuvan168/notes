## Inventory Management System

### Theory: Inventory Concepts

```
INVENTORY SYSTEM COMPONENTS:

1. STOCK TRACKING
   ├─ Quantity on hand
   ├─ Quantity on order
   ├─ Reorder point
   └─ Safety stock

2. VALUATION METHODS
   ├─ FIFO (First In, First Out)
   ├─ LIFO (Last In, First Out)
   └─ Weighted Average Cost

3. MOVEMENTS
   ├─ Receipts (increase inventory)
   ├─ Withdrawals (decrease inventory)
   ├─ Adjustments (corrections)
   └─ Obsolescence (write-offs)

4. ALERTS & TRIGGERS
   ├─ Low stock warnings
   ├─ Automatic PO generation
   ├─ Slow-moving items
   └─ Overstock situations
```

**Complete Inventory System:**

```cobol
       IDENTIFICATION DIVISION.
       PROGRAM-ID. INVENTORY-MANAGEMENT-SYSTEM.
       
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INVENTORY-MASTER ASSIGN TO
               'inventory-master.dat'
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS ITEM-CODE.
           
           SELECT INVENTORY-MOVEMENT ASSIGN TO
               'inventory-movement.txt'
               ORGANIZATION IS SEQUENTIAL.
           
           SELECT INVENTORY-REPORT ASSIGN TO
               'inventory-report.txt'
               ORGANIZATION IS LINE SEQUENTIAL.
           
           SELECT PO-GENERATION ASSIGN TO
               'purchase-orders.txt'
               ORGANIZATION IS LINE SEQUENTIAL.
       
       DATA DIVISION.
       FILE SECTION.
       FD INVENTORY-MASTER.
       01 INVENTORY-ITEM.
           05 ITEM-CODE              PIC X(10).
           05 ITEM-DESCRIPTION       PIC X(40).
           05 CATEGORY                PIC X(20).
           05 UNIT-OF-MEASURE        PIC X(5).
           05 QUANTITY-ON-HAND       PIC 9(7).
           05 QUANTITY-ON-ORDER      PIC 9(7).
           05 UNIT-COST              PIC 9(6)V99.
           05 UNIT-PRICE             PIC 9(6)V99.
           05 REORDER-POINT          PIC 9(7).
           05 ECONOMIC-ORDER-QTY     PIC 9(7).
           05 LEAD-TIME-DAYS         PIC 9(3).
           05 INVENTORY-VALUE        PIC 9(12)V99.
           05 LAST-RECEIPT-DATE      PIC 9(8).
           05 LAST-ISSUE-DATE        PIC 9(8).
           05 SUPPLIER-ID            PIC 9(5).
           05 ITEM-STATUS            PIC X.
               88 ACTIVE-ITEM        VALUE 'A'.
               88 DISCONTINUED-ITEM  VALUE 'D'.
               88 OBSOLETE-ITEM      VALUE 'O'.
       
       FD INVENTORY-MOVEMENT.
       01 MOVEMENT-RECORD.
           05 MOV-DATE               PIC 9(8).
           05 MOV-TIME               PIC 9(6).
           05 MOV-ITEM-CODE          PIC X(10).
           05 MOV-TYPE               PIC X(3).
               88 RECEIPT            VALUE 'REC'.
               88 ISSUE              VALUE 'ISS'.
               88 ADJUSTMENT         VALUE 'ADJ'.
           05 MOV-QUANTITY           PIC 9(7).
           05 MOV-UNIT-COST          PIC 9(6)V99.
           05 MOV-REFERENCE          PIC X(20).
           05 MOV-NOTES              PIC X(50).
       
       FD INVENTORY-REPORT.
       01 REPORT-OUTPUT              PIC X(132).
       
       FD PO-GENERATION.
       01 PO-OUTPUT                  PIC X(132).
       
       WORKING-STORAGE SECTION.
       01 WS-CONTROL.
           05 WS-EOF                 PIC X VALUE 'N'.
           05 WS-RECORDS-PROCESSED   PIC 9(6) VALUE 0.
           05 WS-PO-NUMBER           PIC 9(7) VALUE 0.
           05 WS-CURRENT-DATE        PIC 9(8).
       
       01 WS-INVENTORY-CALCULATIONS.
           05 WS-NEW-QUANTITY        PIC 9(7).
           05 WS-NEW-VALUE           PIC 9(12)V99.
           05 WS-COST-DIFFERENCE     PIC S9(10)V99.
           05 WS-OLD-VALUE           PIC 9(12)V99.
           05 WS-REQUIRED-QTY        PIC 9(7).
           05 WS-DAYS-SUPPLY         PIC 9(5).
       
       01 WS-TOTALS.
           05 WS-TOTAL-INVENTORY-VALUE PIC 9(15)V99 VALUE 0.
           05 WS-LOW-STOCK-VALUE     PIC 9(12)V99 VALUE 0.
           05 WS-OVERSTOCK-VALUE     PIC 9(12)V99 VALUE 0.
           05 WS-OBSOLETE-VALUE      PIC 9(12)V99 VALUE 0.
           05 WS-PO-TOTAL            PIC 9(12)V99 VALUE 0.
       
       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           ACCEPT WS-CURRENT-DATE FROM DATE YYYYMMDD.
           
           PERFORM OPEN-ALL-FILES.
           PERFORM PROCESS-INVENTORY-MOVEMENTS.
           PERFORM GENERATE-INVENTORY-REPORT.
           PERFORM GENERATE-PURCHASE-ORDERS.
           PERFORM CLOSE-ALL-FILES.
           DISPLAY "INVENTORY PROCESSING COMPLETE".
           STOP RUN.
       
       OPEN-ALL-FILES.
           OPEN INPUT INVENTORY-MASTER.
           OPEN INPUT INVENTORY-MOVEMENT.
           OPEN OUTPUT INVENTORY-REPORT.
           OPEN OUTPUT PO-GENERATION.
       
       PROCESS-INVENTORY-MOVEMENTS.
           PERFORM UNTIL WS-EOF = 'Y'
               READ INVENTORY-MOVEMENT
                   AT END
                       MOVE 'Y' TO WS-EOF
                   NOT AT END
                       PERFORM READ-INVENTORY-ITEM
                       PERFORM PROCESS-MOVEMENT
                       PERFORM SAVE-UPDATED-INVENTORY
                       ADD 1 TO WS-RECORDS-PROCESSED
               END-READ
           END-PERFORM.
       
       READ-INVENTORY-ITEM.
           READ INVENTORY-MASTER
               KEY IS ITEM-CODE = MOV-ITEM-CODE
               INVALID KEY
                   DISPLAY "Item not found: " MOV-ITEM-CODE
                   MOVE 'Y' TO WS-EOF
           END-READ.
       
       PROCESS-MOVEMENT.
           MOVE INVENTORY-VALUE TO WS-OLD-VALUE.
           
           EVALUATE TRUE
               WHEN RECEIPT
                   PERFORM PROCESS-RECEIPT
               WHEN ISSUE
                   PERFORM PROCESS-ISSUE
               WHEN ADJUSTMENT
                   PERFORM PROCESS-ADJUSTMENT
           END-EVALUATE.
       
       PROCESS-RECEIPT.
           *> Add quantity to inventory
           COMPUTE WS-NEW-QUANTITY = 
               QUANTITY-ON-HAND + MOV-QUANTITY.
           MOVE WS-NEW-QUANTITY TO QUANTITY-ON-HAND.
           
           *> Update unit cost if different
           IF MOV-UNIT-COST NOT = UNIT-COST
               PERFORM UPDATE-UNIT-COST
           END-IF.
           
           *> Recalculate inventory value
           COMPUTE INVENTORY-VALUE = 
               QUANTITY-ON-HAND * UNIT-COST.
           
           *> Update receipt date
           MOVE MOV-DATE TO LAST-RECEIPT-DATE.
           
           *> Reduce quantity on order
           IF QUANTITY-ON-ORDER >= MOV-QUANTITY
               COMPUTE QUANTITY-ON-ORDER = 
                   QUANTITY-ON-ORDER - MOV-QUANTITY
           ELSE
               MOVE 0 TO QUANTITY-ON-ORDER
           END-IF.
       
       PROCESS-ISSUE.
           *> Remove quantity from inventory
           IF MOV-QUANTITY <= QUANTITY-ON-HAND
               COMPUTE WS-NEW-QUANTITY = 
                   QUANTITY-ON-HAND - MOV-QUANTITY
               MOVE WS-NEW-QUANTITY TO QUANTITY-ON-HAND
           ELSE
               MOVE 0 TO QUANTITY-ON-HAND
           END-IF.
           
           *> Recalculate inventory value
           COMPUTE INVENTORY-VALUE = 
               QUANTITY-ON-HAND * UNIT-COST.
           
           *> Update last issue date
           MOVE MOV-DATE TO LAST-ISSUE-DATE.
       
       PROCESS-ADJUSTMENT.
           *> Adjust quantity (can be positive or negative)
           COMPUTE WS-NEW-QUANTITY = 
               QUANTITY-ON-HAND + MOV-QUANTITY.
           
           IF WS-NEW-QUANTITY >= 0
               MOVE WS-NEW-QUANTITY TO QUANTITY-ON-HAND
           ELSE
               MOVE 0 TO QUANTITY-ON-HAND
           END-IF.
           
           *> Recalculate inventory value
           COMPUTE INVENTORY-VALUE = 
               QUANTITY-ON-HAND * UNIT-COST.
       
       UPDATE-UNIT-COST.
           *> Use weighted average cost method
           COMPUTE UNIT-COST = 
               ((QUANTITY-ON-HAND * UNIT-COST) +
                (MOV-QUANTITY * MOV-UNIT-COST)) /
               (QUANTITY-ON-HAND + MOV-QUANTITY).
       
       SAVE-UPDATED-INVENTORY.
           REWRITE INVENTORY-ITEM
               INVALID KEY
                   DISPLAY "Error writing inventory"
           END-REWRITE.
       
       GENERATE-INVENTORY-REPORT.
           PERFORM WRITE-REPORT-HEADER.
           PERFORM WRITE-INVENTORY-SUMMARY.
           PERFORM WRITE-LOW-STOCK-ITEMS.
           PERFORM WRITE-OVERSTOCK-ITEMS.
           PERFORM WRITE-OBSOLETE-ITEMS.
           PERFORM WRITE-TOTALS.
       
       WRITE-REPORT-HEADER.
           MOVE "INVENTORY STATUS REPORT" 
               TO REPORT-OUTPUT.
           WRITE REPORT-OUTPUT.
           
           STRING
               "Report Date: " DELIMITED BY SIZE
               WS-CURRENT-DATE DELIMITED BY SIZE
               INTO REPORT-OUTPUT
           END-STRING.
           WRITE REPORT-OUTPUT.
       
       WRITE-INVENTORY-SUMMARY.
           *> Would iterate through all inventory items
           MOVE SPACES TO REPORT-OUTPUT.
           WRITE REPORT-OUTPUT.
           
           MOVE "INVENTORY ITEMS DETAIL:" 
               TO REPORT-OUTPUT.
           WRITE REPORT-OUTPUT.
       
       WRITE-LOW-STOCK-ITEMS.
           MOVE "LOW STOCK ITEMS (Below Reorder Point):" 
               TO REPORT-OUTPUT.
           WRITE REPORT-OUTPUT.
           
           *> Iterate and list items with low stock
           PERFORM VARYING ITEM-CODE FROM 1 BY 1
               UNTIL ITEM-CODE > 999
               
               IF QUANTITY-ON-HAND < REORDER-POINT
                   STRING
                       ITEM-CODE DELIMITED BY SIZE
                       " | " DELIMITED BY SIZE
                       ITEM-DESCRIPTION 
                           DELIMITED BY SPACE
                       " | Qty: " DELIMITED BY SIZE
                       QUANTITY-ON-HAND 
                           DELIMITED BY SIZE
                       " | Reorder: " DELIMITED BY SIZE
                       REORDER-POINT DELIMITED BY SIZE
                       INTO REPORT-OUTPUT
                   END-STRING
                   WRITE REPORT-OUTPUT
               END-IF
           END-PERFORM.
       
       WRITE-OVERSTOCK-ITEMS.
           MOVE "OVERSTOCK ITEMS:" TO REPORT-OUTPUT.
           WRITE REPORT-OUTPUT.
       
       WRITE-OBSOLETE-ITEMS.
           MOVE "OBSOLETE/DISCONTINUED ITEMS:" 
               TO REPORT-OUTPUT.
           WRITE REPORT-OUTPUT.
       
       WRITE-TOTALS.
           MOVE SPACES TO REPORT-OUTPUT.
           WRITE REPORT-OUTPUT.
           
           STRING
               "Total Inventory Value: $" 
                   DELIMITED BY SIZE
               WS-TOTAL-INVENTORY-VALUE DELIMITED BY SIZE
               INTO REPORT-OUTPUT
           END-STRING.
           WRITE REPORT-OUTPUT.
       
       GENERATE-PURCHASE-ORDERS.
           *> Create POs for low stock items
           PERFORM CREATE-PURCHASE-ORDERS.
       
       CREATE-PURCHASE-ORDERS.
           MOVE SPACES TO PO-OUTPUT.
           WRITE PO-OUTPUT.
           MOVE "AUTO-GENERATED PURCHASE ORDERS" 
               TO PO-OUTPUT.
           WRITE PO-OUTPUT.
       
       CLOSE-ALL-FILES.
           CLOSE INVENTORY-MASTER.
           CLOSE INVENTORY-MOVEMENT.
           CLOSE INVENTORY-REPORT.
           CLOSE PO-GENERATION.
```

