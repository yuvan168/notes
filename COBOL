           INSPECT TEXT-VALUE REPLACING ALL "l"
               BY "L".
           *> TEXT-VALUE = "HeLLo WorLd"
           
           INSPECT TEXT-VALUE REPLACING 
               CHARACTERS BY "*" 
               BEFORE INITIAL "W".
           *> TEXT-VALUE = "****** WorLd"
       
       ACCEPT-STATEMENT.
           *> Read from keyboard
           ACCEPT USER-INPUT.
           
           *> Read date
           ACCEPT CURRENT-DATE FROM DATE.
           
           *> Read time
           ACCEPT CURRENT-TIME FROM TIME.
           
           *> Read full date/time
           ACCEPT DATE-TIME FROM DATE YYYYMMDD.
       
       DISPLAY-STATEMENT.
           *> Simple output
           DISPLAY "Hello World".
           
           *> With multiple arguments
           DISPLAY "Name: " EMPLOYEE-NAME 
               " Salary: " SALARY.
           
           *> With newline
           DISPLAY " " WITH NO ADVANCING.
           
           *> Formatted output
           DISPLAY "=== REPORT ===" UPON CONSOLE.
       
       SORT-OPERATION.
           SELECT EMPLOYEE-FILE ASSIGN TO 'emp.dat'.
           SELECT SORTED-FILE ASSIGN TO 'emp-sorted.dat'.
           SELECT SORT-WORK ASSIGN TO 'sort-work'.
           
           SORT SORT-WORK 
               ASCENDING KEY EMPLOYEE-ID
               USING EMPLOYEE-FILE
               GIVING SORTED-FILE.
           
           IF RETURN-CODE = 0
               DISPLAY "Sort successful"
           ELSE
               DISPLAY "Sort failed"
           END-IF.
