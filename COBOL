           05 WS-PAYROLL-YEAR       PIC 9(4).
           05 WS-CURRENT-DATE       PIC 9(8).
       
       01 WS-PAYROLL-CALCULATIONS.
           05 WS-REGULAR-HOURS      PIC 9(5)V99.
           05 WS-OVERTIME-HOURS     PIC 9(5)V99.
           05 WS-REGULAR-PAY        PIC 9(9)V99.
           05 WS-OVERTIME-PAY       PIC 9(9)V99.
           05 WS-GROSS-PAY          PIC 9(9)V99.
           05 WS-FEDERAL-TAX        PIC 9(9)V99.
           05 WS-FICA-TAX           PIC 9(9)V99.
           05 WS-MEDICARE-TAX       PIC 9(9)V99.
           05 WS-401K-CONTRIB       PIC 9(9)V99.
           05 WS-INSURANCE-DED      PIC 9(9)V99.
           05 WS-TOTAL-DEDUCTIONS   PIC 9(9)V99.
           05 WS-NET-PAY            PIC 9(9)V99.
       
       01 WS-TOTALS.
           05 WS-TOTAL-GROSS        PIC 9(12)V99 VALUE 0.
           05 WS-TOTAL-TAX          PIC 9(12)V99 VALUE 0.
           05 WS-TOTAL-NET          PIC 9(12)V99 VALUE 0.
           05 WS-TOTAL-HOURS        PIC 9(7)V99 VALUE 0.
       
       01 WS-TAX-TABLES.
           05 FICA-RATE             PIC 9V9999 VALUE 0.062.
           05 MEDICARE-RATE         PIC 9v9999 VALUE 0.0145.
           05 SOCIAL-SEC-WAGE-BASE  PIC 9(9) VALUE 168600.
       
       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           ACCEPT WS-CURRENT-DATE FROM DATE YYYYMMDD.
           
           PERFORM OPEN-ALL-FILES.
           PERFORM PROCESS-PAYROLL.
           PERFORM GENERATE-PAYROLL-REGISTER.
           PERFORM CLOSE-ALL-FILES.
           DISPLAY "PAYROLL PROCESSING COMPLETE".
           STOP RUN.
       
       OPEN-ALL-FILES.
           OPEN INPUT EMPLOYEE-MASTER.
           OPEN INPUT TIMECARD-FILE.
           OPEN OUTPUT PAYCHECK-FILE.
           OPEN OUTPUT PAYROLL-REGISTER.
       
       PROCESS-PAYROLL.
           PERFORM WRITE-PAYROLL-HEADER.
           
           PERFORM UNTIL WS-EOF = 'Y'
               READ TIMECARD-FILE
                   AT END
                       MOVE 'Y' TO WS-EOF
                   NOT AT END
                       PERFORM READ-EMPLOYEE-RECORD
                       PERFORM CALCULATE-PAYROLL
                       PERFORM PRINT-PAYCHECK
                       PERFORM UPDATE-YTD-TOTALS
                       ADD 1 TO WS-RECORDS-PROCESSED
               END-READ
           END-PERFORM.
       
       READ-EMPLOYEE-RECORD.
           READ EMPLOYEE-MASTER
               KEY IS EMPLOYEE-ID = TC-EMPLOYEE-ID
               INVALID KEY
                   MOVE SPACES TO EMPLOYEE-NAME
           END-READ.
       
       CALCULATE-PAYROLL.
           *> Step 1: Calculate total hours
           COMPUTE WS-REGULAR-HOURS = 
               TC-MON-HOURS + TC-TUE-HOURS + TC-WED-HOURS +
               TC-THU-HOURS + TC-FRI-HOURS
               
               (IF TC-SAT-HOURS > 0
                   ADD TC-SAT-HOURS TO WS-REGULAR-HOURS
               END-IF)
               
               (IF TC-SUN-HOURS > 0
                   ADD TC-SUN-HOURS TO WS-REGULAR-HOURS
               END-IF).
           
           ADD WS-REGULAR-HOURS TO WS-TOTAL-HOURS.
           
           *> Step 2: Calculate regular and overtime pay
           PERFORM CALCULATE-GROSS-PAY.
           
           *> Step 3: Calculate deductions
           PERFORM CALCULATE-FEDERAL-TAX.
           PERFORM CALCULATE-FICA-TAX.
           PERFORM CALCULATE-MEDICARE-TAX.
           PERFORM CALCULATE-401K.
           PERFORM CALCULATE-TOTAL-DEDUCTIONS.
           
           *> Step 4: Calculate net pay
           COMPUTE WS-NET-PAY = 
               WS-GROSS-PAY - WS-TOTAL-DEDUCTIONS.
       
       CALCULATE-GROSS-PAY.
           IF WS-REGULAR-HOURS > 40
               COMPUTE WS-OVERTIME-HOURS = 
                   WS-REGULAR-HOURS - 40
               COMPUTE WS-REGULAR-PAY = 
                   40 * HOURLY-RATE
               COMPUTE WS-OVERTIME-PAY = 
                   WS-OVERTIME-HOURS * 
                   HOURLY-RATE * 1.5
               COMPUTE WS-GROSS-PAY = 
                   WS-REGULAR-PAY + WS-OVERTIME-PAY
           ELSE
               COMPUTE WS-REGULAR-PAY = 
                   WS-REGULAR-HOURS * HOURLY-RATE
               MOVE 0 TO WS-OVERTIME-HOURS
               MOVE 0 TO WS-OVERTIME-PAY
               MOVE WS-REGULAR-PAY TO WS-GROSS-PAY
           END-IF.
       
       CALCULATE-FEDERAL-TAX.
           COMPUTE WS-FEDERAL-TAX = 
               WS-GROSS-PAY * 
               TAX-WITHHOLD-RATE ROUNDED.
       
       CALCULATE-FICA-TAX.
           IF NOT EXEMPT-FICA
               IF WS-GROSS-PAY <= SOCIAL-SEC-WAGE-BASE
                   COMPUTE WS-FICA-TAX = 
                       WS-GROSS-PAY * 
                       FICA-RATE ROUNDED
               ELSE
                   COMPUTE WS-FICA-TAX = 
                       SOCIAL-SEC-WAGE-BASE * 
                       FICA-RATE ROUNDED
               END-IF
           ELSE
               MOVE 0 TO WS-FICA-TAX
           END-IF.
       
       CALCULATE-MEDICARE-TAX.
           COMPUTE WS-MEDICARE-TAX = 
               WS-GROSS-PAY * 
               MEDICARE-RATE ROUNDED.
       
       CALCULATE-401K.
           COMPUTE WS-401K-CONTRIB = 
               WS-GROSS-PAY * 
               401K-PERCENT ROUNDED.
       
       CALCULATE-TOTAL-DEDUCTIONS.
           MOVE INSURANCE-DEDUCTION TO WS-INSURANCE-DED.
           
           COMPUTE WS-TOTAL-DEDUCTIONS = 
               WS-FEDERAL-TAX +
               WS-FICA-TAX +
               WS-MEDICARE-TAX +
               WS-401K-CONTRIB +
               WS-INSURANCE-DED.
       
       PRINT-PAYCHECK.
           STRING
               "PAYCHECK | Employee: " DELIMITED BY SIZE
               EMPLOYEE-ID DELIMITED BY SIZE
               " | Name: " DELIMITED BY SIZE
               EMPLOYEE-NAME DELIMITED BY SPACE
               " | Gross: $" DELIMITED BY SIZE
               WS-GROSS-PAY DELIMITED BY SIZE
               " | Net: $" DELIMITED BY SIZE
               WS-NET-PAY DELIMITED BY SIZE
               INTO PAYCHECK-OUTPUT
           END-STRING.
           WRITE PAYCHECK-OUTPUT.
       
       UPDATE-YTD-TOTALS.
           ADD WS-GROSS-PAY TO YTD-GROSS.
           ADD WS-FEDERAL-TAX TO YTD-FEDERAL-TAX.
           ADD WS-FICA-TAX TO YTD-FICA-TAX.
           
           ADD WS-GROSS-PAY TO WS-TOTAL-GROSS.
           ADD WS-TOTAL-DEDUCTIONS TO WS-TOTAL-TAX.
           ADD WS-NET-PAY TO WS-TOTAL-NET.
       
       WRITE-PAYROLL-HEADER.
           MOVE "PAYROLL PROCESSING REPORT" 
               TO PAYCHECK-OUTPUT.
           WRITE PAYCHECK-OUTPUT.
       
       GENERATE-PAYROLL-REGISTER.
           STRING
               "PAYROLL REGISTER | Total Employees: " 
                   DELIMITED BY SIZE
               WS-RECORDS-PROCESSED DELIMITED BY SIZE
               " | Total Gross: $" DELIMITED BY SIZE
               WS-TOTAL-GROSS DELIMITED BY SIZE
               " | Total Net: $" DELIMITED BY SIZE
               WS-TOTAL-NET DELIMITED BY SIZE
               INTO REGISTER-OUTPUT
           END-STRING.
           WRITE REGISTER-OUTPUT.
       
       CLOSE-ALL-FILES.
           CLOSE EMPLOYEE-MASTER.
           CLOSE TIMECARD-FILE.
           CLOSE PAYCHECK-FILE.
           CLOSE PAYROLL-REGISTER.
```

**Payroll Key Features:**
- ✅ Overtime calculation (1.5x rate)
- ✅ Multiple tax types (federal, FICA, Medicare)
- ✅ Social Security wage base cap
- ✅ 401(k) pre-tax deductions
- ✅ Health insurance integration
- ✅ YTD tracking for W-2 reporting
- ✅ Comprehensive pay register

