// Memory leak example
public class MemoryLeak {
    static List<byte[]> list = new ArrayList<>();
    
    public void allocateMemory() {
        for (int i = 0; i < 1000; i++) {
            list.add(new byte[1024 * 1024]);  // 1MB each
        }
