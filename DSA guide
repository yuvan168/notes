# DP - Top Down (Memoization)
def solve(n, memo={}):
    if n in memo:
        return memo[n]
    
    if n == 0 or n == 1:
        return n
    
    memo[n] = solve(n-1, memo) + solve(n-2, memo)
    return memo[n]

# Memoization: O(n) Time, O(n) Space
