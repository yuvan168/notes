### Q4: Zigzag Level Order
**Q**: Level order traversal alternating direction.
**A**:
```python
from collections import deque

def zigzagLevelOrder(root):
    if not root:
        return []
    
    result = []
    queue = deque([root])
    level = 0
    
    while queue:
        level_size = len(queue)
        level_nodes = []
        
        for _ in range(level_size):
            node = queue.popleft()
            level_nodes.append(node.val)
            
            if node.left:
                queue.append(node.left)
            if node.right:
                queue.append(node.right)
        
        if level % 2 == 1:
            level_nodes.reverse()
        
        result.append(level_nodes)
        level += 1
    
    return result

# Time: O(n) | Space: O(w)
```

