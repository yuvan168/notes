### Tree Q&A

**Q: Check if two trees are the same**
```python
def isSameTree(p, q):
    if not p and not q: return True
    if not p or not q:  return False
    return p.val == q.val and isSameTree(p.left, q.left) and isSameTree(p.right, q.right)
# O(n) time, O(h) space
```

**Q: Check if tree is symmetric (mirror)**
```python
def isSymmetric(root):
    def mirror(l, r):
        if not l and not r: return True
        if not l or not r:  return False
        return l.val == r.val and mirror(l.left, r.right) and mirror(l.right, r.left)
    return mirror(root.left, root.right) if root else True
# O(n) time, O(h) space
```

**Q: Find all root-to-leaf paths**
```python
def binaryTreePaths(root):
    result = []
    def dfs(node, path):
        if not node: return
        path += str(node.val)
        if not node.left and not node.right:
            result.append(path)
        else:
            dfs(node.left, path + '->')
            dfs(node.right, path + '->')
    dfs(root, "")
    return result
# O(n) time, O(n×h) space
```

**Q: Count nodes in complete binary tree**
```python
def countNodes(root):
    if not root: return 0
    lh = rh = 0
    l = r = root
    while l: lh += 1; l = l.left
    while r: rh += 1; r = r.right
    if lh == rh:
        return 2**lh - 1                # Perfect binary tree
    return 1 + countNodes(root.left) + countNodes(root.right)
# O(log²n) time — better than O(n)
```

**Q: Kth smallest element in BST**
```python
def kthSmallest(root, k):
    stack, curr = [], root
    while stack or curr:
        while curr:
            stack.append(curr); curr = curr.left
        curr = stack.pop()
        k -= 1
        if k == 0: return curr.val
        curr = curr.right
# O(h + k) time, O(h) space
```

