### L4: LRU Cache ⭐⭐⭐⭐⭐
**Difficulty**: Medium | **Companies**: Amazon, Google, Microsoft
```
REQUIREMENT: get and put both in O(1)
SOLUTION: HashMap + Doubly Linked List
  - HashMap: key → node (O(1) access)
  - DLL: maintains order (O(1) move to front, O(1) remove from back)
```
```python
class DLinkedNode:
    def __init__(self, key=0, val=0):
        self.key = key
        self.val = val
        self.prev = self.next = None

class LRUCache:
    def __init__(self, capacity):
        self.capacity = capacity
        self.cache = {}                     # key → node

        # Dummy head (least recent) and tail (most recent)
        self.head = DLinkedNode()
        self.tail = DLinkedNode()
        self.head.next = self.tail
        self.tail.prev = self.head

    def _add_to_tail(self, node):
        node.prev = self.tail.prev
        node.next = self.tail
        self.tail.prev.next = node
        self.tail.prev = node

    def _remove(self, node):
        node.prev.next = node.next
        node.next.prev = node.prev

    def get(self, key):
        if key not in self.cache:
            return -1
        node = self.cache[key]
        self._remove(node)               # Move to tail (most recent)
        self._add_to_tail(node)
        return node.val

    def put(self, key, value):
        if key in self.cache:
            self._remove(self.cache[key])
        node = DLinkedNode(key, value)
        self.cache[key] = node
        self._add_to_tail(node)

        if len(self.cache) > self.capacity:
            lru = self.head.next           # Head.next = least recently used
            self._remove(lru)
            del self.cache[lru.key]

# get: O(1) | put: O(1) | Space: O(capacity)
```

