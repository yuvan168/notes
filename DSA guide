### Sliding Window Template
```python
# Sliding Window - Fixed Size
def slidingWindowFixed(s, k):
    window_sum = sum(s[:k])
    max_sum = window_sum
    left = 0
    
    for right in range(k, len(s)):
        window_sum += s[right] - s[left]
        max_sum = max(max_sum, window_sum)
        left += 1
    
    return max_sum

# Time: O(n)  Space: O(1)
```

```python
# Sliding Window - Variable Size
def slidingWindowVariable(s, target):
    left = 0
    window_sum = 0
    min_len = float('inf')
    
    for right in range(len(s)):
        window_sum += s[right]
        
        while window_sum >= target:
            min_len = min(min_len, right - left + 1)
            window_sum -= s[left]
            left += 1
    
    return min_len if min_len != float('inf') else -1

# Time: O(n)  Space: O(1)
```

