import heapq
from collections import Counter

def topKFrequent(nums, k):
    count = Counter(nums)
    
    # Min heap of size k
    heap = []
    for num, freq in count.items():
        heapq.heappush(heap, (freq, num))
        if len(heap) > k:
            heapq.heappop(heap)
    
    return [num for freq, num in heap]

# Time: O(n log k) | Space: O(k)
