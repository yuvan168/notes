def countAndSay(n):
    result = "1"
    for _ in range(n - 1):
        temp = ""
        i = 0
        while i < len(result):
            count = 1
            while i + count < len(result) and result[i + count] == result[i]:
                count += 1
            temp += str(count) + result[i]
