def plusOne(digits):
    n = len(digits)
    
    for i in range(n - 1, -1, -1):
        if digits[i] < 9:
            digits[i] += 1
            return digits
        digits[i] = 0
    
    return [1] + digits  # Handle 999 -> 1000

# Time: O(n) | Space: O(1) or O(n)
