```python
def dailyTemperatures(temperatures):
    n = len(temperatures)
    result = [0] * n
    stack = []                          # Stores indices (not values)

    for i in range(n):
        # Pop indices where temperatures are lower than current
        while stack and temperatures[i] > temperatures[stack[-1]]:
            prev_idx = stack.pop()
            result[prev_idx] = i - prev_idx

        stack.append(i)

    # Remaining in stack: no warmer day exists → default 0

    return result

# Time: O(n) — each element pushed & popped at most once
# Space: O(n)

