def allPathsSourceTarget(graph):
    result = []
    def dfs(node, path):
        if node == len(graph) - 1:
            result.append(path[:]); return
        for neighbor in graph[node]:
            dfs(neighbor, path + [neighbor])
    dfs(0, [0])
    return result
# O(2^n × n) time
```

