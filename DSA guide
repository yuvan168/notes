# Two Pointer - Sorted Array
def twoPointer(arr):
    left, right = 0, len(arr) - 1
    
    while left < right:
        if arr[left] + arr[right] == target:
            return [left, right]
        elif arr[left] + arr[right] < target:
            left += 1
        else:
            right -= 1
    
    return []

# Time: O(n)  Space: O(1)
