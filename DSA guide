def canPartition(nums):
    total = sum(nums)
    if total % 2 != 0:
        return False

    target = total // 2
    dp = [False] * (target + 1)
    dp[0] = True                    # Empty subset sums to 0

    for num in nums:
        for s in range(target, num - 1, -1):  # Iterate BACKWARDS (0/1 knapsack)
            dp[s] = dp[s] or dp[s - num]

    return dp[target]

# Time: O(n × target) | Space: O(target)
