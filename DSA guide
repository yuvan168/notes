### Q5: Word Break II
**Q**: Return all possible sentence breaks.
**A**:
```python
def wordBreak(s, wordDict):
    memo = {}
    word_set = set(wordDict)
    
    def dfs(start):
        if start in memo:
            return memo[start]
        
        if start == len(s):
            return ['']
        
        result = []
        for end in range(start + 1, len(s) + 1):
            word = s[start:end]
            if word in word_set:
                rest = dfs(end)
                for sentence in rest:
                    if sentence:
                        result.append(word + ' ' + sentence)
                    else:
                        result.append(word)
        
        memo[start] = result
        return result
    
    return dfs(0)

# Time: O(n × 2^n) | Space: O(n)
```

