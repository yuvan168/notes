def findItinerary(tickets):
    from collections import defaultdict
    
    graph = defaultdict(list)
    for src, dst in tickets:
        graph[src].append(dst)
    
    for src in graph:
        graph[src].sort()
    
    result = []
    
    def dfs(node):
        while graph[node]:
            dfs(graph[node].pop(0))
        result.append(node)
    
    dfs('JFK')
    return result[::-1]

# Time: O(E log E) | Space: O(E)
