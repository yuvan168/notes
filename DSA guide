# Iterative — O(n) time, O(1) space
def reverseList(head):
    prev = None
    curr = head

    while curr:
        next_node = curr.next   # 1. Save next
        curr.next = prev        # 2. Reverse link
        prev = curr             # 3. Move prev forward
        curr = next_node        # 4. Move curr forward

    return prev                 # prev is new head

# Recursive — O(n) time, O(n) space (call stack)
def reverseListRecursive(head):
    if not head or not head.next:
        return head

    new_head = reverseListRecursive(head.next)
    head.next.next = head       # Reverse the link
    head.next = None            # Break old link
    return new_head

# Visual: 1→2→3→None
# Step 1: prev=None, curr=1 → 1→None, prev=1, curr=2
# Step 2: prev=1, curr=2 → 2→1→None, prev=2, curr=3
# Step 3: prev=2, curr=3 → 3→2→1→None, prev=3, curr=None
# Return: 3 (new head)
