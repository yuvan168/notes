def solve(n):
    if n <= 1:
        return n
    
    prev, curr = 0, 1
    
    for i in range(2, n + 1):
        next_val = prev + curr
        prev = curr
        curr = next_val
    
    return curr

# Space Optimized: O(n) Time, O(1) Space
