### DP Q&A

**Q: Word break — can string be segmented?**
```python
def wordBreak(s, wordDict):
    words = set(wordDict)
    dp = [False] * (len(s) + 1)
    dp[0] = True
    for i in range(1, len(s) + 1):
        for j in range(i):
            if dp[j] and s[j:i] in words:
                dp[i] = True; break
    return dp[len(s)]
# O(n² × m) time, O(n) space
```

**Q: Target sum — assign +/- to reach target**
```python
def findTargetSumWays(nums, target):
    dp = {0: 1}              # {running_sum: count}
    for num in nums:
        new_dp = {}
        for s, count in dp.items():
            new_dp[s + num] = new_dp.get(s + num, 0) + count
            new_dp[s - num] = new_dp.get(s - num, 0) + count
        dp = new_dp
    return dp.get(target, 0)
# O(n × sum) time, O(sum) space
```

**Q: Decode ways — number of ways to decode digit string**
```python
def numDecodings(s):
    if not s or s[0] == '0': return 0
    prev2, prev1 = 1, 1
    for i in range(1, len(s)):
        curr = 0
        if s[i] != '0':
            curr += prev1
        two_digit = int(s[i-1:i+1])
        if 10 <= two_digit <= 26:
            curr += prev2
        prev2, prev1 = prev1, curr
    return prev1
# O(n) time, O(1) space
```

**Q: Longest palindromic subsequence**
```python
def longestPalindromeSubseq(s):
    n = len(s)
    dp = [[0] * n for _ in range(n)]
    for i in range(n): dp[i][i] = 1
    for length in range(2, n + 1):
        for i in range(n - length + 1):
            j = i + length - 1
            if s[i] == s[j]:
                dp[i][j] = dp[i+1][j-1] + 2
            else:
                dp[i][j] = max(dp[i+1][j], dp[i][j-1])
    return dp[0][n-1]
# O(n²) time and space
```

