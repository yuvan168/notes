### G3: Word Ladder (BFS Shortest Path) ⭐⭐⭐⭐
**Difficulty**: Hard | **Companies**: Google, Amazon
```
STRATEGY: BFS where each state is a word.
  Neighbors = words that differ by exactly 1 character.
  Use wildcard patterns (h*t → hit, hot) to build neighbor map fast.
```
```python
from collections import defaultdict, deque

def ladderLength(beginWord, endWord, wordList):
    if endWord not in wordList:
        return 0

    word_set = set(wordList)
    L = len(beginWord)

    # Build pattern → words map
    patterns = defaultdict(list)
    for word in wordList + [beginWord]:
        for i in range(L):
            pattern = word[:i] + '*' + word[i+1:]
            patterns[pattern].append(word)

    queue = deque([(beginWord, 1)])
    visited = {beginWord}

    while queue:
        word, length = queue.popleft()

        for i in range(L):
            pattern = word[:i] + '*' + word[i+1:]
            for neighbor in patterns[pattern]:
                if neighbor == endWord:
                    return length + 1
                if neighbor not in visited:
                    visited.add(neighbor)
                    queue.append((neighbor, length + 1))

    return 0

# Time: O(N×L²) | Space: O(N×L²)
```

