### Pattern 3: Merge K Sorted Lists
```python
import heapq

def mergeKLists(lists):
    # Min heap with (value, list_index, node_index)
    heap = []
    
    for i, lst in enumerate(lists):
        if lst:
            heapq.heappush(heap, (lst.val, i, 0))
    
    dummy = ListNode(0)
    current = dummy
    
    while heap:
        val, list_idx, node_idx = heapq.heappop(heap)
        current.next = lists[list_idx]
        current = current.next
        
        if current.next:
            next_val = current.next.val
            heapq.heappush(heap, (next_val, list_idx, node_idx + 1))
    
    return dummy.next

# Time: O(n log k) where k = number of lists, n = total nodes
# Space: O(k)
```

### Pattern 4: Detect Cycle (Floyd's Algorithm)
```python
def hasCycle(head):
    if not head or not head.next:
        return False
    
    slow = fast = head
    
    while fast and fast.next:
        slow = slow.next
        fast = fast.next.next
        
        if slow == fast:
            return True
    
    return False

# Time: O(n)  Space: O(1)
```

### Pattern 5: LRU Cache
```python
from collections import OrderedDict

class LRUCache:
    def __init__(self, capacity):
        self.capacity = capacity
        self.cache = OrderedDict()
    
    def get(self, key):
        if key not in self.cache:
            return -1
        
        # Move to end (most recently used)
        self.cache.move_to_end(key)
        return self.cache[key]
    
    def put(self, key, value):
        if key in self.cache:
            self.cache.move_to_end(key)
        
        self.cache[key] = value
        
        if len(self.cache) > self.capacity:
            # Remove least recently used (first item)
            self.cache.popitem(last=False)

# Time: O(1) for get and put
# Space: O(capacity)
```

