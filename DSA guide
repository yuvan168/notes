### Q4: Shortest Substring with All Characters
**Q**: Find shortest substring containing all chars.
**A**:
```python
def minWindow(s, t):
    if not s or not t:
        return ""
    
    dict_t = {}
    for char in t:
        dict_t[char] = dict_t.get(char, 0) + 1
    
    required = len(dict_t)
    
    left = right = 0
    formed = 0
    window_counts = {}
    min_len = float('inf')
    min_left = 0
    
    while right < len(s):
        char = s[right]
        window_counts[char] = window_counts.get(char, 0) + 1
        
        if char in dict_t and window_counts[char] == dict_t[char]:
            formed += 1
        
        while left <= right and formed == required:
            char = s[left]
            
            if right - left + 1 < min_len:
                min_len = right - left + 1
                min_left = left
            
            window_counts[char] -= 1
            if char in dict_t and window_counts[char] < dict_t[char]:
                formed -= 1
            
            left += 1
        
        right += 1
    
    return "" if min_len == float('inf') else s[min_left:min_left + min_len]

# Time: O(|s| + |t|) | Space: O(|s| + |t|)
```

