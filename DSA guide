### G2: Course Schedule (Cycle Detection) ⭐⭐⭐⭐⭐
**Difficulty**: Medium | **Companies**: Google, Amazon, Facebook
```
PROBLEM: Can you finish all courses given prerequisites?
EQUIVALENT: Does the directed graph have a cycle?
```
```python
# Approach 1: Kahn's Algorithm (BFS Topological Sort)
def canFinish(numCourses, prerequisites):
    graph = [[] for _ in range(numCourses)]
    in_degree = [0] * numCourses

    for dest, src in prerequisites:
        graph[src].append(dest)
        in_degree[dest] += 1

    queue = deque(i for i in range(numCourses) if in_degree[i] == 0)
    processed = 0

    while queue:
        node = queue.popleft()
        processed += 1
        for neighbor in graph[node]:
            in_degree[neighbor] -= 1
            if in_degree[neighbor] == 0:
                queue.append(neighbor)

    return processed == numCourses    # True if no cycle

# Approach 2: DFS Cycle Detection
def canFinish_dfs(numCourses, prerequisites):
    graph = [[] for _ in range(numCourses)]
    for dest, src in prerequisites:
        graph[src].append(dest)

    # 0=unvisited, 1=visiting(in current path), 2=visited
    state = [0] * numCourses

    def dfs(node):
        if state[node] == 1:    # Back edge → cycle
            return False
        if state[node] == 2:    # Already fully processed
            return True

        state[node] = 1
        for neighbor in graph[node]:
            if not dfs(neighbor):
                return False
        state[node] = 2
        return True

    return all(dfs(i) for i in range(numCourses))

# Time: O(V+E) | Space: O(V+E)
```

