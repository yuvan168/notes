**Example 2: Data Warehouse Incremental Load**

```python
"""
Theory: Incremental Loading Pattern
- Previous load timestamp tracked
- Only new/changed records extracted
- Faster, more efficient than full reload
- Common in data warehouse operations
"""

class IncrementalDataWarehouseLoad:
    
    def __init__(self, source_db, target_dw, table_config):
        self.source_db = source_db
        self.target_dw = target_dw
        self.table_config = table_config  # Table name, key column, timestamp column
    
    def execute(self):
        """Execute incremental load"""
        
        # Get last successful load timestamp
        last_load_time = self.get_last_load_time()
        print(f"Last load: {last_load_time}")
        
        # Extract changed records
        changed_records = self.extract_changes(last_load_time)
        print(f"Found {len(changed_records)} changed records")
        
        if changed_records:
            # Transform
            transformed = self.transform(changed_records)
            
            # Load
            self.load_incremental(transformed)
            
            # Update load timestamp
            self.update_load_metadata()
    
    def get_last_load_time(self):
        """Get timestamp of last successful load"""
        
        # Query metadata table
        query = """
        SELECT last_load_time
        FROM etl_metadata
        WHERE table_name = %s
        ORDER BY load_date DESC
        LIMIT 1
        """
        
        result = self.source_db.query(query, (self.table_config['table_name'],))
        
        if result:
            return result[0]['last_load_time']
        else:
            # First load: get oldest record
            return '1900-01-01'
    
    def extract_changes(self, since_time):
        """Extract only changed records since last load"""
        
        timestamp_col = self.table_config['timestamp_column']
        table_name = self.table_config['table_name']
        
        query = f"""
        SELECT *
        FROM {table_name}
        WHERE {timestamp_col} > %s
        ORDER BY {timestamp_col} ASC
        """
        
        records = self.source_db.query(query, (since_time,))
        return records
    
    def transform(self, records):
        """Apply transformations"""
        transformed = []
        
        for record in records:
            # Apply business logic
            record['processed_at'] = datetime.now()
            record['load_version'] = 1
            transformed.append(record)
        
        return transformed
    
    def load_incremental(self, records):
        """
        Theory: Incremental Load Strategies
        
        Strategy 1: Upsert (Insert or Update)
        ├─ If key exists: UPDATE
        └─ If key new: INSERT
        
        Strategy 2: Append Only
        ├─ Always INSERT
        ├─ Keeps history
        └─ Good for fact tables
        
        Strategy 3: Replace Partition
        ├─ Delete partition for load_date
        ├─ Insert new data
        └─ Atomic operation
        """
        
        # Use Upsert strategy
        upsert_sql = """
        INSERT INTO target_table (id, name, value, processed_at)
        SELECT %s, %s, %s, %s
        ON CONFLICT (id)
        DO UPDATE SET
            name = EXCLUDED.name,
            value = EXCLUDED.value,
            processed_at = EXCLUDED.processed_at;
        """
        
        for record in records:
            self.target_dw.execute(upsert_sql, (
                record['id'],
                record['name'],
                record['value'],
                record['processed_at']
            ))
        
        self.target_dw.commit()
    
    def update_load_metadata(self):
        """Record load completion for next run"""
        
        insert_sql = """
        INSERT INTO etl_metadata (table_name, last_load_time, load_date, status)
        VALUES (%s, %s, %s, %s)
        """
        
        self.target_dw.execute(insert_sql, (
            self.table_config['table_name'],
            datetime.now(),
            datetime.now().date(),
            'SUCCESS'
        ))
        
        self.target_dw.commit()
