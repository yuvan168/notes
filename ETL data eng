**Step 4: Create Master Customer Record**

**Theory: Survivorship Rules**
```
When merging duplicates, which value survives?

Rule 1: Most Recent
├─ Use most recently updated value
└─ Example: Latest email address

Rule 2: Most Complete
├─ Use record with most non-null fields
└─ Example: Phone from most complete record

Rule 3: Most Reliable Source
├─ Prioritize trusted systems
└─ Example: Salesforce > Shopify > Loyalty

Rule 4: Longest Record
├─ Use longest/most detailed text
└─ Example: Most detailed name
```

```python
def create_master_record(group_df):
    """
    Theory: Master Record Creation
    - Combine information from multiple sources
    - Apply survivorship rules
    - Create single customer profile
    """
    
    # Rule 1: Most recent email
    most_recent_idx = group_df['extracted_at'].idxmax()
    master_email = group_df.loc[most_recent_idx, 'email']
    
    # Rule 2: Most complete phone (longest non-null)
    phones = group_df[group_df['phone'].notna()]['phone']
    master_phone = phones.iloc[0] if len(phones) > 0 else None
    
    # Rule 3: Most reliable source (priority order)
    source_priority = {'Salesforce': 1, 'Shopify': 2, 'Loyalty': 3}
    best_source = min(group_df['source'].values, 
                     key=lambda x: source_priority.get(x, 999))
    
    # Rule 4: Combine first/last names (use longest)
    first_names = group_df['first_name'].dropna()
    master_first = max(first_names, key=len) if len(first_names) > 0 else None
    
    last_names = group_df['last_name'].dropna()
    master_last = max(last_names, key=len) if len(last_names) > 0 else None
    
    return {
        'customer_id': hashlib.md5(f"{master_email}{master_phone}".encode()).hexdigest()[:16],
        'first_name': master_first,
        'last_name': master_last,
        'email': master_email,
        'phone': master_phone,
        'source_count': len(group_df),
        'primary_source': best_source,
        'customer_since': group_df['extracted_at'].min(),
        'last_updated': group_df['extracted_at'].max()
    }

# Create master records
master_records = []

# Group by duplicate_group_id OR treat non-duplicates as single record
for group_id in df_with_duplicates['duplicate_group_id'].unique():
    if pd.isna(group_id):
        # Single records (no duplicates)
        single_records = df_with_duplicates[df_with_duplicates['duplicate_group_id'].isna()]
        for _, row in single_records.iterrows():
            group_df = pd.DataFrame([row])
            master_records.append(create_master_record(group_df))
    else:
        group_df = df_with_duplicates[df_with_duplicates['duplicate_group_id'] == group_id]
        master_records.append(create_master_record(group_df))

df_master = pd.DataFrame(master_records)
print(f"Created {len(df_master)} master customer records from {len(df_with_duplicates)} source records")
