                'state': self._select_best_value(
                    records, 'state'),
                'source_list': ','.join(
                    [r['source'] for r in records]),
                'consolidation_date': datetime.now(),
                'is_golden': True
            }
            golden_records.append(golden)
        
        return pd.DataFrame(golden_records)
    
    def _select_best_value(self, records, field, prefer_source=None):
        """Select best value for field across sources"""
        
        # Rule: Prefer specific source, then most recent, then any non-null
        values = [(r.get(field), r.get('source')) 
                  for r in records if r.get(field)]
        
        if not values:
            return None
        
        if prefer_source:
            for val, source in values:
                if source in prefer_source and val:
                    return val
        
        return values[0][0] if values else None
    
    def load_golden_records(self, golden_df):
        """Load consolidated data to warehouse"""
        
        golden_df.to_sql('dim_customers_consolidated', 
                        self.engine, 
                        if_exists='append',
                        index=False)
        
        print(f"✓ Loaded {len(golden_df)} golden records")
    
    def run(self):
