**Step 3: Identify and Deduplicate Records**

**Theory: Entity Resolution (Record Matching)**
```
Problem: Same customer, different systems
  John Smith, john@email.com (Salesforce)
  J. Smith, john@email.com (Shopify)
  john_smith, john@email.com (Loyalty)

Solution: Match on multiple fields
├─ Exact Match: Same email → Same customer
├─ Fuzzy Match: Similar names + Email → Same customer
└─ Business Logic: Email + Phone → Same customer
```

```python
from fuzzywuzzy import fuzz
import hashlib

def identify_duplicates(df):
    """
    Theory: Duplicate Detection Strategy
    
    Approach 1: Exact Match (Fast)
    - Same email → Same customer
    - Same phone → Same customer
    
    Approach 2: Fuzzy Match (Slower but more accurate)
    - Name similarity > 90% + Email match → Same customer
    
    Approach 3: Composite Keys
    - Hash of (name + email) → Same customer
    """
    
    # Strategy 1: Exact email match
    email_duplicates = df[df.duplicated(subset=['email'], keep=False)]
    
    # Strategy 2: Exact phone match (exclude null)
    phone_duplicates = df[(df['phone'].notna()) & 
                         (df.duplicated(subset=['phone'], keep=False))]
    
    # Combine known duplicates
    duplicate_groups = {}
    group_id = 0
    
    for email in df['email'].unique():
        if pd.isna(email):
            continue
        records = df[df['email'] == email]
        if len(records) > 1:
            duplicate_groups[email] = group_id
            group_id += 1
    
    # Apply fuzzy matching for unmatched records
    unmatched = df[~df['email'].isin(duplicate_groups.keys())]
    
    for idx, row in unmatched.iterrows():
        for email in df['email'].unique():
            if pd.isna(email):
                continue
            matching_records = df[df['email'] == email]
            
            # Calculate name similarity
            name_similarity = fuzz.token_sort_ratio(
                f"{row['first_name']} {row['last_name']}",
                f"{matching_records['first_name'].iloc[0]} {matching_records['last_name'].iloc[0]}"
            )
            
            # If names are very similar AND emails contain same domain
            if (name_similarity > 90 and 
                row['email'].split('@')[1] == email.split('@')[1]):
                duplicate_groups[row['email']] = duplicate_groups.get(email, group_id)
                group_id += 1
                break
    
    # Assign duplicate group IDs
    df['duplicate_group_id'] = df['email'].map(duplicate_groups)
    
    return df

df_with_duplicates = identify_duplicates(df_combined)

# Check results
print("Duplicate groups found:")
dup_groups = df_with_duplicates[df_with_duplicates['duplicate_group_id'].notna()]
print(dup_groups.groupby('duplicate_group_id').size())
