        print("Starting customer consolidation ETL...")
        
        # Step 1: Extract
        print("1. Extracting from sources...")
        self.extract_from_sources()
        
        # Step 2: Standardize
        print("2. Standardizing data...")
        standardized = self.standardize_data()
        
        # Step 3: Match
        print("3. Matching customers...")
        matches = self.match_customers(standardized)
        print(f"   Found {len(matches)} potential matches")
        
        # Step 4: Create golden records
