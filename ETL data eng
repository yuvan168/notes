### Example 1: Product Catalog ETL

**Complete workflow with error handling and monitoring:**

```python
import logging
from datetime import datetime
import json

# Setup logging
logging.basicConfig(
    filename=f'/logs/etl_{datetime.now().strftime("%Y%m%d")}.log',
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)

class ProductCatalogETL:
    """
    Theory: ETL Class Pattern
    - Encapsulate extract, transform, load logic
    - Maintain state between stages
    - Handle errors gracefully
    - Provide logging and monitoring
    """
    
    def __init__(self):
        self.start_time = datetime.now()
        self.stats = {
            'extracted': 0,
            'transformed': 0,
            'loaded': 0,
            'errors': 0
        }
    
    def run(self):
        """Main ETL pipeline"""
        try:
            logging.info("Starting Product Catalog ETL")
            
            # Extract
            raw_products = self.extract()
            self.stats['extracted'] = len(raw_products)
            
            # Transform
            transformed_products = self.transform(raw_products)
            self.stats['transformed'] = len(transformed_products)
            
            # Validate
            validated_products = self.validate(transformed_products)
            
            # Load
            self.load(validated_products)
            self.stats['loaded'] = len(validated_products)
            
            # Success
            self.log_completion("SUCCESS")
            
        except Exception as e:
            logging.error(f"ETL Failed: {str(e)}", exc_info=True)
            self.log_completion("FAILED")
            raise
    
    def extract(self):
        """
        Theory: Extraction Points
        - Multiple source systems (B2B, Suppliers, Internal)
        - Different formats (JSON, CSV, Database)
        - Handle pagination, rate limits
        """
        logging.info("Starting extraction phase")
        
        all_products = []
        
        # Source 1: Internal database
        logging.info("Extracting from internal database")
        products_internal = self._extract_from_db()
        all_products.extend(products_internal)
        logging.info(f"  ├─ Extracted {len(products_internal)} products")
        
        # Source 2: Supplier API
        logging.info("Extracting from supplier API")
        products_supplier = self._extract_from_api()
        all_products.extend(products_supplier)
        logging.info(f"  ├─ Extracted {len(products_supplier)} products")
        
        # Source 3: B2B Partner
        logging.info("Extracting from B2B partner")
        products_b2b = self._extract_from_partner()
        all_products.extend(products_b2b)
        logging.info(f"  └─ Extracted {len(products_b2b)} products")
        
        return all_products
    
    def _extract_from_db(self):
        """Extract from PostgreSQL database"""
        import psycopg2
        conn = psycopg2.connect("dbname=products_db user=etl password=pass")
        cursor = conn.cursor()
        
        query = "SELECT sku, name, price, category, stock FROM products WHERE active = true"
        cursor.execute(query)
        
        products = []
        for row in cursor.fetchall():
            products.append({
                'sku': row[0],
                'name': row[1],
                'price': row[2],
                'category': row[3],
                'stock': row[4],
                'source': 'internal_db'
            })
        
        cursor.close()
        conn.close()
        return products
    
    def _extract_from_api(self):
        """Extract from supplier REST API with pagination"""
        import requests
        
        products = []
        page = 1
        page_size = 100
        
        while True:
            url = f"https://supplier-api.com/products?page={page}&page_size={page_size}"
            
            try:
                response = requests.get(url, timeout=30)
                response.raise_for_status()
            except requests.exceptions.RequestException as e:
                logging.warning(f"API request failed: {e}")
                break
            
            data = response.json()
            
            for item in data.get('items', []):
                products.append({
                    'sku': item['product_id'],
                    'name': item['product_name'],
                    'price': item['price_usd'],
                    'category': item['category'],
                    'stock': item['available_qty'],
                    'source': 'supplier_api'
                })
            
            if not data.get('has_next'):
                break
            
            page += 1
        
        return products
    
    def _extract_from_partner(self):
        """Extract from B2B partner (CSV file)"""
        import pandas as pd
        
        try:
            df = pd.read_csv('/incoming/b2b_products.csv')
            products = []
            
            for _, row in df.iterrows():
                products.append({
                    'sku': row['product_code'],
                    'name': row['product_name'],
                    'price': float(row['unit_price']),
                    'category': row['product_category'],
                    'stock': int(row['qty_available']),
                    'source': 'b2b_partner'
                })
            
            return products
        
        except Exception as e:
            logging.error(f"B2B extraction failed: {e}")
            return []
    
    def transform(self, raw_products):
        """
        Theory: Transformation Pipeline
        1. Standardization: Align schemas
        2. Data Cleansing: Fix quality issues
        3. Enrichment: Add business value
        4. Aggregation: Prepare for loading
        """
        logging.info("Starting transformation phase")
        
        transformed = []
        
        for product in raw_products:
            try:
                # Standardize
                std_product = {
                    'product_id': str(product['sku']).strip().upper(),
                    'product_name': product['name'].strip().title(),
                    'unit_price': float(product['price']),
                    'category': product['category'].strip().title(),
                    'stock_quantity': int(product['stock']),
                    'source_system': product['source'],
                    'last_updated': datetime.now()
                }
                
                # Enrich
                std_product['price_tier'] = self._get_price_tier(std_product['unit_price'])
                std_product['stock_status'] = self._get_stock_status(std_product['stock_quantity'])
                std_product['margin_percent'] = self._calculate_margin(std_product['unit_price'])
                
                transformed.append(std_product)
            
            except ValueError as e:
                logging.warning(f"Skipping product {product.get('sku')}: {e}")
                self.stats['errors'] += 1
                continue
        
        logging.info(f"Transformed {len(transformed)} products")
        return transformed
    
    def _get_price_tier(self, price):
        """Classify price into tiers"""
        if price < 50:
            return 'BUDGET'
        elif price < 150:
            return 'STANDARD'
        elif price < 500:
            return 'PREMIUM'
        else:
            return 'LUXURY'
    
    def _get_stock_status(self, quantity):
        """Classify stock status"""
        if quantity == 0:
            return 'OUT_OF_STOCK'
        elif quantity < 10:
            return 'LOW'
        elif quantity < 50:
            return 'MEDIUM'
        else:
            return 'HIGH'
    
    def _calculate_margin(self, price):
        """Calculate profit margin"""
        # Example: 40% margin
        return 40
    
    def validate(self, products):
        """
        Theory: Data Validation Gates
        - Quality checks before load
        - Reject bad data
        - Log issues for investigation
        """
        logging.info("Starting validation phase")
        
        valid_products = []
        
        for product in products:
            errors = []
            
            # Validation rules
            if not product['product_id']:
                errors.append("Missing product_id")
            
            if not product['product_name']:
                errors.append("Missing product_name")
            
            if product['unit_price'] < 0:
                errors.append("Negative price")
            
            if product['stock_quantity'] < 0:
                errors.append("Negative stock")
            
            if not product['category']:
                errors.append("Missing category")
            
            if errors:
                logging.warning(f"Validation failed for {product.get('product_id')}: {', '.join(errors)}")
                self.stats['errors'] += 1
            else:
                valid_products.append(product)
        
        logging.info(f"Validated {len(valid_products)} products ({self.stats['errors']} rejected)")
        return valid_products
    
    def load(self, products):
        """
        Theory: UPSERT Loading
        - Update if product exists (same product_id)
        - Insert if new product
        - Idempotent (safe to rerun)
        """
        logging.info("Starting load phase")
        
        import psycopg2
        conn = psycopg2.connect("dbname=warehouse user=etl password=pass")
        cursor = conn.cursor()
        
        upsert_sql = """
        INSERT INTO dim_product 
        (product_id, product_name, unit_price, category, 
         stock_quantity, price_tier, stock_status, margin_percent,
         source_system, last_updated)
        VALUES 
        (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
        ON CONFLICT (product_id)
        DO UPDATE SET
            product_name = EXCLUDED.product_name,
            unit_price = EXCLUDED.unit_price,
            category = EXCLUDED.category,
            stock_quantity = EXCLUDED.stock_quantity,
            price_tier = EXCLUDED.price_tier,
            stock_status = EXCLUDED.stock_status,
            margin_percent = EXCLUDED.margin_percent,
            last_updated = EXCLUDED.last_updated
        WHERE EXCLUDED.source_system = 'internal_db';  -- Internal data wins
        """
        
        try:
            for product in products:
                cursor.execute(upsert_sql, (
                    product['product_id'],
                    product['product_name'],
                    product['unit_price'],
                    product['category'],
                    product['stock_quantity'],
                    product['price_tier'],
                    product['stock_status'],
                    product['margin_percent'],
                    product['source_system'],
                    product['last_updated']
                ))
            
            conn.commit()
            logging.info(f"Successfully loaded {len(products)} products")
        
        except Exception as e:
            conn.rollback()
            logging.error(f"Load failed: {e}")
            raise
        
        finally:
            cursor.close()
            conn.close()
    
    def log_completion(self, status):
        """Log ETL completion with statistics"""
        duration = (datetime.now() - self.start_time).total_seconds()
        
        summary = f"""
        ╔═════════════════════════════════════════╗
        ║    ETL COMPLETION REPORT                ║
        ╠═════════════════════════════════════════╣
        ║ Status:     {status:<25}║
        ║ Duration:   {duration:.2f} seconds{' '*15}║
        ║ Extracted:  {self.stats['extracted']:<25}║
        ║ Transformed:{self.stats['transformed']:<25}║
        ║ Loaded:     {self.stats['loaded']:<25}║
        ║ Errors:     {self.stats['errors']:<25}║
        ╚═════════════════════════════════════════╝
        """
        
        logging.info(summary)
        print(summary)

# Execute
if __name__ == "__main__":
    etl = ProductCatalogETL()
    etl.run()
