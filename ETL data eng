        return []
    
    def standardize_data(self):
        """Normalize and standardize all data"""
        standardized = {}
        
        for source_name, df in self.staging_data.items():
            df_clean = df.copy()
            
            # Email: lowercase, trim
            df_clean['email'] = df_clean['email'] \
                .str.lower().str.strip()
            
            # Phone: remove all non-numeric
            df_clean['phone'] = df_clean['phone'] \
                .str.replace(r'\D', '', regex=True)
            
            # Name: proper case, trim
            df_clean['name'] = df_clean['name'] \
                .str.title().str.strip()
            
            # Address: uppercase
            df_clean['city'] = df_clean['city'].str.upper()
            df_clean['state'] = df_clean['state'].str.upper()
            
            standardized[source_name] = df_clean
        
        return standardized
    
    def match_customers(self, standardized_data):
        """Identify duplicate customers across sources"""
        
        # Combine all data
        dfs = list(standardized_data.values())
        df_combined = pd.concat(dfs, ignore_index=True)
        
        # Rule 1: Email exact match (highest confidence)
        email_groups = df_combined.groupby('email').filter(
            lambda x: len(x) > 1
        )
        
        # Rule 2: Phone exact match
        phone_groups = df_combined.groupby('phone').filter(
            lambda x: len(x) > 1
        )
        
        # Rule 3: Fuzzy matching (name + city)
        indexer = recordlinkage.Index()
        indexer.full()
        candidate_links = indexer.index(df_combined)
        
        # Compare candidate records
        compare = recordlinkage.Compare()
        compare.string('name', 'name', method='jarowinkler', 
                       threshold=0.85, label='name_match')
        compare.string('city', 'city', method='exact', 
                       label='city_match')
        features = compare.compute(candidate_links, df_combined)
        
        # Find matches (score > 1.5)
        matches = features[features.sum(axis=1) > 1.5]
        
        return matches
    
    def create_golden_record(self, matches):
        """Create consolidated golden record"""
        
        # Group matched customers
        groups = self._create_match_groups(matches)
        golden_records = []
        
        for group_id, customer_indices in groups.items():
            # Get all records in this group
            records = [self.staging_data[idx] for idx in customer_indices]
            
            # Select best values for each field
            golden = {
                'master_customer_id': f'MASTER_{group_id}',
                'name': self._select_best_value(
                    records, 'name', prefer_source=['salesforce', 'sap']),
                'email': self._select_best_value(
