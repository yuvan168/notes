## Data Quality & Validation

### Data Quality Dimensions

```
┌─────────────────────────────────────────────────┐
│           DATA QUALITY DIMENSIONS                │
├─────────────────────────────────────────────────┤
│ Accuracy: Data matches source truth             │
│ Completeness: All required data is present      │
│ Consistency: Data is uniform across systems     │
│ Timeliness: Data is current and available       │
│ Validity: Data conforms to defined formats      │
│ Uniqueness: No duplicate records exist          │
│ Conformity: Data adheres to standards           │
└─────────────────────────────────────────────────┘
```

### Validation Rules Framework

```sql
CREATE TABLE data_quality_rules (
    rule_id INT PRIMARY KEY,
    rule_name VARCHAR(100),
    rule_type VARCHAR(50), -- 'NOT_NULL', 'RANGE', 'PATTERN', 'LOOKUP', 'CUSTOM'
    table_name VARCHAR(100),
    column_name VARCHAR(100),
    condition VARCHAR(500),
    severity VARCHAR(20), -- 'ERROR', 'WARNING'
    created_at TIMESTAMP
);

-- Examples of rules
INSERT INTO data_quality_rules VALUES
(1, 'Order Amount Not Null', 'NOT_NULL', 'orders', 'amount', 'amount IS NOT NULL', 'ERROR', NOW()),
(2, 'Order Amount Positive', 'RANGE', 'orders', 'amount', 'amount > 0 AND amount < 10000000', 'ERROR', NOW()),
(3, 'Email Format Valid', 'PATTERN', 'customers', 'email', "email LIKE '%@%.%'", 'WARNING', NOW()),
(4, 'Status Valid Code', 'LOOKUP', 'orders', 'status', 'status IN (''PENDING'', ''COMPLETE'', ''CANCELLED'')', 'ERROR', NOW());

-- Execute validation
CREATE OR REPLACE PROCEDURE validate_data()
AS BEGIN
    DECLARE @rule_count INT = 0;
    DECLARE @passed INT = 0;
    
    SELECT @rule_count = COUNT(*) FROM data_quality_rules WHERE severity = 'ERROR';
    
    DECLARE @rule_id INT;
    DECLARE cur CURSOR FOR SELECT rule_id FROM data_quality_rules WHERE severity = 'ERROR';
    
    OPEN cur;
    FETCH NEXT FROM cur INTO @rule_id;
    
    WHILE @@FETCH_STATUS = 0 BEGIN
        DECLARE @passed_records INT;
        -- Execute rule (implementation depends on rule type)
        
        FETCH NEXT FROM cur INTO @rule_id;
    END;
    
    CLOSE cur;
    DEALLOCATE cur;
END;
```

