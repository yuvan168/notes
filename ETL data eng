**Business Problem:**
E-commerce company needs real-time sales dashboards updated within 5 minutes of order placement.

**Theory: Stream Processing vs Batch**
```
Batch ETL:
├─ Load at 2:00 AM daily
├─ Latency: 22 hours (for 1:00 PM order)
└─ Not suitable for real-time dashboards

Stream ETL:
├─ Process continuously as orders arrive
├─ Latency: < 5 minutes
└─ True real-time analytics
```

**Implementation: Kafka + Python**

```python
from kafka import KafkaConsumer, KafkaProducer
import json
from datetime import datetime
import psycopg2

# Step 1: Consume events from Kafka
def consume_sales_events():
    """
    Theory: Event Streaming
    
    Orders flow through Kafka topic:
    Order System → Kafka Topic (sales-orders)
                  ├─ Consumer 1: Transform
                  ├─ Consumer 2: Validate
                  └─ Consumer 3: Enrich
    """
    
    consumer = KafkaConsumer(
        'sales-orders',
        bootstrap_servers=['kafka:9092'],
        value_deserializer=lambda m: json.loads(m.decode('utf-8')),
        group_id='sales-etl-group',
        auto_offset_reset='earliest'
    )
    
    for message in consumer:
        order = message.value
        print(f"Received order: {order['order_id']}")
        
        # Step 2: Transform
        transformed_order = transform_order(order)
        
        # Step 3: Validate
        if validate_order(transformed_order):
            # Step 4: Enrich
            enriched_order = enrich_order(transformed_order)
            
            # Step 5: Load
            load_to_warehouse(enriched_order)

def transform_order(order):
    """
    Theory: Stream Transformation
    - Parse incoming data
    - Standardize formats
    - Calculate derived fields
    """
    
    return {
        'order_id': order['id'],
        'customer_id': order['customer_id'],
        'product_id': order['product_id'],
        'quantity': int(order['qty']),
        'unit_price': float(order['price']),
        'total_amount': float(order['qty']) * float(order['price']),
        'order_timestamp': datetime.fromisoformat(order['timestamp']),
        'order_date': datetime.fromisoformat(order['timestamp']).date(),
        'order_hour': datetime.fromisoformat(order['timestamp']).hour,
        'source_system': 'ecommerce_platform',
        'processed_timestamp': datetime.now()
    }

def validate_order(order):
    """
    Theory: Stream Validation
    - Check critical business rules
    - Reject invalid records early
    - Log for debugging
    """
    
    validations = [
        ('customer_id', lambda x: x is not None),
        ('product_id', lambda x: x is not None),
        ('quantity', lambda x: x > 0),
        ('unit_price', lambda x: x > 0),
        ('total_amount', lambda x: x > 0),
    ]
    
    for field, check in validations:
        if not check(order.get(field)):
            print(f"VALIDATION FAILED: {field} = {order.get(field)}")
            return False
    
    return True

def enrich_order(order):
    """
    Theory: Stream Enrichment
    - Join with reference data
    - Add contextual information
    - Calculate metrics
    """
    
    # Simulate enrichment (in practice, join with master tables)
    enrichment = {
        'customer_segment': get_customer_segment(order['customer_id']),
        'product_category': get_product_category(order['product_id']),
        'region': get_region(order['customer_id']),
        'promotion_applied': check_promotion(order['product_id']),
        'profit_margin': 0.30  # Example: 30% margin
    }
    
    order.update(enrichment)
    return order

def load_to_warehouse(order):
    """
    Theory: Stream Loading with Deduplication
    - Use idempotent keys (order_id)
    - Handle late arrivals
    - Maintain ordering
    """
    
    connection = psycopg2.connect("dbname=warehouse user=etl password=pass")
    cursor = connection.cursor()
    
    insert_sql = """
    INSERT INTO fact_sales_stream 
    (order_id, customer_id, product_id, quantity, unit_price, 
     total_amount, customer_segment, product_category, region,
     profit_margin, order_timestamp, processed_timestamp)
    VALUES 
    (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
    ON CONFLICT (order_id) DO NOTHING;  -- Idempotency
    """
    
    cursor.execute(insert_sql, (
        order['order_id'],
        order['customer_id'],
        order['product_id'],
        order['quantity'],
        order['unit_price'],
        order['total_amount'],
        order['customer_segment'],
        order['product_category'],
        order['region'],
        order['profit_margin'],
        order['order_timestamp'],
        order['processed_timestamp']
    ))
    
    connection.commit()
    cursor.close()
    connection.close()

