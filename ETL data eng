**Step 5: Load Master Data**

```python
def load_master_data(df_master):
    """
    Theory: Upsert Loading Pattern
    
    Why Upsert?
    - Insert new customers
    - Update existing customers (if data changed)
    - Maintain referential integrity
    - Support incremental loads
    
    Flow:
    1. Try to match existing customer
    2. If match found: UPDATE
    3. If no match: INSERT
    """
    
    from sqlalchemy import create_engine
    engine = create_engine('postgresql://user:pass@localhost/warehouse')
    
    with engine.connect() as conn:
        # SQL MERGE / UPSERT
        upsert_sql = """
        INSERT INTO dim_customer 
        (customer_id, first_name, last_name, email, phone, 
         source_count, primary_source, customer_since, last_updated)
        VALUES 
        (%s, %s, %s, %s, %s, %s, %s, %s, %s)
        ON CONFLICT (customer_id)
        DO UPDATE SET
            first_name = EXCLUDED.first_name,
            last_name = EXCLUDED.last_name,
            email = EXCLUDED.email,
            phone = EXCLUDED.phone,
            source_count = EXCLUDED.source_count,
            primary_source = EXCLUDED.primary_source,
            last_updated = EXCLUDED.last_updated;
        """
        
        for _, row in df_master.iterrows():
            values = (
                row['customer_id'],
                row['first_name'],
                row['last_name'],
                row['email'],
                row['phone'],
                row['source_count'],
                row['primary_source'],
                row['customer_since'],
                row['last_updated']
            )
            conn.execute(upsert_sql, values)
        
        conn.commit()
    
    print(f"Successfully loaded {len(df_master)} master customer records")

load_master_data(df_master)
```

