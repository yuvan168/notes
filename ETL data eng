├─ Missing columns = NULL
├─ Added columns = Captured automatically
└─ Pro: Flexible | Con: Type casting overhead

APPROACH 2: SCHEMA VERSIONING
├─ Track schema version for each source
├─ Maintain multiple schema mappings
├─ Version transformation logic
└─ Pro: Type safe | Con: Complex

APPROACH 3: ELT (Extract, Load, Transform)
├─ Load raw data as-is to warehouse
├─ Transform in SQL using views
├─ Schema changes are just new columns
└─ Pro: Flexible | Con: Processing in warehouse

APPROACH 4: AUTO-DISCOVERY
├─ Introspect source schema
├─ Compare with previous run
├─ Alert on changes
└─ Pro: No manual maintenance | Con: Error prone
```

**Implementation:**

```python
import pandas as pd
import json
from datetime import datetime

class SchemaEvolutionETL:
    """
    Handle schema changes gracefully
    """
    
    def __init__(self):
        self.schema_history = self._load_schema_history()
        self.alerts = []
    
    def _load_schema_history(self):
        """Load previously captured schema"""
        try:
            with open('schema_history.json', 'r') as f:
                return json.load(f)
        except:
            return {}
    
    def detect_schema_changes(self, df, source_name):
        """Detect schema changes from previous load"""
        
        current_schema = {
            'columns': df.columns.tolist(),
            'dtypes': df.dtypes.to_dict(),
            'shape': df.shape,
            'timestamp': datetime.now().isoformat()
        }
        
        if source_name not in self.schema_history:
            print(f"First load for {source_name}, storing schema...")
            self.schema_history[source_name] = current_schema
            return None
        
        previous_schema = self.schema_history[source_name]
        changes = {}
        
        # Check for new columns
        new_cols = set(current_schema['columns']) - \
                   set(previous_schema['columns'])
        if new_cols:
            changes['new_columns'] = list(new_cols)
            self.alerts.append(
                f"⚠️  NEW COLUMNS in {source_name}: {new_cols}")
        
        # Check for dropped columns
        dropped_cols = set(previous_schema['columns']) - \
                       set(current_schema['columns'])
        if dropped_cols:
            changes['dropped_columns'] = list(dropped_cols)
            self.alerts.append(
                f"⚠️  DROPPED COLUMNS in {source_name}: {dropped_cols}")
        
        # Check for type changes
        for col in previous_schema['columns']:
            if col in current_schema['columns']:
                old_type = str(previous_schema['dtypes'][col])
                new_type = str(current_schema['dtypes'][col])
                
                if old_type != new_type:
                    changes['type_changes'] = changes.get(
                        'type_changes', {})
                    changes['type_changes'][col] = {
                        'old': old_type,
                        'new': new_type
                    }
                    self.alerts.append(
                        f"⚠️  TYPE CHANGE in {source_name}.{col}: "
                        f"{old_type} → {new_type}")
        
        # Update schema history
        self.schema_history[source_name] = current_schema
        
        return changes if changes else None
    
    def handle_schema_changes(self, df, source_name, schema_changes):
        """Handle detected schema changes"""
        
        df_processed = df.copy()
        
        if schema_changes is None:
            return df_processed
        
        # Handle new columns: add to expected columns
        if 'new_columns' in schema_changes:
            print(f"New columns will be loaded: {schema_changes['new_columns']}")
            # These are already in df, just log them
        
        # Handle dropped columns: remove from expected
        if 'dropped_columns' in schema_changes:
            cols_to_drop = [c for c in schema_changes['dropped_columns'] 
                           if c in df_processed.columns]
            print(f"Removing dropped columns: {cols_to_drop}")
        
        # Handle type changes: safe conversion
        if 'type_changes' in schema_changes:
            for col, type_info in schema_changes['type_changes'].items():
                old_type = type_info['old']
                new_type = type_info['new']
                
                try:
                    if 'int' in new_type.lower():
                        df_processed[col] = pd.to_numeric(
                            df_processed[col], errors='coerce')
                    elif 'float' in new_type.lower():
                        df_processed[col] = pd.to_numeric(
                            df_processed[col], errors='coerce')
                    elif 'datetime' in new_type.lower():
                        df_processed[col] = pd.to_datetime(
                            df_processed[col], errors='coerce')
                    
                    print(f"Converted {col}: {old_type} → {new_type}")
                except Exception as e:
                    self.alerts.append(
                        f"ERROR converting {col}: {str(e)}")
        
        return df_processed
    
    def run_etl_with_schema_evolution(self, df, source_name):
        """Main ETL with schema evolution handling"""
        
        # Detect changes
        changes = self.detect_schema_changes(df, source_name)
        
        # Handle changes
        df_processed = self.handle_schema_changes(
            df, source_name, changes)
        
        # Log all alerts
        if self.alerts:
            print("\n🔔 SCHEMA CHANGE ALERTS:")
            for alert in self.alerts:
                print(f"  {alert}")
            
            # Send to admin/monitoring
            self._send_alert_to_admin()
        
        # Save updated schema history
        self._save_schema_history()
        
        return df_processed
    
    def _save_schema_history(self):
        """Persist schema history for next run"""
        with open('schema_history.json', 'w') as f:
            json.dump(self.schema_history, f, indent=2)
    
    def _send_alert_to_admin(self):
        """Send alerts to data engineering team"""
        print("📧 Alert sent to data-engineering@company.com")

# Usage
etl = SchemaEvolutionETL()
df_new = pd.DataFrame({
    'id': [1, 2, 3],
    'name': ['A', 'B', 'C'],
    'email': ['a@ex.com', 'b@ex.com', 'c@ex.com'],
    'new_field': ['X', 'Y', 'Z']  # New column added
})

df_processed = etl.run_etl_with_schema_evolution(df_new, 'customers')
