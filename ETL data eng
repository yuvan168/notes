**Python Implementation:**
```python
import pandas as pd
from airflow import DAG
from airflow.operators.python_operator import PythonOperator
from datetime import datetime, timedelta

def extract_system_a():
    """Extract from XML files (System A)"""
    files = glob.glob('/data/incoming/system_a/*.xml')
    dfs = [pd.read_xml(f) for f in files]
    df = pd.concat(dfs, ignore_index=True)
    df.to_csv('/staging/raw_system_a.csv', index=False)

def extract_system_b():
    """Extract from REST API (System B)"""
    response = requests.get('https://api.system-b.com/sales')
    df = pd.json_normalize(response.json()['data'])
    df.to_csv('/staging/raw_system_b.csv', index=False)

def extract_system_c():
    """Extract from CSV files (System C)"""
    df = pd.read_csv('/data/incoming/system_c/sales.csv')
    df.to_csv('/staging/raw_system_c.csv', index=False)

def transform_and_load():
    """Unified transform and load"""
    dfs = []
    for file in ['/staging/raw_system_a.csv', 
                 '/staging/raw_system_b.csv',
                 '/staging/raw_system_c.csv']:
        df = pd.read_csv(file)
        # Standardize columns
        df = df.rename(columns={'store_code': 'store_id'})
        dfs.append(df)
    
    # Combine and deduplicate
    df = pd.concat(dfs, ignore_index=True)
    df = df.drop_duplicates(subset=['transaction_id'])
    
    # Validate
    df = df[df['amount'] > 0]
    df = df[df['store_id'].notna()]
    
    # Currency conversion
    df['amount_usd'] = df.apply(lambda row: 
        row['amount'] if row['currency'] == 'USD' 
        else row['amount'] * get_exchange_rate(row['currency']), axis=1)
    
    # Load to database
    engine = create_engine('postgresql://user:pass@host/warehouse')
    df.to_sql('fact_sales', engine, if_exists='append', index=False)
```

### Scenario 2: Real-Time Event Stream ETL

**Requirements:**
- Process millions of user events daily
- Stream processing (near real-time)
- Complex transformations and enrichment
- Fault tolerance and exactly-once semantics

**Solution: Kafka + Spark Streaming**

```
Events → Kafka → Spark Streaming → Transform → Load → Data Lake
         (Queue)  (Processing)                       (Parquet)
```

```python
from pyspark.sql import SparkSession
from pyspark.sql.functions import *
from pyspark.sql.types import *

spark = SparkSession.builder \
    .appName("RealTimeEventETL") \
    .getOrCreate()

# Schema definition
schema = StructType([
    StructField("user_id", StringType()),
    StructField("event_type", StringType()),
    StructField("timestamp", LongType()),
    StructField("properties", MapType(StringType(), StringType()))
])

# Read from Kafka
df = spark.readStream \
    .format("kafka") \
    .option("kafka.bootstrap.servers", "kafka:9092") \
    .option("subscribe", "user-events") \
    .option("startingOffsets", "latest") \
    .load()

# Parse JSON
events = df.select(
    from_json(col("value").cast("string"), schema).alias("event")
).select("event.*")

# Transform
transformed = events \
    .withColumn("event_date", from_unixtime(col("timestamp")/1000, "yyyy-MM-dd")) \
    .withColumn("event_hour", hour(from_unixtime(col("timestamp")/1000))) \
    .filter(col("event_type").isNotNull())

# Enrich with user data (broadcast join)
user_df = spark.read.jdbc(url, "dim_user", properties=db_properties)
enriched = transformed.join(
    broadcast(user_df),
    "user_id",
    "left"
)

# Aggregation window
window_agg = enriched \
    .groupBy(
        window(col("timestamp"), "10 minutes", "5 minutes"),
        col("event_type")
    ) \
    .agg(
        count("*").alias("event_count"),
        countDistinct("user_id").alias("unique_users"),
        max("properties").alias("latest_properties")
    )

# Write to Data Lake
query = transformed.writeStream \
    .format("parquet") \
    .option("path", "/data/events/") \
    .option("checkpointLocation", "/data/checkpoints/events") \
    .partitionBy("event_date", "event_hour") \
    .mode("append") \
    .start()

spark.awaitTermination()
```

