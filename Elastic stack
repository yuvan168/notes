**Q10: What Logstash filters would you use to parse Windows Event XML logs?**

Answer:

```conf
filter {
  # 1. Parse XML structure
  xml {
    source => "message"
    target => "event_data"
    remove_namespaces => true
  }
  
  # 2. Extract key fields
  mutate {
    rename => {
      "[event_data][Computer]" => "[host][name]"
      "[event_data][EventID]" => "[event][code]"
      "[event_data][SubjectUserName]" => "[user][name]"
      "[event_data][IpAddress]" => "[source][ip]"
    }
    convert => {"[event][code]" => "integer"}
  }
  
  # 3. Add enrichment (GeoIP)
  geoip {
    source => "[source][ip]"
    target => "[source][geo]"
  }
  
  # 4. Conditional processing by event type
  if [event][code] == 4688 {
    # Process creation event
    mutate {
      add_field => {"event_type" => "process_create"}
      add_tag => ["process_execution"]
    }
  } else if [event][code] == 4625 {
    # Failed login
    mutate {
      add_field => {"event_type" => "failed_login"}
      add_tag => ["auth_failure"]
    }
  }
  
  # 5. Filter noise (drop internal traffic)
  if [source][ip] =~ /^10\./ or 
     [source][ip] =~ /^192\.168\./ {
    drop {}
  }
}
```

