### Custom Error Classes (Apollo Server)
```javascript
import { GraphQLError } from 'graphql';

// Throw custom errors
throw new GraphQLError('User not found', {
  extensions: {
    code: 'NOT_FOUND',
    statusCode: 404,
    userId: id,
  },
});

throw new GraphQLError('Authentication required', {
  extensions: {
    code: 'UNAUTHENTICATED',
    statusCode: 401,
