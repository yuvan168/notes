## 4. SCHEMA DEFINITION LANGUAGE (SDL)

The Schema is the most important concept — it defines your entire API.

### Complete Schema Example
```graphql
# ========================================
# ENUMS
# ========================================
enum Role {
  ADMIN
  USER
  MODERATOR
  GUEST
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SortOrder {
  ASC
  DESC
}

# ========================================
# TYPES
# ========================================
type User {
  id: ID!
  name: String!
  email: String!
  age: Int
  isActive: Boolean!
  role: Role!
  posts: [Post!]!
  comments: [Comment!]!
  profile: Profile
  createdAt: String!
  updatedAt: String
}

type Post {
  id: ID!
  title: String!
  content: String!
  status: PostStatus!
  author: User!
  comments: [Comment!]!
  tags: [String!]
  likes: Int!
  createdAt: String!
}

type Comment {
  id: ID!
  text: String!
  author: User!
  post: Post!
  createdAt: String!
}

type Profile {
  bio: String
  avatar: String
  website: String
  socialLinks: [String]
}

# ========================================
# INPUT TYPES (for mutations)
# ========================================
input CreateUserInput {
  name: String!
  email: String!
  age: Int
  role: Role = USER    # Default value
}

input UpdateUserInput {
  name: String
  email: String
  age: Int
  role: Role
}

input CreatePostInput {
  title: String!
  content: String!
  status: PostStatus = DRAFT
  tags: [String]
}

input PostFilterInput {
  status: PostStatus
  authorId: ID
  tag: String
  searchText: String
}

input PaginationInput {
  page: Int = 1
  limit: Int = 10
  sortBy: String = "createdAt"
  sortOrder: SortOrder = DESC
}

# ========================================
# RESPONSE TYPES
# ========================================
type PostConnection {
  edges: [Post!]!
  totalCount: Int!
  pageInfo: PageInfo!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  currentPage: Int!
  totalPages: Int!
}

type AuthPayload {
  token: String!
  user: User!
}

type DeleteResponse {
  success: Boolean!
  message: String
}

# ========================================
# ROOT TYPES
# ========================================
type Query {
  # User queries
  user(id: ID!): User
  users(pagination: PaginationInput): [User!]!
  me: User

  # Post queries
  post(id: ID!): Post
  posts(filter: PostFilterInput, pagination: PaginationInput): PostConnection!
  postsByUser(userId: ID!): [Post!]!

  # Search
  search(query: String!): [SearchResult!]!
}

type Mutation {
  # Auth
  register(input: CreateUserInput!): AuthPayload!
  login(email: String!, password: String!): AuthPayload!

  # User mutations
  updateUser(id: ID!, input: UpdateUserInput!): User!
  deleteUser(id: ID!): DeleteResponse!

  # Post mutations
  createPost(input: CreatePostInput!): Post!
  updatePost(id: ID!, input: CreatePostInput!): Post!
  deletePost(id: ID!): DeleteResponse!
  publishPost(id: ID!): Post!

  # Comment mutations
  addComment(postId: ID!, text: String!): Comment!
  deleteComment(id: ID!): DeleteResponse!

  # Like
  likePost(postId: ID!): Post!
  unlikePost(postId: ID!): Post!
}

type Subscription {
  postAdded: Post!
  commentAdded(postId: ID!): Comment!
  userStatusChanged: User!
}

# ========================================
# UNION & INTERFACE
# ========================================
union SearchResult = User | Post | Comment

interface Node {
  id: ID!
  createdAt: String!
}

# Schema root
schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}
```

