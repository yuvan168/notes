## 19. RESOLVERS — HOW DATA IS FETCHED

Resolvers are **functions that return data** for each field in the schema.

### Resolver Function Signature
```javascript
fieldName(parent, args, context, info) {
  // parent  — result from the parent resolver (for nested fields)
  // args    — arguments passed to this field
  // context — shared data (auth, dataloaders, db connection)
  // info    — field-specific info (AST, field name, etc.)
}
```

### Complete Resolver Example
```javascript
const resolvers = {
  // ================================
  // QUERY RESOLVERS
  // ================================
  Query: {
    // Get single user
    user: async (_, { id }, context) => {
      return await context.db.users.findById(id);
    },

    // Get all users with pagination
    users: async (_, { pagination }, context) => {
      const { page = 1, limit = 10 } = pagination || {};
      return await context.db.users.find()
        .skip((page - 1) * limit)
        .limit(limit);
    },

    // Get authenticated user
    me: async (_, __, context) => {
      if (!context.user) throw new Error('Not authenticated');
      return await context.db.users.findById(context.user.id);
    },

    // Get posts with filter
    posts: async (_, { filter, pagination }, context) => {
      const query = {};
      if (filter?.status) query.status = filter.status;
      if (filter?.authorId) query.authorId = filter.authorId;
      if (filter?.searchText) {
        query.title = { $regex: filter.searchText, $options: 'i' };
      }

      const { page = 1, limit = 10 } = pagination || {};
      const totalCount = await context.db.posts.countDocuments(query);
      const posts = await context.db.posts.find(query)
        .skip((page - 1) * limit)
        .limit(limit)
        .sort({ createdAt: -1 });

      return {
        edges: posts,
        totalCount,
        pageInfo: {
          currentPage: page,
          totalPages: Math.ceil(totalCount / limit),
          hasNextPage: page * limit < totalCount,
          hasPreviousPage: page > 1,
        },
      };
    },

    // Search across types
    search: async (_, { query }, context) => {
      const users = await context.db.users.find(
        { name: { $regex: query, $options: 'i' } }
      );
      const posts = await context.db.posts.find(
        { title: { $regex: query, $options: 'i' } }
      );
      return [
        ...users.map(u => ({ __typename: 'User', ...u })),
        ...posts.map(p => ({ __typename: 'Post', ...p })),
      ];
    },
  },

  // ================================
  // MUTATION RESOLVERS
  // ================================
  Mutation: {
    register: async (_, { input }, context) => {
      const existingUser = await context.db.users.findOne({ email: input.email });
      if (existingUser) throw new Error('Email already exists');

      const hashedPassword = await bcrypt.hash(input.password, 10);
      const user = await context.db.users.create({
        ...input,
        password: hashedPassword,
      });

      const token = jwt.sign({ userId: user.id }, process.env.JWT_SECRET);
      return { token, user };
    },

    login: async (_, { email, password }, context) => {
      const user = await context.db.users.findOne({ email });
      if (!user) throw new Error('Invalid credentials');

      const valid = await bcrypt.compare(password, user.password);
      if (!valid) throw new Error('Invalid credentials');

      const token = jwt.sign({ userId: user.id }, process.env.JWT_SECRET);
      return { token, user };
    },

    createPost: async (_, { input }, context) => {
      if (!context.user) throw new Error('Not authenticated');
      return await context.db.posts.create({
        ...input,
        authorId: context.user.id,
      });
    },

    deletePost: async (_, { id }, context) => {
      if (!context.user) throw new Error('Not authenticated');
      const post = await context.db.posts.findById(id);
      if (!post) return { success: false, message: 'Post not found' };
      if (post.authorId !== context.user.id) throw new Error('Not authorized');

      await context.db.posts.deleteById(id);
      return { success: true, message: 'Post deleted' };
    },
  },

  // ================================
  // TYPE RESOLVERS (Relationship)
  // ================================
  User: {
    // When a User type is returned, resolve the 'posts' field
    posts: async (parent, _, context) => {
      return await context.db.posts.find({ authorId: parent.id });
    },
    
    // Computed field
    postCount: async (parent, _, context) => {
      return await context.db.posts.count({ authorId: parent.id });
    },

    fullName: (parent) => {
      return `${parent.firstName} ${parent.lastName}`;
    },
  },

  Post: {
    // When a Post type is returned, resolve the 'author' field
    author: async (parent, _, context) => {
      return await context.db.users.findById(parent.authorId);
    },

    comments: async (parent, _, context) => {
      return await context.db.comments.find({ postId: parent.id });
    },
  },

  Comment: {
    author: async (parent, _, context) => {
      return await context.db.users.findById(parent.authorId);
    },

    post: async (parent, _, context) => {
      return await context.db.posts.findById(parent.postId);
    },
  },

  // ================================
  // UNION/INTERFACE RESOLVERS
  // ================================
  SearchResult: {
    __resolveType(obj) {
      if (obj.email) return 'User';
      if (obj.title) return 'Post';
      if (obj.text) return 'Comment';
      return null;
    },
  },

  Node: {
    __resolveType(obj) {
      if (obj.email) return 'User';
      if (obj.title) return 'Post';
      return 'Comment';
    },
  },
};
```

### Resolver Chain (Parent-Child)
```
Query.user (parent = null)
  → User.posts (parent = the User object)
    → Post.author (parent = each Post object)
    → Post.comments (parent = each Post object)
      → Comment.author (parent = each Comment object)
```

