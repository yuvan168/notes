        return userService.findById(id);
    }

    @QueryMapping
    public List<Post> posts() {
        return postService.findAll();
    }

    // Mutation resolvers
    @MutationMapping
    public User createUser(@Argument CreateUserInput input) {
        return userService.create(input);
    }

    @MutationMapping
    public Post createPost(@Argument CreatePostInput input) {
        return postService.create(input);
    }

    // Field resolver — User.posts
    @SchemaMapping(typeName = "User", field = "posts")
    public List<Post> userPosts(User user) {
        return postService.findByAuthorId(user.getId());
    }

    // Field resolver — Post.author
    @SchemaMapping(typeName = "Post", field = "author")
    public User postAuthor(Post post) {
        return userService.findById(post.getAuthorId());
    }

    // Batch loading (DataLoader equivalent)
    @BatchMapping
    public Map<User, List<Post>> posts(List<User> users) {
        // Single query, mapped by user
        return postService.findByAuthors(users);
    }
}
