```javascript
import { ApolloServer } from '@apollo/server';
import assert from 'assert';

describe('GraphQL API', () => {
  let server;

  beforeAll(async () => {
    server = new ApolloServer({ typeDefs, resolvers });
    await server.start();
  });

  afterAll(async () => {
    await server.stop();
  });

  it('should return all users', async () => {
    const response = await server.executeOperation({
      query: '{ users { id name email } }',
    });

    assert(response.body.singleResult.errors === undefined);
    const users = response.body.singleResult.data.users;
    assert(users.length > 0);
    assert(users[0].name);
  });

  it('should return user by ID', async () => {
    const response = await server.executeOperation({
      query: 'query GetUser($id: ID!) { user(id: $id) { name email } }',
      variables: { id: '1' },
    });

    const user = response.body.singleResult.data.user;
    assert.equal(user.name, 'Alice');
  });

  it('should create a user', async () => {
    const response = await server.executeOperation({
      query: `
        mutation CreateUser($input: CreateUserInput!) {
          createUser(input: $input) { id name email }
        }
      `,
      variables: { input: { name: 'Test User', email: 'test@test.com' } },
    });

    const user = response.body.singleResult.data.createUser;
    assert.equal(user.name, 'Test User');
  });

  it('should return error for invalid input', async () => {
    const response = await server.executeOperation({
      query: '{ user(id: "999") { name } }',
