### Auth Middleware / Directive Approach
```javascript
// Reusable auth check function
function requireAuth(context, requiredRole = null) {
  if (!context.user) {
    throw new Error('Authentication required');
  }
  if (requiredRole && context.user.role !== requiredRole) {
    throw new Error(`Role '${requiredRole}' required`);
  }
  return context.user;
}

// Usage
const resolvers = {
  Query: {
    me: (_, __, ctx) => requireAuth(ctx),
    adminDashboard: (_, __, ctx) => {
      requireAuth(ctx, 'ADMIN');
      return getDashboardData();
    },
  },
};
