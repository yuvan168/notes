throw new GraphQLError('You do not have permission', {
  extensions: {
    code: 'FORBIDDEN',
    statusCode: 403,
  },
});

throw new GraphQLError('Email already in use', {
  extensions: {
    code: 'BAD_USER_INPUT',
    statusCode: 400,
    field: 'email',
  },
});
```

### Error Handling Patterns

```javascript
// Pattern 1: Union result type (recommended for mutations)
// Schema:
// union CreateUserResult = User | ValidationError | DuplicateError

// Pattern 2: Result type with errors field
// type CreateUserPayload {
//   user: User
//   errors: [FieldError!]
// }
// type FieldError {
//   field: String!
//   message: String!
// }

const resolvers = {
  Mutation: {
    createUser: async (_, { input }, context) => {
      const errors = [];
      
      if (!input.email.includes('@')) {
        errors.push({ field: 'email', message: 'Invalid email format' });
      }
      if (input.name.length < 2) {
        errors.push({ field: 'name', message: 'Name too short' });
      }
      
      if (errors.length > 0) {
        return { user: null, errors };
      }

      const user = await context.db.users.create(input);
      return { user, errors: [] };
    },
  },
};
```

### Error Formatting (Apollo Server)
```javascript
const server = new ApolloServer({
  typeDefs,
  resolvers,
  formatError: (formattedError, error) => {
    // Log all errors server-side
    console.error('GraphQL Error:', error);
    
    // Don't expose internal errors to clients in production
    if (process.env.NODE_ENV === 'production') {
      if (formattedError.extensions?.code === 'INTERNAL_SERVER_ERROR') {
        return {
          message: 'An unexpected error occurred',
          extensions: { code: 'INTERNAL_SERVER_ERROR' },
        };
      }
    }
    
    return formattedError;
  },
});
```

