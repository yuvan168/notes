## 15. INTERFACES

An interface defines a **set of fields that multiple types must implement**.

```graphql
# Interface definition
interface Node {
  id: ID!
  createdAt: String!
}

interface Timestamped {
  createdAt: String!
  updatedAt: String
}

# Types implementing interface
type User implements Node & Timestamped {
  id: ID!
  createdAt: String!
  updatedAt: String
  name: String!
  email: String!
}

type Post implements Node & Timestamped {
  id: ID!
  createdAt: String!
  updatedAt: String
  title: String!
  content: String!
}

type Comment implements Node {
  id: ID!
  createdAt: String!
  text: String!
}

# Query that returns interface type
type Query {
  node(id: ID!): Node     # Can return User, Post, or Comment
}

# Client query
query {
  node(id: "abc123") {
    id
    createdAt
    # Type-specific fields with inline fragments
    ... on User {
      name
      email
    }
    ... on Post {
      title
      content
    }
  }
}
```

