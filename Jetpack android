**WorkManager:**

```kotlin
// Define Worker
class SyncDataWorker(
    context: Context,
    params: WorkerParameters
) : CoroutineWorker(context, params) {
    
    @Inject lateinit var repository: DataRepository
    
    override suspend fun doWork(): Result {
        return try {
            // Do background work
            val data = repository.syncData()
            
            // Return result
            Result.success(
                workDataOf("syncedItems" to data.size)
            )
        } catch (e: Exception) {
            if (runAttemptCount < 3) {
                Result.retry()  // Retry up to 3 times
            } else {
                Result.failure()  // Give up
            }
        }
    }
}

// Schedule Work
class MainActivity : AppCompatActivity() {
    
    fun scheduleSyncWork() {
        val syncWork = PeriodicWorkRequestBuilder<SyncDataWorker>(
            15, TimeUnit.MINUTES
        )
        .setConstraints(
            Constraints.Builder()
                .setRequiredNetworkType(NetworkType.CONNECTED)
                .setRequiresCharging(false)
                .build()
        )
        .setBackoffCriteria(
            BackoffPolicy.EXPONENTIAL,
            15,
            TimeUnit.MINUTES
        )
        .build()
        
        WorkManager.getInstance(this).enqueueUniquePeriodicWork(
            "sync_work",
            ExistingPeriodicWorkPolicy.KEEP,
            syncWork
        )
    }
    
    fun observeSyncProgress() {
        WorkManager.getInstance(this)
            .getWorkInfosForTagLiveData("sync")
            .observe(this) { workInfos ->
                workInfos.forEach { workInfo ->
                    when (workInfo.state) {
                        WorkInfo.State.RUNNING -> {
                            val syncedItems = workInfo.outputData.getInt("syncedItems", 0)
                            Log.d("Work", "Syncing... $syncedItems items")
                        }
                        WorkInfo.State.SUCCEEDED -> {
                            Log.d("Work", "Sync completed")
                        }
                        else -> {}
                    }
                }
            }
    }
}
```

**Key Points:**
- ✅ DataStore is async and type-safe
- ✅ WorkManager survives app death
- ✅ Set constraints (network, battery, charging)
- ✅ Exponential backoff for retries
- ✅ Can observe work progress with LiveData
- ✅ Unique work prevents duplicates

