## Data Persistence

### Room Database

**Theory:**
Room is an abstraction layer over SQLite that provides compile-time SQL verification.

**Three Main Components:**

```
┌────────────────────┐
│   Entity (Table)   │  <- Models
├────────────────────┤
│      DAO            │  <- Queries
├────────────────────┤
│   RoomDatabase      │  <- Container
└────────────────────┘
```

**Implementation:**

```kotlin
// 1. Entity - Represents database table
@Entity(tableName = "users", indices = [Index("email", unique = true)])
data class UserEntity(
    @PrimaryKey(autoGenerate = true)
    val id: Int = 0,
    
    @ColumnInfo(name = "full_name")
    val fullName: String,
    
    val email: String,
    
    @Ignore
    val isTemporary: Boolean = false  // Not stored in DB
)

// 2. DAO - Data Access Object
@Dao
interface UserDao {
    
    // Insert
    @Insert
    suspend fun insert(user: UserEntity)
    
    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertOrUpdate(user: UserEntity)
    
    // Query
    @Query("SELECT * FROM users WHERE id = :id")
    suspend fun getUserById(id: Int): UserEntity?
    
    @Query("SELECT * FROM users ORDER BY full_name")
    fun getAllUsers(): LiveData<List<UserEntity>>
    
    // Reactive Query (Flow)
    @Query("SELECT * FROM users WHERE email = :email")
    fun observeUser(email: String): Flow<UserEntity>
    
    // Update
    @Update
    suspend fun update(user: UserEntity)
    
    // Delete
    @Delete
    suspend fun delete(user: UserEntity)
    
    @Query("DELETE FROM users WHERE id = :id")
    suspend fun deleteById(id: Int)
    
    // Transaction
    @Transaction
    suspend fun insertUserWithPosts(
        user: UserEntity,
        posts: List<PostEntity>
    ) {
        insert(user)
        insertPosts(posts)
    }
    
    @Insert
    suspend fun insertPosts(posts: List<PostEntity>)
}

// 3. Database
@Database(
    entities = [UserEntity::class, PostEntity::class],
    version = 1,
    exportSchema = true
)
abstract class AppDatabase : RoomDatabase() {
    
    abstract fun userDao(): UserDao
    abstract fun postDao(): PostDao
    
    companion object {
        @Volatile private var instance: AppDatabase? = null
        
        fun getInstance(context: Context): AppDatabase =
            instance ?: synchronized(this) {
                instance ?: buildDatabase(context).also { instance = it }
            }
        
        private fun buildDatabase(context: Context): AppDatabase {
            return Room.databaseBuilder(
                context,
                AppDatabase::class.java,
                "app.db"
            )
            .addMigrations(MIGRATION_1_2)
            .build()
        }
    }
}

// 4. Migration
val MIGRATION_1_2 = object : Migration(1, 2) {
    override fun migrate(database: SupportSQLiteDatabase) {
        database.execSQL("ALTER TABLE users ADD COLUMN phone TEXT DEFAULT ''")
    }
}
```

**Repository Pattern with Room:**

```kotlin
class UserRepository(
    private val userDao: UserDao,
    private val userApi: UserApi
) {
    
    // Read from local cache
    fun getAllUsers(): LiveData<List<User>> {
        return userDao.getAllUsers()
            .map { entities ->
                entities.map { it.toDomain() }
            }
    }
    
    // Offline-first: Local cache + background sync
    fun getUser(id: Int): Flow<User?> = flow {
        // Emit cached data first
        val cached = userDao.getUserById(id)
        if (cached != null) {
            emit(cached.toDomain())
        }
        
        try {
            // Fetch fresh data
            val fresh = userApi.getUser(id)
            userDao.insertOrUpdate(fresh.toEntity())
            emit(fresh)
        } catch (e: Exception) {
            if (cached == null) throw e
        }
    }
    
    // Insert with error handling
    suspend fun insertUser(user: User): Result<Unit> = runCatching {
        userDao.insert(user.toEntity())
    }
}
```

**Key Points:**
- ✅ Compile-time SQL verification
- ✅ Automatic cursor-to-object mapping
- ✅ LiveData/Flow support in DAO
- ✅ Transaction support with @Transaction
- ✅ Migrations for schema changes
- ✅ Type-safe queries

