### DataStore & WorkManager

**Theory:**
DataStore replaces SharedPreferences with better performance and type safety.

**DataStore vs SharedPreferences:**

```
SharedPreferences:
├── Plain text storage
├── Not type-safe
├── No transaction support
└── Deprecated

DataStore:
├── Protocol Buffer support
├── Type-safe
├── ACID transactions
├── Coroutine-based
└── Async by default
```

**Implementation:**

```kotlin
// Proto DataStore
data class UserPreferences(
    val isDarkMode: Boolean = false,
    val lastUserId: String = "",
    val fontSize: Float = 14f
)

val Context.userPreferences: DataStore<UserPreferences> by preferencesDataStore(
    name = "user_preferences",
    serializer = UserPreferencesSerializer()
)

// Custom Serializer
object UserPreferencesSerializer : Serializer<UserPreferences> {
    override val defaultValue: UserPreferences = UserPreferences()
    
    override suspend fun readFrom(input: InputStream): UserPreferences {
        return try {
            JsonFormat.merge(input.readBytes().decodeToString(), UserPreferences())
        } catch (e: Exception) {
            defaultValue
        }
    }
    
    override suspend fun writeTo(
        t: UserPreferences,
        output: OutputStream
    ) {
        output.write(JsonFormat.printer().print(t).encodeToByteArray())
    }
}

// Usage in ViewModel
@HiltViewModel
class SettingsViewModel @Inject constructor(
    private val dataStore: DataStore<UserPreferences>
) : ViewModel() {
    
    val isDarkMode: Flow<Boolean> = dataStore.data
        .catch { exception ->
            emit(UserPreferences())
        }
        .map { preferences ->
            preferences.isDarkMode
        }
    
    fun setDarkMode(enabled: Boolean) {
        viewModelScope.launch {
            dataStore.updateData { preferences ->
                preferences.copy(isDarkMode = enabled)
            }
        }
    }
}
```

**WorkManager:**

```kotlin
// Define Worker
class SyncDataWorker(
    context: Context,
    params: WorkerParameters
) : CoroutineWorker(context, params) {
    
    @Inject lateinit var repository: DataRepository
    
    override suspend fun doWork(): Result {
        return try {
            // Do background work
            val data = repository.syncData()
            
            // Return result
            Result.success(
                workDataOf("syncedItems" to data.size)
            )
        } catch (e: Exception) {
            if (runAttemptCount < 3) {
                Result.retry()  // Retry up to 3 times
            } else {
                Result.failure()  // Give up
            }
        }
    }
}

// Schedule Work
class MainActivity : AppCompatActivity() {
    
    fun scheduleSyncWork() {
        val syncWork = PeriodicWorkRequestBuilder<SyncDataWorker>(
            15, TimeUnit.MINUTES
        )
        .setConstraints(
            Constraints.Builder()
                .setRequiredNetworkType(NetworkType.CONNECTED)
                .setRequiresCharging(false)
                .build()
        )
        .setBackoffCriteria(
            BackoffPolicy.EXPONENTIAL,
            15,
            TimeUnit.MINUTES
        )
        .build()
        
        WorkManager.getInstance(this).enqueueUniquePeriodicWork(
            "sync_work",
            ExistingPeriodicWorkPolicy.KEEP,
            syncWork
        )
    }
    
    fun observeSyncProgress() {
        WorkManager.getInstance(this)
            .getWorkInfosForTagLiveData("sync")
            .observe(this) { workInfos ->
                workInfos.forEach { workInfo ->
                    when (workInfo.state) {
                        WorkInfo.State.RUNNING -> {
                            val syncedItems = workInfo.outputData.getInt("syncedItems", 0)
                            Log.d("Work", "Syncing... $syncedItems items")
                        }
                        WorkInfo.State.SUCCEEDED -> {
                            Log.d("Work", "Sync completed")
                        }
                        else -> {}
                    }
                }
            }
    }
}
```

**Key Points:**
- ✅ DataStore is async and type-safe
- ✅ WorkManager survives app death
- ✅ Set constraints (network, battery, charging)
- ✅ Exponential backoff for retries
- ✅ Can observe work progress with LiveData
- ✅ Unique work prevents duplicates

