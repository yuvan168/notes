## Asynchronous Programming

### Coroutines & viewModelScope

**Theory:**
Coroutines are lightweight threads managed by Kotlin runtime.

**Coroutine Scope Hierarchy:**

```
GlobalScope (App lifetime)
├── viewModelScope (ViewModel lifetime)
├── lifecycleScope (Activity/Fragment lifetime)
│   ├── launchWhenStarted
│   ├── launchWhenResumed
│   └── repeatOnLifecycle
└── Custom Scope
```

**Implementation:**

```kotlin
@HiltViewModel
class DataViewModel @Inject constructor(
    private val repository: DataRepository
) : ViewModel() {
    
    private val _data = MutableLiveData<Data>()
    val data: LiveData<Data> = _data
    
    private val _error = MutableLiveData<String?>()
    val error: LiveData<String?> = _error
    
    // Launch on ViewModel scope
    fun loadData() {
        viewModelScope.launch {
            try {
                // Suspend call (won't block UI thread)
                val result = repository.getData()
                _data.value = result
                _error.value = null
            } catch (e: CancellationException) {
                // Job was cancelled
                throw e
            } catch (e: Exception) {
                _error.value = e.message
            }
        }
    }
    
    // Parallel requests
    fun loadUserAndPosts(userId: Int) {
        viewModelScope.launch {
            try {
                // Launch parallel
                val userDeferred = async { repository.getUser(userId) }
                val postsDeferred = async { repository.getPosts(userId) }
                
                // Wait for both
                val user = userDeferred.await()
                val posts = postsDeferred.await()
                
                // Update UI
                _user.value = user
                _posts.value = posts
            } catch (e: Exception) {
                _error.value = e.message
            }
        }
    }
    
    // Sequential requests
    fun loadUserThenFollowers(userId: Int) {
        viewModelScope.launch {
            try {
                // Wait for first, then second
                val user = repository.getUser(userId)
                val followers = repository.getFollowers(user.id)
                
                _user.value = user
                _followers.value = followers
            } catch (e: Exception) {
                _error.value = e.message
            }
        }
    }
    
    // Timeout
    fun loadDataWithTimeout() {
        viewModelScope.launch {
            try {
                withTimeoutOrNull(5000) {
                    val data = repository.getData()
                    _data.value = data
                }
            } catch (e: TimeoutCancellationException) {
                _error.value = "Request timeout"
            }
        }
    }
    
    // Clean up
    override fun onCleared() {
        super.onCleared()
        // All coroutines in viewModelScope are cancelled automatically
    }
}
```

