### LiveData & State Management

**Theory:**
LiveData is an observable data holder that is lifecycle-aware.

**Advantages:**

```
LiveData Features:
├── Lifecycle Aware
│   ├── Automatically unsubscribes when lifecycle ends
│   └── Won't update destroyed views
├── No Memory Leaks
│   ├── Lifecycle binding prevents leaks
│   └── Auto cleanup
├── Thread Safe
│   ├── postValue() from any thread
│   ├── value from main thread
├── Configuration Change Safe
│   ├── Data persists across rotation
│   └── No redundant updates
└── One-time Observers
    └── observeOnce possible
```

**Implementation Patterns:**

```kotlin
// Pattern 1: Simple LiveData
class SimpleViewModel : ViewModel() {
    private val _counter = MutableLiveData<Int>(0)
    val counter: LiveData<Int> = _counter
    
    fun increment() {
        _counter.value = (_counter.value ?: 0) + 1
    }
}

// Pattern 2: Transformed LiveData
class TransformedViewModel : ViewModel() {
    private val _userName = MutableLiveData<String>("")
    
    // Transform name to uppercase
    val userNameUppercase: LiveData<String> = _userName.map { name ->
        name.uppercase()
    }
    
    // Switch between different LiveData sources
    private val _userId = MutableLiveData<Int>()
    val user: LiveData<User> = _userId.switchMap { userId ->
        repository.getUser(userId)  // Returns LiveData<User>
    }
}

// Pattern 3: Merging LiveData
class MergedViewModel : ViewModel() {
    private val _firstName = MutableLiveData<String>("")
    private val _lastName = MutableLiveData<String>("")
    
    val fullName: LiveData<String> = mediatorLiveData {
        val first = _firstName.value ?: ""
        val last = _lastName.value ?: ""
        
        value = "$first $last"
    }
    
    init {
        // Update whenever either changes
        addSource(_firstName) {
            value = "${_firstName.value ?: ""} ${_lastName.value ?: ""}"
        }
        addSource(_lastName) {
            value = "${_firstName.value ?: ""} ${_lastName.value ?: ""}"
        }
    }
}

// Pattern 4: Distinct Until Changed
class DistinctViewModel : ViewModel() {
    private val _searchQuery = MutableLiveData<String>()
    
    // Only update when value actually changes
    val results: LiveData<List<SearchResult>> = 
        _searchQuery
            .distinctUntilChanged()
            .switchMap { query ->
                if (query.length < 3) {
                    MutableLiveData<List<SearchResult>>(emptyList())
                } else {
                    repository.search(query)
                }
            }
}
```

**Comparison: LiveData vs StateFlow:**

```kotlin
// LiveData (Lifecycle-aware)
class LiveDataViewModel : ViewModel() {
    val state: LiveData<State> = ...
}
// Usage:
viewModel.state.observe(this) { state ->
    // Automatic lifecycle management
}

// StateFlow (Coroutine-based)
class StateFlowViewModel : ViewModel() {
    val state: StateFlow<State> = ...
}
// Usage:
lifecycleScope.launch {
    repeatOnLifecycle(Lifecycle.State.STARTED) {
        viewModel.state.collect { state ->
            updateUI(state)
        }
    }
}
```

**Key Points:**
- ✅ Lifecycle-aware - automatic unsubscribe
- ✅ Thread-safe with `postValue()`
- ✅ Use `.map()` for transformations
- ✅ Use `.switchMap()` for switching data sources
- ✅ `distinctUntilChanged()` prevents redundant updates
- ✅ StateFlow more modern, but LiveData still widely used

