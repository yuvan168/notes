## MVVM Architecture Pattern

**Complete Example:**

```kotlin
// 1. MODEL - Data layer
data class User(val id: Int, val name: String, val email: String)

// 2. REPOSITORY - Data access abstraction
class UserRepository(
    private val userDao: UserDao,
    private val userApi: UserApi
) {
    fun getUserById(id: Int): LiveData<User> = userDao.getUserById(id)
    
    fun getAllUsers(): LiveData<List<User>> = userDao.getAllUsers()
    
    suspend fun syncUsers() {
        try {
            val users = userApi.fetchUsers()
            userDao.insertAll(users)
        } catch (e: Exception) {
            Log.e("UserRepository", "Sync failed", e)
        }
    }
}

