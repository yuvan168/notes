## Data Persistence

### 1. Preferences DataStore

**Theory:**

DataStore replaces SharedPreferences with:
- Type-safe
- Asynchronous (coroutine-based)
- Reactive (Flow-based)
- ACID transactions

**Implementation:**

```kotlin
// Define schema (proto file)
syntax = "proto3";

message UserPreferences {
    string theme = 1;
    int32 font_size = 2;
    bool dark_mode = 3;
}

// Create DataStore
class UserPreferencesRepository(
    private val dataStore: DataStore<UserPreferences>
) {
    val userPreferencesFlow: Flow<UserPreferences> = dataStore.data
        .catch { exception ->
            if (exception is IOException) {
                emit(UserPreferences.getDefaultInstance())
            } else {
                throw exception
            }
        }
    
    suspend fun updateTheme(theme: String) {
        dataStore.updateData { currentPreferences ->
            currentPreferences.toBuilder()
                .setTheme(theme)
                .build()
        }
    }
    
    suspend fun updateDarkMode(isDark: Boolean) {
        dataStore.updateData { currentPreferences ->
            currentPreferences.toBuilder()
                .setDarkMode(isDark)
                .build()
        }
    }
}

// Use in ViewModel
class SettingsViewModel(
    private val prefRepo: UserPreferencesRepository
) : ViewModel() {
    val userPreferences = prefRepo.userPreferencesFlow.stateIn(
        viewModelScope,
        SharingStarted.Eagerly,
        UserPreferences.getDefaultInstance()
    )
    
    fun setTheme(theme: String) {
        viewModelScope.launch {
            prefRepo.updateTheme(theme)
        }
    }
}
```

