### 2. WorkManager

**Theory:**

WorkManager schedules deferrable, guaranteed work:
- Works even if app is closed/device restarted
- Respects device battery state
- Automatic retry with backoff
- Chains multiple tasks

**Use Cases:**

- Syncing data with server
- Uploading logs
- Periodic backups
- Background image processing

**Implementation:**

```kotlin
// Define Work
class SyncDataWork(context: Context, params: WorkerParameters) 
    : CoroutineWorker(context, params) {
    
    override suspend fun doWork(): Result {
        return try {
            // Do background work
            val data = fetchFromServer()
            saveToDatabase(data)
            
            Result.success()
        } catch (exception: Exception) {
            if (runAttemptCount < 3) {
                Result.retry()  // Retry with backoff
            } else {
                Result.failure()
            }
        }
    }
}

// Schedule Work
class SyncWorkScheduler {
    fun scheduleDataSync(context: Context) {
        val syncWork = PeriodicWorkRequestBuilder<SyncDataWork>(
            15, TimeUnit.MINUTES  // Repeat every 15 minutes
        ).setBackoffCriteria(
            BackoffPolicy.EXPONENTIAL,
            WorkRequest.MIN_BACKOFF_MILLIS,
            TimeUnit.MILLISECONDS
        ).build()
        
        WorkManager.getInstance(context).enqueueUniquePeriodicWork(
            "sync_data",
            ExistingPeriodicWorkPolicy.KEEP,
            syncWork
        )
    }
    
    // One-time work
    fun syncNow(context: Context) {
        val syncWork = OneTimeWorkRequestBuilder<SyncDataWork>()
            .setBackoffCriteria(
                BackoffPolicy.EXPONENTIAL,
                10, TimeUnit.SECONDS
            )
            .build()
        
        WorkManager.getInstance(context).enqueueUniqueWork(
            "sync_now",
            ExistingWorkPolicy.REPLACE,
            syncWork
        )
    }
}

// Observe Work Status
class SyncViewModel : ViewModel() {
    val syncState = WorkManager.getInstance(context)
        .getWorkInfosForUniqueWorkLiveData("sync_data")
        .map { workInfos ->
            when {
                workInfos.isEmpty() -> SyncState.Idle
                workInfos.all { it.state == WorkInfo.State.SUCCEEDED } -> 
                    SyncState.Success
                workInfos.any { it.state == WorkInfo.State.RUNNING } -> 
                    SyncState.Running
                workInfos.any { it.state == WorkInfo.State.FAILED } -> 
                    SyncState.Failed
                else -> SyncState.Idle
            }
        }
}

sealed class SyncState {
    object Idle : SyncState()
    object Running : SyncState()
    object Success : SyncState()
    object Failed : SyncState()
}
```

