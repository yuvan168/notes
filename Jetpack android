## Architecture Components

### 1. ViewModel

**Theory:**

ViewModel holds UI-related data that survives configuration changes (like device rotation). It's designed to:
- Survive lifecycle changes
- Store and manage UI-related data
- Not hold references to Views (prevents memory leaks)
- Share data between Fragments

**How It Works:**

```
Activity/Fragment destroyed (rotation)
         ↓
ViewModel SURVIVES (in memory)
         ↓
New Activity/Fragment created
         ↓
ViewModel provides saved data
```

**Implementation:**

```kotlin
// Define ViewModel
class UserViewModel : ViewModel() {
    private val _user = MutableLiveData<User>()
    val user: LiveData<User> = _user
    
    private val _loading = MutableLiveData<Boolean>()
    val loading: LiveData<Boolean> = _loading
    
    fun loadUser(userId: Int) {
        _loading.value = true
        viewModelScope.launch {
            try {
                val user = fetchUserFromApi(userId)
                _user.value = user
            } catch (e: Exception) {
                // Handle error
            } finally {
                _loading.value = false
            }
        }
    }
    
    override fun onCleared() {
        super.onCleared()
        // Clean up resources
        cancelAllCoroutines()
    }
}

// Use in Activity
class UserActivity : AppCompatActivity() {
    private val viewModel: UserViewModel by viewModels()
    
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        
        // Observe data
        viewModel.user.observe(this) { user ->
            displayUser(user)
        }
        
        viewModel.loading.observe(this) { isLoading ->
            if (isLoading) showProgressBar() else hideProgressBar()
        }
        
        viewModel.loadUser(1)
    }
}

// Use in Fragment
class UserFragment : Fragment() {
    private val viewModel: UserViewModel by viewModels()
    
    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        
        viewModel.user.observe(viewLifecycleOwner) { user ->
            // Update UI
        }
    }
}
```

**Why ViewModel?**

```kotlin
// ❌ WITHOUT ViewModel
class UserActivity : AppCompatActivity() {
    var users: List<User>? = null  // Lost on rotation!
    
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        if (users == null) {
            users = fetchExpensiveUserList()  // Called again after rotation!
        }
    }
}

// ✅ WITH ViewModel
class UserActivity : AppCompatActivity() {
    private val viewModel: UserViewModel by viewModels()
    
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        // ViewModel survives rotation, no re-fetch!
        viewModel.users.observe(this) { users ->
            updateUI(users)
        }
    }
}
```

