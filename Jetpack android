## Performance & Best Practices

### Memory Leaks

**Common Leaks:**

```kotlin
// ❌ LEAK 1: ViewModel holding Activity reference
class BadViewModel : ViewModel() {
    var activity: Activity? = null  // LEAK!
    var context: Context? = null    // LEAK!
}

// ✅ CORRECT: Only hold data
class GoodViewModel : ViewModel() {
    val userData: LiveData<User> = ...
}

// ❌ LEAK 2: Inner class holding outer reference
class MyFragment : Fragment() {
    private inner class InnerTask : AsyncTask<...>() {
        // Holds reference to MyFragment
    }
}

// ✅ CORRECT: Use static inner class or separate class
class MyFragment : Fragment() {
    companion object {
        private class InnerTask : AsyncTask<...>() {
            // No reference to MyFragment
        }
    }
}

// ❌ LEAK 3: Global scope in ViewModel
class BadViewModel : ViewModel() {
    fun loadData() {
        GlobalScope.launch {  // Never cancelled!
            fetchData()
        }
    }
}

// ✅ CORRECT: Use viewModelScope
class GoodViewModel : ViewModel() {
    fun loadData() {
        viewModelScope.launch {  // Auto-cancelled
            fetchData()
        }
    }
}
```

