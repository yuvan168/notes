### 2. Paging3

**Theory:**

Paging3 enables efficient loading of large datasets:
- Loads data in chunks
- Smooth scrolling
- Built-in loading indicators
- Handles retry logic

**Implementation:**

```kotlin
// Step 1: Create PagingSource
class UserPagingSource(private val api: UserApi) : PagingSource<Int, User>() {
    override suspend fun load(params: LoadParams<Int>): LoadResult<Int, User> {
        val pageNumber = params.key ?: 1
        
        return try {
            val response = api.getUsers(
                page = pageNumber,
                pageSize = params.loadSize
            )
            
            LoadResult.Page(
                data = response.users,
                prevKey = if (pageNumber > 1) pageNumber - 1 else null,
                nextKey = if (response.hasNextPage) pageNumber + 1 else null
            )
        } catch (e: Exception) {
            LoadResult.Error(e)
        }
    }
}

// Step 2: Create Repository
class UserRepository(private val api: UserApi) {
    fun getUsersPaged(): Flow<PagingData<User>> {
        return Pager(
            config = PagingConfig(
                pageSize = 20,
                enablePlaceholders = false
            ),
            pagingSourceFactory = { UserPagingSource(api) }
        ).flow
    }
}

// Step 3: Create PagingDataAdapter
class PagingUserAdapter : PagingDataAdapter<User, UserViewHolder>(UserDiffUtil) {
    
    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): UserViewHolder {
        // Similar to ListAdapter
    }
    
    override fun onBindViewHolder(holder: UserViewHolder, position: Int) {
        holder.bind(getItem(position))
    }
}

// Step 4: Use in Fragment
class UserListFragment : Fragment() {
    private val viewModel: UserViewModel by viewModels()
    private val adapter = PagingUserAdapter()
    
    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        
        binding.recyclerView.adapter = adapter.withLoadStateFooter(
            footer = PagingLoadStateAdapter { adapter.retry() }
        )
        
        viewModel.usersPaged.collectLatest { pagingData ->
            adapter.submitData(pagingData)
        }
    }
}
```

