### 3. Room Database

**Theory:**

Room is an abstraction layer over SQLite that:
- Provides compile-time checked SQL
- Reduces boilerplate (no ContentProviders needed)
- Integrates with LiveData for reactive queries
- Thread-safe by default

**Architecture:**

```
Entity (Data Class)
    ↓
DAO (Database Access Object)
    ↓
Database (Room.databaseBuilder)
    ↓
Repository (handles data flow)
```

**Implementation:**

```kotlin
// Step 1: Define Entity
@Entity(tableName = "users")
data class User(
    @PrimaryKey
    val id: Int,
    val name: String,
    val email: String,
    @ColumnInfo(name = "created_at")
    val createdAt: Long
)

// Step 2: Create DAO (Data Access Object)
@Dao
interface UserDao {
    @Insert
    suspend fun insertUser(user: User)
    
    @Update
    suspend fun updateUser(user: User)
    
    @Delete
    suspend fun deleteUser(user: User)
    
    @Query("SELECT * FROM users WHERE id = :userId")
    fun getUserById(userId: Int): LiveData<User>
    
    @Query("SELECT * FROM users ORDER BY created_at DESC")
    fun getAllUsers(): LiveData<List<User>>
    
    @Query("SELECT * FROM users WHERE name LIKE :searchQuery")
    fun searchUsers(searchQuery: String): Flow<List<User>>
    
    @Query("DELETE FROM users WHERE created_at < :timestamp")
    suspend fun deleteOldUsers(timestamp: Long)
}

// Step 3: Create Room Database
@Database(entities = [User::class], version = 1)
abstract class AppDatabase : RoomDatabase() {
    abstract fun userDao(): UserDao
    
    companion object {
        private var INSTANCE: AppDatabase? = null
        
        fun getInstance(context: Context): AppDatabase {
            return INSTANCE ?: synchronized(this) {
                Room.databaseBuilder(
                    context,
                    AppDatabase::class.java,
                    "app_database"
                ).build().also { INSTANCE = it }
            }
        }
    }
}

// Step 4: Create Repository (abstraction over data sources)
class UserRepository(private val userDao: UserDao) {
    fun getUserById(id: Int): LiveData<User> = userDao.getUserById(id)
    
    fun getAllUsers(): LiveData<List<User>> = userDao.getAllUsers()
    
    suspend fun createUser(user: User) {
        userDao.insertUser(user)
    }
    
    suspend fun updateUser(user: User) {
        userDao.updateUser(user)
    }
    
    suspend fun deleteUser(user: User) {
        userDao.deleteUser(user)
    }
}

// Step 5: Use in ViewModel
class UserViewModel(private val repository: UserRepository) : ViewModel() {
    val users: LiveData<List<User>> = repository.getAllUsers()
    
    fun addUser(name: String, email: String) {
        viewModelScope.launch {
            val user = User(
                id = System.currentTimeMillis().toInt(),
                name = name,
                email = email,
                createdAt = System.currentTimeMillis()
            )
            repository.createUser(user)
        }
    }
}
```

**Query Types:**

```kotlin
// Simple query - returns Live data (auto-updates)
@Query("SELECT * FROM users")
fun getAllUsers(): LiveData<List<User>>

// Flow query - reactive stream
@Query("SELECT * FROM users")
fun getUsersFlow(): Flow<List<User>>

// Parameterized query - prevents SQL injection
@Query("SELECT * FROM users WHERE id = :userId")
fun getUser(userId: Int): LiveData<User>

// Join query
@Query("""
    SELECT users.*, posts.title 
    FROM users 
    LEFT JOIN posts ON users.id = posts.user_id 
    WHERE users.id = :userId
""")
fun getUserWithPosts(userId: Int): LiveData<UserWithPosts>

// Transaction
@Transaction
@Query("SELECT * FROM users")
fun getUsersWithPosts(): LiveData<List<UserWithPosts>>
```

