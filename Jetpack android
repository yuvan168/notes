### Offline-First Architecture

```kotlin
class UserRepository(
    private val userDao: UserDao,
    private val userApi: UserApi
) {
    
    fun getUser(id: Int): Flow<User> = flow {
        // 1. Emit cached data if available
        val cached = userDao.getUserById(id)
        if (cached != null) {
            emit(cached.toDomain())
        }
        
        // 2. Try to fetch fresh data
        try {
            val fresh = userApi.getUser(id)
            userDao.insertOrUpdate(fresh.toEntity())
            emit(fresh)
        } catch (e: IOException) {
            // Network error
            if (cached == null) throw e  // No fallback, throw error
            // else silently use cache
        }
    }
    
    // Background sync
    suspend fun syncUsers(): Result<Unit> = runCatching {
        val users = userApi.getAllUsers()
        userDao.insertAll(users.map { it.toEntity() })
    }
}
```

**Key Points:**
- ✅ Never hold View/Activity references in ViewModel
- ✅ Always use `viewModelScope` for coroutines
- ✅ Use pagination for large lists
- ✅ Cache network responses locally
- ✅ Implement offline-first architecture
- ✅ Monitor memory with Profiler

