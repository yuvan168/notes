## 4. TEMPLATES & RENDERING

### 4.1 lit-html Tagged Template Literals

Lit uses JavaScript tagged template literals (`html` tag) — not JSX, not a template string language.

```typescript
import { html, nothing, svg } from 'lit';

// Basic template
render() {
  return html`<p>Hello ${this.name}</p>`;
}
```

### 4.2 Expression Types

```typescript
render() {
  return html`
    <!-- ① Text Content -->
    <p>${this.message}</p>

    <!-- ② Attribute Binding -->
    <div id="${this.id}" class="${this.className}"></div>

    <!-- ③ Boolean Attribute (? prefix) -->
    <input ?disabled=${this.isDisabled} />
    <details ?open=${this.isOpen}>...</details>

    <!-- ④ Property Binding (. prefix) -->
    <input .value=${this.inputValue} />
    <my-child .data=${this.complexObject}></my-child>

    <!-- ⑤ Event Listener (@ prefix) -->
    <button @click=${this._handleClick}>Click me</button>
    <input @input=${this._handleInput} @keydown=${this._handleKey} />

    <!-- ⑥ Element Reference (ref directive) -->
    <div ${ref(this._divRef)}></div>
  `;
}
```

### 4.3 Binding Summary Table

| Syntax | Type | Example | Description |
|--------|------|---------|-------------|
| `${expr}` | Text/Child | `<p>${name}</p>` | Sets text content or child nodes |
| `attr=${expr}` | Attribute | `id="${id}"` | Sets HTML attribute (string) |
| `?attr=${expr}` | Boolean Attr | `?disabled=${flag}` | Adds/removes attribute |
| `.prop=${expr}` | Property | `.value=${val}` | Sets JS property directly |
| `@event=${handler}` | Event | `@click=${fn}` | Adds event listener |

### 4.4 Conditionals

```typescript
render() {
  return html`
    <!-- Ternary operator -->
    ${this.loggedIn
      ? html`<p>Welcome back, ${this.username}!</p>`
      : html`<p>Please log in.</p>`}

    <!-- Using 'nothing' to render nothing -->
    ${this.showBanner ? html`<div class="banner">New!</div>` : nothing}

    <!-- if/else with method -->
    ${this._renderContent()}

    <!-- Nullish fallback -->
    <p>${this.title ?? 'Untitled'}</p>
  `;
}

private _renderContent() {
  switch (this.page) {
    case 'home':    return html`<home-page></home-page>`;
    case 'about':   return html`<about-page></about-page>`;
    case 'contact': return html`<contact-page></contact-page>`;
    default:        return html`<not-found></not-found>`;
  }
}
```

### 4.5 Lists & Iteration

```typescript
render() {
  return html`
    <!-- Simple list with .map() -->
    <ul>
      ${this.items.map(item => html`
        <li>${item.name} - $${item.price}</li>
      `)}
    </ul>

    <!-- With index -->
    <ol>
      ${this.items.map((item, index) => html`
        <li>#${index + 1}: ${item}</li>
      `)}
    </ol>

    <!-- Efficient keyed list (use repeat directive) -->
    <ul>
      ${repeat(
        this.items,
        (item) => item.id,         // Key function
        (item, index) => html`     // Template function
          <li>${item.name}</li>
        `
      )}
    </ul>

    <!-- Empty state -->
    ${this.items.length === 0
      ? html`<p class="empty">No items found.</p>`
      : html`<ul>${this.items.map(i => html`<li>${i}</li>`)}</ul>`}
  `;
}
```

### 4.6 Nested Templates & Composition

```typescript
render() {
  const header = html`<header><h1>${this.title}</h1></header>`;
  const footer = html`<footer>&copy; 2026</footer>`;

  return html`
    ${header}
    <main>
      ${this._renderCards()}
    </main>
    ${footer}
  `;
}

private _renderCards() {
  return html`
    <div class="cards">
      ${this.cards.map(card => this._renderCard(card))}
    </div>
  `;
}

private _renderCard(card: Card) {
  return html`
    <div class="card">
      <h2>${card.title}</h2>
      <p>${card.description}</p>
    </div>
  `;
}
```

### 4.7 Raw HTML (Unsafe)

```typescript
