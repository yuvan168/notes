## 5. REACTIVE PROPERTIES

### 5.1 Property Declaration

Reactive properties trigger a re-render when their value changes.

```typescript
// ========== With Decorators (TypeScript) ==========
import { LitElement } from 'lit';
import { property, state } from 'lit/decorators.js';

export class MyElement extends LitElement {
  // Public reactive property (attribute + property)
  @property({ type: String }) name = 'default';
  @property({ type: Number }) count = 0;
  @property({ type: Boolean }) active = false;
  @property({ type: Array }) items: string[] = [];
  @property({ type: Object }) config = {};

  // Internal reactive state (no attribute)
  @state() private _loading = false;
}

// ========== Without Decorators (JavaScript) ==========
export class MyElement extends LitElement {
  static properties = {
    name:    { type: String },
    count:   { type: Number },
    active:  { type: Boolean },
    items:   { type: Array },
    config:  { type: Object },
    _loading: { state: true },   // Internal state
  };

  constructor() {
    super();
    this.name = 'default';
    this.count = 0;
    this.active = false;
    this.items = [];
    this.config = {};
    this._loading = false;
  }
}
```

### 5.2 Property Options

```typescript
@property({
  // --- Type Conversion ---
  type: String,                // Converter for attribute ↔ property
  // Built-in types: String, Number, Boolean, Array, Object

  // --- Attribute Handling ---
  attribute: 'my-name',        // Custom attribute name (default: lowercase property name)
  // attribute: false,          // No attribute — property only (set via JS)

  // --- Reflection ---
  reflect: true,               // Reflect property back to attribute
  // reflect: false,            // Default: don't reflect

  // --- Custom Converter ---
  converter: {
    fromAttribute(value: string | null, type?: unknown): Date {
      return new Date(value ?? '');
    },
    toAttribute(value: Date): string {
      return value.toISOString();
    }
  },

  // --- Change Detection ---
  hasChanged(newVal: unknown, oldVal: unknown): boolean {
    // Return true to trigger update
    return newVal !== oldVal;
  },

  // --- No attribute (internal state) ---
  // state: true,    // Use @state() decorator instead
})
name = 'default';
```

### 5.3 Property Types & Attribute Conversion

| Declared Type | Attribute Value | Property Value |
|--------------|----------------|----------------|
| `String` | `"hello"` | `"hello"` |
| `Number` | `"42"` | `42` |
| `Boolean` | `""` (present) | `true` |
| `Boolean` | (absent) | `false` |
| `Object` | `'{"a":1}'` | `{a: 1}` (JSON.parse) |
| `Array` | `'[1,2,3]'` | `[1, 2, 3]` (JSON.parse) |

```html
<!-- Boolean attributes: presence = true, absence = false -->
<my-element active></my-element>         <!-- active = true -->
<my-element></my-element>                <!-- active = false -->

<!-- String/Number attributes -->
<my-element name="Alice" count="5"></my-element>

<!-- Object/Array attributes (JSON string) -->
<my-element items='["a","b","c"]'></my-element>
```

### 5.4 @property vs @state

| Feature | `@property()` | `@state()` |
|---------|--------------|------------|
| Triggers re-render | Yes | Yes |
| Has HTML attribute | Yes (default) | No |
| Public API | Yes | No (internal) |
| Reflected | Optional (`reflect: true`) | No |
| Use case | Component inputs | Internal UI state |

```typescript
@customElement('user-card')
export class UserCard extends LitElement {
  // Public — set via HTML attributes or JS
  @property() name = '';
  @property({ type: Number }) age = 0;

  // Private — only used internally
  @state() private _isEditing = false;
  @state() private _formData = { name: '', age: 0 };
}
```

### 5.5 Mutability & Objects/Arrays

```typescript
// ⚠️ Lit uses strict equality (===) by default for change detection
// Mutating objects/arrays in place does NOT trigger re-render

// ✗ WRONG — mutation
this.items.push('new item');       // Same reference — no re-render
this.user.name = 'Alice';         // Same reference — no re-render

// ✓ CORRECT — create new reference
this.items = [...this.items, 'new item'];
this.user = { ...this.user, name: 'Alice' };

// ✓ For deeply nested updates
this.config = {
  ...this.config,
  settings: {
    ...this.config.settings,
    theme: 'dark',
  },
};

// ✓ Alternative: call requestUpdate() after mutation
this.items.push('new item');
this.requestUpdate();    // Force re-render
```

