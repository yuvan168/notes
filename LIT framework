### 14.4 Composition Patterns

```typescript
// ---- Compound Component Pattern ----

// Container
@customElement('tab-group')
export class TabGroup extends LitElement {
  @state() private _activeIndex = 0;

  render() {
    return html`
      <div class="tabs" role="tablist">
        <slot name="tab" @click=${this._onTabClick}></slot>
      </div>
      <div class="panels">
        <slot name="panel"></slot>
      </div>
    `;
  }

  private _onTabClick(e: Event) {
    const tab = (e.target as HTMLElement).closest('[slot="tab"]');
    if (!tab) return;
    const tabs = this.querySelectorAll('[slot="tab"]');
    this._activeIndex = Array.from(tabs).indexOf(tab);
    this._updateVisibility();
  }

  private _updateVisibility() {
    const panels = this.querySelectorAll('[slot="panel"]');
    panels.forEach((panel, i) => {
      (panel as HTMLElement).hidden = i !== this._activeIndex;
    });
  }
}

// Usage
// <tab-group>
//   <button slot="tab">Tab 1</button>
//   <button slot="tab">Tab 2</button>
//   <div slot="panel">Panel 1</div>
//   <div slot="panel">Panel 2</div>
// </tab-group>
