## 7. LIFECYCLE

### 7.1 Lifecycle Overview

```
Component Lifecycle:
┌──────────────────────────────────────────────────────────────┐
│                                                              │
│  constructor()                 → Initialize, set defaults     │
│       │                                                      │
│       ▼                                                      │
│  connectedCallback()           → Added to DOM                 │
│       │                                                      │
│       ▼                                                      │
│  ┌─── Update Cycle ───────────────────────────────────────┐  │
│  │                                                        │  │
│  │  willUpdate(changedProps)    → Before rendering          │  │
│  │       │                                                │  │
│  │       ▼                                                │  │
│  │  update(changedProps)        → Calls render()            │  │
│  │       │                                                │  │
│  │       ▼                                                │  │
│  │  render()                    → Return template           │  │
│  │       │                                                │  │
│  │       ▼                                                │  │
│  │  firstUpdated(changedProps)  → After FIRST render only   │  │
│  │       │                                                │  │
│  │       ▼                                                │  │
│  │  updated(changedProps)       → After EVERY render        │  │
│  │                                                        │  │
│  └────────────── (re-runs on property changes) ───────────┘  │
│                                                              │
│  disconnectedCallback()        → Removed from DOM             │
│                                                              │
│  adoptedCallback()             → Moved to new document        │
│                                                              │
│  attributeChangedCallback()    → Attribute changed            │
│                                                              │
└──────────────────────────────────────────────────────────────┘
```

### 7.2 Lifecycle Methods (Detailed)

```typescript
@customElement('lifecycle-demo')
export class LifecycleDemo extends LitElement {
  @property() name = '';
  @property({ type: Number }) count = 0;

  // ① CONSTRUCTOR — Initialize default values
  constructor() {
    super();   // Must call super() first!
    console.log('1. constructor');
    // Set default property values
    // Do NOT access DOM here — it doesn't exist yet
  }

  // ② CONNECTED — Element added to DOM
  connectedCallback() {
    super.connectedCallback();   // Must call super!
    console.log('2. connectedCallback');
    // Set up event listeners, observers, intervals
    // DOM is attached but not yet rendered
    window.addEventListener('resize', this._handleResize);
  }

  // ③ WILL UPDATE — Before rendering (sync)
  willUpdate(changedProperties: PropertyValues) {
    console.log('3. willUpdate', changedProperties);
    // Compute derived values based on changed properties
    // Can set properties here without triggering extra render
    if (changedProperties.has('name')) {
      this._upperName = this.name.toUpperCase();
    }
  }

  // ④ UPDATE — Reflects properties, calls render()
  // Override only if you need to control the update process itself
  // Usually you do NOT override this

  // ⑤ RENDER — Return the template
  render() {
    console.log('4. render');
    return html`
      <p>${this.name} - ${this.count}</p>
    `;
  }

  // ⑥ FIRST UPDATED — After first render only
  firstUpdated(changedProperties: PropertyValues) {
    console.log('5. firstUpdated');
    // Access shadow DOM elements
    // Initialize third-party libraries that need DOM
    // Set focus, measure sizes, etc.
    const input = this.renderRoot.querySelector('input');
    input?.focus();
  }

  // ⑦ UPDATED — After every render
  updated(changedProperties: PropertyValues) {
    console.log('6. updated', changedProperties);
    // React to property changes after render
    if (changedProperties.has('count')) {
      const oldCount = changedProperties.get('count') as number;
      console.log(`Count changed from ${oldCount} to ${this.count}`);
    }
  }

  // ⑧ DISCONNECTED — Element removed from DOM
  disconnectedCallback() {
    super.disconnectedCallback();
    console.log('7. disconnectedCallback');
    // Clean up: remove listeners, cancel timers, etc.
    window.removeEventListener('resize', this._handleResize);
  }

  private _handleResize = () => {
    // handle resize
  };
}
```

### 7.3 Update Lifecycle Control

```typescript
// ---- Request an Update ----
this.requestUpdate();                      // Force re-render
this.requestUpdate('propName', oldValue);  // Specify changed property

// ---- Wait for Update to Complete ----
await this.updateComplete;   // Promise that resolves after render

// Example: Sequential updates
async doSomething() {
  this.count = 5;
  await this.updateComplete;  // Wait for DOM to reflect count=5
  this.count = 10;
  await this.updateComplete;  // Wait for DOM to reflect count=10
  // Now DOM is up to date
}

// ---- shouldUpdate — Control whether to render ----
shouldUpdate(changedProperties: PropertyValues): boolean {
  // Return false to skip rendering
  // Example: only re-render if name changed
  return changedProperties.has('name');
}

// ---- getUpdateComplete — Custom async update ----
protected async getUpdateComplete() {
  const result = await super.getUpdateComplete();
  // Wait for child components to finish updating
  await this._childElement?.updateComplete;
  return result;
}
```

