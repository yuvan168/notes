// test/my-counter.test.ts
import { fixture, html, expect, oneEvent } from '@open-wc/testing';
import '../src/my-counter.js';
import type { MyCounter } from '../src/my-counter.js';

describe('MyCounter', () => {
  // ---- Rendering ----
  it('renders with default values', async () => {
    const el = await fixture<MyCounter>(html`<my-counter></my-counter>`);
    expect(el.count).to.equal(0);
    expect(el.shadowRoot!.querySelector('p')!.textContent).to.contain('0');
  });

  it('renders with custom count', async () => {
    const el = await fixture<MyCounter>(html`<my-counter count="5"></my-counter>`);
    expect(el.count).to.equal(5);
  });

  // ---- Property Changes ----
  it('updates DOM when count changes', async () => {
    const el = await fixture<MyCounter>(html`<my-counter></my-counter>`);
    el.count = 10;
    await el.updateComplete;   // Wait for re-render
    expect(el.shadowRoot!.querySelector('p')!.textContent).to.contain('10');
  });

  // ---- Events ----
  it('dispatches count-changed event on click', async () => {
    const el = await fixture<MyCounter>(html`<my-counter></my-counter>`);
    const button = el.shadowRoot!.querySelector('button')!;

    setTimeout(() => button.click());
    const { detail } = await oneEvent(el, 'count-changed');

    expect(detail.count).to.equal(1);
  });

  // ---- User Interaction ----
  it('increments on button click', async () => {
    const el = await fixture<MyCounter>(html`<my-counter></my-counter>`);
    const button = el.shadowRoot!.querySelector('button')!;

    button.click();
    await el.updateComplete;
    expect(el.count).to.equal(1);

    button.click();
    await el.updateComplete;
    expect(el.count).to.equal(2);
  });

  // ---- Accessibility ----
  it('passes accessibility checks', async () => {
    const el = await fixture(html`<my-counter></my-counter>`);
    await expect(el).to.be.accessible();
  });

  // ---- Snapshot ----
  it('matches snapshot', async () => {
    const el = await fixture(html`<my-counter count="3"></my-counter>`);
    expect(el).shadowDom.to.equalSnapshot();
  });

  // ---- Slots ----
  it('renders slotted content', async () => {
    const el = await fixture(html`
      <my-card>
        <span slot="title">Test Title</span>
        <p>Test content</p>
      </my-card>
    `);
    expect(el).lightDom.to.equal(`
      <span slot="title">Test Title</span>
      <p>Test content</p>
    `);
  });
});
