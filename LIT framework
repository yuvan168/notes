### 9.3 Directive Reference

#### repeat — Efficient keyed list rendering

```typescript
import { repeat } from 'lit/directives/repeat.js';

render() {
  return html`
    <ul>
      ${repeat(
        this.items,                              // Array
        (item) => item.id,                       // Key function
        (item, index) => html`                   <!-- Template -->
          <li>${index}: ${item.name}</li>
        `
      )}
    </ul>
  `;
}
// Use repeat when:
// - Items have stable unique IDs
// - Items are reordered, inserted, or removed
// Use .map() for simple, append-only lists
```

#### classMap — Dynamic CSS classes

```typescript
import { classMap } from 'lit/directives/class-map.js';

render() {
  const classes = {
    'card': true,
    'card--active': this.active,
    'card--disabled': this.disabled,
    'card--highlighted': this.count > 10,
  };

  return html`<div class=${classMap(classes)}>Content</div>`;
  // Renders: <div class="card card--active">Content</div>
}
```

#### styleMap — Dynamic inline styles

```typescript
import { styleMap } from 'lit/directives/style-map.js';

render() {
  const styles = {
    backgroundColor: this.bgColor,
    width: `${this.width}px`,
    height: `${this.height}px`,
    transform: `rotate(${this.rotation}deg)`,
    '--custom-prop': this.theme,  // CSS custom properties work too
  };

  return html`<div style=${styleMap(styles)}>Styled</div>`;
}
```

#### when — Conditional rendering

```typescript
import { when } from 'lit/directives/when.js';

render() {
  return html`
    ${when(this.loggedIn,
      () => html`<user-dashboard></user-dashboard>`,    // True case
      () => html`<login-form></login-form>`              // False case (optional)
    )}
  `;
}
```

#### choose — Switch/case rendering

```typescript
import { choose } from 'lit/directives/choose.js';

render() {
  return html`
    ${choose(this.status, [
      ['loading', () => html`<spinner-icon></spinner-icon>`],
      ['error',   () => html`<error-message .msg=${this.error}></error-message>`],
      ['success', () => html`<data-view .data=${this.data}></data-view>`],
    ], () => html`<p>Unknown status</p>`   // Default
    )}
  `;
}
```

#### cache — Cache template results for conditionally rendered templates

```typescript
import { cache } from 'lit/directives/cache.js';

render() {
  return html`
    ${cache(this.showDetails
      ? html`<detail-view .item=${this.item}></detail-view>`
      : html`<summary-view .items=${this.items}></summary-view>`
    )}
  `;
  // Without cache: switching destroys and recreates DOM each time
  // With cache: DOM is preserved and reused
}
```

#### guard — Skip re-rendering when dependencies haven't changed

```typescript
import { guard } from 'lit/directives/guard.js';

render() {
  return html`
    ${guard([this.items], () => html`
      <heavy-component .data=${this.items}></heavy-component>
    `)}
  `;
  // Template only re-evaluates when this.items reference changes
}
```

#### ifDefined — Only set attribute if value is defined

```typescript
import { ifDefined } from 'lit/directives/if-defined.js';

render() {
  return html`
    <img src=${ifDefined(this.src)} alt=${ifDefined(this.alt)} />
    <a href=${ifDefined(this.url)}>Link</a>
  `;
  // If this.src is undefined, the attribute is removed entirely
}
```

#### live — Bind to live DOM value (for inputs)

```typescript
import { live } from 'lit/directives/live.js';

render() {
  return html`
    <input .value=${live(this.inputValue)}
           @input=${this._onInput} />
  `;
  // 'live' checks the actual DOM value, not the last rendered value
  // Useful when external code might modify the input
}
```

#### ref — Get a reference to a rendered element

```typescript
import { ref, createRef } from 'lit/directives/ref.js';
import type { Ref } from 'lit/directives/ref.js';

export class MyElement extends LitElement {
  private _inputRef: Ref<HTMLInputElement> = createRef();

  render() {
    return html`
      <input ${ref(this._inputRef)} type="text" />
      <button @click=${this._focus}>Focus Input</button>
    `;
  }

  private _focus() {
    this._inputRef.value?.focus();
  }
}
```

#### until — Show placeholder while async value resolves

```typescript
import { until } from 'lit/directives/until.js';

render() {
  return html`
    <p>${until(
      this._fetchData(),                           // Promise
      html`<span>Loading...</span>`                 // Placeholder
    )}</p>
  `;
}

private async _fetchData() {
  const response = await fetch('/api/data');
  const data = await response.json();
  return html`<span>${data.name}</span>`;
}
```

#### map, join, range — Collection helpers

```typescript
import { map } from 'lit/directives/map.js';
import { join } from 'lit/directives/join.js';
import { range } from 'lit/directives/range.js';

render() {
  return html`
    <!-- map: like Array.map but for iterables -->
    ${map(this.items, (item) => html`<div>${item}</div>`)}

    <!-- join: insert separator between items -->
    ${join(
      this.tags.map(tag => html`<span class="tag">${tag}</span>`),
      html`<span class="sep"> | </span>`
    )}

    <!-- range: generate number sequence -->
    <select>
      ${map(range(1, 13), (i) => html`<option value=${i}>Month ${i}</option>`)}
    </select>
  `;
