## 12. MIXINS

### 12.1 Mixin Pattern

Mixins add reusable functionality to multiple components without inheritance chains.

```typescript
// ---- Define a Mixin ----
type Constructor<T = {}> = new (...args: any[]) => T;

export function LoggingMixin<T extends Constructor<LitElement>>(superClass: T) {
  class LoggingElement extends superClass {
    connectedCallback() {
      super.connectedCallback();
      console.log(`${this.tagName} connected`);
    }

    disconnectedCallback() {
      super.disconnectedCallback();
      console.log(`${this.tagName} disconnected`);
    }

    updated(changedProps: PropertyValues) {
      super.updated(changedProps);
      console.log(`${this.tagName} updated:`, [...changedProps.keys()]);
    }
  }
  return LoggingElement as T;
}

// ---- Resizable Mixin ----
export function ResizableMixin<T extends Constructor<LitElement>>(superClass: T) {
  class ResizableElement extends superClass {
    @state() width = 0;
    @state() height = 0;

    private _observer?: ResizeObserver;

    connectedCallback() {
      super.connectedCallback();
      this._observer = new ResizeObserver(([entry]) => {
        this.width = entry.contentRect.width;
        this.height = entry.contentRect.height;
      });
      this._observer.observe(this);
    }

    disconnectedCallback() {
      super.disconnectedCallback();
      this._observer?.disconnect();
    }
  }
  return ResizableElement as T;
}

// ---- Apply Mixins ----
@customElement('my-widget')
export class MyWidget extends ResizableMixin(LoggingMixin(LitElement)) {
  render() {
    return html`<p>Size: ${this.width} x ${this.height}</p>`;
  }
}
```

