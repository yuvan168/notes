## 15. FORMS & INPUT HANDLING

### 15.1 Basic Form Handling

```typescript
@customElement('my-form')
export class MyForm extends LitElement {
  @state() private _formData = {
    name: '',
    email: '',
    role: 'user',
    agree: false,
  };

  @state() private _errors: Record<string, string> = {};

  render() {
    return html`
      <form @submit=${this._onSubmit} novalidate>
        <div class="field">
          <label for="name">Name:</label>
          <input id="name"
                 type="text"
                 .value=${this._formData.name}
                 @input=${(e: InputEvent) =>
                   this._updateField('name', (e.target as HTMLInputElement).value)}
                 required />
          ${this._errors.name ? html`<span class="error">${this._errors.name}</span>` : nothing}
        </div>

        <div class="field">
          <label for="email">Email:</label>
          <input id="email"
                 type="email"
                 .value=${this._formData.email}
                 @input=${(e: InputEvent) =>
                   this._updateField('email', (e.target as HTMLInputElement).value)} />
        </div>

        <div class="field">
          <label for="role">Role:</label>
          <select id="role"
                  .value=${this._formData.role}
                  @change=${(e: Event) =>
                    this._updateField('role', (e.target as HTMLSelectElement).value)}>
            <option value="user">User</option>
            <option value="admin">Admin</option>
            <option value="editor">Editor</option>
          </select>
        </div>

        <div class="field">
          <label>
            <input type="checkbox"
                   .checked=${this._formData.agree}
                   @change=${(e: Event) =>
                     this._updateField('agree', (e.target as HTMLInputElement).checked)} />
            I agree to terms
          </label>
        </div>

        <button type="submit">Submit</button>
      </form>
    `;
  }

  private _updateField(field: string, value: unknown) {
    this._formData = { ...this._formData, [field]: value };
    // Clear error for this field
    if (this._errors[field]) {
      const { [field]: _, ...rest } = this._errors;
      this._errors = rest;
    }
  }

  private _validate(): boolean {
    const errors: Record<string, string> = {};
    if (!this._formData.name.trim()) errors.name = 'Name is required';
    if (!this._formData.email.includes('@')) errors.email = 'Invalid email';
    if (!this._formData.agree) errors.agree = 'Must agree to terms';
    this._errors = errors;
    return Object.keys(errors).length === 0;
  }

  private _onSubmit(e: Event) {
    e.preventDefault();
    if (this._validate()) {
      this.dispatchEvent(new CustomEvent('form-submit', {
        detail: this._formData,
        bubbles: true,
        composed: true,
      }));
    }
  }
}
```

### 15.2 Using ElementInternals (Form-Associated Custom Elements)

```typescript
@customElement('fancy-input')
export class FancyInput extends LitElement {
  static formAssociated = true;   // Opt-in to form association

  private _internals: ElementInternals;

  @property() name = '';
  @property() value = '';
  @property({ type: Boolean }) required = false;

  constructor() {
    super();
    this._internals = this.attachInternals();
  }

  render() {
    return html`
      <input .value=${this.value}
             @input=${this._onInput}
             ?required=${this.required}
             part="input" />
    `;
  }

  private _onInput(e: InputEvent) {
    this.value = (e.target as HTMLInputElement).value;
    this._internals.setFormValue(this.value);

    // Custom validation
    if (this.required && !this.value) {
      this._internals.setValidity(
        { valueMissing: true },
        'This field is required',
        this.renderRoot.querySelector('input')!
      );
    } else {
      this._internals.setValidity({});
    }
  }

  // Standard form callbacks
  formResetCallback() {
    this.value = '';
    this._internals.setFormValue('');
  }

  formStateRestoreCallback(state: string) {
    this.value = state;
  }
}

// Now works inside native <form>:
// <form>
//   <fancy-input name="username" required></fancy-input>
//   <button type="submit">Submit</button>
// </form>
```

