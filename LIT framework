// ⚠️ WARNING: Only use with TRUSTED content!
// NEVER use with user input — XSS vulnerability!
render() {
  // this.htmlContent comes from a trusted CMS
  return html`<div>${unsafeHTML(this.trustedHtmlContent)}</div>`;
}
