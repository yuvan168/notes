### 3.3 Component Anatomy

```typescript
import { LitElement, html, css, nothing } from 'lit';
import { customElement, property, state, query } from 'lit/decorators.js';

@customElement('my-component')
export class MyComponent extends LitElement {
  // ---- 1. STYLES (scoped to shadow DOM) ----
  static styles = css`
    :host {
      display: block;
      padding: 16px;
    }
    .title { font-size: 1.5rem; }
  `;

  // ---- 2. REACTIVE PROPERTIES (trigger re-render on change) ----
  @property({ type: String }) title = 'Default';              // Public (reflected from attribute)
  @property({ type: Number }) count = 0;                      // Public
  @property({ type: Boolean, reflect: true }) active = false;  // Reflected to attribute
  @property({ type: Array }) items: string[] = [];             // Complex type
  @property({ attribute: false }) data = {};                   // No attribute (JS only)

  // ---- 3. INTERNAL STATE (private, not exposed as attribute) ----
  @state() private _expanded = false;

  // ---- 4. DOM QUERIES ----
  @query('#input') private _input!: HTMLInputElement;

  // ---- 5. RENDER METHOD ----
  render() {
    return html`
      <div class="title">${this.title}</div>
      <p>Count: ${this.count}</p>
      <button @click=${this._handleClick}>Increment</button>
      <input id="input" type="text" />
      ${this.active ? html`<span>Active!</span>` : nothing}
    `;
  }

  // ---- 6. METHODS ----
  private _handleClick() {
    this.count++;
    this.dispatchEvent(new CustomEvent('count-changed', {
      detail: { count: this.count },
      bubbles: true,
      composed: true,
    }));
  }
}
```

### 3.4 Custom Element Rules

```
Custom Element Naming Rules:
├── MUST contain a hyphen (-): my-element, app-header ✓
├── Cannot be a single word: myElement ✗
├── Cannot start with a digit: 1-element ✗
├── Must be all lowercase: My-Element ✗ (convention)
├── Cannot conflict with existing HTML elements
└── Register: customElements.define('tag-name', ClassName)
     or use @customElement('tag-name') decorator
```

### 3.5 Shadow DOM Basics

```typescript
@customElement('shadow-demo')
export class ShadowDemo extends LitElement {
  // Shadow DOM is enabled by default in LitElement
  // To disable Shadow DOM (not recommended):
  // createRenderRoot() {
  //   return this;  // Renders to light DOM instead
  // }

  render() {
    return html`
      <!-- This is INSIDE the Shadow DOM -->
      <style>
        /* These styles are scoped — won't leak out */
        p { color: red; }
      </style>
      <p>I'm in the shadow DOM</p>
      <slot></slot>  <!-- Projected light DOM content appears here -->
    `;
  }
}
```

```
Shadow DOM Structure:
<shadow-demo>
  ┌─── Shadow Root ───────────────────────┐
  │  <style>p { color: red; }</style>     │  ← Scoped styles
  │  <p>I'm in the shadow DOM</p>        │  ← Shadow DOM content
  │  <slot></slot>                        │  ← Insertion point
  └───────────────────────────────────────┘
  <span>Light DOM content</span>             ← Projected into <slot>
</shadow-demo>
```

