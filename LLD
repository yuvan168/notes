public enum SeatStatus  { AVAILABLE, LOCKED, BOOKED }
public enum BookingStatus { PENDING, CONFIRMED, CANCELLED }

public class Seat {
    private String seatId;
    private String row;
    private int    col;
    private SeatType   type;
    private SeatStatus status = SeatStatus.AVAILABLE;
    private String     lockedBy;  // userId who locked
    private LocalDateTime lockExpiry;

    // Seat locking with expiry to handle payment timeouts
    public synchronized boolean lock(String userId, int expiryMinutes) {
        if (status != SeatStatus.AVAILABLE) return false;
        status     = SeatStatus.LOCKED;
        lockedBy   = userId;
        lockExpiry = LocalDateTime.now().plusMinutes(expiryMinutes);
        return true;
    }

    public synchronized void confirm(String userId) {
        if (!userId.equals(lockedBy)) throw new IllegalArgumentException("Lock mismatch");
        status = SeatStatus.BOOKED;
    }

    public synchronized void release() {
        status     = SeatStatus.AVAILABLE;
        lockedBy   = null;
        lockExpiry = null;
    }

    public synchronized boolean isLockExpired() {
        return status == SeatStatus.LOCKED &&
               lockExpiry != null &&
               LocalDateTime.now().isAfter(lockExpiry);
    }
}

public class BookingService {
    private final Map<String, Booking> bookings = new ConcurrentHashMap<>();
    private final SeatService  seatService;
    private final PaymentService paymentService;
    private static final int LOCK_MINUTES = 10;

    public Booking initiateBooking(User user, Show show, List<String> seatIds) {
        // Lock seats atomically
        List<Seat> seats = seatService.getSeats(seatIds);
        List<Seat> locked = new ArrayList<>();
        for (Seat seat : seats) {
            if (!seat.lock(user.getId(), LOCK_MINUTES)) {
                // Rollback all locked seats
                locked.forEach(Seat::release);
                throw new RuntimeException("Seat " + seat.getSeatId() + " not available");
            }
            locked.add(seat);
        }

        double total = show.getPrice() * seats.size();
        Booking booking = new Booking(user, show, locked, total);
        bookings.put(booking.getId(), booking);
        return booking;
    }

    public Booking confirmBooking(String bookingId, PaymentDetails paymentDetails) {
        Booking booking = bookings.get(bookingId);
        if (booking == null) throw new IllegalArgumentException("Booking not found");

        Payment payment = paymentService.process(paymentDetails, booking.getTotalAmount());
        if (payment.isSuccessful()) {
            booking.getSeats().forEach(s -> s.confirm(booking.getUser().getId()));
            booking.setStatus(BookingStatus.CONFIRMED);
        } else {
            booking.getSeats().forEach(Seat::release);
            booking.setStatus(BookingStatus.CANCELLED);
        }
        return booking;
    }
}
