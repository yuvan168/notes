### Implementation

```java
public enum Color { WHITE, BLACK }

public class Position {
    private final int row, col;
    public Position(int row, int col) { this.row = row; this.col = col; }
    public boolean isValid() { return row >= 0 && row < 8 && col >= 0 && col < 8; }
    // equals, hashCode, getters...
}

public abstract class Piece {
    protected Color color;
    protected Position position;
    protected boolean hasMoved = false;

    public Piece(Color color, Position position) {
        this.color = color; this.position = position;
    }

    public abstract List<Position> getValidMoves(Board board);

    public Color getColor() { return color; }
    public Position getPosition() { return position; }
    public void setPosition(Position p) { this.position = p; hasMoved = true; }
}

public class Rook extends Piece {
    public Rook(Color color, Position position) { super(color, position); }

    @Override
    public List<Position> getValidMoves(Board board) {
        List<Position> moves = new ArrayList<>();
        int[][] directions = {{1,0},{-1,0},{0,1},{0,-1}};
        for (int[] dir : directions) {
            int r = position.getRow() + dir[0];
            int c = position.getCol() + dir[1];
            while (new Position(r, c).isValid()) {
                Piece p = board.getPieceAt(r, c);
                if (p == null) {
                    moves.add(new Position(r, c));
                } else {
                    if (p.getColor() != this.color) moves.add(new Position(r, c));
                    break;
                }
                r += dir[0]; c += dir[1];
            }
        }
        return moves;
    }
}

public class Knight extends Piece {
    public Knight(Color color, Position position) { super(color, position); }

    @Override
    public List<Position> getValidMoves(Board board) {
        List<Position> moves = new ArrayList<>();
        int[][] offsets = {{2,1},{2,-1},{-2,1},{-2,-1},{1,2},{1,-2},{-1,2},{-1,-2}};
        for (int[] off : offsets) {
            Position target = new Position(position.getRow() + off[0], position.getCol() + off[1]);
            if (target.isValid()) {
                Piece p = board.getPieceAt(target);
                if (p == null || p.getColor() != this.color) moves.add(target);
            }
        }
        return moves;
    }
}

public class Board {
    private Piece[][] grid = new Piece[8][8];

    public Board() { initializeBoard(); }

    private void initializeBoard() {
        // Place pieces...
        grid[0][0] = new Rook(Color.WHITE, new Position(0, 0));
        grid[0][1] = new Knight(Color.WHITE, new Position(0, 1));
        // ... etc
    }

    public Piece getPieceAt(int row, int col) { return grid[row][col]; }
    public Piece getPieceAt(Position p) { return grid[p.getRow()][p.getCol()]; }

    public boolean executeMove(Move move) {
        Piece piece = move.getPiece();
        if (!piece.getValidMoves(this).contains(move.getTo())) return false;

        grid[move.getFrom().getRow()][move.getFrom().getCol()] = null;
        grid[move.getTo().getRow()][move.getTo().getCol()] = piece;
        piece.setPosition(move.getTo());
        return true;
    }

    public boolean isInCheck(Color color) {
        Position kingPos = findKing(color);
        return getAllPieces(color.opposite()).stream()
               .anyMatch(p -> p.getValidMoves(this).contains(kingPos));
    }
}

public class ChessGame {
    private Board board;
    private Player[] players = new Player[2];
    private int currentPlayerIndex = 0;
    private GameStatus status = GameStatus.ACTIVE;

    public ChessGame(Player white, Player black) {
        this.board = new Board();
        this.players[0] = white;  // WHITE first
        this.players[1] = black;
    }

    public boolean makeMove(Move move) {
        Player current = players[currentPlayerIndex];
        if (move.getPiece().getColor() != current.getColor()) return false;

        if (!board.executeMove(move)) return false;

        // Check for check/checkmate
        Color opponent = current.getColor() == Color.WHITE ? Color.BLACK : Color.WHITE;
        if (board.isInCheck(opponent)) {
            status = board.isCheckmate(opponent) ? GameStatus.CHECKMATE : GameStatus.CHECK;
        }

        currentPlayerIndex = 1 - currentPlayerIndex;
        return true;
    }
}
