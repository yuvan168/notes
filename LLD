## 22. LLD Case Study: Logger System

### Requirements

- Multiple log levels: DEBUG, INFO, WARN, ERROR, FATAL
- Multiple output destinations: Console, File, Database
- Filtering by log level
- Asynchronous logging
- Log rotation
- Singleton logger

### Design Pattern: Singleton + Chain of Responsibility + Observer

```java
public enum LogLevel { DEBUG, INFO, WARN, ERROR, FATAL }

public class LogMessage {
    private final LogLevel   level;
    private final String     message;
    private final LocalDateTime timestamp = LocalDateTime.now();
    private final String     className;

    public LogMessage(LogLevel level, String message, String className) {
        this.level = level; this.message = message; this.className = className;
    }

    @Override
    public String toString() {
        return String.format("[%s] [%s] [%s] %s",
            timestamp, level, className, message);
    }
    // getters...
}

public abstract class LogHandler {
    protected LogHandler next;
    protected LogLevel   minLevel;

    public LogHandler(LogLevel minLevel) { this.minLevel = minLevel; }

    public LogHandler setNext(LogHandler next) { this.next = next; return next; }

    public void handle(LogMessage msg) {
        if (msg.getLevel().ordinal() >= minLevel.ordinal()) {
            write(msg);
        }
        if (next != null) next.handle(msg);
    }

    protected abstract void write(LogMessage msg);
}

public class ConsoleLogHandler extends LogHandler {
    public ConsoleLogHandler(LogLevel level) { super(level); }
    protected void write(LogMessage msg) {
        System.out.println(msg);
    }
}

public class FileLogHandler extends LogHandler {
    private final String filePath;

    public FileLogHandler(LogLevel level, String filePath) {
        super(level);
        this.filePath = filePath;
    }

    protected void write(LogMessage msg) {
        try (FileWriter fw = new FileWriter(filePath, true)) {
            fw.write(msg + "\n");
        } catch (IOException e) {
            System.err.println("Failed to write log: " + e.getMessage());
        }
    }
}

public class Logger {
    private static volatile Logger instance;
    private LogHandler handlerChain;
    private BlockingQueue<LogMessage> queue = new LinkedBlockingQueue<>();
    private ExecutorService executor = Executors.newSingleThreadExecutor();

    private Logger() {
        // Set up chain: Console(DEBUG) -> File(WARN)
        LogHandler console = new ConsoleLogHandler(LogLevel.DEBUG);
        LogHandler file    = new FileLogHandler(LogLevel.WARN, "app.log");
        console.setNext(file);
        handlerChain = console;

        // Async processing
        executor.submit(() -> {
            while (!Thread.currentThread().isInterrupted()) {
                try {
                    LogMessage msg = queue.take();
                    handlerChain.handle(msg);
                } catch (InterruptedException e) { Thread.currentThread().interrupt(); }
            }
        });
    }

    public static Logger getInstance() {
        if (instance == null) {
            synchronized (Logger.class) {
                if (instance == null) instance = new Logger();
            }
        }
        return instance;
    }

    private void log(LogLevel level, String message) {
        String caller = Thread.currentThread().getStackTrace()[3].getClassName();
        queue.offer(new LogMessage(level, message, caller));
    }

    public void debug(String msg) { log(LogLevel.DEBUG, msg); }
    public void info(String msg)  { log(LogLevel.INFO,  msg); }
    public void warn(String msg)  { log(LogLevel.WARN,  msg); }
    public void error(String msg) { log(LogLevel.ERROR, msg); }
    public void fatal(String msg) { log(LogLevel.FATAL, msg); }
}

// Usage
Logger.getInstance().info("Application started");
Logger.getInstance().error("Database connection failed");
