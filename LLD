```java
public enum DriverStatus { AVAILABLE, ON_TRIP, OFFLINE }
public enum TripStatus   { REQUESTED, ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED }
public enum VehicleType  { MINI, SEDAN, SUV, AUTO }

public class Location {
    private double lat, lng;
    public Location(double lat, double lng) { this.lat = lat; this.lng = lng; }

    public double distanceTo(Location other) {
        // Haversine formula (simplified)
        double dlat = Math.abs(this.lat - other.lat);
        double dlng = Math.abs(this.lng - other.lng);
        return Math.sqrt(dlat * dlat + dlng * dlng) * 111; // approx km
    }
}

public class DriverMatchingService {
    private Map<String, Driver> availableDrivers = new ConcurrentHashMap<>();

    public void updateDriverLocation(String driverId, Location location) {
        Driver driver = availableDrivers.get(driverId);
        if (driver != null) driver.setLocation(location);
    }

    public Optional<Driver> findNearestDriver(Location riderLocation, VehicleType type) {
        return availableDrivers.values().stream()
            .filter(d -> d.getStatus() == DriverStatus.AVAILABLE)
            .filter(d -> d.getVehicleType() == type)
            .min(Comparator.comparingDouble(
                d -> d.getLocation().distanceTo(riderLocation)));
    }
}

public class PricingService {
    private static final double BASE_FARE   = 30.0;
    private static final double RATE_PER_KM = 12.0;
    private static final double SURGE_MULTIPLIER = 1.5;

    public double calculateFare(Location from, Location to, VehicleType type, boolean isSurge) {
        double distance    = from.distanceTo(to);
        double typeMultiplier = switch (type) {
            case MINI  -> 1.0;
            case SEDAN -> 1.2;
            case SUV   -> 1.5;
            case AUTO  -> 0.8;
        };
        double fare = (BASE_FARE + RATE_PER_KM * distance) * typeMultiplier;
        return isSurge ? fare * SURGE_MULTIPLIER : fare;
    }
}

public class TripService {
    private final DriverMatchingService matchingService;
    private final PricingService pricingService;
    private final Map<String, Trip> activeTrips = new ConcurrentHashMap<>();

    public Trip requestRide(Rider rider, Location destination, VehicleType type) {
        Driver driver = matchingService.findNearestDriver(rider.getLocation(), type)
            .orElseThrow(() -> new RuntimeException("No driver available"));

        double estimatedFare = pricingService.calculateFare(
            rider.getLocation(), destination, type, isSurge());

        Trip trip = new Trip(rider, driver, rider.getLocation(), destination, estimatedFare);
        driver.setStatus(DriverStatus.ON_TRIP);
        activeTrips.put(trip.getId(), trip);
        return trip;
    }

    public Trip completeTrip(String tripId) {
        Trip trip = activeTrips.remove(tripId);
        trip.setStatus(TripStatus.COMPLETED);
        trip.getDriver().setStatus(DriverStatus.AVAILABLE);
        return trip;
    }

    private boolean isSurge() {
        // Logic based on demand/supply ratio
        return activeTrips.size() > 100;
    }
}
