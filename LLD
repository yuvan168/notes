    public CashDispenser(double initial) { this.availableCash = initial; }
    public boolean hasCash(double amount) { return availableCash >= amount; }
    public void dispense(double amount) {
        if (!hasCash(amount)) throw new RuntimeException("Not enough cash");
        availableCash -= amount;
    }
