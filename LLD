public enum BookStatus { AVAILABLE, LOANED, RESERVED, LOST }

public class BookItem {
    private String barcode;
    private Book book;
    private BookStatus status = BookStatus.AVAILABLE;

    public synchronized boolean checkout(Member member) {
        if (status != BookStatus.AVAILABLE) return false;
        status = BookStatus.LOANED;
        return true;
    }

    public synchronized void returnBook() {
        status = BookStatus.AVAILABLE;
    }
}

public class LoanManager {
    private Map<String, Loan> activeLoans    = new HashMap<>();
    private Map<String, Queue<Member>> reservations = new HashMap<>();
    private static final int LOAN_DAYS = 14;
    private static final double FINE_PER_DAY = 5.0;

    public Loan borrowBook(Member member, BookItem item) {
        if (!item.checkout(member)) throw new RuntimeException("Book not available");
        Loan loan = new Loan(item, member, LocalDate.now(), LocalDate.now().plusDays(LOAN_DAYS));
        activeLoans.put(item.getBarcode(), loan);
        return loan;
    }

    public double returnBook(String barcode) {
        Loan loan = activeLoans.remove(barcode);
        if (loan == null) throw new IllegalArgumentException("No active loan for " + barcode);
        loan.setReturnDate(LocalDate.now());
        loan.getItem().returnBook();

        // notify next in queue
        Queue<Member> queue = reservations.get(barcode);
        if (queue != null && !queue.isEmpty()) {
            Member nextMember = queue.poll();
            // notify nextMember that book is available
        }

        return calculateFine(loan);
    }

    private double calculateFine(Loan loan) {
        long overdueDays = ChronoUnit.DAYS.between(loan.getDueDate(), loan.getReturnDate());
        return overdueDays > 0 ? overdueDays * FINE_PER_DAY : 0.0;
    }

    public void reserveBook(Member member, String isbn) {
        reservations.computeIfAbsent(isbn, k -> new LinkedList<>()).offer(member);
    }
}

public class Catalog {
    private Map<String, Book> booksByISBN        = new HashMap<>();
    private Map<String, List<Book>> booksByTitle  = new HashMap<>();
    private Map<String, List<Book>> booksByAuthor = new HashMap<>();

    public void addBook(Book book) {
        booksByISBN.put(book.getIsbn(), book);
        booksByTitle.computeIfAbsent(book.getTitle().toLowerCase(), k -> new ArrayList<>()).add(book);
        booksByAuthor.computeIfAbsent(book.getAuthor().toLowerCase(), k -> new ArrayList<>()).add(book);
    }

    public List<Book> searchByTitle(String title) {
        return booksByTitle.getOrDefault(title.toLowerCase(), Collections.emptyList());
    }

    public Optional<BookItem> findAvailableCopy(String isbn) {
        Book book = booksByISBN.get(isbn);
        if (book == null) return Optional.empty();
        return book.getCopies().stream()
                   .filter(item -> item.getStatus() == BookStatus.AVAILABLE)
                   .findFirst();
    }
}
