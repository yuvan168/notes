    private VendingState state = VendingState.IDLE;
    private String selectedProductId;
    private double insertedAmount = 0.0;

    public void addProduct(Product p) { inventory.put(p.getId(), p); }

    public void selectProduct(String productId) {
        if (state != VendingState.IDLE) throw new IllegalStateException("Invalid state");
        Product p = inventory.get(productId);
        if (p == null || !p.isAvailable()) throw new RuntimeException("Product not available");
        selectedProductId = productId;
        state = VendingState.ITEM_SELECTED;
        System.out.println("Selected: " + p.getName() + " | Price: " + p.getPrice());
    }

    public void insertMoney(double amount) {
        if (state != VendingState.ITEM_SELECTED) throw new IllegalStateException("Select item first");
        insertedAmount += amount;
        System.out.printf("Inserted: %.2f | Total: %.2f%n", amount, insertedAmount);

        Product p = inventory.get(selectedProductId);
        if (insertedAmount >= p.getPrice()) {
            state = VendingState.PAYMENT_RECEIVED;
        }
    }

    public double dispenseProduct() {
        if (state != VendingState.PAYMENT_RECEIVED) throw new IllegalStateException("Insufficient payment");
        Product p = inventory.get(selectedProductId);
        p.dispense();
        double change = insertedAmount - p.getPrice();
        reset();
        System.out.println("Dispensing: " + p.getName() + " | Change: " + change);
        return change;
    }

    public double cancel() {
        double refund = insertedAmount;
        reset();
        System.out.println("Cancelled. Refund: " + refund);
        return refund;
    }

    private void reset() {
        selectedProductId = null;
        insertedAmount    = 0.0;
        state             = VendingState.IDLE;
    }
}
