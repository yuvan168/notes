## CRUD Operations

### Pattern 1: Complete Resource Controller
```php
// Model with relationships
class Post extends Model {
    protected $fillable = ['title', 'body', 'published'];

    public function author() {
        return $this->belongsTo(User::class);
    }
}

// Form Request for validation
class StorePostRequest extends FormRequest {
    public function authorize(): bool {
        return auth()->check(); // Only authenticated users can create
    }

    public function rules(): array {
        return [
            'title' => 'required|string|max:255|unique:posts',
            'body' => 'required|string|min:10',
        ];
    }
}

// Resource Controller
class PostController extends Controller {
    // List with pagination, filtering, sorting
    public function index(Request $request) {
        $query = Post::with('author');

        // Filtering
        if ($request->filled('search')) {
            $query->where('title', 'like', "%{$request->search}%");
        }

        // Sorting
        if ($request->filled('sort')) {
            $direction = $request->get('direction', 'asc');
            $query->orderBy($request->sort, $direction);
        } else {
            $query->latest();
        }

        $posts = $query->paginate(15);
        return view('posts.index', ['posts' => $posts]);
    }

    // Show create form
    public function create() {
        return view('posts.create');
    }

    // Store new resource
    public function store(StorePostRequest $request) {
        $post = auth()->user()->posts()->create($request->validated());
        
        // Optional: Dispatch event or job
        event(new PostCreated($post));

        return redirect("/posts/{$post->id}")
            ->with('success', 'Post created successfully!');
    }

    // Show single resource
    public function show(Post $post) {
        // Check authorization
        $this->authorize('view', $post);
        
        // Eager load relationships
        return view('posts.show', ['post' => $post->load('author', 'comments')]);
    }

    // Show edit form
    public function edit(Post $post) {
        $this->authorize('update', $post);
        return view('posts.edit', ['post' => $post]);
    }

    // Update resource
    public function update(UpdatePostRequest $request, Post $post) {
        $this->authorize('update', $post);
        
        $post->update($request->validated());
        
        return redirect("/posts/{$post->id}")
            ->with('success', 'Post updated successfully!');
    }

    // Delete resource
    public function destroy(Post $post) {
        $this->authorize('delete', $post);
        
        $post->delete();
        
        return redirect('/posts')
            ->with('success', 'Post deleted successfully!');
    }
}

// Routes
Route::resource('posts', PostController::class);
```

**Key Points**:
- Use Form Requests for validation
- Eager load relationships to avoid N+1
- Check authorization before operations
- Use flash messages for user feedback
- Automatic model binding via route parameter

