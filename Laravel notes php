            if ($this->attempts() >= $this->tries) {
                $webhook->update(['status' => 'failed', 'error' => $e->getMessage()]);
                Log::error('Webhook processing failed', ['webhook_id' => $webhook->id]);
            }
            throw $e;
        }
    }
}
