## Routing

### Basic Routes
```php
// routes/web.php

// Simple GET route
Route::get('/posts', function () {
    return 'List of posts';
});

// POST route
Route::post('/posts', function () {
    return 'Create post';
});

// Route with parameter
Route::get('/posts/{id}', function ($id) {
    return "Post: $id";
});

// Named route
Route::get('/profile', function () {
    return 'Profile';
})->name('profile');

// Multiple methods
Route::match(['get', 'post'], '/path', function () {
    //
});
```

### Resource Routes
```php
// Generates 7 standard routes (index, create, store, show, edit, update, destroy)
Route::resource('posts', PostController::class);

// Only specific actions
Route::resource('posts', PostController::class)->only(['index', 'show']);

// Exclude specific actions
Route::resource('posts', PostController::class)->except(['destroy']);
```

### Route Groups
```php
// Group with prefix
Route::prefix('admin')->group(function () {
    Route::get('/dashboard', [DashboardController::class, 'index']);
});

// Group with middleware
Route::middleware(['auth'])->group(function () {
    Route::get('/profile', [ProfileController::class, 'show']);
});

// Group with namespace
Route::namespace('Admin')->group(function () {
    // Controllers here are in Admin namespace
});

// Combined
Route::prefix('api')->middleware(['auth:api'])->group(function () {
    Route::resource('posts', PostController::class);
});
```

### Route Parameters
```php
// Optional parameter
Route::get('/posts/{id?}', function ($id = null) {
    return $id ?? 'All posts';
});

// Parameter constraints
Route::get('/posts/{id}', function ($id) {
    //
})->where('id', '[0-9]+');

// Multiple constraints
Route::get('/posts/{category}/{post}', function ($category, $post) {
    //
})->where(['category' => '[a-z]+', 'post' => '[0-9]+']);

// Global constraints in RouteServiceProvider
public function boot(): void
{
    Route::pattern('id', '[0-9]+');
}
```

### Redirects
```php
Route::redirect('/here', '/there', 301);
Route::permanentRedirect('/here', '/there');
Route::view('/welcome', 'welcome');
```

