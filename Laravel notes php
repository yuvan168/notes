        try {
            match ($webhook->event_type) {
                'charge.succeeded' => $this->handleChargeSucceeded($webhook),
                'charge.failed' => $this->handleChargeFailed($webhook),
                default => throw new UnhandledWebhookEvent(),
            };
            
            $webhook->update(['status' => 'processed']);
