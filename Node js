### 4. Buffer & Binary Data Handling

**Concept:**
Buffers are fixed-size chunks of memory used for working with binary data, especially in streams.

**Understanding Buffers:**

```javascript
const { Buffer } = require('buffer');

// Create buffer from string
const buf1 = Buffer.from('Hello', 'utf8');
console.log(buf1); // <Buffer 48 65 6c 6c 6f>

// Create buffer of specific size
const buf2 = Buffer.alloc(5);
buf2[0] = 72; // 'H'
console.log(buf2); // <Buffer 48 00 00 00 00>

// Buffer operations
const buf3 = Buffer.from([1, 2, 3, 4, 5]);
const buf4 = Buffer.from([6, 7, 8]);

// Concatenate buffers
const combined = Buffer.concat([buf3, buf4]);
console.log(combined); // <Buffer 01 02 03 04 05 06 07 08>

// Encoding conversions
const buf = Buffer.from('Hello');
console.log(buf.toString('hex')); // 48656c6c6f
console.log(buf.toString('base64')); // SGVsbG8=

// Buffer comparison
const buf5 = Buffer.from('abc');
const buf6 = Buffer.from('abc');
console.log(buf5.equals(buf6)); // true
```

**Practical Application - File Operations & Hashing:**

```javascript
const fs = require('fs');
const crypto = require('crypto');

// Calculate file hash while reading (memory efficient)
function hashFile(filePath) {
  return new Promise((resolve, reject) => {
    const hash = crypto.createHash('sha256');
    const stream = fs.createReadStream(filePath);

    stream.on('data', (chunk) => {
      hash.update(chunk);
    });

    stream.on('end', () => {
      resolve(hash.digest('hex'));
    });

    stream.on('error', reject);
  });
}

// Usage
const fileHash = await hashFile('large-file.zip');
console.log('SHA256:', fileHash);

// Binary data processing
function compressWithMetadata(data, metadata) {
  const metaBuf = Buffer.from(JSON.stringify(metadata));
  const dataBuf = Buffer.from(data);
  
  // Create format: [metadataLength:4][metadata:n][data:m]
  const lengthBuf = Buffer.alloc(4);
  lengthBuf.writeUInt32BE(metaBuf.length, 0);
  
  return Buffer.concat([lengthBuf, metaBuf, dataBuf]);
}

function decompressWithMetadata(buffer) {
  const metaLen = buffer.readUInt32BE(0);
  const metadata = JSON.parse(buffer.slice(4, 4 + metaLen).toString());
  const data = buffer.slice(4 + metaLen).toString();
  
  return { metadata, data };
}
```

