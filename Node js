### 3. Non-Blocking I/O & Concurrency Model

**Concept:**
Node.js uses a non-blocking, event-driven architecture. While JavaScript is single-threaded, the underlying C++ libraries (libuv) handle I/O in a thread pool.

**Blocking vs Non-Blocking:**

```javascript
// BLOCKING: Each operation waits for the previous one
function fetchUserSync(id) {
  // This blocks execution of other code
  const user = database.querySync(`SELECT * FROM users WHERE id = ${id}`);
  return user;
}

// Takes time = db_time * 3 for 3 users
fetchUserSync(1);
fetchUserSync(2);
fetchUserSync(3);

// NON-BLOCKING: Operations run concurrently
async function fetchUserAsync(id) {
  const user = await database.query(`SELECT * FROM users WHERE id = ${id}`);
  return user;
}

// Takes time = max(db_time) for 3 users (all run in parallel)
await Promise.all([
  fetchUserAsync(1),
  fetchUserAsync(2),
  fetchUserAsync(3)
]);
```

**Thread Pool Concept:**

```javascript
// libuv manages a thread pool (default 4 threads)
// CPU-intensive operations use threads
// I/O operations use OS async APIs (no thread needed)

const fs = require('fs');
const crypto = require('crypto');

// I/O operation: Uses OS async APIs (fast, doesn't need thread)
fs.readFile('large-file.txt', (err, data) => {
  console.log('Read complete');
});

// CPU operation: Uses thread pool
crypto.pbkdf2('password', 'salt', 100000, 64, 'sha512', (err, hash) => {
  console.log('Hash complete');
});

// Increase thread pool size for CPU-heavy apps
process.env.UV_THREADPOOL_SIZE = 128;

// Monitor thread pool usage
const piscina = require('piscina');
const worker = new piscina.Piscina({
  maxThreads: 8,
  minThreads: 2
});

app.post('/hash-password', async (req, res) => {
  // Offload CPU work to thread pool
  const hash = await worker.run(req.body.password);
  res.json({ hash });
});
```

