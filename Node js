**Dependency Injection Pattern:**

```javascript
// BAD: Hard-coded dependencies (hard to test)
class UserService {
  constructor() {
    this.database = new Database(); // Tightly coupled
  }
  
  async getUser(id) {
    return this.database.query(`SELECT * FROM users WHERE id = ${id}`);
  }
}

// GOOD: Dependency injection (loosely coupled)
class UserService {
  constructor(database, cache) {
    this.database = database;
    this.cache = cache;
  }
  
  async getUser(id) {
    const cached = this.cache.get(`user:${id}`);
    if (cached) return cached;
    
    const user = await this.database.query(`SELECT * FROM users WHERE id = ${id}`);
    this.cache.set(`user:${id}`, user);
    return user;
  }
}

// Usage
const database = new Database(connectionString);
const cache = new RedisCache();
const userService = new UserService(database, cache);

// Testing - easy to mock dependencies
class MockDatabase {
  async query() { return { id: 1, name: 'Test' }; }
}

class MockCache {
  get() { return null; }
  set() {}
}

const userService = new UserService(
  new MockDatabase(),
  new MockCache()
);

// Using a DI container (Inversify)
const { Container } = require('inversify');

const container = new Container();

container.bind('Database').to(Database);
container.bind('Cache').to(RedisCache);
container.bind('UserService').to(UserService);

const userService = container.get('UserService');
```

