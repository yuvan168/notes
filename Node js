### 2. Memory Management & Garbage Collection

**Concept:**
Node.js uses V8's garbage collection. Understanding memory management is crucial for building scalable applications.

**Memory Structure:**

```
┌─────────────────────────────────────────┐
│     Node.js Process Memory              │
├─────────────────────────────────────────┤
│  Heap (Allocated dynamically)           │
│  ├─ Young Generation (short-lived)      │
│  └─ Old Generation (long-lived)         │
├─────────────────────────────────────────┤
│  Stack (Function calls, local vars)     │
├─────────────────────────────────────────┤
│  Code Space (Function code)             │
└─────────────────────────────────────────┘
```

**Memory Leak Detection:**

```javascript
// BAD: Global accumulation (memory leak)
const cache = {};

function processRequest(id, data) {
  cache[id] = data; // Never cleared - memory leak!
}

// GOOD: Size-limited cache
const LRU = require('lru-cache');

const cache = new LRU({
  max: 500, // Maximum 500 items
  maxAge: 1000 * 60 * 60 // 1 hour TTL
});

function processRequest(id, data) {
  cache.set(id, data); // Auto-evicts oldest items
}

// Monitor memory usage
function monitorMemory() {
  const used = process.memoryUsage();
  console.log({
    rss: `${Math.round(used.rss / 1024 / 1024)}MB`,      // Resident Set Size
    heapTotal: `${Math.round(used.heapTotal / 1024 / 1024)}MB`,
    heapUsed: `${Math.round(used.heapUsed / 1024 / 1024)}MB`,
    external: `${Math.round(used.external / 1024 / 1024)}MB`
  });
}

setInterval(monitorMemory, 30000);

// Detect potential leaks
let previousHeap = 0;

setInterval(() => {
  const current = process.memoryUsage().heapUsed;
  const increase = current - previousHeap;
  
  if (increase > 50 * 1024 * 1024) { // 50MB increase
    console.warn('Potential memory leak detected!');
  }
  
  previousHeap = current;
}, 60000);
```

