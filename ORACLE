### 7. TRANSACTION MANAGEMENT - DETAILED

#### Transaction States & Lifecycle

```
TRANSACTION LIFECYCLE:

START TRANSACTION (Implicit)
     |
     v
EXECUTE STATEMENTS (SQL)
     |
     +-- DML: INSERT, UPDATE, DELETE
     +-- DDL: CREATE, ALTER (Auto-commits)
     |
     v
SAVEPOINT (Optional checkpoint)
     |
     v
ROLLBACK TO SAVEPOINT (Undo to checkpoint)
     |
     v
COMMIT (Make permanent) OR ROLLBACK (Discard all)
     |
     v
TRANSACTION END
```

**Practical Implementation:**
```sql
-- Complex transaction with savepoints
BEGIN
    -- Step 1: Insert employee
    INSERT INTO employees VALUES (1, 'John', 50000);
    SAVEPOINT sp1;
    
    -- Step 2: Insert department (may fail)
    INSERT INTO departments VALUES (10, 'IT');
    SAVEPOINT sp2;
    
    -- Step 3: Insert assignment
    INSERT INTO emp_dept_assign VALUES (1, 10);
    
    -- If error occurs, can rollback to specific point
    ROLLBACK TO sp2;  -- Undoes step 3
    -- Step 1 and 2 still committed
    
    COMMIT;  -- Make all changes permanent
    
EXCEPTION
    WHEN DUP_VAL_ON_INDEX THEN
        ROLLBACK;  -- Undo everything
        DBMS_OUTPUT.PUT_LINE('Duplicate key error');
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE;
END;
/
```

#### Isolation Levels - Complete Guide

```sql
-- Level 1: READ UNCOMMITTED (Dirty Read Possible)
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
BEGIN
    SELECT * FROM employees WHERE emp_id = 1;  -- Sees uncommitted changes
END;
/

Theory:
- Lowest isolation level
- Can read uncommitted data (dirty read)
- Rarely used
- Fastest performance

-- Level 2: READ COMMITTED (Default in Oracle)
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
BEGIN
    SELECT * FROM employees WHERE emp_id = 1;  -- Sees only committed data
END;
/

Theory:
- Default in Oracle
- Cannot see uncommitted changes
- Can have non-repeatable reads
- Non-serializable

-- Level 3: REPEATABLE READ
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN
    SELECT * FROM employees WHERE emp_id = 1;  -- First read
    -- Other transaction cannot update this row
    SELECT * FROM employees WHERE emp_id = 1;  -- Same data guaranteed
END;
/

Theory:
- Row-level consistency
- Prevents non-repeatable reads
- Phantom reads possible
- Medium isolation

-- Level 4: SERIALIZABLE (Highest)
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
BEGIN
    SELECT * FROM employees WHERE dept_id = 10;  -- First range read
    -- Other transaction cannot insert/update/delete rows in range
    SELECT * FROM employees WHERE dept_id = 10;  -- Exact same result set
END;
/

Theory:
- Highest isolation level
- Prevents phantom reads
- Transactions execute serially
- Highest overhead
```

#### Lock Types & Mechanisms

```sql
-- Implicit lock (Row-level)
BEGIN
    -- Automatically locked when updated
    UPDATE employees SET salary = 60000 WHERE emp_id = 1;
    
    -- Try to update same row from another session -> WAIT
    -- Lock released on COMMIT or ROLLBACK
    COMMIT;
END;
/

-- Explicit lock - FOR UPDATE
BEGIN
    SELECT * FROM employees WHERE emp_id = 1 FOR UPDATE;
    -- Row locked, no other session can update
    
    -- Other updates possible
    UPDATE employees SET salary = 60000 WHERE emp_id = 1;
    
    COMMIT;  -- Lock released
END;
/

-- NOWAIT option (no blocking)
BEGIN
    SELECT * FROM employees WHERE emp_id = 1 
    FOR UPDATE NOWAIT;
    -- If row locked by another session, immediately fail
    -- Instead of waiting
END;
/

-- WAIT with timeout
BEGIN
    SELECT * FROM employees WHERE emp_id = 1 
    FOR UPDATE WAIT 5;
    -- Wait max 5 seconds for lock
    -- Then fail if still locked
END;
/

Deadlock Resolution:
```sql
-- Deadlock example
SESSION 1:
BEGIN
    UPDATE accounts SET balance = balance - 100 WHERE acc_id = 1;
    -- Lock account 1
    DBMS_LOCK.sleep(2);  -- Wait 2 seconds
    UPDATE accounts SET balance = balance + 100 WHERE acc_id = 2;
    -- Try to lock account 2 - DEADLOCK
END;

SESSION 2:
BEGIN
    UPDATE accounts SET balance = balance + 100 WHERE acc_id = 2;
    -- Lock account 2
    DBMS_LOCK.sleep(2);
    UPDATE accounts SET balance = balance - 100 WHERE acc_id = 1;
    -- Try to lock account 1 - DEADLOCK
END;

-- Solution: Always acquire locks in same order
BEGIN
    UPDATE accounts SET balance = balance - 100 WHERE acc_id = 1;
    UPDATE accounts SET balance = balance + 100 WHERE acc_id = 2;
    COMMIT;
END;

BEGIN
    UPDATE accounts SET balance = balance - 100 WHERE acc_id = 1;
    UPDATE accounts SET balance = balance + 100 WHERE acc_id = 2;
    COMMIT;
END;
```

