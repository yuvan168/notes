    WHERE status = 'ACTIVE' AND wait_time > 60000;
    
    IF v_alert_sessions > 0 THEN
        DBMS_OUTPUT.PUT_LINE('ALERT: ' || v_alert_sessions || 
                           ' sessions waiting > 1 minute');
