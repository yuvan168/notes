### Real-World Scenario 3: Financial Transaction Processing

#### Transaction Workflow

```sql
-- Accounts table
CREATE TABLE accounts (
    account_id NUMBER PRIMARY KEY,
    account_holder VARCHAR2(100) NOT NULL,
    account_type VARCHAR2(20),
    balance NUMBER(15,2) NOT NULL DEFAULT 0,
    created_date DATE DEFAULT SYSDATE
);

-- Transactions table
CREATE TABLE transactions (
    transaction_id NUMBER PRIMARY KEY,
    from_account_id NUMBER REFERENCES accounts(account_id),
    to_account_id NUMBER REFERENCES accounts(account_id),
    amount NUMBER(15,2) NOT NULL,
    transaction_type VARCHAR2(20),
    status VARCHAR2(20) DEFAULT 'PENDING',
    transaction_date DATE DEFAULT SYSDATE,
    completed_date DATE,
    notes VARCHAR2(200)
);

-- Create sequences
CREATE SEQUENCE acct_seq START WITH 1000 INCREMENT BY 1;
CREATE SEQUENCE txn_seq START WITH 1 INCREMENT BY 1;

-- Money transfer with proper transaction handling
CREATE OR REPLACE PROCEDURE transfer_money (
    p_from_account IN NUMBER,
    p_to_account IN NUMBER,
    p_amount IN NUMBER,
    p_transaction_id OUT NUMBER
) IS
    v_from_balance NUMBER(15,2);
    v_to_balance NUMBER(15,2);
    v_txn_id NUMBER;
    SAVEPOINT before_transfer;
BEGIN
    -- Start transaction
    SAVEPOINT before_transfer;
    
    -- Validate amount
    IF p_amount <= 0 THEN
        RAISE_APPLICATION_ERROR(-20001, 'Amount must be positive');
    END IF;
    
    -- Lock source account FOR UPDATE
    SELECT balance INTO v_from_balance FROM accounts
    WHERE account_id = p_from_account FOR UPDATE;
    
    -- Check sufficient balance
    IF v_from_balance < p_amount THEN
        RAISE_APPLICATION_ERROR(-20002, 'Insufficient balance');
    END IF;
    
    -- Get transaction ID
    SELECT txn_seq.NEXTVAL INTO v_txn_id FROM dual;
    
    -- Debit from account
    UPDATE accounts SET balance = balance - p_amount
    WHERE account_id = p_from_account;
    
    -- Lock destination account
    SELECT balance INTO v_to_balance FROM accounts
    WHERE account_id = p_to_account FOR UPDATE;
    
    -- Credit to account
    UPDATE accounts SET balance = balance + p_amount
    WHERE account_id = p_to_account;
    
    -- Record transaction
    INSERT INTO transactions (
        transaction_id, from_account_id, to_account_id,
        amount, transaction_type, status, completed_date
    ) VALUES (
        v_txn_id, p_from_account, p_to_account,
        p_amount, 'TRANSFER', 'COMPLETED', SYSDATE
    );
    
    COMMIT;
    p_transaction_id := v_txn_id;
    DBMS_OUTPUT.PUT_LINE('Transfer successful. TXN ID: ' || v_txn_id);
    
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK TO before_transfer;
        RAISE_APPLICATION_ERROR(-20999, 'Transfer failed: ' || SQLERRM);
END transfer_money;
/
```

