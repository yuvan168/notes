### 11. WINDOW FUNCTIONS - ADVANCED PATTERNS

#### Window Function Framework

```sql
-- Syntax: func() OVER (PARTITION BY ... ORDER BY ... frame)

-- ROW_NUMBER: Unique number per row
SELECT 
    emp_name,
    salary,
    dept_id,
    ROW_NUMBER() OVER (PARTITION BY dept_id ORDER BY salary DESC) as rank_in_dept
FROM employees;

/* Output:
emp_name | salary | dept_id | rank_in_dept
John     | 90000  | 10      | 1
Jane     | 80000  | 10      | 2
Bob      | 95000  | 20      | 1
*/

-- RANK: Rank with gaps
SELECT 
    emp_name,
    salary,
    RANK() OVER (ORDER BY salary DESC) as rank
FROM employees;

/* Output:
emp_name | salary | rank
John     | 90000  | 1
John     | 90000  | 1     <- Same rank
Alice    | 85000  | 3     <- Gap after tie
*/

-- DENSE_RANK: Rank without gaps
SELECT 
    emp_name,
    salary,
    DENSE_RANK() OVER (ORDER BY salary DESC) as dense_rank
FROM employees;

/* Output:
emp_name | salary | dense_rank
John     | 90000  | 1
John     | 90000  | 1
Alice    | 85000  | 2     <- No gap
*/

-- LAG/LEAD: Previous/Next row values
SELECT 
    emp_name,
    hire_date,
    salary,
    LAG(salary) OVER (ORDER BY hire_date) as prev_emp_salary,
    LEAD(salary) OVER (ORDER BY hire_date) as next_emp_salary
FROM employees;

-- Running total
SELECT 
    order_date,
    amount,
    SUM(amount) OVER (ORDER BY order_date 
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as running_total
FROM orders;

-- Moving average
SELECT 
    order_date,
    amount,
    ROUND(AVG(amount) OVER (ORDER BY order_date 
        ROWS BETWEEN 3 PRECEDING AND CURRENT ROW), 2) as moving_avg_4days
FROM orders;

Key Points:
- PARTITION BY divides data into groups
- ORDER BY sorts within partition
- Frame clause defines range (ROWS BETWEEN)
- Computed after WHERE, before ORDER BY
```

