    WHERE status = 'INVALID';
    
    IF v_alert_sessions > 0 THEN
        DBMS_OUTPUT.PUT_LINE('ALERT: ' || v_alert_sessions || 
                           ' invalid objects found');
    END IF;
    
    DBMS_OUTPUT.PUT_LINE('Health check completed');
END database_health_check;
