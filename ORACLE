-- Step 4: Migrate data
BEGIN
    -- Clear target tables
    DELETE FROM employees;
    DELETE FROM departments;
    
    -- Copy from backup
    INSERT INTO departments SELECT * FROM departments_backup;
    INSERT INTO employees SELECT * FROM employees_backup;
    
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Migration completed successfully');
    
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        DBMS_OUTPUT.PUT_LINE('Migration failed: ' || SQLERRM);
END;
