    FROM products WHERE product_id = p_product_id;
    
    IF v_stock_available < p_quantity THEN
        RAISE_APPLICATION_ERROR(-20002, 
            'Insufficient stock. Available: ' || v_stock_available);
    END IF;
    
    -- Get unit price
    SELECT price INTO v_unit_price
    FROM products WHERE product_id = p_product_id;
    
    -- Calculate line total
    v_line_total := p_quantity * v_unit_price * 
                   (1 - p_discount_percent / 100);
    
    -- Insert order item
    INSERT INTO order_items (
        order_item_id, order_id, product_id, quantity,
        unit_price, discount_percent, line_total
    ) VALUES (
        ord_item_seq.NEXTVAL, p_order_id, p_product_id, p_quantity,
        v_unit_price, p_discount_percent, v_line_total
    );
    
    -- Reduce stock
    UPDATE products
    SET quantity_in_stock = quantity_in_stock - p_quantity
    WHERE product_id = p_product_id;
    
    -- Update order total
    UPDATE orders
    SET total_amount = (SELECT SUM(line_total) FROM order_items 
                       WHERE order_id = p_order_id)
    WHERE order_id = p_order_id;
    
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Item added to order');
    
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE_APPLICATION_ERROR(-20999, 'Error: ' || SQLERRM);
END add_order_item;
/

-- Complete order
CREATE OR REPLACE PROCEDURE complete_order (
    p_order_id IN NUMBER,
    p_ship_date IN DATE
) IS
BEGIN
    UPDATE orders
    SET status = 'COMPLETED',
        ship_date = p_ship_date
    WHERE order_id = p_order_id;
    
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Order completed and ready to ship');
    
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE_APPLICATION_ERROR(-20999, 'Error: ' || SQLERRM);
END complete_order;
/
