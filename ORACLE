## PL/SQL

### Basic Structure
```sql
DECLARE
    -- Variable declarations
    v_emp_name VARCHAR2(50);
    v_salary NUMBER;
    CURSOR c_emp IS SELECT * FROM employees;
BEGIN
    -- Executable statements
    SELECT emp_name, salary INTO v_emp_name, v_salary
    FROM employees WHERE emp_id = 1;
    
    DBMS_OUTPUT.PUT_LINE('Name: ' || v_emp_name);
    DBMS_OUTPUT.PUT_LINE('Salary: ' || v_salary);
    
EXCEPTION
    -- Exception handling
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Employee not found');
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
END;
/
```

### Variable Declaration
```sql
DECLARE
    -- Scalar variables
    v_name VARCHAR2(50);
    v_salary NUMBER(10,2) := 50000;
    v_date DATE := SYSDATE;
    
    -- Table and record types
    TYPE emp_record IS RECORD (
        emp_id NUMBER,
        emp_name VARCHAR2(50),
        salary NUMBER
    );
    v_emp emp_record;
    
    -- Collections
    TYPE emp_table IS TABLE OF emp_record;
    v_emp_list emp_table;
BEGIN
    -- Code
END;
/
```

### Procedures
```sql
-- Create procedure
CREATE OR REPLACE PROCEDURE raise_salary (
    p_emp_id IN NUMBER,
    p_percent IN NUMBER DEFAULT 10
) IS
    v_salary NUMBER;
BEGIN
    SELECT salary INTO v_salary FROM employees 
    WHERE emp_id = p_emp_id;
    
    UPDATE employees 
    SET salary = salary * (1 + p_percent/100)
    WHERE emp_id = p_emp_id;
    
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Salary raised by ' || p_percent || '%');
    
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Employee not found');
END raise_salary;
/

-- Call procedure
BEGIN
    raise_salary(1, 15);
END;
/

EXEC raise_salary(1, 15);
```

### Functions
```sql
CREATE OR REPLACE FUNCTION get_emp_bonus (
    p_emp_id IN NUMBER
) RETURN NUMBER IS
    v_salary NUMBER;
    v_bonus NUMBER;
BEGIN
    SELECT salary INTO v_salary 
    FROM employees 
    WHERE emp_id = p_emp_id;
    
    v_bonus := CASE
        WHEN v_salary >= 100000 THEN v_salary * 0.20
        WHEN v_salary >= 50000 THEN v_salary * 0.15
        ELSE v_salary * 0.10
    END;
    
    RETURN v_bonus;
    
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(-20001, 'Employee not found');
END get_emp_bonus;
/

-- Call function
SELECT emp_name, get_emp_bonus(emp_id) as bonus
FROM employees;
```

### Packages
```sql
-- Package specification
CREATE OR REPLACE PACKAGE emp_pkg IS
    PROCEDURE hire_employee(p_name VARCHAR2, p_salary NUMBER);
    FUNCTION get_salary(p_emp_id NUMBER) RETURN NUMBER;
END emp_pkg;
/

-- Package body
CREATE OR REPLACE PACKAGE BODY emp_pkg IS
    PROCEDURE hire_employee(p_name VARCHAR2, p_salary NUMBER) IS
    BEGIN
        INSERT INTO employees (emp_id, emp_name, salary)
        VALUES (emp_seq.NEXTVAL, p_name, p_salary);
        COMMIT;
    END hire_employee;
    
    FUNCTION get_salary(p_emp_id NUMBER) RETURN NUMBER IS
        v_salary NUMBER;
    BEGIN
        SELECT salary INTO v_salary FROM employees 
        WHERE emp_id = p_emp_id;
        RETURN v_salary;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN RETURN NULL;
    END get_salary;
END emp_pkg;
/

-- Call package
EXEC emp_pkg.hire_employee('Alice', 60000);
SELECT emp_pkg.get_salary(1) FROM dual;
```

### Triggers
```sql
-- BEFORE INSERT trigger
CREATE OR REPLACE TRIGGER employees_bi
BEFORE INSERT ON employees
FOR EACH ROW
BEGIN
    :NEW.hire_date := SYSDATE;
    :NEW.emp_id := emp_seq.NEXTVAL;
END;
/

-- AFTER UPDATE trigger
CREATE OR REPLACE TRIGGER employees_au
AFTER UPDATE ON employees
FOR EACH ROW
BEGIN
    INSERT INTO salary_history (emp_id, old_salary, new_salary, change_date)
    VALUES (:OLD.emp_id, :OLD.salary, :NEW.salary, SYSDATE);
END;
/

-- Enable/Disable trigger
ALTER TRIGGER employees_bi ENABLE;
ALTER TRIGGER employees_bi DISABLE;

-- Drop trigger
DROP TRIGGER employees_bi;
```

### Cursors
```sql
-- Explicit cursor
DECLARE
    CURSOR c_employees IS
        SELECT emp_id, emp_name, salary FROM employees
        WHERE dept_id = 10
        ORDER BY salary DESC;
    
    v_emp_record c_employees%ROWTYPE;
BEGIN
    OPEN c_employees;
    LOOP
        FETCH c_employees INTO v_emp_record;
        EXIT WHEN c_employees%NOTFOUND;
        
        DBMS_OUTPUT.PUT_LINE(v_emp_record.emp_name || ': ' || 
                           v_emp_record.salary);
    END LOOP;
    CLOSE c_employees;
END;
/

-- Implicit cursor with FOR loop
BEGIN
    FOR emp_record IN (SELECT emp_id, emp_name FROM employees)
    LOOP
        DBMS_OUTPUT.PUT_LINE(emp_record.emp_name);
    END LOOP;
END;
/

-- Cursor with parameters
CREATE OR REPLACE PROCEDURE show_dept_employees (
    p_dept_id IN NUMBER
) IS
    CURSOR c_emp (p_dept_id NUMBER) IS
        SELECT emp_name, salary FROM employees
        WHERE dept_id = p_dept_id;
BEGIN
    FOR emp IN c_emp(p_dept_id)
    LOOP
        DBMS_OUTPUT.PUT_LINE(emp.emp_name || ': ' || emp.salary);
    END LOOP;
END;
/
```

### Exception Handling
```sql
DECLARE
    v_salary NUMBER;
    v_emp_id NUMBER := 999;
BEGIN
    SELECT salary INTO v_salary FROM employees 
    WHERE emp_id = v_emp_id;
    
EXCEPTION
