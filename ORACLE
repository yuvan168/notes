## Advanced SQL

### Joins

#### INNER JOIN
```sql
SELECT e.emp_name, d.dept_name, e.salary
FROM employees e
INNER JOIN departments d ON e.dept_id = d.dept_id;
```

#### LEFT JOIN
```sql
SELECT e.emp_name, d.dept_name
FROM employees e
LEFT JOIN departments d ON e.dept_id = d.dept_id;
```

#### RIGHT JOIN
```sql
SELECT e.emp_name, d.dept_name
FROM employees e
RIGHT JOIN departments d ON e.dept_id = d.dept_id;
```

#### FULL OUTER JOIN
```sql
SELECT e.emp_name, d.dept_name
FROM employees e
FULL OUTER JOIN departments d ON e.dept_id = d.dept_id;
```

#### CROSS JOIN
```sql
SELECT e.emp_name, d.dept_name
FROM employees e
CROSS JOIN departments d;
```

#### SELF JOIN
```sql
SELECT e1.emp_name as employee, e2.emp_name as manager
FROM employees e1
LEFT JOIN employees e2 ON e1.manager_id = e2.emp_id;
```

### Subqueries

#### Scalar Subquery
```sql
SELECT emp_name, salary,
       (SELECT AVG(salary) FROM employees) as avg_salary
FROM employees;
```

#### IN Subquery
```sql
SELECT emp_name, salary
FROM employees
WHERE dept_id IN (SELECT dept_id FROM departments 
                  WHERE location = 'New York');
```

#### EXISTS Subquery
```sql
SELECT emp_name
FROM employees e
WHERE EXISTS (SELECT 1 FROM projects p 
              WHERE p.emp_id = e.emp_id);
```

#### Correlated Subquery
```sql
SELECT emp_name, salary
FROM employees e1
WHERE salary > (SELECT AVG(salary) FROM employees e2 
                WHERE e1.dept_id = e2.dept_id);
```

### Set Operations

#### UNION (removes duplicates)
```sql
SELECT emp_name FROM employees
UNION
SELECT emp_name FROM archived_employees;
```

#### UNION ALL (keeps duplicates)
```sql
SELECT emp_name FROM employees
UNION ALL
SELECT emp_name FROM archived_employees;
```

#### INTERSECT (common records)
```sql
SELECT emp_name FROM employees
INTERSECT
SELECT emp_name FROM project_members;
```

#### MINUS (difference)
```sql
SELECT emp_name FROM employees
MINUS
SELECT emp_name FROM inactive_employees;
```

### Window Functions

#### ROW_NUMBER
```sql
SELECT emp_name, salary, dept_id,
       ROW_NUMBER() OVER (PARTITION BY dept_id ORDER BY salary DESC) as rank
FROM employees;
```

#### RANK
```sql
SELECT emp_name, salary,
       RANK() OVER (ORDER BY salary DESC) as rank
FROM employees;
```

#### DENSE_RANK
```sql
SELECT emp_name, salary,
       DENSE_RANK() OVER (ORDER BY salary DESC) as dense_rank
FROM employees;
```

#### LAG and LEAD
```sql
SELECT emp_name, salary,
       LAG(salary, 1, 0) OVER (ORDER BY salary) as previous_salary,
       LEAD(salary, 1, 0) OVER (ORDER BY salary) as next_salary
FROM employees;
```

#### SUM Window Function
```sql
SELECT emp_name, salary,
       SUM(salary) OVER (ORDER BY salary 
           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as running_total
FROM employees;
```

### CTE (Common Table Expression)

#### Simple CTE
```sql
WITH emp_salaries AS (
    SELECT emp_id, emp_name, salary,
           AVG(salary) OVER () as avg_sal
    FROM employees
)
SELECT * FROM emp_salaries
WHERE salary > avg_sal;
```

#### Recursive CTE
```sql
WITH RECURSIVE org_chart AS (
    -- Base case: CEO
    SELECT emp_id, emp_name, manager_id, 1 as level
    FROM employees
    WHERE manager_id IS NULL
    
    UNION ALL
    
    -- Recursive case
    SELECT e.emp_id, e.emp_name, e.manager_id, oc.level + 1
    FROM employees e
    INNER JOIN org_chart oc ON e.manager_id = oc.emp_id
)
SELECT * FROM org_chart
ORDER BY level, emp_id;
```

### CASE Expression
```sql
-- Simple CASE
SELECT emp_name, salary,
       CASE dept_id
           WHEN 10 THEN 'Sales'
           WHEN 20 THEN 'IT'
           WHEN 30 THEN 'HR'
           ELSE 'Other'
       END as dept_name
FROM employees;

-- Searched CASE
SELECT emp_name, salary,
       CASE
           WHEN salary >= 100000 THEN 'Senior'
           WHEN salary >= 50000 THEN 'Mid'
           ELSE 'Junior'
       END as level
FROM employees;
```

