## SQL Basics

### Data Types

| Type | Description | Example |
|------|-------------|---------|
| VARCHAR2(n) | Variable character | 'John' |
| CHAR(n) | Fixed character | 'M' |
| NUMBER(p,s) | Numeric | 150, 99.99 |
| INTEGER | Whole number | 100 |
| DATE | Date and time | 01-JAN-2025 |
| TIMESTAMP | High precision date | 01-JAN-2025 14:30:45.123456 |
| CLOB | Large text | Documents |
| BLOB | Binary data | Images |
| BOOLEAN | True/False | TRUE |

### Create Table
```sql
CREATE TABLE employees (
    emp_id NUMBER PRIMARY KEY,
    emp_name VARCHAR2(50) NOT NULL,
    salary NUMBER(10,2),
    hire_date DATE DEFAULT SYSDATE,
    dept_id NUMBER REFERENCES departments(dept_id)
);
```

### Insert Data
```sql
-- Single row
INSERT INTO employees (emp_id, emp_name, salary, dept_id)
VALUES (1, 'John Doe', 50000, 10);

-- Multiple rows
INSERT INTO employees (emp_id, emp_name, salary, dept_id)
SELECT emp_id, emp_name, salary, dept_id FROM emp_backup;

-- Insert from select
INSERT INTO archive_employees 
SELECT * FROM employees WHERE hire_date < '01-JAN-2020';
```

### Update Data
```sql
-- Update specific records
UPDATE employees 
SET salary = salary * 1.1 
WHERE dept_id = 10;

-- Update with join
UPDATE employees e
SET e.salary = (SELECT avg_salary FROM dept_salaries d 
                WHERE e.dept_id = d.dept_id)
WHERE EXISTS (SELECT 1 FROM dept_salaries d 
              WHERE e.dept_id = d.dept_id);
```

### Delete Data
```sql
-- Delete specific records
DELETE FROM employees 
WHERE emp_id = 5;

-- Delete all records
DELETE FROM employees;

-- Delete with condition
DELETE FROM employees 
WHERE salary < 30000 AND hire_date < '01-JAN-2010';
```

### Select Queries
```sql
-- Basic select
SELECT emp_id, emp_name, salary 
FROM employees;

-- With conditions
SELECT * FROM employees 
WHERE salary > 50000 AND dept_id = 10;

-- With sorting
SELECT emp_name, salary 
FROM employees 
ORDER BY salary DESC;

-- With DISTINCT
SELECT DISTINCT dept_id FROM employees;

-- With LIMIT (rownum)
SELECT * FROM employees 
WHERE ROWNUM <= 10;

-- OFFSET/FETCH (Oracle 12c+)
SELECT * FROM employees 
ORDER BY salary 
OFFSET 10 ROWS FETCH NEXT 10 ROWS ONLY;
```

### Aggregate Functions
```sql
-- COUNT, SUM, AVG, MIN, MAX
SELECT 
    COUNT(*) as total_employees,
    SUM(salary) as total_salary,
    AVG(salary) as avg_salary,
    MIN(salary) as min_salary,
    MAX(salary) as max_salary
FROM employees;

-- GROUP BY
SELECT dept_id, COUNT(*) as emp_count, AVG(salary) as avg_sal
FROM employees
GROUP BY dept_id;

-- HAVING clause
SELECT dept_id, COUNT(*) as emp_count
FROM employees
GROUP BY dept_id
HAVING COUNT(*) > 5;
```

### String Functions
```sql
SELECT 
    UPPER(emp_name) as upper_name,
    LOWER(emp_name) as lower_name,
    LENGTH(emp_name) as name_length,
    SUBSTR(emp_name, 1, 5) as first_5_chars,
    INSTR(emp_name, 'o') as position_of_o,
    REPLACE(emp_name, 'John', 'Jon') as replaced,
    TRIM('  ' || emp_name || '  ') as trimmed,
    CONCAT(emp_name, ' - ', dept_id) as concatenated
FROM employees;
```

### Number Functions
```sql
SELECT 
    ROUND(salary, 0) as rounded,
    TRUNC(salary, -3) as truncated,
    ABS(-100) as absolute,
    MOD(salary, 100) as modulo,
    CEIL(3.2) as ceiling,
    FLOOR(3.9) as floor
FROM employees;
```

### Date Functions
```sql
SELECT 
    SYSDATE as current_date,
    TRUNC(SYSDATE) as today_midnight,
    ADD_MONTHS(SYSDATE, 1) as next_month,
    NEXT_DAY(SYSDATE, 'MONDAY') as next_monday,
    LAST_DAY(SYSDATE) as last_day_of_month,
    MONTHS_BETWEEN(SYSDATE, hire_date) as months_employed,
    TO_DATE('01-JAN-2025', 'DD-MON-YYYY') as specific_date
FROM employees;
```

