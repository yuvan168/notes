**Q27: What is ETL and data loading best practices?**

A:
```
ETL: Extract, Transform, Load

Extract:
-- From various sources
SELECT * FROM legacy_system.employees;
SELECT * FROM csv_file;

Transform:
-- Data validation and manipulation
SELECT 
    emp_id,
    TRIM(emp_name) as emp_name,           -- Clean
    UPPER(email) as email,                 -- Standardize
    CASE WHEN salary > 0 THEN salary       -- Validate
         ELSE 0 END as salary,
    SYSDATE as load_date
FROM source_data;

Load:
-- Into target table
INSERT INTO employees SELECT ...;

ETL Tools:
- Oracle Data Integrator (ODI)
- Informatica
- Talend
- Custom PL/SQL

Best Practices:

1. Staging Table:
   -- Load to temporary table first
   INSERT INTO employees_staging SELECT ...;
   
   -- Validate data
   SELECT COUNT(*) FROM employees_staging 
   WHERE salary < 0;
   
   -- Move to production
   TRUNCATE TABLE employees;
   INSERT INTO employees SELECT * FROM employees_staging;

2. Data Quality Checks:
   -- Before loading
   SELECT COUNT(*), COUNT(DISTINCT emp_id)
   FROM source_data;
   
   -- Check for duplicates
   SELECT emp_id, COUNT(*)
   FROM source_data
   GROUP BY emp_id
   HAVING COUNT(*) > 1;
   
   -- Check for invalid data
   SELECT * FROM source_data
   WHERE email NOT LIKE '%@%.%';

3. Incremental Loading:
   -- Only new/changed data
   MERGE INTO employees t
   USING (SELECT * FROM employees_staging s
          WHERE s.load_date > (SELECT MAX(load_date) 
                               FROM employees)) s
   ON t.emp_id = s.emp_id
   WHEN MATCHED THEN UPDATE SET ...
   WHEN NOT MATCHED THEN INSERT ...;

4. Batch Processing:
   FOR batch IN 1..100 LOOP
       INSERT INTO employees
       SELECT * FROM employees_staging
       WHERE batch_num = batch;
       COMMIT;  -- Commit frequently
   END LOOP;

5. Error Handling:
   BEGIN
       -- ETL process
       INSERT INTO employees SELECT ...;
       COMMIT;
   EXCEPTION
       WHEN DUP_VAL_ON_INDEX THEN
           ROLLBACK;
           INSERT INTO error_log VALUES (SYSDATE, SQLERRM);
       WHEN OTHERS THEN
           ROLLBACK;
           RAISE;
   END;

6. Performance:
   -- Disable constraints temporarily
   ALTER TABLE employees DISABLE CONSTRAINT fk_emp_dept;
   INSERT INTO employees SELECT ...;
   ALTER TABLE employees ENABLE CONSTRAINT fk_emp_dept;
   
   -- Rebuild indexes after large load
   ALTER INDEX idx_emp_name REBUILD;

Typical ETL Pipeline:
```sql
CREATE OR REPLACE PROCEDURE etl_employees IS
    v_start_time TIMESTAMP;
    v_source_count NUMBER;
    v_loaded_count NUMBER;
BEGIN
    v_start_time := SYSTIMESTAMP;
    
    -- Extract
    INSERT INTO emp_staging
    SELECT * FROM legacy_emp_table;
    
    SELECT COUNT(*) INTO v_source_count FROM emp_staging;
    
    -- Transform
    UPDATE emp_staging SET email = LOWER(email);
    DELETE FROM emp_staging WHERE salary < 0;
    
    -- Load
    INSERT INTO employees
    SELECT * FROM emp_staging;
    
    SELECT COUNT(*) INTO v_loaded_count FROM employees;
    
    COMMIT;
    
    DBMS_OUTPUT.PUT_LINE('Loaded ' || v_loaded_count || 
                        ' of ' || v_source_count || ' records');
    DBMS_OUTPUT.PUT_LINE('Duration: ' || 
        (SYSTIMESTAMP - v_start_time));
    
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        INSERT INTO etl_error_log VALUES 
            (SYSDATE, SQLERRM);
        RAISE;
END;
```
