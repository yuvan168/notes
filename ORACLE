CREATE OR REPLACE PROCEDURE database_health_check IS
    v_free_space NUMBER;
    v_total_space NUMBER;
    v_alert_sessions NUMBER;
BEGIN
    -- Check tablespace usage
    SELECT SUM(bytes)/1024/1024/1024 INTO v_total_space
    FROM dba_data_files;
    
