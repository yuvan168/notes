#### Complete Migration Workflow

```sql
-- Step 1: Create backup of old data
CREATE TABLE employees_backup AS SELECT * FROM employees;
CREATE TABLE departments_backup AS SELECT * FROM departments;

-- Step 2: Data validation before migration
CREATE OR REPLACE PROCEDURE validate_migration_data IS
    v_emp_count NUMBER;
    v_dept_count NUMBER;
BEGIN
    -- Count records
    SELECT COUNT(*) INTO v_emp_count FROM employees_backup;
    SELECT COUNT(*) INTO v_dept_count FROM departments_backup;
    
    DBMS_OUTPUT.PUT_LINE('Backup records - Employees: ' || v_emp_count);
    DBMS_OUTPUT.PUT_LINE('Backup records - Departments: ' || v_dept_count);
    
    -- Check for NULL values in required fields
    SELECT COUNT(*) INTO v_emp_count FROM employees_backup
    WHERE emp_name IS NULL OR email IS NULL;
    
    IF v_emp_count > 0 THEN
        DBMS_OUTPUT.PUT_LINE('WARNING: ' || v_emp_count || 
                           ' records with NULL required fields');
    ELSE
        DBMS_OUTPUT.PUT_LINE('All required fields are populated');
    END IF;
END validate_migration_data;
/

-- Step 3: Transform data if needed
CREATE OR REPLACE PROCEDURE transform_employee_data IS
BEGIN
    -- Example: Convert email to lowercase
    UPDATE employees SET email = LOWER(email);
    
    -- Remove duplicate records
    DELETE FROM employees e1
    WHERE ROWID > (SELECT MIN(ROWID) FROM employees e2
                   WHERE e1.emp_id = e2.emp_id);
    
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Data transformation completed');
END transform_employee_data;
