#### Business Logic - Procedures

```sql
-- Hire new employee
CREATE OR REPLACE PROCEDURE hire_employee (
    p_emp_name IN VARCHAR2,
    p_email IN VARCHAR2,
    p_salary IN NUMBER,
    p_dept_id IN NUMBER,
    p_job_title IN VARCHAR2,
    p_emp_id OUT NUMBER
) IS
    v_emp_id NUMBER;
BEGIN
    -- Validate inputs
    IF p_salary <= 0 THEN
        RAISE_APPLICATION_ERROR(-20001, 'Salary must be greater than 0');
    END IF;
    
    IF NOT EXISTS (SELECT 1 FROM departments WHERE dept_id = p_dept_id) THEN
        RAISE_APPLICATION_ERROR(-20002, 'Invalid department ID');
    END IF;
    
    -- Get next employee ID
    SELECT emp_seq.NEXTVAL INTO v_emp_id FROM dual;
    
    -- Insert employee
    INSERT INTO employees (
        emp_id, emp_name, email, salary, dept_id, 
        job_title, hire_date
    ) VALUES (
        v_emp_id, p_emp_name, p_email, p_salary, p_dept_id,
        p_job_title, SYSDATE
    );
    
    -- Return new emp_id
    p_emp_id := v_emp_id;
    
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Employee ' || p_emp_name || ' hired successfully');
    
EXCEPTION
    WHEN DUP_VAL_ON_INDEX THEN
        ROLLBACK;
        RAISE_APPLICATION_ERROR(-20003, 'Email already exists');
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE_APPLICATION_ERROR(-20999, 'Error hiring employee: ' || SQLERRM);
END hire_employee;
/

-- Give salary increase
CREATE OR REPLACE PROCEDURE raise_salary (
    p_emp_id IN NUMBER,
    p_increase_percent IN NUMBER
) IS
    v_old_salary NUMBER;
    v_new_salary NUMBER;
BEGIN
    -- Get current salary
    SELECT salary INTO v_old_salary 
    FROM employees 
    WHERE emp_id = p_emp_id;
    
    -- Calculate new salary
    v_new_salary := v_old_salary * (1 + p_increase_percent / 100);
    
    -- Update salary
    UPDATE employees 
    SET salary = v_new_salary, modified_date = SYSDATE
    WHERE emp_id = p_emp_id;
    
    -- Record history
    INSERT INTO salary_history (
        history_id, emp_id, old_salary, new_salary, 
        change_reason, changed_by
    ) VALUES (
        sal_hist_seq.NEXTVAL, p_emp_id, v_old_salary, v_new_salary,
        'Salary increase: ' || p_increase_percent || '%',
        USER
    );
    
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Salary updated from ' || v_old_salary || 
                        ' to ' || v_new_salary);
    
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(-20004, 'Employee not found');
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE_APPLICATION_ERROR(-20999, 'Error: ' || SQLERRM);
END raise_salary;
/

-- Record attendance
CREATE OR REPLACE PROCEDURE record_attendance (
    p_emp_id IN NUMBER,
    p_attendance_date IN DATE,
    p_check_in IN VARCHAR2,
    p_check_out IN VARCHAR2,
    p_status IN VARCHAR2
) IS
    v_hours_worked NUMBER(5,2);
BEGIN
    -- Calculate hours worked
    IF p_check_in IS NOT NULL AND p_check_out IS NOT NULL THEN
        v_hours_worked := (TO_DATE(p_check_out, 'HH24:MI') - 
                          TO_DATE(p_check_in, 'HH24:MI')) * 24;
    ELSE
        v_hours_worked := 0;
    END IF;
    
    -- Insert or update attendance
    MERGE INTO attendance a
    USING DUAL
    ON (a.emp_id = p_emp_id AND a.attendance_date = p_attendance_date)
    WHEN MATCHED THEN
        UPDATE SET
            a.check_in = p_check_in,
            a.check_out = p_check_out,
            a.hours_worked = v_hours_worked,
            a.status = p_status
    WHEN NOT MATCHED THEN
        INSERT (
            attendance_id, emp_id, attendance_date, 
            check_in, check_out, hours_worked, status
        ) VALUES (
            attend_seq.NEXTVAL, p_emp_id, p_attendance_date,
            p_check_in, p_check_out, v_hours_worked, p_status
        );
    
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Attendance recorded successfully');
    
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE_APPLICATION_ERROR(-20999, 'Error: ' || SQLERRM);
END record_attendance;
/
```

