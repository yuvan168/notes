## Design Patterns in PHP

### Pattern 1: Singleton

```php
<?php
// Problem: Ensure only one instance of class
class Database {
    private static $instance = null;
    private $connection;
    
    // Private constructor prevents instantiation
    private function __construct() {
        $this->connection = new PDO(...);
    }
    
    // Static method to get instance
    public static function getInstance() {
        if (self::$instance === null) {
            self::$instance = new self();
        }
        return self::$instance;
    }
    
    // Prevent cloning
    private function __clone() {}
    
    // Prevent serialization
    private function __sleep() {}
}

// Usage
$db1 = Database::getInstance();
$db2 = Database::getInstance();
assert($db1 === $db2);  // Same instance
?>
```

**When to use:** Database connections, configuration managers, logging

### Pattern 2: Factory Method

```php
<?php
// Problem: Create objects without specifying exact classes
abstract class Transport {
    abstract public function deliver($package);
}

class Truck extends Transport {
    public function deliver($package) {
        return "Delivering by truck: $package";
    }
}

class Ship extends Transport {
    public function deliver($package) {
        return "Delivering by ship: $package";
    }
}

class Airplane extends Transport {
    public function deliver($package) {
        return "Delivering by airplane: $package";
    }
}

class Logistics {
    public static function createTransport($type) {
        return match($type) {
            'truck' => new Truck(),
            'ship' => new Ship(),
            'airplane' => new Airplane(),
            default => throw new InvalidArgumentException("Unknown transport")
        };
    }
}

$transport = Logistics::createTransport('truck');
echo $transport->deliver('Package');
?>
```

**When to use:** Creating objects with different implementations, plugin systems

### Pattern 3: Observer (Event-Driven)

```php
<?php
// Problem: Notify multiple objects about state changes
interface Observer {
    public function update(Subject $subject);
}

class Subject {
    private $observers = [];
    private $state;
    
    public function attach(Observer $observer) {
        $this->observers[] = $observer;
    }
    
    public function detach(Observer $observer) {
        $this->observers = array_filter(
            $this->observers,
            fn($o) => $o !== $observer
        );
    }
    
    public function notify() {
        foreach ($this->observers as $observer) {
            $observer->update($this);
        }
    }
    
    public function setState($state) {
        $this->state = $state;
        $this->notify();
    }
    
    public function getState() {
        return $this->state;
    }
}

class Logger implements Observer {
    public function update(Subject $subject) {
        echo "Logging state: " . $subject->getState() . "\n";
    }
}

class EmailNotifier implements Observer {
    public function update(Subject $subject) {
        echo "Sending email about: " . $subject->getState() . "\n";
    }
}

$subject = new Subject();
$subject->attach(new Logger());
$subject->attach(new EmailNotifier());
$subject->setState("New order placed");
// Outputs:
// Logging state: New order placed
// Sending email about: New order placed
?>
```

**When to use:** Event systems, MVC frameworks, real-time notifications

### Pattern 4: Decorator

```php
<?php
// Problem: Add functionality to objects dynamically
interface Coffee {
    public function cost();
    public function description();
}

class SimpleCoffee implements Coffee {
    public function cost() {
        return 2.0;
    }
    
    public function description() {
        return "Simple coffee";
    }
}

// Abstract decorator
abstract class CoffeeDecorator implements Coffee {
    protected $coffee;
    
    public function __construct(Coffee $coffee) {
        $this->coffee = $coffee;
    }
}

class Milk extends CoffeeDecorator {
    public function cost() {
        return $this->coffee->cost() + 0.5;
    }
    
    public function description() {
        return $this->coffee->description() . ", milk";
    }
}

class Caramel extends CoffeeDecorator {
    public function cost() {
        return $this->coffee->cost() + 0.75;
    }
    
    public function description() {
        return $this->coffee->description() . ", caramel";
    }
}

$coffee = new SimpleCoffee();                    // $2.00
$coffee = new Milk($coffee);                    // $2.50
$coffee = new Caramel($coffee);                 // $3.25
echo $coffee->description();                    // "Simple coffee, milk, caramel"
echo $coffee->cost();                           // 3.25
?>
```

**When to use:** Adding features to objects, middleware pipelines, logging/caching wrappers

### Pattern 5: Strategy

```php
<?php
// Problem: Switch between different algorithms at runtime
interface PaymentStrategy {
    public function pay($amount);
}

class CreditCardPayment implements PaymentStrategy {
    private $cardNumber;
    
    public function __construct($cardNumber) {
        $this->cardNumber = $cardNumber;
    }
    
    public function pay($amount) {
        return "Paid $amount using card: {$this->cardNumber}";
    }
}

class PayPalPayment implements PaymentStrategy {
    private $email;
    
    public function __construct($email) {
        $this->email = $email;
    }
    
    public function pay($amount) {
        return "Paid $amount using PayPal: {$this->email}";
    }
}

