    ['id' => 1, 'name' => 'John', 'age' => 30],
    ['id' => 2, 'name' => 'Alice', 'age' => 25],
    ['id' => 3, 'name' => 'Bob', 'age' => 35],
];
$names = array_column($users, 'name');
// ['John', 'Alice', 'Bob']

// Index by another column
$indexed = array_column($users, null, 'id');
// [1 => [...], 2 => [...], 3 => [...]]

