**Sample Senior Task:**
```php
<?php
// Design scalable microservice architecture

namespace App\Services\Architecture;

/**
 * Event-driven order processing system
 * - Handles high-volume transactions
 * - Ensures data consistency across services
 * - Implements circuit breakers & resilience
 */

class OrderService {
    private $eventBus;
    private $cache;
    private $circuitBreaker;
    
    public function __construct(
        EventBus $eventBus,
        Cache $cache,
        CircuitBreaker $circuitBreaker
    ) {
        $this->eventBus = $eventBus;
        $this->cache = $cache;
        $this->circuitBreaker = $circuitBreaker;
    }
    
    public function createOrder(OrderRequest $request) {
        try {
            // Start transaction
            DB::transaction(function() use ($request) {
                $order = Order::create($request->validated());
                
                // Emit event for async processing
                $this->eventBus->publish('order.created', $order);
                
                // Warm cache for quick retrieval
                $this->cache->put(
                    "order.{$order->id}",
                    $order,
                    3600
                );
                
                return $order;
            });
            
        } catch (Exception $e) {
            // Circuit breaker pattern
            if ($this->circuitBreaker->isOpen()) {
                throw new ServiceUnavailableException();
            }
            throw $e;
        }
    }
}

// Real-world: Handle millions of orders/day
// - Message queue workers process async tasks
// - Read replicas for reports
// - Caching layers for hot data
// - Monitoring and alerting
?>
