    }
}

$order = new Order();
$order->setPaymentStrategy(new CreditCardPayment("1234-5678"));
echo $order->checkout(100);     // Using credit card

$order->setPaymentStrategy(new PayPalPayment("user@example.com"));
echo $order->checkout(100);     // Using PayPal
?>
