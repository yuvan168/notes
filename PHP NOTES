        try {
            // Cache query results
            $products = $this->cache->remember(
                'products_list',
                self::CACHE_TTL,
                function() {
                    return Product::with('category')
                        ->select(['id', 'name', 'price', 'category_id'])
                        ->active()
                        ->orderByDesc('updated_at')
                        ->paginate(20);
