### Problem 3: Implement Simple Cache

```php
<?php
class SimpleCache {
    private $cache = [];
    private $ttl_map = [];
    
    public function set($key, $value, $ttl = 3600) {
        $this->cache[$key] = $value;
        $this->ttl_map[$key] = time() + $ttl;
    }
    
    public function get($key) {
        if (!isset($this->cache[$key])) {
            return null;
        }
        
        if (time() > $this->ttl_map[$key]) {
            unset($this->cache[$key]);
            unset($this->ttl_map[$key]);
            return null;
        }
        
        return $this->cache[$key];
    }
    
    public function clear() {
        $this->cache = [];
        $this->ttl_map = [];
    }
}

$cache = new SimpleCache();
$cache->set('user_1', ['name' => 'John'], 3600);
echo $cache->get('user_1')['name'];  // "John"
?>
