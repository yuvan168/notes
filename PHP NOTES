### Higher-Order Functions

```php
<?php
// Function that takes/returns functions
function compose(...$functions) {
    return function($value) use ($functions) {
        foreach (array_reverse($functions) as $fn) {
            $value = $fn($value);
        }
        return $value;
    };
}

$add5 = fn($x) => $x + 5;
$multiply2 = fn($x) => $x * 2;
$squared = fn($x) => $x * $x;

// Compose functions: squared(multiply2(add5(x)))
$pipeline = compose($add5, $multiply2, $squared);
echo $pipeline(3);  // (3+5)*2^2 = 256

// Map/Filter/Reduce chaining
$data = [1, 2, 3, 4, 5];
$result = array_reduce(
    array_filter(
        array_map(fn($x) => $x * 2, $data),
        fn($x) => $x > 4
    ),
    fn($carry, $item) => $carry + $item,
    0
);
// [2,4,6,8,10] -> [6,8,10] -> 24

// Partial application
function partial(callable $fn, ...$args) {
    return function(...$moreArgs) use ($fn, $args) {
        return $fn(...$args, ...$moreArgs);
    };
}

function greet($greeting, $name) {
    return "$greeting, $name!";
}

$sayHello = partial('greet', 'Hello');
echo $sayHello('John');         // "Hello, John!"
