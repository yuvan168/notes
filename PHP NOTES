### Q15: Common PHP mistakes and how to avoid them

**Answer:**
```php
<?php
// Mistake 1: Not checking if array key exists
// ❌ WRONG
$name = $array['name'];  // Warning: Undefined array key 'name'

// ✅ RIGHT
$name = $array['name'] ?? 'Unknown';
$name = isset($array['name']) ? $array['name'] : 'Unknown';
$name = $array['name'] ?? null;

// Mistake 2: Forgetting to close database connections
// ❌ WRONG
$stmt = $pdo->prepare("SELECT * FROM users");
$stmt->execute();
// Connection not properly released

// ✅ RIGHT
$stmt = $pdo->prepare("SELECT * FROM users");
$stmt->execute();
$result = $stmt->fetch();
$stmt = null;  // Close statement

// Mistake 3: Using $this outside of class context
// ❌ WRONG
function helper() {
    echo $this->name;  // Error outside class
}

// ✅ RIGHT
class Helper {
    public function process() {
        echo $this->name;  // OK inside class
    }
}

// Mistake 4: Type juggling in conditions
// ❌ WRONG
if ($count == 0) {
    // Also true if $count = "0" or "0abc"
}

// ✅ RIGHT
if ($count === 0) {
    // Only true for integer 0
}

// Mistake 5: Not validating user input
// ❌ WRONG
$email = $_POST['email'];
$db->query("SELECT * FROM users WHERE email = '$email'");
// SQL injection vulnerability!

// ✅ RIGHT
$email = $_POST['email'];
if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
    echo "Invalid email";
    exit;
}
$stmt = $db->prepare("SELECT * FROM users WHERE email = ?");
$stmt->execute([$email]);

// Mistake 6: Infinite loops
// ❌ WRONG
while (true) {
    // Forgot break condition
}

// ✅ RIGHT
while ($condition) {
    // Has clear exit condition
    if ($done) {
        break;
    }
}

// Mistake 7: Modifying array while iterating
// ❌ WRONG
foreach ($array as $item) {
    if ($item['delete']) {
        unset($array[$item['id']]);  // Unsafe!
    }
}

// ✅ RIGHT
$array = array_filter($array, fn($item) => !$item['delete']);

// Mistake 8: Not handling exceptions
// ❌ WRONG
$data = json_decode($response);  // May fail
foreach ($data->users as $user) {
    // Crash if $data is null
}

// ✅ RIGHT
try {
    $data = json_decode($response, true);
    if (json_last_error() !== JSON_ERROR_NONE) {
        throw new Exception("Invalid JSON");
    }
} catch (Exception $e) {
    echo "Error: " . $e->getMessage();
}

// Mistake 9: Inconsistent naming conventions
// ❌ WRONG
$userName = "john";
$user_email = "john@example.com";
$userPhone = "555-1234";

// ✅ RIGHT (consistent)
$user_name = "john";
$user_email = "john@example.com";
$user_phone = "555-1234";

// Mistake 10: Hardcoded values
// ❌ WRONG
$host = "localhost";
$db_name = "my_app";
$secret_key = "super_secret";

// ✅ RIGHT (use environment variables)
$host = getenv('DB_HOST');
$db_name = getenv('DB_NAME');
$secret_key = getenv('SECRET_KEY');
?>
```

