### Q13: How do you optimize database queries?

**Answer:**
```php
<?php
// 1. Use indexes on frequently searched columns
// CREATE INDEX idx_email ON users(email);
// CREATE INDEX idx_user_status ON users(status, created_at);

// 2. Avoid SELECT * (specify needed columns)
// ❌ SELECT * FROM users WHERE id = 1;
// ✅ SELECT id, name, email FROM users WHERE id = 1;

// 3. Use WHERE clauses effectively
// ❌ SELECT * FROM users; // Then filter in PHP
// ✅ SELECT * FROM users WHERE age > 18;

// 4. Eager load relationships (prevent N+1)
// ❌ N+1 queries
$users = User::all();
foreach ($users as $user) {
    echo $user->profile->bio;  // Query per user
}

// ✅ Eager loading
$users = User::with('profile')->get();  // 2 queries total

// 5. Limit result set
$results = User::limit(100)->get();

// 6. Use JOINs instead of separate queries
// ❌ Two queries
$user = User::find(1);
$orders = Order::where('user_id', $user->id)->get();

// ✅ One query
$user = User::with('orders')->find(1);

// 7. Add LIMIT to aggregations
$count = User::where('active', true)->count();

// 8. Use database-level aggregation
// ❌ Load all, calculate in PHP
$users = User::all();
$average_age = array_sum(array_column($users, 'age')) / count($users);

// ✅ Database aggregation
$avg = User::avg('age');
$sum = User::sum('age');
$max = User::max('age');

// 9. Cache query results
$results = Cache::remember('users_active', 3600, function() {
    return User::where('active', true)->get();
});

// 10. Monitor with EXPLAIN
// EXPLAIN SELECT * FROM users WHERE email = 'john@example.com';
// Shows query execution plan

// Query optimization class
class UserRepository {
    public function findActiveUsers() {
        return User::where('active', true)
            ->select('id', 'name', 'email')
            ->with('profile')
            ->orderBy('created_at', 'desc')
            ->limit(100)
            ->get();
    }
    
    public function getUserStats() {
        return DB::table('users')
            ->select(DB::raw('COUNT(*) as total, AVG(age) as avg_age'))
            ->where('active', true)
            ->first();
    }
}
