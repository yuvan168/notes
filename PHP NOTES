    // Generate unique name
    $filename = bin2hex(random_bytes(8)) . '.' . 
                pathinfo($file['name'], PATHINFO_EXTENSION);
    
    // Move to secure location
    move_uploaded_file($file['tmp_name'], 
                      "/secure/uploads/" . $filename);
}
