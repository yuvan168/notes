    public function show($id) {
        // Invalidate cache on update
        try {
            $product = Product::findOrFail($id);
            return response()->json($product);
        } catch (ModelNotFoundException $e) {
            return response()->json(
                ['error' => 'Product not found'],
                404
            );
        }
    }
