## 19) Scenario-Based Script Examples

### Scenario A: Organize files by extension
**Requirement:** Move files from an incoming directory into extension-based folders.

```python
from pathlib import Path
import shutil


def organize_files(source: Path, destination: Path) -> int:
    moved = 0
    for file_path in source.iterdir():
        if not file_path.is_file():
            continue
        extension = file_path.suffix.lower().lstrip(".") or "no_extension"
        target_dir = destination / extension
        target_dir.mkdir(parents=True, exist_ok=True)
        target_path = target_dir / file_path.name
        if target_path.exists():
            raise FileExistsError(f"Refusing to overwrite {target_path}")
        shutil.move(str(file_path), target_path)
        moved += 1
    return moved
```

**Interview discussion:** What happens with duplicate names, hidden files, permissions, and a failure halfway through? Explain a dry-run mode and an audit log.

### Scenario B: Find error lines in a large log
**Requirement:** Count errors without loading a multi-gigabyte file into memory.

```python
from collections import Counter
from pathlib import Path


def error_summary(log_path: Path) -> Counter[str]:
    counts = Counter()
    with log_path.open(encoding="utf-8", errors="replace") as log_file:
        for line in log_file:
            if "ERROR" in line:
                service = line.split("service=", 1)[-1].split()[0]
                counts[service] += 1
    return counts
```

**Interview discussion:** Explain streaming, malformed lines, rotation, and why a proper parser may be safer than `split`.

### Scenario C: Validate and convert a CSV batch
**Requirement:** Accept employee rows, reject invalid records, and create a clean output file.

```python
import csv
from pathlib import Path


def valid_employee(row: dict[str, str]) -> bool:
    return bool(row.get("id", "").strip() and "@" in row.get("email", ""))


def convert_employees(source: Path, target: Path, rejects: Path) -> tuple[int, int]:
    accepted = rejected = 0
    with source.open(newline="", encoding="utf-8") as input_file, \
            target.open("w", newline="", encoding="utf-8") as output_file, \
            rejects.open("w", newline="", encoding="utf-8") as reject_file:
        reader = csv.DictReader(input_file)
        writer = csv.DictWriter(output_file, fieldnames=["id", "email"])
        reject_writer = csv.DictWriter(reject_file, fieldnames=reader.fieldnames or [])
        writer.writeheader()
        reject_writer.writeheader()
        for row in reader:
            if valid_employee(row):
                writer.writerow({"id": row["id"].strip(), "email": row["email"].strip().lower()})
                accepted += 1
            else:
                reject_writer.writerow(row)
                rejected += 1
    return accepted, rejected
```

**Interview discussion:** Explain schema validation, rejection reporting, encoding, duplicate IDs, atomic output, and rerun behavior.

### Scenario D: Create a JSON backup
**Requirement:** Back up a JSON file with a timestamp while retaining only the newest five copies.

```python
from datetime import datetime, timezone
from pathlib import Path
import shutil


def backup_json(source: Path, backup_dir: Path, keep: int = 5) -> Path:
    backup_dir.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    target = backup_dir / f"{source.stem}_{timestamp}{source.suffix}"
    shutil.copy2(source, target)
    backups = sorted(backup_dir.glob(f"{source.stem}_*{source.suffix}"), reverse=True)
    for old_backup in backups[keep:]:
        old_backup.unlink()
    return target
```

**Interview discussion:** Explain timestamp collisions, atomic copying, retention policy, disk-full errors, and permissions.

### Scenario E: Call an API with retries
**Requirement:** Fetch data from a service that sometimes returns temporary failures.

```python
import time
from urllib.error import HTTPError, URLError
from urllib.request import urlopen


def fetch_with_retry(url: str, attempts: int = 3) -> bytes:
    for attempt in range(attempts):
        try:
            with urlopen(url, timeout=10) as response:
                if response.status == 200:
                    return response.read()
                if response.status < 500:
                    raise RuntimeError(f"Permanent HTTP error: {response.status}")
        except (HTTPError, URLError) as error:
            if attempt == attempts - 1:
                raise RuntimeError("API request failed after retries") from error
        time.sleep(2 ** attempt)
    raise RuntimeError("Unreachable")
```

**Interview discussion:** Retry only transient failures, honor `Retry-After`, add jitter in distributed systems, and avoid retrying non-idempotent operations blindly.

### Scenario F: Compare two directories
**Requirement:** Report files missing from either directory and files whose contents differ.

```python
import hashlib
from pathlib import Path


def digest(path: Path) -> str:
    hasher = hashlib.sha256()
    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            hasher.update(chunk)
    return hasher.hexdigest()


def compare(left: Path, right: Path) -> dict[str, list[str]]:
    left_files = {p.relative_to(left) for p in left.rglob("*") if p.is_file()}
    right_files = {p.relative_to(right) for p in right.rglob("*") if p.is_file()}
    common = left_files & right_files
    return {
        "only_left": [str(path) for path in sorted(left_files - right_files)],
        "only_right": [str(path) for path in sorted(right_files - left_files)],
        "different": [str(path) for path in sorted(common) if digest(left / path) != digest(right / path)],
    }
```

### Scenario G: Build a command-line report
**Requirement:** Count files by extension and write a JSON summary.

```python
from collections import Counter
from pathlib import Path
import json


def extension_report(directory: Path) -> dict[str, int]:
    counts = Counter(
        path.suffix.lower() or "[no extension]"
        for path in directory.rglob("*")
        if path.is_file()
    )
    return dict(sorted(counts.items()))


report = extension_report(Path("."))
Path("report.json").write_text(json.dumps(report, indent=2), encoding="utf-8")
```

