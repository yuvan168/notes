        person.persist();  // Save to DB
        return Response.status(Response.Status.CREATED).entity(person).build();
    }

    @PUT
    @Path("/{id}")
    @Transactional
    public Person update(@PathParam("id") Long id, Person updated) {
        Person person = Person.findById(id);
        if (person == null) {
            throw new NotFoundException();
        }
        person.name = updated.name;
        person.email = updated.email;
        person.age = updated.age;
        // No need to call persist() — entity is managed
        return person;
    }

    @DELETE
    @Path("/{id}")
    @Transactional
    public Response delete(@PathParam("id") Long id) {
        boolean deleted = Person.deleteById(id);
        if (!deleted) {
