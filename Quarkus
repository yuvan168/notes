@Path("/api/persons")
public class PersonResource {

    // Automatic validation with @Valid
    @POST
    public Response create(@Valid PersonDTO person) {
        // If validation fails, 400 Bad Request is returned automatically
        return Response.status(201).entity(personService.create(person)).build();
    }

    // Manual validation
    @Inject
    Validator validator;

    @POST
    @Path("/manual")
    public Response createManual(PersonDTO person) {
        Set<ConstraintViolation<PersonDTO>> violations = validator.validate(person);
        if (!violations.isEmpty()) {
            List<String> errors = violations.stream()
                .map(v -> v.getPropertyPath() + ": " + v.getMessage())
                .toList();
            return Response.status(400).entity(errors).build();
        }
        return Response.status(201).entity(personService.create(person)).build();
    }
}
