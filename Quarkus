```java
import org.eclipse.microprofile.reactive.messaging.Channel;
import org.eclipse.microprofile.reactive.messaging.Emitter;

@ApplicationScoped
public class OrderProducer {

    @Inject
    @Channel("orders-out")
    Emitter<Order> orderEmitter;

    public void sendOrder(Order order) {
        orderEmitter.send(order);
    }

    // With metadata (key, headers)
    public void sendOrderWithKey(Order order) {
        orderEmitter.send(
            Message.of(order)
                .addMetadata(OutgoingKafkaRecordMetadata.<String>builder()
                    .withKey(order.getId().toString())
                    .withHeader("event-type", "ORDER_CREATED".getBytes())
                    .build())
        );
    }
}
```

### Consumer
```java
import org.eclipse.microprofile.reactive.messaging.Incoming;

@ApplicationScoped
public class OrderConsumer {

    @Incoming("orders-in")
    public void processOrder(Order order) {
        System.out.println("Received order: " + order.getId());
        // Process order...
    }

    // With acknowledgment control
    @Incoming("orders-in")
    public CompletionStage<Void> processWithAck(Message<Order> message) {
        try {
            processOrder(message.getPayload());
            return message.ack();  // Acknowledge success
        } catch (Exception e) {
            return message.nack(e);  // Negative acknowledge
        }
    }
}
```

