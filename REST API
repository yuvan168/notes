});

// ✓ GOOD - Returns proper status codes
app.post('/api/users', (req, res) => {
  try {
    // ...
  } catch (error) {
    res.status(400).json({ error: { code: 'ERROR', message: error.message } });
  }
});
```

**2. Trusting Client-Side Validation**
```javascript
// ✗ BAD - Only validates on client
const createUser = (formData) => {
  if (!validateEmail(formData.email)) {
    return; // Doesn't send
  }
  return fetch('/api/users', { body: JSON.stringify(formData) });
};

// ✓ GOOD - Validates on server AND client
app.post('/api/users', (req, res) => {
  // Server-side validation
  if (!isValidEmail(req.body.email)) {
    return res.status(400).json({
      error: { code: 'INVALID_EMAIL', message: 'Invalid email format' }
    });
  }
  // ... process
});
```

**3. Missing Authorization Checks**
```javascript
// ✗ BAD - No authorization check
app.delete('/api/users/:id', verifyJWT, (req, res) => {
  User.deleteOne({ _id: req.params.id }); // Anyone can delete anyone!
});

// ✓ GOOD - Check ownership or role
app.delete('/api/users/:id', verifyJWT, (req, res) => {
  const userId = req.params.id;
  
  if (userId !== req.user.id && req.user.role !== 'admin') {
    return res.status(403).json({
      error: { code: 'FORBIDDEN', message: 'Cannot delete this user' }
    });
  }
  
  User.deleteOne({ _id: userId });
});
```

**4. Exposing Sensitive Information in Errors**
```javascript
// ✗ BAD - Leaks database structure
app.get('/api/users/:id', (req, res) => {
  User.findById(req.params.id, (err, user) => {
    if (err) {
      // Stack trace exposed!
      res.json({ error: err.stack });
    }
  });
});

// ✓ GOOD - Generic error messages in production
app.get('/api/users/:id', (req, res) => {
  try {
    const user = await User.findById(req.params.id);
    if (!user) {
      return res.status(404).json({
        error: { code: 'NOT_FOUND', message: 'User not found' }
      });
    }
    res.json(user);
  } catch (error) {
    // Log internally
    logger.error(error);
    
    // Generic response to client
    res.status(500).json({
      error: { code: 'SERVER_ERROR', message: 'An error occurred' }
    });
  }
});
```

**5. No Pagination for Large Datasets**
```javascript
// ✗ BAD - Returns all 1 million records
app.get('/api/users', (req, res) => {
  const users = await User.find(); // HUGE!
  res.json(users);
});

// ✓ GOOD - Implement pagination
app.get('/api/users', (req, res) => {
  const page = parseInt(req.query.page) || 1;
  const limit = Math.min(parseInt(req.query.limit) || 10, 100);
  const skip = (page - 1) * limit;

  const [users, total] = await Promise.all([
    User.find().skip(skip).limit(limit),
    User.countDocuments()
  ]);

  res.json({
    data: users,
    pagination: {
      page,
      limit,
      total,
      pages: Math.ceil(total / limit)
    }
  });
});
```

**6. No Rate Limiting**
```javascript
// ✗ BAD - Anyone can spam the API
app.post('/api/auth/login', (req, res) => {
  // Vulnerable to brute force!
  const user = await User.findOne({ email: req.body.email });
});

// ✓ GOOD - Implement rate limiting
const rateLimit = require('express-rate-limit');

const loginLimiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 minutes
  max: 5, // 5 attempts per IP
  message: 'Too many login attempts, please try again later'
});

app.post('/api/auth/login', loginLimiter, (req, res) => {
  const user = await User.findOne({ email: req.body.email });
});
```

**7. Inconsistent Response Format**
```javascript
// ✗ BAD - Different formats for different endpoints
app.get('/api/users', (req, res) => {
  res.json(users); // Array directly
});

app.get('/api/products', (req, res) => {
  res.json({ data: products }); // Wrapped in data
});

// ✓ GOOD - Consistent format
app.get('/api/users', (req, res) => {
  res.json({ success: true, data: users });
});

app.get('/api/products', (req, res) => {
  res.json({ success: true, data: products });
});
```

**8. No Input Sanitization**
```javascript
// ✗ BAD - Vulnerable to injection
app.get('/api/users', (req, res) => {
  const query = req.query.search;
  User.find({ $where: query }); // MongoDB injection!
});

// ✓ GOOD - Sanitize and validate
app.get('/api/users', (req, res) => {
  const query = req.query.search;
  
  // Validate
  if (typeof query !== 'string' || query.length > 100) {
    return res.status(400).json({
      error: { code: 'INVALID_QUERY', message: 'Invalid search query' }
    });
  }
  
  // Escape/sanitize
  const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  User.find({ name: new RegExp(escaped, 'i') });
});
```

**9. Not Handling Concurrent Updates**
```javascript
// ✗ BAD - No concurrency control
app.put('/api/users/:id', (req, res) => {
  const user = await User.findById(req.params.id);
  user.balance -= 100;
  await user.save(); // May overwrite concurrent update!
});

// ✓ GOOD - Use optimistic locking or ETags
app.put('/api/users/:id', (req, res) => {
  const ifMatch = req.headers['if-match'];
  
  if (!ifMatch) {
    return res.status(428).json({
      error: { code: 'PRECONDITION_REQUIRED', message: 'ETag required' }
    });
  }

  const user = await User.findById(req.params.id);
  const etag = createETag(user);

  if (etag !== ifMatch) {
    return res.status(412).json({
      error: { code: 'PRECONDITION_FAILED', message: 'Resource was modified' }
    });
  }

  user.balance -= 100;
  await user.save();

  res.set('ETag', createETag(user)).json(user);
});
```

**10. No Request/Response Logging**
```javascript
// ✗ BAD - No visibility into requests
app.post('/api/users', (req, res) => {
  // Process request
});

// ✓ GOOD - Log requests for debugging
const requestLogger = (req, res, next) => {
  const start = Date.now();
  const requestId = generateId();

  res.on('finish', () => {
    const duration = Date.now() - start;
    logger.info({
      requestId,
      method: req.method,
      path: req.path,
      status: res.statusCode,
      duration,
      ip: req.ip,
      userId: req.user?.id
    });
  });

  req.id = requestId;
  next();
};

app.use(requestLogger);
```

