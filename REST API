  constructor(private notificationService: NotificationService) {}

  intercept(req: HttpRequest<any>, next: HttpHandler): Observable<HttpEvent<any>> {
    return next.handle(req).pipe(
      catchError((error: HttpErrorResponse) => {
        // Handle different error types
        const errorMessage = this.getErrorMessage(error);
        
        // Show notification to user
        if (error.status === 401) {
          this.notificationService.error('Your session has expired. Please login again.');
        } else if (error.status === 403) {
          this.notificationService.error('You do not have permission to perform this action.');
        } else if (error.status === 404) {
          this.notificationService.error('The requested resource was not found.');
        } else if (error.status >= 500) {
          this.notificationService.error('Server error. Please try again later.');
        } else {
          this.notificationService.error(errorMessage);
        }

        // Log error
        console.error({
          status: error.status,
          code: error.error?.error?.code,
          message: error.error?.error?.message,
          url: error.url,
          timestamp: new Date().toISOString()
        });

        return throwError(() => error);
      })
    );
  }

  private getErrorMessage(error: HttpErrorResponse): string {
    if (error.error?.error?.message) {
      return error.error.error.message;
    }
    
    if (error.error?.message) {
      return error.error.message;
    }

    switch (error.status) {
      case 0:
        return 'Network error. Please check your connection.';
      case 400:
        return 'Invalid request. Please check your input.';
      case 401:
        return 'Authentication required.';
      case 403:
        return 'Permission denied.';
      case 404:
        return 'Resource not found.';
      case 429:
        return 'Too many requests. Please try again later.';
      case 500:
        return 'Server error. Please try again later.';
      default:
        return 'An unexpected error occurred.';
    }
  }
}

// Error handling service
@Injectable()
export class ErrorHandlingService {
  handleValidationError(error: any) {
    // Format validation errors for display
    const fieldErrors = error.error?.error?.details?.reduce((acc, detail) => {
      acc[detail.field] = detail.message;
      return acc;
    }, {});

    return fieldErrors;
  }

  handleConflictError(error: any) {
    // Handle duplicate/conflict errors
    return error.error?.error?.message;
  }
}

// Usage in component
export class UserFormComponent {
  constructor(
    private userService: UserService,
    private errorHandling: ErrorHandlingService,
    private notification: NotificationService
  ) {}

  createUser(formData) {
    this.userService.createUser(formData).subscribe({
      next: (user) => {
        this.notification.success('User created successfully');
      },
      error: (error) => {
        if (error.status === 400) {
          const fieldErrors = this.errorHandling.handleValidationError(error);
          // Update form with field-level errors
          this.form.setErrors(fieldErrors);
        } else if (error.status === 409) {
          const message = this.errorHandling.handleConflictError(error);
          this.notification.error(message);
        }
      }
    });
  }
}
