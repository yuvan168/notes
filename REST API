#### Q20: Design a notification system using REST API.
**Answer:**
```javascript
// 1. Create notification
app.post('/api/notifications', async (req, res) => {
  const { userId, type, message, data } = req.body;

  const notification = await Notification.create({
    userId,
    type,        // 'order_confirmed', 'payment_failed', etc.
    message,
    data,
    read: false,
    createdAt: new Date()
  });

  // Trigger webhook/event
  emit('notification:created', notification);

  res.status(201).json({
    success: true,
    data: notification
  });
});

// 2. Get notifications for user
app.get('/api/users/:userId/notifications', async (req, res) => {
  const { unreadOnly } = req.query;
  
  let query = { userId: req.params.userId };
  if (unreadOnly === 'true') {
    query.read = false;
  }

  const notifications = await Notification.find(query)
    .sort({ createdAt: -1 })
    .limit(50);

  res.json({
    success: true,
    data: notifications,
    unreadCount: notifications.filter(n => !n.read).length
  });
});

// 3. Mark as read
app.patch('/api/notifications/:id', async (req, res) => {
  const notification = await Notification.findByIdAndUpdate(
    req.params.id,
    { read: true },
    { new: true }
  );

  res.json({
    success: true,
    data: notification
  });
});

// 4. Mark all as read
app.post('/api/notifications/mark-all-read', async (req, res) => {
  const { userId } = req.body;

  await Notification.updateMany(
    { userId, read: false },
    { read: true }
  );

  res.json({
    success: true,
    message: 'All notifications marked as read'
  });
});

// 5. Real-time notifications (WebSocket)
io.on('connection', (socket) => {
  const userId = socket.handshake.query.userId;

  socket.join(`user-${userId}`);

  // When notification created
  socket.on('notification:created', (notification) => {
    io.to(`user-${userId}`).emit('new-notification', notification);
  });
});

// Emit to specific user when notification created
Notification.create({ userId: 123, message: 'Order confirmed' })
  .then(notification => {
    io.to(`user-123`).emit('new-notification', notification);
  });
```

