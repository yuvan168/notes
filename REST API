#### Q14: Design pagination for a large dataset with millions of records.
**Answer:**

**Bad Approach: Offset-based (Inefficient for large offsets)**
```javascript
GET /api/users?page=10000&limit=10
// Database skips 99,990 records
// Very slow for large offsets!
```

**Good Approach: Keyset/Cursor-based**
```javascript
// First request
GET /api/users?limit=10

Response:
{
  "data": [
    { "id": 1, "name": "John", "createdAt": "2024-01-01" },
    { "id": 2, "name": "Jane", "createdAt": "2024-01-02" },
    ...
  ],
  "pagination": {
    "nextCursor": "encoded_data_from_last_record"
  }
}

// Next request (using cursor)
GET /api/users?limit=10&cursor=encoded_data

// Never skip records, always use WHERE clause
db.users
  .find({ id: { $gt: 1 } })
  .sort({ id: 1 })
  .limit(10)
```

**Implementation:**
```javascript
app.get('/api/users', async (req, res) => {
  const limit = Math.min(parseInt(req.query.limit) || 10, 100);
  const cursor = req.query.cursor ? 
    Buffer.from(req.query.cursor, 'base64').toString().split(':') : 
    null;

  let query = {};

  // If cursor provided, fetch after that point
  if (cursor) {
    const [lastId, lastCreatedAt] = cursor;
    query = {
      $or: [
        { id: { $gt: lastId } },
        { 
          id: lastId,
          createdAt: { $gt: new Date(lastCreatedAt) }
        }
      ]
    };
  }

  // Fetch limit + 1 to determine if there are more
  const users = await User.find(query)
    .sort({ id: 1, createdAt: 1 })
    .limit(limit + 1);

  const hasMore = users.length > limit;
  const pageData = users.slice(0, limit);

  let nextCursor = null;
  if (hasMore && pageData.length > 0) {
    const lastRecord = pageData[pageData.length - 1];
    nextCursor = Buffer.from(
      `${lastRecord.id}:${lastRecord.createdAt.toISOString()}`
    ).toString('base64');
  }

  res.json({
    success: true,
    data: pageData,
    pagination: {
      nextCursor,
      hasMore
    }
  });
});
```

