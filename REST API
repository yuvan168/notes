#### Q13: How do you handle concurrent updates/race conditions in REST APIs?
**Answer:**
Multiple clients updating same resource simultaneously can cause inconsistency.

**Solution 1: Optimistic Locking with ETags**
```javascript
// GET - Client receives current state with ETag
GET /api/users/123
Response:
{
  "id": 123,
  "name": "John",
  "balance": 1000
}
ETag: "abc123"

// PUT - Client sends ETag with update
PUT /api/users/123
If-Match: "abc123"
{
  "name": "John",
  "balance": 900
}

// Server validates ETag
app.put('/api/users/:id', (req, res) => {
  const ifMatch = req.headers['if-match'];
  const user = await User.findById(req.params.id);
  const currentETag = createETag(user);

  // Check if resource was modified
  if (ifMatch !== currentETag) {
    return res.status(412).json({
      error: {
        code: 'PRECONDITION_FAILED',
        message: 'Resource was modified'
      }
    });
  }

  // Update allowed
  user.name = req.body.name;
  user.balance = req.body.balance;
  await user.save();

  res.set('ETag', createETag(user)).json(user);
});

// Helper
function createETag(data) {
  const crypto = require('crypto');
  return crypto
    .createHash('md5')
    .update(JSON.stringify(data))
    .digest('hex');
}
```

**Solution 2: Pessimistic Locking (Database level)**
```javascript
// Lock resource during update
app.put('/api/users/:id', async (req, res) => {
  // Lock the row
  const user = await User.findByIdAndLock(req.params.id);

  try {
    // Update
    user.balance -= 100;
    await user.save();

    res.json(user);
  } finally {
    // Unlock
    await user.unlock();
  }
});
```

