## 💡 REAL-WORLD EXAMPLE: Complete User API

```javascript
// Node.js/Express - Complete implementation

const express = require('express');
const jwt = require('jsonwebtoken');
const app = express();

app.use(express.json());

// Constants
const SECRET = process.env.JWT_SECRET;
const USERS_PER_PAGE = 10;

// Custom error class
class APIError extends Error {
  constructor(code, message, status = 400) {
    super(message);
    this.code = code;
    this.status = status;
  }
}

// Request ID middleware
app.use((req, res, next) => {
  req.id = generateRequestId();
  res.setHeader('X-Request-ID', req.id);
  next();
});

// Logging middleware
app.use((req, res, next) => {
  const start = Date.now();
  res.on('finish', () => {
    logger.info({
      requestId: req.id,
      method: req.method,
      path: req.path,
      status: res.statusCode,
      duration: Date.now() - start
    });
  });
  next();
});

// Auth middleware
const verifyJWT = (req, res, next) => {
  const auth = req.headers.authorization;
  
  if (!auth || !auth.startsWith('Bearer ')) {
    return res.status(401).json({
      success: false,
      error: { code: 'UNAUTHORIZED', message: 'No token provided' }
    });
  }

  const token = auth.substring(7);

  try {
    req.user = jwt.verify(token, SECRET);
    next();
  } catch (error) {
    res.status(401).json({
      success: false,
      error: { 
        code: error.name === 'TokenExpiredError' ? 'TOKEN_EXPIRED' : 'INVALID_TOKEN',
        message: 'Invalid or expired token'
      }
    });
  }
};

// Authorization middleware
const authorize = (requiredRole) => {
  return (req, res, next) => {
    if (req.user.role !== requiredRole) {
      return res.status(403).json({
        success: false,
        error: { code: 'FORBIDDEN', message: 'Insufficient permissions' }
      });
    }
    next();
  };
};

// Error handler
app.use((err, req, res, next) => {
  if (!(err instanceof APIError)) {
    err = new APIError('SERVER_ERROR', 'An unexpected error occurred', 500);
  }

  logger.error({ requestId: req.id, error: err });

  res.status(err.status).json({
    success: false,
    error: {
      code: err.code,
      message: err.message,
      requestId: req.id
    }
  });
});

// ========== API ENDPOINTS ==========

// 1. Login
app.post('/api/v1/auth/login', async (req, res, next) => {
  try {
    const { email, password } = req.body;

    if (!email || !password) {
      throw new APIError('VALIDATION_ERROR', 'Email and password required', 400);
    }

    const user = await User.findOne({ email });
    
    if (!user || !user.comparePassword(password)) {
      throw new APIError('INVALID_CREDENTIALS', 'Invalid email or password', 401);
    }

    const accessToken = jwt.sign(
      { sub: user.id, email: user.email, role: user.role },
      SECRET,
      { expiresIn: '15m' }
    );

    res.status(200).json({
      success: true,
      data: { accessToken, expiresIn: 900 }
    });
  } catch (error) {
    next(error);
  }
});

// 2. Get all users (paginated)
app.get('/api/v1/users', verifyJWT, async (req, res, next) => {
  try {
    const page = Math.max(1, parseInt(req.query.page) || 1);
    const limit = Math.min(parseInt(req.query.limit) || USERS_PER_PAGE, 100);
    const skip = (page - 1) * limit;

    const [users, total] = await Promise.all([
      User.find()
        .skip(skip)
        .limit(limit)
        .select('-password'),
      User.countDocuments()
    ]);

    res.status(200).json({
      success: true,
      data: users,
      pagination: {
        page,
        limit,
        total,
        pages: Math.ceil(total / limit)
      }
    });
  } catch (error) {
    next(error);
  }
});

// 3. Get single user
app.get('/api/v1/users/:id', verifyJWT, async (req, res, next) => {
  try {
    const user = await User.findById(req.params.id).select('-password');
    
    if (!user) {
      throw new APIError('NOT_FOUND', 'User not found', 404);
    }

    // Set cache headers
    res.set('ETag', createETag(user));
    res.set('Cache-Control', 'private, max-age=300');

    res.status(200).json({
      success: true,
      data: user
    });
  } catch (error) {
    next(error);
  }
});

// 4. Create user
app.post('/api/v1/users', verifyJWT, authorize('admin'), async (req, res, next) => {
  try {
    const { email, name, password, role } = req.body;

    // Validation
    if (!email || !name || !password) {
      throw new APIError('VALIDATION_ERROR', 'Missing required fields', 400);
    }

    // Check for duplicates
    const existing = await User.findOne({ email });
    if (existing) {
      throw new APIError('CONFLICT', 'Email already in use', 409);
    }

    const user = await User.create({ email, name, password, role });

    res.status(201)
      .location(`/api/v1/users/${user.id}`)
      .json({
        success: true,
        data: user
      });
  } catch (error) {
    next(error);
  }
});

// 5. Update user
app.put('/api/v1/users/:id', verifyJWT, async (req, res, next) => {
  try {
    const { id } = req.params;
    const { name, email } = req.body;

    // Authorization check
    if (id !== req.user.sub && req.user.role !== 'admin') {
      throw new APIError('FORBIDDEN', 'Cannot update this user', 403);
    }

    // Validation
    if (!name || !email) {
      throw new APIError('VALIDATION_ERROR', 'Name and email required', 400);
    }

    const user = await User.findByIdAndUpdate(
      id,
      { name, email },
      { new: true, runValidators: true }
    ).select('-password');

    if (!user) {
      throw new APIError('NOT_FOUND', 'User not found', 404);
    }

    res.status(200).json({
      success: true,
      data: user
    });
  } catch (error) {
    next(error);
  }
});

// 6. Delete user
app.delete('/api/v1/users/:id', verifyJWT, authorize('admin'), async (req, res, next) => {
  try {
    const user = await User.findByIdAndDelete(req.params.id);

    if (!user) {
      throw new APIError('NOT_FOUND', 'User not found', 404);
    }

    res.status(204).send();
  } catch (error) {
    next(error);
  }
});

// 7. Health check
app.get('/api/health', (req, res) => {
  res.status(200).json({
    success: true,
    data: { status: 'healthy', timestamp: new Date().toISOString() }
  });
});

// Start server
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`API server listening on port ${PORT}`);
});

// Helper functions
function generateRequestId() {
  return `req-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
}

function createETag(data) {
  const crypto = require('crypto');
  return crypto.createHash('md5').update(JSON.stringify(data)).digest('hex');
}
```

