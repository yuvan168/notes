  windowMs: 1 * 60 * 1000,      // 1 minute
  max: 5                         // 5 requests
});

const moderateLimiter = rateLimit({
  store: new RedisStore({
    client: client,
    prefix: 'moderate-limit:'
  }),
  windowMs: 15 * 60 * 1000,     // 15 minutes
  max: 100
});

// Apply limits
app.post('/api/auth/login', strictLimiter, (req, res) => {
  // Strict: 5 per minute
});

app.get('/api/users', moderateLimiter, (req, res) => {
  // Moderate: 100 per 15 minutes
});

// Custom implementation with response headers
app.use((req, res, next) => {
  const clientId = req.ip;
  const key = `rate-limit:${clientId}`;
  const limit = 100;
  const window = 3600; // 1 hour

  redis.incr(key, (err, count) => {
    if (count === 1) {
      redis.expire(key, window);
    }

    res.set('X-RateLimit-Limit', limit);
    res.set('X-RateLimit-Remaining', Math.max(0, limit - count));
    res.set('X-RateLimit-Reset', Math.floor(Date.now() / 1000) + window);

    if (count > limit) {
      return res.status(429).json({
        error: {
          code: 'RATE_LIMIT_EXCEEDED',
          message: 'Too many requests',
          retryAfter: window
        }
      });
    }

    next();
  });
});
