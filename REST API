#### Q19: You have an API that's getting slow. How would you troubleshoot and optimize it?
**Answer:**

**Step 1: Identify the bottleneck**
```javascript
// Add timing middleware
app.use((req, res, next) => {
  const start = process.hrtime.bigint();
  
  res.on('finish', () => {
    const end = process.hrtime.bigint();
    const duration = Number(end - start) / 1000000; // ms
    
    console.log({
      method: req.method,
      path: req.path,
      status: res.statusCode,
      duration: `${duration.toFixed(2)}ms`
    });
  });
  
  next();
});

// Monitor slow requests
if (duration > 1000) {
  logger.warn(`Slow request: ${req.method} ${req.path} took ${duration}ms`);
}
```

**Step 2: Check common culprits**
```javascript
// 1. N+1 Query Problem
// ✗ BAD
app.get('/api/users/:id/posts', async (req, res) => {
  const user = await User.findById(req.params.id);
  // Now loading author for EACH post
  const posts = await Post.find({ userId: user.id });
  for (let post of posts) {
    post.author = await User.findById(post.userId); // N queries!
  }
});

// ✓ GOOD
app.get('/api/users/:id/posts', async (req, res) => {
  const posts = await Post.find({ userId: req.params.id })
    .populate('author'); // Single query with join
});

// 2. Missing database indexes
// Create indexes on frequently queried fields
db.users.createIndex({ email: 1 });
db.posts.createIndex({ userId: 1, createdAt: -1 });

// 3. Not using pagination
// ✗ BAD - Returns all 1 million records
GET /api/users

// ✓ GOOD - Return in chunks
GET /api/users?page=1&limit=100

// 4. Inefficient caching
// ✗ BAD - Not caching at all
app.get('/api/stats', async (req, res) => {
  const data = await computeExpensiveStats(); // Every request!
  res.json(data);
});

// ✓ GOOD - Cache expensive operations
const cache = {};

app.get('/api/stats', async (req, res) => {
  if (cache.stats && Date.now() - cache.timestamp < 60000) {
    return res.json(cache.stats); // Return cached
  }
  
  const data = await computeExpensiveStats();
  cache.stats = data;
  cache.timestamp = Date.now();
  res.json(data);
});
```

