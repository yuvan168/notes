    "use strict";

    return Controller.extend("myapp.controller.Main", {
        onInit: function () {
            // Initialization logic
        },

        onSearch: function (oEvent) {
            var sQuery = oEvent.getParameter("query");
            var aFilters = [];
            if (sQuery) {
                aFilters.push(new Filter("Maktx", FilterOperator.Contains, sQuery));
