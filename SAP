### 6.4 Internal Table Operations

```abap
" ---- APPEND ----
APPEND wa_material TO lt_materials.
APPEND INITIAL LINE TO lt_materials.

" ---- INSERT ----
INSERT wa_material INTO TABLE lt_materials.    " Key-based insert
INSERT wa_material INTO lt_materials INDEX 5.  " Index-based insert

" ---- READ ----
READ TABLE lt_materials INTO wa_material INDEX 1.
READ TABLE lt_materials INTO wa_material WITH KEY matnr = '000000001234'.
READ TABLE lt_materials ASSIGNING <fs_material> WITH KEY matnr = '000000001234'.
" sy-subrc = 0 means found

" ---- LOOP ----
LOOP AT lt_materials INTO wa_material.
  WRITE: / wa_material-matnr, wa_material-maktx.
ENDLOOP.

LOOP AT lt_materials ASSIGNING <fs_material> WHERE mtart = 'FERT'.
  <fs_material>-meins = 'EA'.  " Direct modification via field symbol
ENDLOOP.

" ---- MODIFY ----
MODIFY lt_materials FROM wa_material INDEX 3.
MODIFY lt_materials FROM wa_material TRANSPORTING meins WHERE matnr = '000000001234'.

" ---- DELETE ----
DELETE lt_materials INDEX 3.
DELETE lt_materials WHERE mtart = 'ROH'.

" ---- SORT ----
SORT lt_materials BY matnr ASCENDING mtart DESCENDING.

" ---- COLLECT ----
" Aggregates numeric fields for duplicate key entries
COLLECT wa_material INTO lt_materials.

" ---- DESCRIBE / LINES ----
DATA(lv_lines) = lines( lt_materials ).
```

### 6.5 Open SQL (Database Access)

```abap
" SELECT single row
SELECT SINGLE matnr, maktx, mtart
  FROM mara
  INTO @DATA(ls_result)
  WHERE matnr = @lv_matnr.

" SELECT multiple rows
SELECT matnr, maktx, mtart, meins
  FROM mara
  INTO TABLE @DATA(lt_results)
  WHERE mtart = 'FERT'
  ORDER BY matnr.

" JOIN
SELECT a~matnr, b~maktx, a~mtart
  FROM mara AS a
  INNER JOIN makt AS b ON a~matnr = b~matnr
  INTO TABLE @DATA(lt_join)
  WHERE b~spras = @sy-langu.

" Aggregate functions
SELECT mtart, COUNT(*) AS count, SUM( ntgew ) AS total_weight
  FROM mara
  INTO TABLE @DATA(lt_aggregate)
  GROUP BY mtart
  HAVING COUNT(*) > 10.

" FOR ALL ENTRIES
IF lt_materials IS NOT INITIAL.
  SELECT matnr, maktx
    FROM makt
    INTO TABLE @DATA(lt_texts)
    FOR ALL ENTRIES IN @lt_materials
    WHERE matnr = @lt_materials-matnr
      AND spras = @sy-langu.
ENDIF.

" INSERT
INSERT INTO zcustom_table VALUES @wa_data.

" UPDATE
UPDATE zcustom_table SET field1 = 'NEW' WHERE key_field = '001'.

" MODIFY (Insert or Update)
MODIFY zcustom_table FROM @wa_data.

" DELETE
DELETE FROM zcustom_table WHERE key_field = '001'.
