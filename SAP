### 9.6 CDS Views (Core Data Services)

CDS views are the foundation for S/4HANA analytics and Fiori apps.

```abap
@AbapCatalog.sqlViewName: 'ZSALES_ORD_V'
@AbapCatalog.compiler.compareFilter: true
@AccessControl.authorizationCheck: #CHECK
@EndUserText.label: 'Sales Order CDS View'

@Analytics.dataCategory: #CUBE
@VDM.viewType: #COMPOSITE

DEFINE VIEW Z_SALES_ORDER_CUBE
  AS SELECT FROM vbak AS header
  INNER JOIN vbap AS item
    ON header.vbeln = item.vbeln
  INNER JOIN kna1 AS customer
    ON header.kunnr = customer.kunnr
{
  -- Dimensions
  @EndUserText.label: 'Sales Order'
  key header.vbeln       AS SalesOrder,

  @EndUserText.label: 'Item'
  key item.posnr         AS SalesOrderItem,

  @EndUserText.label: 'Customer'
  header.kunnr           AS Customer,

  @EndUserText.label: 'Customer Name'
  customer.name1         AS CustomerName,

  @EndUserText.label: 'Material'
  item.matnr             AS Material,

  @EndUserText.label: 'Order Date'
  header.erdat           AS OrderDate,

  @EndUserText.label: 'Sales Org'
  header.vkorg           AS SalesOrganization,

  -- Measures
  @EndUserText.label: 'Net Value'
  @Semantics.amount.currencyCode: 'Currency'
  @DefaultAggregation: #SUM
  item.netwr             AS NetValue,

  @EndUserText.label: 'Quantity'
  @DefaultAggregation: #SUM
  item.kwmeng            AS OrderQuantity,

  @EndUserText.label: 'Currency'
  @Semantics.currencyCode: true
  header.waerk           AS Currency
}
WHERE header.vbtyp = 'C'  -- Standard Orders only
```

