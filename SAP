**Service Definition:**
```cds
// srv/service.cds
using my.bookshop from '../db/schema';

service CatalogService {
  @readonly entity Books as projection on bookshop.Books;
  entity Orders as projection on bookshop.Orders;
  action submitOrder(book: UUID, quantity: Integer) returns Orders;
}
```

**Service Implementation:**
```javascript
// srv/service.js
module.exports = (srv) => {
  const { Books, Orders } = srv.entities;

  srv.before('CREATE', 'Orders', async (req) => {
    const { book, quantity } = req.data;
    const b = await SELECT.one.from(Books).where({ ID: book });
    if (!b) req.error(404, 'Book not found');
    if (b.stock < quantity) req.error(409, 'Not enough stock');
  });

  srv.on('submitOrder', async (req) => {
    const { book, quantity } = req.data;
    await UPDATE(Books).set({ stock: { '-=': quantity } }).where({ ID: book });
    return INSERT.into(Orders).entries({ book_ID: book, quantity, buyer: req.user.id });
  });

  srv.after('READ', 'Books', (books) => {
    for (const b of books) {
      if (b.stock > 100) b.title += ' -- 📗 Available';
    }
  });
};
```

