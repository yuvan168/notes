### 6.7 Object-Oriented ABAP

```abap
" ========== CLASS DEFINITION ==========
CLASS lcl_vehicle DEFINITION.
  PUBLIC SECTION.
    METHODS: constructor IMPORTING iv_brand TYPE string
                                   iv_model TYPE string,
             get_info RETURNING VALUE(rv_info) TYPE string,
             accelerate IMPORTING iv_speed TYPE i.

    DATA: mv_brand TYPE string READ-ONLY,
          mv_model TYPE string READ-ONLY.

  PROTECTED SECTION.
    DATA: mv_speed TYPE i.

  PRIVATE SECTION.
    DATA: mv_engine_temp TYPE i.
    METHODS: check_engine.
ENDCLASS.

" ========== CLASS IMPLEMENTATION ==========
CLASS lcl_vehicle IMPLEMENTATION.
  METHOD constructor.
    mv_brand = iv_brand.
    mv_model = iv_model.
    mv_speed = 0.
  ENDMETHOD.

  METHOD get_info.
    rv_info = |{ mv_brand } { mv_model } - Speed: { mv_speed } km/h|.
  ENDMETHOD.

  METHOD accelerate.
    mv_speed = mv_speed + iv_speed.
    check_engine( ).
  ENDMETHOD.

  METHOD check_engine.
    IF mv_speed > 200.
      mv_engine_temp = mv_engine_temp + 10.
    ENDIF.
  ENDMETHOD.
ENDCLASS.

" ========== INHERITANCE ==========
CLASS lcl_electric_car DEFINITION INHERITING FROM lcl_vehicle.
  PUBLIC SECTION.
    METHODS: constructor IMPORTING iv_brand    TYPE string
                                   iv_model    TYPE string
                                   iv_battery  TYPE i,
             get_info REDEFINITION.    " Override
  PRIVATE SECTION.
    DATA: mv_battery TYPE i.
ENDCLASS.

CLASS lcl_electric_car IMPLEMENTATION.
  METHOD constructor.
    super->constructor( iv_brand = iv_brand iv_model = iv_model ).
    mv_battery = iv_battery.
  ENDMETHOD.

  METHOD get_info.
    rv_info = |{ mv_brand } { mv_model } - Battery: { mv_battery }%|.
  ENDMETHOD.
ENDCLASS.

" ========== INTERFACE ==========
INTERFACE lif_chargeable.
  METHODS: charge IMPORTING iv_amount TYPE i,
           get_charge_level RETURNING VALUE(rv_level) TYPE i.
ENDINTERFACE.

CLASS lcl_electric_car DEFINITION INHERITING FROM lcl_vehicle.
  PUBLIC SECTION.
    INTERFACES: lif_chargeable.
    " ...
ENDCLASS.
```

### 6.8 ABAP Events (Report Programming)

```abap
REPORT zmy_report.

" Selection Screen
PARAMETERS: p_matnr TYPE matnr OBLIGATORY.
SELECT-OPTIONS: s_mtart FOR mara-mtart.

" Events (execute in this order):
INITIALIZATION.
  " Set default values
  s_mtart-sign   = 'I'.
  s_mtart-option = 'EQ'.
  s_mtart-low    = 'FERT'.
  APPEND s_mtart.

AT SELECTION-SCREEN.
  " Validate input
  SELECT SINGLE matnr FROM mara INTO @DATA(lv_check) WHERE matnr = @p_matnr.
  IF sy-subrc <> 0.
    MESSAGE 'Material not found' TYPE 'E'.
  ENDIF.

START-OF-SELECTION.
  " Main processing logic
  SELECT matnr, mtart, meins
    FROM mara
    INTO TABLE @DATA(lt_materials)
    WHERE matnr = @p_matnr
      AND mtart IN @s_mtart.

END-OF-SELECTION.
  " Output results
  LOOP AT lt_materials INTO DATA(ls_mat).
    WRITE: / ls_mat-matnr, ls_mat-mtart, ls_mat-meins.
  ENDLOOP.

TOP-OF-PAGE.
  " Page header
  WRITE: / 'Material Report', sy-datum.
  ULINE.

END-OF-PAGE.
  " Page footer
  ULINE.
  WRITE: / 'Page:', sy-pagno.
```

