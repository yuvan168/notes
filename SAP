        mo_cut->divide( iv_a = 10 iv_b = 0 ).
        cl_abap_unit_assert=>fail( msg = 'Exception expected' ).
      CATCH zcx_division_by_zero.
        " Expected behavior
    ENDTRY.
  ENDMETHOD.
ENDCLASS.
