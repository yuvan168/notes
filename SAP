        empid   TYPE n LENGTH 8,
        name    TYPE string,
        salary  TYPE p DECIMALS 2,
        deptno  TYPE c LENGTH 4,
      END OF ls_employee.

" Structure using DDIC
DATA: ls_material TYPE mara.              " From table MARA

" Internal Tables
DATA: lt_materials TYPE TABLE OF mara,          " Standard table
      lt_sorted    TYPE SORTED TABLE OF mara    " Sorted table
                     WITH UNIQUE KEY matnr,
      lt_hashed    TYPE HASHED TABLE OF mara    " Hashed table
                     WITH UNIQUE KEY matnr.

" Work Area
