### Pattern 2: Asynchronous with Message Queue

**Scenario**: Process order - don't need to wait for inventory confirmation

```python
# Order Service - Publisher
import pika
import json

def create_order(order_data):
    # Create order immediately
    order = {
        "order_id": "ORD123",
        "customer_id": order_data["customer_id"],
        "items": order_data["items"],
        "status": "pending"
    }
    
    # Save to database
    save_to_db(order)
    
    # Publish event asynchronously
    connection = pika.BlockingConnection(
        pika.ConnectionParameters('localhost')
    )
    channel = connection.channel()
    
    # Declare exchange
    channel.exchange_declare(
        exchange='orders',
        exchange_type='topic',
        durable=True
    )
    
    # Publish message
    message = {
        "event": "order_created",
        "order_id": order["order_id"],
        "items": order["items"],
        "timestamp": str(datetime.now())
    }
    
    channel.basic_publish(
        exchange='orders',
        routing_key='order.created',
        body=json.dumps(message),
        properties=pika.BasicProperties(
            delivery_mode=2  # Persistent
        )
    )
    
    connection.close()
    
    # Return immediately to customer
    return {
        "success": True,
        "order_id": order["order_id"],
        "status": order["status"],
        "message": "Order received. Processing in progress."
    }

# Inventory Service - Consumer
def start_inventory_listener():
    connection = pika.BlockingConnection(
        pika.ConnectionParameters('localhost')
    )
    channel = connection.channel()
    
    # Setup queue
    channel.exchange_declare(
        exchange='orders',
        exchange_type='topic',
        durable=True
    )
    
    result = channel.queue_declare(queue='inventory_queue', durable=True)
    queue_name = result.method.queue
    
    channel.queue_bind(
        exchange='orders',
        queue=queue_name,
        routing_key='order.*'
    )
    
    def process_order(ch, method, properties, body):
        try:
            order = json.loads(body)
            
            if order["event"] == "order_created":
                # Check inventory
                inventory_available = check_inventory(order["items"])
                
                if inventory_available:
                    # Deduct from inventory
                    deduct_inventory(order["items"])
                    
                    # Publish success event
                    publish_event("inventory.reserved", {
                        "order_id": order["order_id"],
                        "status": "success"
                    })
                else:
                    # Publish failure event
                    publish_event("inventory.failed", {
                        "order_id": order["order_id"],
                        "status": "failed",
                        "reason": "Out of stock"
                    })
            
            ch.basic_ack(delivery_tag=method.delivery_tag)
        
        except Exception as e:
            print(f"Processing error: {e}")
            ch.basic_nack(delivery_tag=method.delivery_tag, requeue=True)
    
    channel.basic_consume(
        queue=queue_name,
        on_message_callback=process_order
    )
    
    print("Listening for inventory updates...")
    channel.start_consuming()
```

**Event Flow**:
```
1. Customer places order
   ↓
2. Order Service creates order, publishes event
   ↓
3. Returns to customer immediately
   ↓
4. Inventory Service receives event
   ↓
5. Checks stock, deducts inventory
   ↓
6. Publishes inventory.reserved event
   ↓
7. Payment Service receives event
   ↓
8. Processes payment
```

**When to Use**:
- Non-critical operations
- Background processing
- Analytics and reporting
- Notifications
- Workflow orchestration

**Benefits**:
- Decoupled services
- High throughput
- Resilient (queued messages persist)
- Easy to add new subscribers

