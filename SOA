### Example 1: RESTful Account Service (Python/FastAPI)

**Theory**: 
A REST service provides HTTP endpoints for account operations. Each operation is stateless and idempotent where possible. The service manages its own database and doesn't directly access other service databases.

**Implementation**:

```python
# account_service.py
from fastapi import FastAPI, HTTPException, status
from pydantic import BaseModel
from typing import Optional
import httpx
import os

app = FastAPI(title="Account Service")

# Database (simplified - use actual database in production)
accounts_db = {
    "ACC001": {
        "account_id": "ACC001",
        "customer_id": "CUST001",
        "balance": 5000.00,
        "type": "Savings",
        "status": "Active"
    }
}

# Data Models
class Account(BaseModel):
    account_id: str
    customer_id: str
    balance: float
    type: str
    status: str

class Transaction(BaseModel):
    account_id: str
    amount: float
    type: str  # "deposit" or "withdrawal"
    description: str

class TransferRequest(BaseModel):
    from_account: str
    to_account: str
    amount: float
    description: str

# Service Discovery (simplified)
NOTIFICATION_SERVICE_URL = os.getenv("NOTIFICATION_SERVICE_URL", 
                                     "http://localhost:8002")
AUDIT_SERVICE_URL = os.getenv("AUDIT_SERVICE_URL", 
                              "http://localhost:8003")

# Endpoints

@app.get("/health")
async def health_check():
    """Service health check"""
    return {"status": "healthy", "service": "account-service"}

@app.get("/accounts/{account_id}")
async def get_account(account_id: str):
    """Retrieve account details"""
    if account_id not in accounts_db:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Account {account_id} not found"
        )
    return accounts_db[account_id]

@app.get("/accounts/customer/{customer_id}")
async def get_customer_accounts(customer_id: str):
    """Retrieve all accounts for a customer"""
    customer_accounts = [
        acc for acc in accounts_db.values() 
        if acc["customer_id"] == customer_id
    ]
    if not customer_accounts:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"No accounts found for customer {customer_id}"
        )
    return customer_accounts

@app.post("/accounts/{account_id}/deposit")
async def deposit(account_id: str, transaction: Transaction):
    """Deposit money to account"""
    if account_id not in accounts_db:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Account {account_id} not found"
        )
    
    # Validate amount
    if transaction.amount <= 0:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Amount must be positive"
        )
    
    # Update balance
    accounts_db[account_id]["balance"] += transaction.amount
    
    # Log transaction (async call)
    try:
        async with httpx.AsyncClient() as client:
            await client.post(
                f"{AUDIT_SERVICE_URL}/log",
                json={
                    "service": "account-service",
                    "action": "deposit",
                    "account_id": account_id,
                    "amount": transaction.amount,
                    "description": transaction.description,
                    "timestamp": "2024-01-01T10:00:00Z"
                }
            )
    except Exception as e:
        print(f"Audit logging failed: {e}")
    
    # Send notification (async call)
    try:
        async with httpx.AsyncClient() as client:
            await client.post(
                f"{NOTIFICATION_SERVICE_URL}/notify",
                json={
                    "customer_id": accounts_db[account_id]["customer_id"],
                    "type": "deposit_confirmation",
                    "amount": transaction.amount,
                    "account_id": account_id,
                    "new_balance": accounts_db[account_id]["balance"]
                }
            )
    except Exception as e:
        print(f"Notification failed: {e}")
    
    return {
        "status": "success",
        "account_id": account_id,
        "amount": transaction.amount,
        "new_balance": accounts_db[account_id]["balance"],
        "message": "Deposit successful"
    }

@app.post("/accounts/{account_id}/withdraw")
async def withdraw(account_id: str, transaction: Transaction):
    """Withdraw money from account"""
    if account_id not in accounts_db:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Account {account_id} not found"
        )
    
    # Validate amount
    if transaction.amount <= 0:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Amount must be positive"
        )
    
    # Check balance
    if accounts_db[account_id]["balance"] < transaction.amount:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Insufficient funds"
        )
    
    # Update balance
    accounts_db[account_id]["balance"] -= transaction.amount
    
    # Async operations
    try:
        async with httpx.AsyncClient() as client:
            # Log transaction
            await client.post(
                f"{AUDIT_SERVICE_URL}/log",
                json={
                    "service": "account-service",
                    "action": "withdrawal",
                    "account_id": account_id,
                    "amount": transaction.amount,
                    "timestamp": "2024-01-01T10:05:00Z"
                }
            )
            
            # Send notification
            await client.post(
                f"{NOTIFICATION_SERVICE_URL}/notify",
                json={
                    "customer_id": accounts_db[account_id]["customer_id"],
                    "type": "withdrawal_confirmation",
                    "amount": transaction.amount,
                    "account_id": account_id,
                    "new_balance": accounts_db[account_id]["balance"]
                }
            )
    except Exception as e:
        print(f"Post-operation failed: {e}")
    
    return {
        "status": "success",
        "account_id": account_id,
        "amount": transaction.amount,
        "new_balance": accounts_db[account_id]["balance"],
        "message": "Withdrawal successful"
    }

@app.post("/accounts/transfer")
async def transfer_funds(transfer: TransferRequest):
    """Transfer funds between accounts"""
    # Validate accounts exist
    if transfer.from_account not in accounts_db:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Source account {transfer.from_account} not found"
        )
    
    if transfer.to_account not in accounts_db:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Target account {transfer.to_account} not found"
        )
    
    # Validate amount
    if transfer.amount <= 0:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Transfer amount must be positive"
        )
    
    # Check balance
    if accounts_db[transfer.from_account]["balance"] < transfer.amount:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Insufficient funds"
        )
    
    # Perform transfer (atomic operation)
    accounts_db[transfer.from_account]["balance"] -= transfer.amount
    accounts_db[transfer.to_account]["balance"] += transfer.amount
    
    # Log and notify
    try:
        async with httpx.AsyncClient() as client:
            await client.post(
                f"{AUDIT_SERVICE_URL}/log",
                json={
                    "service": "account-service",
                    "action": "transfer",
                    "from_account": transfer.from_account,
                    "to_account": transfer.to_account,
                    "amount": transfer.amount,
                    "description": transfer.description
                }
            )
    except Exception as e:
        print(f"Audit logging failed: {e}")
    
    return {
        "status": "success",
        "from_account": transfer.from_account,
        "to_account": transfer.to_account,
        "amount": transfer.amount,
        "message": "Transfer completed successfully"
    }

@app.get("/accounts/{account_id}/balance")
async def get_balance(account_id: str):
    """Get current balance"""
    if account_id not in accounts_db:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Account {account_id} not found"
        )
    return {
        "account_id": account_id,
        "balance": accounts_db[account_id]["balance"]
    }

# Error handling middleware
@app.exception_handler(HTTPException)
async def http_exception_handler(request, exc):
    return {
        "error": True,
        "status_code": exc.status_code,
        "message": exc.detail,
        "service": "account-service"
    }

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8001)
```

**Key Concepts Demonstrated**:
- **Stateless Design**: Each request is independent
- **HTTP Methods**: GET for retrieval, POST for actions
- **Error Handling**: Proper HTTP status codes and error messages
- **Service Communication**: Calls to other services via HTTP
- **Idempotency**: Withdraw/deposit operations are clear
- **Validation**: Input validation before processing
- **Async Operations**: Non-blocking calls to other services

