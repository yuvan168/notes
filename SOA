    res.json({ status: 'healthy', service: 'notification-service' });
});

/**
 * Send notification via REST
 * POST /notify
 * Body: { customer_id, type, email, phone, user_id, ... }
 */
app.post('/notify', async (req, res) => {
    try {
        const { customer_id, type, email, phone, user_id, ...data } = req.body;
        
        // Validate
        if (!customer_id || !type) {
            return res.status(400).json({
                error: true,
                message: 'customer_id and type are required'
            });
        }
        
        // Check preferences
        const preferences = await getUserPreferences(customer_id);
        
        if (!preferences.notification_types.includes(type)) {
            return res.status(400).json({
                error: true,
                message: `Notification type ${type} not enabled for customer`
            });
        }
        
        const results = [];
        
        // Send via enabled channels
        if (preferences.email_enabled && email) {
            const emailResult = await sendEmail({
                type,
                email,
                ...data
            });
            results.push({ method: 'email', ...emailResult });
        }
        
        if (preferences.sms_enabled && phone) {
            const smsResult = await sendSMS({
                type,
                phone,
                message: `${type}: Check your email for details`
            });
            results.push({ method: 'sms', ...smsResult });
        }
        
        if (preferences.push_enabled && user_id) {
            const pushResult = await sendPushNotification({
                type,
                user_id,
                message: `${type}: Check your app for details`
            });
            results.push({ method: 'push', ...pushResult });
        }
        
        res.json({
            success: true,
            customer_id,
            notification_type: type,
            channels: results,
            timestamp: new Date()
        });
        
    } catch (error) {
        console.error('Notification error:', error);
        res.status(500).json({
            error: true,
            message: 'Failed to send notification',
            details: error.message
        });
    }
});

/**
 * Get notification preferences
 * GET /preferences/:customerId
 */
app.get('/preferences/:customerId', async (req, res) => {
    try {
        const { customerId } = req.params;
        const preferences = await getUserPreferences(customerId);
        
        res.json({
            success: true,
            preferences
        });
    } catch (error) {
        res.status(500).json({
            error: true,
            message: 'Failed to retrieve preferences',
            details: error.message
        });
    }
});

/**
 * Update notification preferences
 * PUT /preferences/:customerId
 */
app.put('/preferences/:customerId', async (req, res) => {
    try {
        const { customerId } = req.params;
        const { email_enabled, sms_enabled, push_enabled } = req.body;
        
        // In production, update database
        const updatedPreferences = {
            customer_id: customerId,
            email_enabled: email_enabled !== undefined ? email_enabled : true,
            sms_enabled: sms_enabled !== undefined ? sms_enabled : true,
            push_enabled: push_enabled !== undefined ? push_enabled : true
        };
        
        res.json({
            success: true,
            message: 'Preferences updated',
            preferences: updatedPreferences
        });
    } catch (error) {
        res.status(500).json({
            error: true,
            message: 'Failed to update preferences'
        });
    }
});

// Message queue consumer
async function consumeNotificationMessages() {
    try {
        if (!channel) {
            setTimeout(consumeNotificationMessages, 1000);
            return;
        }
        
        await channel.assertQueue('notifications.queue', { durable: true });
        await channel.bindQueue('notifications.queue', 'notifications', '#');
        
        await channel.consume('notifications.queue', async (msg) => {
            if (msg) {
                try {
                    const notification = JSON.parse(msg.content.toString());
                    console.log('Processing notification from queue:', notification);
                    
                    // Process async
                    await sendEmail(notification);
                    
                    channel.ack(msg);
                } catch (error) {
                    console.error('Failed to process queue message:', error);
                    channel.nack(msg, false, true); // Requeue
                }
            }
        });
    } catch (error) {
        console.error('Queue consumption error:', error);
    }
}

consumeNotificationMessages();

// Start server
const PORT = process.env.PORT || 8002;
app.listen(PORT, () => {
    console.log(`Notification Service running on port ${PORT}`);
});
