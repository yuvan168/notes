### Strategy 2: Event Sourcing

**Theory**: Store all changes as immutable events instead of current state.

```python
class OrderEventStore:
    def __init__(self):
        self.events = []
    
    def add_event(self, event):
        """Store event"""
        event_record = {
            "event_id": len(self.events) + 1,
            "timestamp": datetime.now(),
            "type": event["type"],
            "data": event["data"],
            "aggregate_id": event.get("order_id")
        }
        self.events.append(event_record)
        return event_record
    
    def rebuild_order_state(self, order_id):
        """Rebuild current state from events"""
        order_state = {
            "order_id": order_id,
            "status": "pending",
            "items": [],
            "total": 0
        }
        
        # Replay events
        for event in self.events:
            if event["aggregate_id"] == order_id:
                if event["type"] == "OrderCreated":
                    order_state["items"] = event["data"]["items"]
                    order_state["total"] = event["data"]["total"]
                
                elif event["type"] == "ItemAdded":
                    order_state["items"].append(event["data"]["item"])
                    order_state["total"] += event["data"]["price"]
                
                elif event["type"] == "OrderConfirmed":
                    order_state["status"] = "confirmed"
                
                elif event["type"] == "OrderShipped":
                    order_state["status"] = "shipped"
        
        return order_state

# Usage
event_store = OrderEventStore()

# Create order
event_store.add_event({
    "type": "OrderCreated",
    "order_id": "ORD123",
    "data": {
        "items": [{"product_id": "P001", "qty": 2}],
        "total": 99.99
    }
})

# Add item
event_store.add_event({
    "type": "ItemAdded",
    "order_id": "ORD123",
    "data": {"item": {"product_id": "P002", "qty": 1}, "price": 49.99}
})

# Confirm order
event_store.add_event({
    "type": "OrderConfirmed",
    "order_id": "ORD123",
    "data": {}
})

# Get current state
