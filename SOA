### Pattern 3: Orchestration (Choreography with Saga)

**Scenario**: Order processing with multiple steps that must succeed or rollback

```python
# Saga Orchestrator Pattern
from enum import Enum
from typing import Dict, List

class OrderStatus(Enum):
    PENDING = "pending"
    PAYMENT_PROCESSED = "payment_processed"
    INVENTORY_RESERVED = "inventory_reserved"
    SHIPPED = "shipped"
    COMPLETED = "completed"
    FAILED = "failed"

class OrderSaga:
    def __init__(self, order_id: str, order_data: Dict):
        self.order_id = order_id
        self.order_data = order_data
        self.status = OrderStatus.PENDING
        self.compensations: List[str] = []
    
    def execute(self):
        """Execute order saga with compensation"""
        try:
            # Step 1: Process Payment
            print(f"[{self.order_id}] Processing payment...")
            if not self.process_payment():
                raise Exception("Payment failed")
            self.status = OrderStatus.PAYMENT_PROCESSED
            self.compensations.append("refund_payment")
            print(f"[{self.order_id}] Payment successful")
            
            # Step 2: Reserve Inventory
            print(f"[{self.order_id}] Reserving inventory...")
            if not self.reserve_inventory():
                raise Exception("Inventory reservation failed")
            self.status = OrderStatus.INVENTORY_RESERVED
            self.compensations.append("release_inventory")
            print(f"[{self.order_id}] Inventory reserved")
            
            # Step 3: Arrange Shipping
            print(f"[{self.order_id}] Arranging shipping...")
            if not self.arrange_shipping():
                raise Exception("Shipping arrangement failed")
            self.status = OrderStatus.SHIPPED
            self.compensations.append("cancel_shipping")
            print(f"[{self.order_id}] Shipping arranged")
            
            # Step 4: Update Order Status
            self.status = OrderStatus.COMPLETED
            print(f"[{self.order_id}] Order completed successfully")
            
            return {
                "success": True,
                "order_id": self.order_id,
                "status": self.status.value
            }
        
        except Exception as e:
            print(f"[{self.order_id}] Error: {e}")
            print(f"[{self.order_id}] Initiating compensation...")
            
            # Rollback in reverse order
            self.compensate()
            
            self.status = OrderStatus.FAILED
            return {
                "success": False,
                "order_id": self.order_id,
                "error": str(e)
            }
    
    def process_payment(self) -> bool:
        """Call payment service"""
        try:
            response = requests.post(
                "http://api-gateway/api/payments",
                json={
                    "order_id": self.order_id,
                    "amount": self.order_data["total"],
                    "customer_id": self.order_data["customer_id"]
                },
                timeout=5
            )
            return response.status_code == 200
        except Exception as e:
            print(f"Payment service error: {e}")
            return False
    
    def reserve_inventory(self) -> bool:
        """Call inventory service"""
        try:
            response = requests.post(
                "http://api-gateway/api/inventory/reserve",
                json={
                    "order_id": self.order_id,
                    "items": self.order_data["items"]
                },
                timeout=5
            )
            return response.status_code == 200
        except Exception as e:
            print(f"Inventory service error: {e}")
            return False
    
    def arrange_shipping(self) -> bool:
        """Call shipping service"""
        try:
            response = requests.post(
                "http://api-gateway/api/shipping",
                json={
                    "order_id": self.order_id,
                    "address": self.order_data["address"],
                    "items": self.order_data["items"]
                },
                timeout=5
            )
            return response.status_code == 200
        except Exception as e:
            print(f"Shipping service error: {e}")
            return False
    
    def compensate(self):
        """Execute compensating transactions in reverse"""
        for compensation in reversed(self.compensations):
            try:
                if compensation == "refund_payment":
                    self.refund_payment()
                elif compensation == "release_inventory":
                    self.release_inventory()
                elif compensation == "cancel_shipping":
                    self.cancel_shipping()
            except Exception as e:
                print(f"Compensation error: {e}")
    
    def refund_payment(self):
        """Refund payment"""
        print(f"[{self.order_id}] Refunding payment...")
        # Call payment service to refund
    
    def release_inventory(self):
        """Release reserved inventory"""
        print(f"[{self.order_id}] Releasing inventory...")
        # Call inventory service to release
    
    def cancel_shipping(self):
        """Cancel shipping"""
        print(f"[{self.order_id}] Canceling shipping...")
        # Call shipping service to cancel

# Usage
if __name__ == "__main__":
    order_data = {
        "customer_id": "CUST123",
        "items": [
            {"product_id": "PROD001", "quantity": 2}
        ],
        "total": 99.99,
        "address": "123 Main St"
    }
    
    saga = OrderSaga("ORD123", order_data)
    result = saga.execute()
    print(f"\nResult: {result}")
```

**Saga Execution Flow**:
```
Step 1: Process Payment
├── Success → Continue
└── Fail → Compensate (nothing to undo)

Step 2: Reserve Inventory
├── Success → Continue
└── Fail → Compensate (refund payment)

Step 3: Arrange Shipping
├── Success → Complete
└── Fail → Compensate (refund payment, release inventory)

Step 4: Notify Customer
```

