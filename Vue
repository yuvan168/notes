```typescript
// composables/useKanban.ts
import { ref, computed, watch } from 'vue'
import { useWebSocket } from '@vueuse/core'
import type { Task, Board } from '@/types'

export function useKanban(boardId: string) {
  const tasks = ref<Task[]>([])
  const columns = ref(['Todo', 'In Progress', 'Done'])
  
  const { data: wsData, send: sendWS } = useWebSocket(`ws://api/boards/${boardId}`)
  
  // Group tasks by column
  const tasksByColumn = computed(() => {
    const grouped: Record<string, Task[]> = {}
    columns.value.forEach(col => {
      grouped[col] = tasks.value.filter(task => task.status === col)
    })
    return grouped
  })
  
  // Handle real-time updates
  watch(wsData, (message) => {
    if (!message) return
    
    const { type, payload } = JSON.parse(message)
    
    switch (type) {
      case 'TASK_CREATED':
        tasks.value.push(payload)
        break
      case 'TASK_UPDATED':
        const index = tasks.value.findIndex(t => t.id === payload.id)
        if (index !== -1) {
          tasks.value[index] = payload
        }
        break
      case 'TASK_DELETED':
        tasks.value = tasks.value.filter(t => t.id !== payload.id)
        break
    }
  })
  
  const moveTask = (taskId: string, newStatus: string) => {
    const task = tasks.value.find(t => t.id === taskId)
    if (task) {
      task.status = newStatus
      sendWS(JSON.stringify({
        type: 'TASK_UPDATED',
        payload: task
      }))
    }
  }
  
  return { tasks, tasksByColumn, moveTask, columns }
}
```

