#### CSRF Token Handling

```javascript
// CSRF: Cross-Site Request Forgery
// Attacker tricks you into making unwanted requests

// Solution: CSRF tokens

// Server sends token to client
const csrfToken = document.querySelector('meta[name="csrf-token"]').content

// Client sends token back with state-changing requests
const apiClient = axios.create()

apiClient.interceptors.request.use(config => {
  if (['post', 'put', 'delete'].includes(config.method)) {
    config.headers['X-CSRF-Token'] = csrfToken
  }
  return config
})

// Server verifies token matches before processing request
