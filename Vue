// composables/useChat.ts
import { ref, computed } from 'vue'
import { useWebSocket } from '@vueuse/core'
import { useDateFormat } from '@vueuse/core'
import type { Message, ChatRoom } from '@/types'

export function useChat(roomId: string) {
  const messages = ref<Message[]>([])
  const currentMessage = ref('')
  const isTyping = ref(false)
  const typing = ref<string[]>([])
  
  const { data: wsData, send: sendWS } = useWebSocket(
    `ws://api/chat/${roomId}`
  )
  
  const formattedMessages = computed(() =>
    messages.value.map(msg => ({
      ...msg,
      timestamp: useDateFormat(msg.createdAt, 'HH:mm').value
    }))
  )
  
  const sendMessage = () => {
    if (!currentMessage.value.trim()) return
    
    const message: Message = {
      id: Date.now().toString(),
      content: currentMessage.value,
      userId: useAuth().user.value.id,
      createdAt: new Date(),
      reactions: []
    }
    
    messages.value.push(message)
    sendWS(JSON.stringify({ type: 'MESSAGE', payload: message }))
    currentMessage.value = ''
  }
  
  const notifyTyping = () => {
    sendWS(JSON.stringify({ type: 'TYPING' }))
  }
  
  return {
    messages,
    formattedMessages,
    currentMessage,
    isTyping,
    typing,
    sendMessage,
    notifyTyping
  }
}
```

