<script>
// Notification System with Polling
class NotificationSystem {
    constructor() {
        this.bell = document.getElementById('notificationBell');
        this.badge = document.getElementById('notificationBadge');
        this.dropdown = document.getElementById('notificationDropdown');
        
        this.unreadCount = 0;
        this.notifications = [];
        this.pollingInterval = null;
        this.isDropdownOpen = false;
        
        this.setupEventListeners();
        this.startPolling();
    }
    
    setupEventListeners() {
        // Toggle dropdown
        this.bell.addEventListener('click', (e) => {
            e.stopPropagation();
            this.toggleDropdown();
        });
        
        // Close dropdown on outside click
        document.addEventListener('click', () => {
            if (this.isDropdownOpen) {
                this.closeDropdown();
            }
        });
    }
    
    // Start polling for notifications
    startPolling() {
        // Poll every 10 seconds
        this.pollingInterval = setInterval(() => {
            this.checkForNotifications();
        }, 10000);
        
        // Also check immediately
        this.checkForNotifications();
    }
    
    // Check for new notifications
    async checkForNotifications() {
        try {
            const response = await fetch('/api/notifications', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'include' // Include cookies for auth
            });
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            
            // Update if new notifications
            if (data.notifications && data.notifications.length > 0) {
                this.handleNewNotifications(data.notifications);
            }
            
            // Update unread count
            if (data.unreadCount !== undefined) {
                this.updateBadge(data.unreadCount);
            }
            
        } catch (error) {
            console.error('Error checking notifications:', error);
        }
    }
    
    // Handle new notifications
    handleNewNotifications(newNotifications) {
        // Check for truly new ones
        const existingIds = this.notifications.map(n => n.id);
        const actualNew = newNotifications.filter(n => !existingIds.includes(n.id));
        
        if (actualNew.length > 0) {
            // Add to notifications list
            this.notifications = newNotifications;
            
            // Show notification sound/alert
            this.playNotificationSound();
            
            // Show desktop notification (if permitted)
            this.showDesktopNotification(actualNew[0]);
            
            // Refresh dropdown if open
            if (this.isDropdownOpen) {
                this.displayNotifications();
            }
        }
    }
    
    // Update badge count
    updateBadge(count) {
        this.unreadCount = count;
        
        if (count > 0) {
            this.badge.textContent = count > 99 ? '99+' : count;
            this.badge.classList.add('show');
        } else {
            this.badge.classList.remove('show');
        }
    }
    
    // Display notifications in dropdown
    displayNotifications() {
        this.dropdown.innerHTML = '';
        
        if (this.notifications.length === 0) {
            this.dropdown.innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">No notifications</div>';
            return;
        }
        
        this.notifications.forEach(notification => {
            const div = document.createElement('div');
            div.className = `notification-item ${notification.read ? '' : 'unread'}`;
            
            const title = document.createElement('div');
            title.style.fontWeight = 'bold';
            title.textContent = notification.title;
            
            const message = document.createElement('div');
            message.style.fontSize = '14px';
            message.style.marginTop = '4px';
            message.textContent = notification.message;
            
            const time = document.createElement('div');
            time.className = 'notification-time';
            time.textContent = this.formatTime(notification.timestamp);
            
            div.appendChild(title);
            div.appendChild(message);
            div.appendChild(time);
            
            // Click to mark as read and handle action
            div.addEventListener('click', () => {
                this.markAsRead(notification.id);
                if (notification.action) {
                    window.location.href = notification.action;
                }
            });
            
            this.dropdown.appendChild(div);
        });
    }
    
    // Mark notification as read
    async markAsRead(notificationId) {
        try {
            await fetch(`/api/notifications/${notificationId}/read`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'include'
            });
            
            // Update local state
            const notif = this.notifications.find(n => n.id === notificationId);
            if (notif) {
                notif.read = true;
                this.displayNotifications();
            }
            
        } catch (error) {
            console.error('Error marking as read:', error);
        }
    }
    
    // Toggle dropdown visibility
    toggleDropdown() {
        if (this.isDropdownOpen) {
            this.closeDropdown();
        } else {
            this.openDropdown();
        }
    }
    
    openDropdown() {
        this.isDropdownOpen = true;
        this.dropdown.classList.add('show');
        this.displayNotifications();
    }
    
    closeDropdown() {
        this.isDropdownOpen = false;
        this.dropdown.classList.remove('show');
    }
    
    // Show desktop notification
    showDesktopNotification(notification) {
        if ('Notification' in window && Notification.permission === 'granted') {
            new Notification(notification.title, {
                body: notification.message,
                icon: '/images/icon.png'
            });
        }
    }
    
    // Play notification sound
    playNotificationSound() {
        const audio = new Audio('/sounds/notification.mp3');
        audio.volume = 0.5;
        audio.play().catch(e => console.log('Audio play failed:', e));
    }
    
    // Format timestamp
    formatTime(timestamp) {
        const date = new Date(timestamp);
        const now = new Date();
        const diffMs = now - date;
        const diffMins = Math.floor(diffMs / 60000);
        
        if (diffMins < 1) return 'Just now';
        if (diffMins < 60) return `${diffMins}m ago`;
        
        const diffHours = Math.floor(diffMins / 60);
        if (diffHours < 24) return `${diffHours}h ago`;
        
        return date.toLocaleDateString();
    }
    
    // Stop polling (cleanup)
    destroy() {
        if (this.pollingInterval) {
            clearInterval(this.pollingInterval);
        }
    }
}

// Initialize when page loads
document.addEventListener('DOMContentLoaded', () => {
    const notificationSystem = new NotificationSystem();
    
    // Request desktop notification permission
    if ('Notification' in window && Notification.permission === 'default') {
        Notification.requestPermission();
    }
});
</script>

