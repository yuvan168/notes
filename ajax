//             DISP=(OLD,DELETE)

//PRINTER  DD SYSOUT=*

//*==================================================
//* DEPOSIT - PREPARE ACH FILE FOR BANK
//*==================================================

//DEPOSIT  EXEC PGM=CREATE-ACH,
//              COND=(0,NE,CALC)

//SYSOUT   DD SYSOUT=*

//PAYDATA  DD DSN=&&PAYROLL-DATA,
//             DISP=(OLD,PASS)

//ACHFILE  DD DSN=BANK.ACH.PAYROLL.DIRECT-DEP,
//             DISP=(NEW,CATLG),
//             SPACE=(CYL,(50,25))

//*==================================================
