//REPORT   DD SYSOUT=*

//*==================================================
//* CALCULATE - COMPUTE GROSS PAY AND DEDUCTIONS
//*==================================================

//CALC     EXEC PGM=PAYROLL-CALC,
//              REGION=16M,
//              COND=(0,NE,VALIDATE)

//SYSOUT   DD SYSOUT=*

//TIMECARD DD DSN=&&VALID-TIMECARDS,
