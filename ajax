//EMPFILE  DD DSN=HR.EMPLOYEES.MASTER,
//             DISP=SHR

//TAXRATES DD DSN=HR.TAX.RATES.CURRENT,
//             DISP=SHR

//PAYDATA  DD DSN=&&PAYROLL-DATA,
