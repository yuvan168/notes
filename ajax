## Advanced Patterns

### Q17: Implement a request queue and retry mechanism

**Answer:**

```javascript
class RequestQueue {
    constructor(maxConcurrent = 3, maxRetries = 3) {
        this.queue = [];
        this.active = 0;
        this.maxConcurrent = maxConcurrent;
        this.maxRetries = maxRetries;
        this.inFlight = new Map();
    }
    
    async enqueue(url, options = {}) {
        return new Promise((resolve, reject) => {
            this.queue.push({ url, options, resolve, reject, retries: 0 });
            this.process();
        });
    }
    
    async process() {
        while (this.active < this.maxConcurrent && this.queue.length > 0) {
            this.active++;
            const task = this.queue.shift();
            
            try {
                const result = await this.fetchWithRetry(task);
                task.resolve(result);
            } catch (error) {
                task.reject(error);
            } finally {
                this.active--;
                this.process(); // Process next in queue
            }
        }
    }
    
    async fetchWithRetry(task) {
        while (task.retries < this.maxRetries) {
            try {
                const response = await fetch(task.url, task.options);
                
                if (response.ok) {
                    return await response.json();
                }
                
                // Don't retry on 4xx errors
                if (response.status >= 400 && response.status < 500) {
                    throw new Error(`HTTP ${response.status}`);
                }
                
                // Retry on 5xx
                throw new Error(`HTTP ${response.status}`);
                
            } catch (error) {
                task.retries++;
                
                if (task.retries >= this.maxRetries) {
                    throw new Error(
                        `Failed after ${this.maxRetries} attempts: ${error.message}`
                    );
                }
                
                // Exponential backoff
                const delay = Math.pow(2, task.retries - 1) * 1000;
                await new Promise(resolve => setTimeout(resolve, delay));
            }
        }
    }
}

// Usage
const queue = new RequestQueue(3, 3); // 3 concurrent, 3 retries

const requests = [
    queue.enqueue('/api/users/1'),
    queue.enqueue('/api/users/2'),
    queue.enqueue('/api/users/3'),
    queue.enqueue('/api/users/4'),
    queue.enqueue('/api/users/5'),
];

const results = await Promise.all(requests);
```

