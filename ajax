//*==================================================
//* STEP 3: DELETE TEMPORARY FILES
//*==================================================

//CLEANUP  EXEC PGM=DELETE-TEMPORARY-FILES,
//              COND=(0,NE)

//SYSOUT   DD SYSOUT=*

//CATALOG  DD DUMMY

//*==================================================
//* STEP 4: REPORT SPACE UTILIZATION
//*==================================================

//SPACERPT EXEC PGM=SPACE-UTILIZATION,
//              COND=(0,NE)

//SYSOUT   DD SYSOUT=*

//REPORT   DD SYSOUT=*

//

