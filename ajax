### Q6: How do you handle errors in XMLHttpRequest?

**Answer:**

**Multiple error types to handle:**

```
1. NETWORK ERRORS
   └─ Connection refused
   └─ DNS lookup failed
   └─ Network unreachable
   └─ Event: onerror

2. TIMEOUT ERRORS
   └─ Request took too long
   └─ Exceeded timeout value
   └─ Event: ontimeout

3. HTTP ERRORS (4xx, 5xx)
   └─ Bad request (400)
   └─ Unauthorized (401)
   └─ Server error (500)
   └─ Status code > 300 (usually error)

4. ABORT ERRORS
   └─ Request cancelled by user
   └─ Event: onabort

5. PARSING ERRORS
   └─ Invalid JSON response
   └─ Malformed XML
   └─ Cannot parse response
```

**Comprehensive error handling:**

```javascript
function robustAjaxRequest(url, options = {}) {
    const xhr = new XMLHttpRequest();
    const method = options.method || 'GET';
    const timeout = options.timeout || 10000;
    const onSuccess = options.onSuccess || (() => {});
    const onError = options.onError || (() => {});
    
    // Configure request
    xhr.open(method, url, true);
    xhr.timeout = timeout;
    
    // Set headers
    if (options.headers) {
        Object.keys(options.headers).forEach(key => {
            xhr.setRequestHeader(key, options.headers[key]);
        });
    }
    
    // Success handler
    xhr.onload = function() {
        try {
            if (xhr.status >= 200 && xhr.status < 300) {
                // Success (2xx status)
                let data;
                if (xhr.getResponseHeader('content-type')?.includes('application/json')) {
                    data = JSON.parse(xhr.responseText);
                } else {
                    data = xhr.responseText;
                }
                onSuccess(data);
            } else {
                // HTTP error (4xx, 5xx)
                const error = {
                    status: xhr.status,
                    statusText: xhr.statusText,
                    message: `HTTP Error: ${xhr.status} ${xhr.statusText}`,
                    response: xhr.responseText
                };
                onError(error);
            }
        } catch (parseError) {
            // JSON parsing error
            const error = {
                type: 'PARSE_ERROR',
                message: 'Failed to parse response',
                details: parseError.message
            };
            onError(error);
        }
    };
    
    // Network error
    xhr.onerror = function() {
        onError({
            type: 'NETWORK_ERROR',
            message: 'Network error - check your connection'
        });
    };
    
    // Timeout error
    xhr.ontimeout = function() {
        onError({
            type: 'TIMEOUT_ERROR',
            message: `Request timeout after ${timeout}ms`,
            timeout: timeout
        });
    };
    
    // Abort error
    xhr.onabort = function() {
        onError({
            type: 'ABORT_ERROR',
            message: 'Request was cancelled'
        });
    };
    
    // Progress tracking
    if (options.onProgress) {
        xhr.onprogress = function(event) {
            if (event.lengthComputable) {
                const progress = (event.loaded / event.total) * 100;
                options.onProgress(progress);
            }
        };
    }
    
    // Send request
    xhr.send(options.data || null);
    
    // Return abort function for manual cancellation
    return () => xhr.abort();
}

// Usage:
const cancelRequest = robustAjaxRequest('/api/data', {
    method: 'GET',
    timeout: 5000,
    headers: { 'Authorization': 'Bearer token' },
    onSuccess: (data) => {
        console.log('Success:', data);
    },
    onError: (error) => {
        console.error(`Error [${error.type}]: ${error.message}`);
        // Show user-friendly error message
        if (error.type === 'NETWORK_ERROR') {
            showAlert('Unable to connect. Check your internet connection.');
        } else if (error.type === 'TIMEOUT_ERROR') {
            showAlert('Request took too long. Please try again.');
        } else if (error.status === 401) {
            // Redirect to login
            window.location.href = '/login';
        }
    },
    onProgress: (percent) => {
        updateProgressBar(percent);
    }
});

// Can cancel: cancelRequest();
```

