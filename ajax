User Experience:
├─ Type: "ja"
├─ Suggestions: JavaScript, Java, JSON
├─ Type more: "javas"
├─ Suggestions: JavaScript
├─ Press Enter or click
├─ Navigate to search results
```

**Theory Behind Autocomplete:**

```
Challenges:
├─ MANY requests (one per keystroke)
├─ Network latency
├─ User types faster than server responds
├─ Show suggestions from cache or server
└─ Must handle race conditions

Solution:
├─ Debounce: Wait 300ms after typing stops
├─ Cache results locally
├─ Cancel previous requests if new one sent
├─ Show cached results immediately
├─ Fetch new results in background
```

**Complete Implementation:**

```html
<!DOCTYPE html>
<html>
<head>
    <style>
        .search-container {
            position: relative;
            width: 400px;
        }
        
        .search-input {
            width: 100%;
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        
        .suggestions {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            border: 1px solid #ccc;
            border-top: none;
            max-height: 300px;
            overflow-y: auto;
            background: white;
            display: none;
        }
        
        .suggestions.show {
            display: block;
        }
        
        .suggestion-item {
            padding: 10px;
            cursor: pointer;
            border-bottom: 1px solid #eee;
        }
        
        .suggestion-item:hover,
        .suggestion-item.selected {
            background-color: #f0f0f0;
        }
        
        .loading {
            color: #999;
            font-style: italic;
        }
        
        .error {
            color: #d32f2f;
        }
    </style>
</head>
<body>

<div class="search-container">
    <input type="text" class="search-input" placeholder="Search...">
    <div class="suggestions"></div>
</div>

<script>
// Autocomplete Implementation with Debouncing
class SearchAutocomplete {
    constructor() {
        this.input = document.querySelector('.search-input');
        this.suggestions = document.querySelector('.suggestions');
        this.debounceTimer = null;
        this.cache = {}; // Cache for search results
        this.currentRequest = null; // Track current request
        this.selectedIndex = -1; // For keyboard navigation
        
        // Event listeners
        this.input.addEventListener('input', (e) => this.handleInput(e));
        this.input.addEventListener('keydown', (e) => this.handleKeyboard(e));
        document.addEventListener('click', (e) => this.handleClickOutside(e));
    }
    
    // Debounce: Wait for user to stop typing
    handleInput(event) {
        const query = event.target.value.trim();
        
        // Cancel previous debounce timer
        clearTimeout(this.debounceTimer);
        
        // Hide if empty
        if (!query) {
            this.hideSuggestions();
            return;
        }
        
        // Show loading state
        this.showLoading();
        
        // Wait 300ms before making request
        this.debounceTimer = setTimeout(() => {
            this.fetchSuggestions(query);
        }, 300);
    }
    
    // Fetch suggestions from server
    async fetchSuggestions(query) {
        // Check cache first
        if (this.cache[query]) {
            this.displaySuggestions(this.cache[query], query);
            return;
        }
        
        try {
            // Cancel previous request if exists
            if (this.currentRequest) {
                this.currentRequest.abort();
            }
            
            // Create new request
            this.currentRequest = new AbortController();
            
            const response = await fetch(`/api/search/suggestions?q=${encodeURIComponent(query)}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                signal: this.currentRequest.signal
            });
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            
            // Cache results
            this.cache[query] = data.suggestions || [];
            
            // Display suggestions
            this.displaySuggestions(this.cache[query], query);
            
        } catch (error) {
            if (error.name !== 'AbortError') {
                console.error('Error fetching suggestions:', error);
                this.showError('Error loading suggestions');
            }
        }
    }
    
    // Display suggestions on page
    displaySuggestions(items, query) {
        if (!items || items.length === 0) {
            this.showNotFound();
            return;
        }
        
        // Clear previous suggestions
        this.suggestions.innerHTML = '';
        this.selectedIndex = -1;
        
        // Create suggestion items
        items.forEach((item, index) => {
            const div = document.createElement('div');
            div.className = 'suggestion-item';
            div.textContent = item.label || item;
            div.setAttribute('data-value', item.value || item);
            div.setAttribute('data-index', index);
            
            // Click to select
            div.addEventListener('click', () => this.selectItem(item));
            
            this.suggestions.appendChild(div);
        });
        
        // Show suggestions
        this.suggestions.classList.add('show');
    }
    
    // Keyboard navigation
    handleKeyboard(event) {
        const items = this.suggestions.querySelectorAll('.suggestion-item');
        
        switch (event.key) {
            case 'ArrowDown':
                event.preventDefault();
                this.selectedIndex = Math.min(this.selectedIndex + 1, items.length - 1);
                this.updateSelection(items);
                break;
                
            case 'ArrowUp':
                event.preventDefault();
                this.selectedIndex = Math.max(this.selectedIndex - 1, -1);
                this.updateSelection(items);
                break;
                
            case 'Enter':
                event.preventDefault();
                if (this.selectedIndex >= 0) {
                    const selectedItem = items[this.selectedIndex];
                    this.selectItem(selectedItem.getAttribute('data-value'));
                }
                break;
                
            case 'Escape':
                this.hideSuggestions();
                break;
        }
    }
    
    // Update visual selection
    updateSelection(items) {
        items.forEach((item, index) => {
            if (index === this.selectedIndex) {
                item.classList.add('selected');
