class ShoppingCart {
    constructor() {
        this.items = [];
        this.cartId = this.getOrCreateCartId();
        this.loadFromServer();
    }
    
    async addToCart(productId, quantity = 1) {
        try {
            // Optimistic update
            this.items.push({ productId, quantity });
            this.updateUI();
            
            // Send to server
            const response = await fetch('/api/cart/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId, quantity, cartId: this.cartId })
            });
            
            const result = await response.json();
            
            if (!response.ok) {
                // Revert on error
                this.items = this.items.filter(i => i.productId !== productId);
                this.updateUI();
                throw new Error(result.message);
            }
            
            // Update with server response
            this.loadFromServer();
            
        } catch (error) {
            console.error('Error adding to cart:', error);
            alert(error.message);
        }
    }
    
    async updateQuantity(productId, quantity) {
        try {
            const response = await fetch('/api/cart/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId, quantity, cartId: this.cartId })
            });
            
            if (response.ok) {
                this.loadFromServer();
            }
        } catch (error) {
            console.error('Error updating quantity:', error);
        }
    }
    
    async loadFromServer() {
        const response = await fetch(`/api/cart/${this.cartId}`);
        const data = await response.json();
        this.items = data.items;
        this.updateUI();
    }
    
    updateUI() {
        // Update DOM elements
        const total = this.items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        document.getElementById('cartTotal').textContent = `$${total.toFixed(2)}`;
        document.getElementById('cartCount').textContent = this.items.length;
    }
}
