## XMLHttpRequest in Depth

### Q4: What is XMLHttpRequest and how do you use it?

**Answer:**

XMLHttpRequest (XHR) is a browser API that allows JavaScript to make HTTP requests asynchronously.

**Basic structure:**

```javascript
const xhr = new XMLHttpRequest();

// 1. Configure the request
xhr.open(method, url, async);

// 2. Set request headers
xhr.setRequestHeader(header, value);

// 3. Set up response handling
xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) { // DONE
        if (xhr.status === 200) { // Success
            // Handle response
        } else {
            // Handle error
        }
    }
};

// 4. Send the request
xhr.send(data);
```

**Complete example with GET request:**

```javascript
function fetchUserData(userId) {
    const xhr = new XMLHttpRequest();
    
    // Configure request
    xhr.open('GET', `/api/users/${userId}`, true);
    
    // Set headers
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.setRequestHeader('Content-Type', 'application/json');
    
    // Handle response
    xhr.onreadystatechange = function() {
        if (xhr.readyState === 4) {
            if (xhr.status === 200) {
                const user = JSON.parse(xhr.responseText);
                console.log('User:', user);
                displayUser(user);
            } else if (xhr.status === 404) {
                console.error('User not found');
                showError('User not found');
            } else {
                console.error(`Error: ${xhr.status}`);
                showError(`Server error: ${xhr.status}`);
            }
        }
    };
    
    // Handle network errors
    xhr.onerror = function() {
        console.error('Network error');
        showError('Network error - please try again');
    };
    
    // Handle timeout
    xhr.timeout = 10000; // 10 seconds
    xhr.ontimeout = function() {
        console.error('Request timeout');
        showError('Request timed out');
    };
    
    // Send request
    xhr.send(null);
}
```

**POST request example:**

```javascript
function submitForm(formData) {
    const xhr = new XMLHttpRequest();
    
    xhr.open('POST', '/api/users', true);
    
    // Important for POST requests
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
    
    xhr.onload = function() {
        if (xhr.status === 201) { // Created
            const newUser = JSON.parse(xhr.responseText);
            console.log('User created:', newUser);
        } else if (xhr.status === 400) { // Bad request
            const errors = JSON.parse(xhr.responseText);
            console.error('Validation errors:', errors);
        }
    };
    
    xhr.onerror = function() {
        console.error('Failed to submit form');
    };
    
    // Convert data to JSON
    const jsonData = JSON.stringify(formData);
    xhr.send(jsonData);
}
```

