//* COLLECT - GATHER TIMECARDS FROM MULTIPLE LOCATIONS
//*==================================================

//COLLECT  EXEC PGM=COLLECT-TIMECARDS

//SYSOUT   DD SYSOUT=*

//LOCATION1 DD DSN=LOCATION1.TIMECARDS.WEEKLY,
