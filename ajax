//              DISP=SHR

//ALLCARDS DD DSN=&&COLLECTED-TIMECARDS,
//             DISP=(NEW,PASS),
//             SPACE=(CYL,(100,50))

//*==================================================
//* VALIDATE - CHECK FOR ERRORS
//*==================================================

//VALIDATE EXEC PGM=VALIDATE-TIMECARDS,
