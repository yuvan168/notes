### Q5: What are the different readyState values and what do they mean?

**Answer:**

readyState indicates the current state of an XMLHttpRequest.

**All values:**

```
readyState = 0: UNSENT
  └─ Request object created
  └─ open() not yet called
  └─ Example: const xhr = new XMLHttpRequest();

readyState = 1: OPENED
  └─ open() has been called
  └─ send() not yet called
  └─ Example: xhr.open('GET', url, true);

readyState = 2: HEADERS_RECEIVED
  └─ send() has been called
  └─ Response headers received
  └─ Status and statusText available
  └─ Response body not yet received

readyState = 3: LOADING
  └─ Response body is being downloaded
  └─ Partial data available in responseText
  └─ Can be used to show download progress
  └─ Example: Downloading large files

readyState = 4: DONE
  └─ Request complete (success or failure)
  └─ Full response available
  └─ Use this state for final processing
  └─ Either status 200 or error code
```

**Practical example using readyState:**

```javascript
const xhr = new XMLHttpRequest();

xhr.onreadystatechange = function() {
    switch (xhr.readyState) {
        case 0: // UNSENT
            console.log('Request not yet created');
            break;
            
        case 1: // OPENED
            console.log('Request opened, preparing to send');
            break;
            
        case 2: // HEADERS_RECEIVED
            console.log('Headers received');
            console.log(`Status: ${xhr.status} ${xhr.statusText}`);
            break;
            
        case 3: // LOADING
            console.log('Downloading response...');
            // Can show progress here
            const percentComplete = (xhr.loaded / xhr.total) * 100;
            console.log(`Progress: ${percentComplete}%`);
            break;
            
        case 4: // DONE
            console.log('Request complete!');
            if (xhr.status === 200) {
                console.log('Success:', xhr.responseText);
            } else {
                console.log('Error:', xhr.status);
            }
            break;
    }
};

xhr.open('GET', '/api/data', true);
xhr.send();
```

**Better approach using onload:**

```javascript
// Instead of checking readyState === 4, use these events:

const xhr = new XMLHttpRequest();

xhr.onload = function() {
    // Automatically fires when readyState === 4 AND status is ok
    console.log(xhr.responseText);
};

xhr.onerror = function() {
    // Fires if network error occurs
    console.error('Network error');
};

xhr.onprogress = function(event) {
    // Fires during download (readyState === 3)
    if (event.lengthComputable) {
        const progress = (event.loaded / event.total) * 100;
        console.log(`Downloaded: ${progress}%`);
    }
};

xhr.open('GET', '/api/data', true);
xhr.send();
