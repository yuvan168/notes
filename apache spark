### Application 4: ETL Pipeline - Data Lake Ingestion & Transformation

**Business Context:**
Enterprise needs to ingest data from 50+ source systems (databases, APIs, files) into a data lake for unified analytics.

**Problem Statement:**
- Handle diverse source formats and schemas
- Ensure data quality and consistency
- Detect schema changes automatically
- Track data lineage
- Handle incremental loads efficiently

**Implementation:**

```python
from pyspark.sql import SparkSession
from pyspark.sql.functions import (
    col, current_timestamp, md5, concat_ws, lit,
    year, month, day, when, coalesce
)
from pyspark.sql.types import StructType, StructField, StringType, IntegerType

spark = SparkSession.builder \
    .appName("Enterprise ETL") \
    .config("spark.sql.adaptive.enabled", "true") \
    .master("local[*]") \
    .getOrCreate()

# ===== UNIFIED SOURCE CONNECTOR =====
def read_source(source_type, config):
    """
    Unified function to read from different sources
    """
    if source_type == "sql_server":
        return spark.read \
            .format("jdbc") \
            .option("url", config["url"]) \
            .option("dbtable", config["table"]) \
            .option("user", config["user"]) \
            .option("password", config["password"]) \
            .option("numPartitions", 10) \
            .load()
    
    elif source_type == "postgresql":
        return spark.read \
            .format("jdbc") \
            .option("url", config["url"]) \
            .option("dbtable", config["table"]) \
            .option("user", config["user"]) \
            .option("password", config["password"]) \
            .option("driver", "org.postgresql.Driver") \
            .load()
    
    elif source_type == "csv":
        return spark.read \
            .option("header", "true") \
            .option("inferSchema", "true") \
            .csv(config["path"])
    
    elif source_type == "parquet":
        return spark.read.parquet(config["path"])
    
    elif source_type == "api":
        # Simplified - would typically use requests library
        import requests
        import pandas as pd
        data = requests.get(config["url"]).json()
        pdf = pd.DataFrame(data)
        return spark.createDataFrame(pdf)
    
    else:
        raise ValueError(f"Unknown source type: {source_type}")

# ===== SOURCE CONFIGURATIONS =====
sources_config = [
    {
        "name": "customers_db",
        "type": "sql_server",
        "url": "jdbc:sqlserver://db.company.com:1433;database=CRM",
        "table": "dbo.Customers",
        "user": "etl_user",
        "password": "***",
        "business_key": ["customer_id"],
        "incremental": True,
        "timestamp_col": "updated_at"
    },
    {
        "name": "products_db",
        "type": "postgresql",
        "url": "jdbc:postgresql://db.company.com:5432/inventory",
        "table": "public.products",
        "user": "etl_user",
        "password": "***",
        "business_key": ["product_id"],
        "incremental": False
    },
    {
        "name": "sales_csv",
        "type": "csv",
        "path": "/data/raw/sales_*.csv",
        "business_key": ["order_id", "line_item"],
        "incremental": True,
        "timestamp_col": "sale_date"
    },
    {
        "name": "weather_api",
        "type": "api",
        "url": "https://api.weather.com/data",
        "business_key": ["location", "date"],
        "incremental": True
    }
]

# ===== INCREMENTAL LOAD TRACKING =====
def get_last_checkpoint(source_name):
    """Get last successful load timestamp"""
    try:
        checkpoint = spark.read.parquet(f"/checkpoints/{source_name}").collect()[0]
        return checkpoint["last_load_time"]
    except:
        return None

def save_checkpoint(source_name, timestamp):
    """Save checkpoint after successful load"""
    checkpoint_df = spark.createDataFrame(
        [(timestamp,)],
        ["last_load_time"]
    )
    checkpoint_df.write.mode("overwrite").parquet(f"/checkpoints/{source_name}")

# ===== DATA QUALITY FRAMEWORK =====
def validate_data_quality(df, quality_rules):
    """Apply data quality checks"""
    issues = {}
    
    for rule_name, rule_func in quality_rules.items():
        result = df.filter(~rule_func(df)).count()
        if result > 0:
            issues[rule_name] = result
    
    return issues

# ===== MAIN ETL PROCESS =====
def process_source(source_config):
    """
    ETL process for a single source
    Extract → Transform → Quality Check → Load
    """
    
    source_name = source_config["name"]
    print(f"\n{'='*60}")
    print(f"Processing source: {source_name}")
    print(f"{'='*60}")
    
    # ===== EXTRACT =====
    print(f"[EXTRACT] Reading from {source_name}...")
    
    if source_config["incremental"]:
        last_checkpoint = get_last_checkpoint(source_name)
        config_copy = source_config.copy()
        
        # Add incremental filter
        if last_checkpoint and source_config.get("timestamp_col"):
            config_copy["extra_filter"] = f"{source_config['timestamp_col']} > '{last_checkpoint}'"
        
        df_raw = read_source(source_config["type"], config_copy)
    else:
        df_raw = read_source(source_config["type"], source_config)
    
    record_count = df_raw.count()
    print(f"[EXTRACT] Loaded {record_count:,} records")
    
    # ===== TRANSFORM =====
    print(f"[TRANSFORM] Applying business logic...")
    
    # Add metadata columns
    df_transformed = df_raw \
        .withColumn("_source_system", lit(source_name)) \
        .withColumn("_load_timestamp", current_timestamp()) \
        .withColumn("_load_date", current_timestamp().cast("date")) \
        .withColumn(
            "_record_hash",
            md5(concat_ws("||", *df_raw.columns))
        )
    
    # Apply transformations specific to source
    if source_name == "customers_db":
        df_transformed = df_transformed \
            .filter(col("customer_status") != "deleted") \
            .withColumn("email", lower(col("email"))) \
            .withColumn("country", upper(col("country"))) \
            .withColumn("is_vip", when(col("lifetime_value") > 100000, 1).otherwise(0))
    
    elif source_name == "products_db":
        df_transformed = df_transformed \
            .filter(col("active") == True) \
            .withColumn("category", lower(col("category"))) \
            .withColumn("margin_percent", (col("price") - col("cost")) / col("price") * 100)
    
    elif source_name == "sales_csv":
        df_transformed = df_transformed \
            .withColumn("sale_date", to_date(col("sale_date"), "yyyy-MM-dd")) \
            .withColumn("quantity", col("quantity").cast("int")) \
            .withColumn("amount", col("amount").cast("decimal(10,2)"))
    
    transformed_count = df_transformed.count()
    print(f"[TRANSFORM] Transformed {transformed_count:,} records")
    
    # ===== DATA QUALITY CHECKS =====
    print(f"[QUALITY] Checking data quality...")
    
    quality_rules = {
        "null_business_key": lambda df: ~df[source_config["business_key"]].isnull().any(axis=1),
        "valid_dates": lambda df: (col("created_at") <= col("updated_at")) if "created_at" in df.columns else True,
        "positive_amounts": lambda df: (col("amount") >= 0) if "amount" in df.columns else True
    }
    
    quality_issues = validate_data_quality(df_transformed, quality_rules)
    
    if quality_issues:
        print(f"[QUALITY] Issues detected: {quality_issues}")
        # Quarantine problematic records
        for rule_name, count in quality_issues.items():
            problem_df = df_transformed.filter(~quality_rules[rule_name](df_transformed))
            problem_df.write.mode("append").parquet(f"/quarantine/{source_name}/{rule_name}")
            print(f"[QUALITY] Quarantined {count} records for rule: {rule_name}")
    
    else:
        print(f"[QUALITY] All quality checks passed ✓")
    
    # ===== LOAD =====
    print(f"[LOAD] Writing to data lake...")
    
    # Partition by date for efficient querying
    df_transformed \
        .repartition(50, "_load_date") \
        .write \
        .mode("append") \
        .partitionBy("_load_date") \
        .parquet(f"/data/bronze/{source_name}")
    
    print(f"[LOAD] Successfully loaded to bronze layer")
    
    # ===== CHECKPOINT =====
    if source_config["incremental"] and source_config.get("timestamp_col"):
        max_timestamp = df_raw.agg({source_config["timestamp_col"]: "max"}).collect()[0][0]
        save_checkpoint(source_name, max_timestamp)
        print(f"[CHECKPOINT] Saved checkpoint: {max_timestamp}")
    
    return {
        "source": source_name,
        "status": "success",
        "records_loaded": transformed_count,
        "quality_issues": len(quality_issues)
    }

# ===== ORCHESTRATION =====
load_results = []

for source_config in sources_config:
    try:
        result = process_source(source_config)
        load_results.append(result)
    except Exception as e:
        print(f"[ERROR] Failed to process {source_config['name']}: {str(e)}")
        load_results.append({
            "source": source_config['name'],
            "status": "failed",
            "error": str(e)
        })

# ===== GENERATE ETL REPORT =====
print(f"\n{'='*60}")
print("ETL EXECUTION SUMMARY")
print(f"{'='*60}")

for result in load_results:
    status_icon = "✓" if result["status"] == "success" else "✗"
    print(f"{status_icon} {result['source']:20} | {result['status']:10} | {result.get('records_loaded', 'N/A')} records")

# Save report
report_df = spark.createDataFrame(load_results)
report_df.write.mode("append").parquet("/data/etl_reports")

spark.stop()
```

**ETL Best Practices Demonstrated:**
- Unified source abstraction handles diverse systems
- Incremental loading reduces data transfer and processing
- Data quality framework catches issues early
- Metadata tracking enables audit trails
- Checkpoint mechanism recovers from failures
- Quarantine area isolates problematic records
- Partitioning optimizes downstream queries

