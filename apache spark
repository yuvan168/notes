### Application 3: Machine Learning Pipeline - Customer Churn Prediction

**Business Context:**
A telecom company wants to predict which customers are likely to churn (cancel service) so they can proactively offer retention deals.

**Problem Statement:**
- Predict customer churn 30 days in advance
- Handle imbalanced classes (churn is rare event)
- Explain which features drive churn
- Score all customers in batch daily
- A/B test retention offers

**Implementation:**

```python
from pyspark.sql import SparkSession
from pyspark.sql.functions import col, when, datediff, lit, rand
from pyspark.ml import Pipeline, PipelineModel
from pyspark.ml.feature import (
    StringIndexer, OneHotEncoder, VectorAssembler, StandardScaler
)
from pyspark.ml.classification import RandomForestClassifier, LogisticRegression
from pyspark.ml.evaluation import BinaryClassificationEvaluator, MulticlassClassificationEvaluator
from pyspark.ml.tuning import CrossValidator, ParamGridBuilder

spark = SparkSession.builder \
    .appName("Churn Prediction") \
    .config("spark.sql.adaptive.enabled", "true") \
    .master("local[*]") \
    .getOrCreate()

# ===== LOAD DATA =====
customer_data = spark.read.parquet("/data/customers_full")
service_data = spark.read.parquet("/data/services")
billing_data = spark.read.parquet("/data/billing")
churn_labels = spark.read.parquet("/data/churn_labels")  # Historical labels

# ===== DATA PREPARATION =====
# Join datasets
full_data = customer_data \
    .join(service_data, "customer_id", "left") \
    .join(billing_data, "customer_id", "left") \
    .join(churn_labels, "customer_id", "left")

# Calculate features
# Recency: days since last service interaction
# Frequency: number of service changes
# Monetary: average monthly bill
features_df = full_data \
    .withColumn(
        "days_since_last_interaction",
        datediff(lit(datetime.now()), col("last_interaction_date"))
    ) \
    .withColumn(
        "monthly_bill_increase",
        (col("current_bill") - col("bill_6_months_ago")) / col("bill_6_months_ago") * 100
    ) \
    .withColumn(
        "support_ticket_ratio",
        col("support_tickets") / greatest(col("months_as_customer"), 1)
    ) \
    .withColumn(
        "has_long_contract",
        when(col("contract_length_months") > 12, 1).otherwise(0)
    ) \
    .select(
        "customer_id",
        "age",
        "gender",
        "service_type",
        "monthly_charges",
        "tenure_months",
        "total_charges",
        "days_since_last_interaction",
        "monthly_bill_increase",
        "support_ticket_ratio",
        "has_long_contract",
        "churn"  # Target variable
    )

# Handle missing values
features_df = features_df.na.fill(
    {
        "monthly_bill_increase": 0,
        "support_ticket_ratio": 0,
        "days_since_last_interaction": 999
    }
)

# Balance classes (churn is ~20% of data)
churn_positive = features_df.filter(col("churn") == 1)
churn_negative = features_df.filter(col("churn") == 0)

# Downsample negative class
churn_negative_sampled = churn_negative.sample(
    withReplacement=False,
    fraction=churn_positive.count() / churn_negative.count() * 0.8
)

balanced_df = churn_positive.union(churn_negative_sampled)

# Split train/test
train_df, test_df = balanced_df.randomSplit([0.8, 0.2], seed=42)

print(f"Training set size: {train_df.count()}")
print(f"Test set size: {test_df.count()}")

# ===== FEATURE ENGINEERING PIPELINE =====
# String indexing
gender_indexer = StringIndexer(inputCol="gender", outputCol="gender_idx")
service_indexer = StringIndexer(inputCol="service_type", outputCol="service_idx")

# One-hot encoding
gender_encoder = OneHotEncoder(inputCols=["gender_idx"], outputCols=["gender_vec"])
service_encoder = OneHotEncoder(inputCols=["service_idx"], outputCols=["service_vec"])

# Feature assembly
feature_columns = [
    "age", "tenure_months", "monthly_charges", "total_charges",
    "days_since_last_interaction", "monthly_bill_increase",
    "support_ticket_ratio", "has_long_contract",
    "gender_vec", "service_vec"
]
assembler = VectorAssembler(inputCols=feature_columns, outputCol="features")

# Scaling
scaler = StandardScaler(inputCol="features", outputCol="scaled_features")

# ===== TRAIN MODEL WITH HYPERPARAMETER TUNING =====
rf = RandomForestClassifier(
    featuresCol="scaled_features",
    labelCol="churn",
    numTrees=100,
    seed=42,
    weightCol=None
)

# Create pipeline
pipeline = Pipeline(stages=[
    gender_indexer, service_indexer,
    gender_encoder, service_encoder,
    assembler, scaler,
    rf
])

# Hyperparameter grid
param_grid = ParamGridBuilder() \
    .addGrid(rf.maxDepth, [5, 10, 15]) \
    .addGrid(rf.numTrees, [50, 100, 200]) \
    .addGrid(rf.minInstancesPerNode, [1, 5, 10]) \
    .build()

# Cross-validator
evaluator = BinaryClassificationEvaluator(labelCol="churn", metricName="areaUnderROC")
cv = CrossValidator(
    estimator=pipeline,
    estimatorParamMaps=param_grid,
    evaluator=evaluator,
    numFolds=5
)

# Train with cross-validation
print("Training model with cross-validation...")
cv_model = cv.fit(train_df)

# Get best model
best_model = cv_model.bestModel

# ===== EVALUATE MODEL =====
predictions = best_model.transform(test_df)

# ROC-AUC
auc = evaluator.evaluate(predictions)
print(f"ROC-AUC Score: {auc:.4f}")

# Accuracy
accuracy_evaluator = MulticlassClassificationEvaluator(
    labelCol="churn",
    predictionCol="prediction",
    metricName="accuracy"
)
accuracy = accuracy_evaluator.evaluate(predictions)
print(f"Accuracy: {accuracy:.4f}")

# Precision & Recall
precision_evaluator = MulticlassClassificationEvaluator(
    labelCol="churn",
    predictionCol="prediction",
    metricName="weightedPrecision"
)
recall_evaluator = MulticlassClassificationEvaluator(
    labelCol="churn",
    predictionCol="prediction",
    metricName="weightedRecall"
)
print(f"Precision: {precision_evaluator.evaluate(predictions):.4f}")
print(f"Recall: {recall_evaluator.evaluate(predictions):.4f}")

# Feature importance
feature_importance = best_model.stages[-1].featureImportances
feature_names = feature_columns

importance_df = spark.createDataFrame(
    [(feature_names[i], float(feature_importance[i])) for i in range(len(feature_names))],
    ["feature", "importance"]
).orderBy("importance", ascending=False)

print("\n=== TOP FEATURES DRIVING CHURN ===")
importance_df.show()

# ===== SAVE MODEL =====
best_model.save("/models/churn_prediction_model")

# ===== BATCH SCORING ALL CUSTOMERS =====
all_customers = spark.read.parquet("/data/customers_for_scoring")
scored_customers = best_model.transform(all_customers)

churn_risk = scored_customers \
    .select(
        col("customer_id"),
        col("prediction").alias("will_churn"),
        col("probability")[1].alias("churn_probability")
    ) \
    .filter(col("churn_probability") > 0.6) \
    .orderBy(col("churn_probability").desc())

print("\n=== HIGH-RISK CHURN CUSTOMERS ===")
churn_risk.show()

# ===== A/B TEST RETENTION OFFERS =====
# Randomly assign customers to control and treatment groups
test_customers = churn_risk \
    .withColumn("random", rand()) \
    .withColumn(
        "test_group",
        when(col("random") < 0.5, "control").otherwise("treatment")
    ) \
    .select("customer_id", "churn_probability", "test_group")

# Save for retention offer execution
test_customers.write.mode("overwrite").parquet("/data/retention_ab_test")

print(f"Customers for retention offers: {churn_risk.count()}")
print(f"Control group: {test_customers.filter(col('test_group') == 'control').count()}")
print(f"Treatment group: {test_customers.filter(col('test_group') == 'treatment').count()}")

spark.stop()
```

**Key Learnings:**
- Handle class imbalance through sampling for better predictions
- Cross-validation finds optimal hyperparameters
- Feature importance reveals business drivers of churn
- Batch scoring allows targeted interventions
- A/B testing measures intervention effectiveness

