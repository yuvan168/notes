**Q16: How would you implement real-time fraud detection in Spark?**

A: Combine streaming with stateful operations and historical data.

**Architecture**:
```python
spark = SparkSession.builder.getOrCreate()

# Historical fraud patterns
fraud_patterns = spark.read.parquet("/data/fraud_rules")
broadcast_patterns = broadcast(fraud_patterns)

# Real-time transactions
transactions = spark.readStream \
    .format("kafka") \
    .option("kafka.bootstrap.servers", "localhost:9092") \
    .option("subscribe", "transactions") \
    .load() \
    .select(from_json(col("value").cast("string"), schema).alias("data")) \
    .select("data.*")

# Detect fraud
suspicious = transactions \
    .withWatermark("timestamp", "10 minutes") \
    .groupBy("user_id", window(col("timestamp"), "5 minutes")) \
    .agg(
        count("*").alias("transaction_count"),
        sum("amount").alias("total_amount"),
        countDistinct("merchant_id").alias("unique_merchants")
    ) \
    .filter((col("transaction_count") > 10) | (col("total_amount") > 10000)) \
    .join(broadcast_patterns, "user_id", "left") \
    .filter(col("risk_score") > 0.8)

# Write alerts
suspicious.writeStream \
    .format("kafka") \
    .option("kafka.bootstrap.servers", "localhost:9092") \
    .option("topic", "fraud-alerts") \
    .option("checkpointLocation", "/tmp/fraud_checkpoint") \
    .start()
```

