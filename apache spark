## Practical Applications

### Application 1: E-Commerce Data Analytics & Revenue Analysis

**Business Context:**
An e-commerce company processes millions of transactions daily and needs to analyze sales patterns, identify high-value customers, predict trends, and optimize inventory. Data includes orders, customer behavior, product details, and returns.

**Problem Statement:**
- Process 100GB+ of daily transaction data
- Analyze customer purchase patterns across regions
- Identify top products and seasonal trends
- Detect anomalies and fraud
- Real-time dashboard updates

**Theory & Approach:**
- Use DataFrames for structured transaction data (faster than RDD)
- Leverage Catalyst optimizer for complex joins and aggregations
- Partition by date for efficient time-based queries
- Use broadcast joins for small dimension tables (products, customers)
- Cache frequently accessed analysis results

**Complete Implementation:**

```python
from pyspark.sql import SparkSession
from pyspark.sql.functions import (
    col, sum, avg, max, min, count, countDistinct, 
    date_format, year, month, quarter, 
    when, case, broadcast, percent_rank, row_number
)
from pyspark.sql.window import Window
from pyspark.ml.feature import StringIndexer, VectorAssembler
from pyspark.ml.clustering import KMeans
from datetime import datetime, timedelta

# Initialize Spark Session with optimized config
spark = SparkSession.builder \
    .appName("E-Commerce Analytics") \
    .config("spark.sql.shuffle.partitions", "200") \
    .config("spark.sql.adaptive.enabled", "true") \
    .config("spark.sql.adaptive.coalescePartitions.enabled", "true") \
    .config("spark.driver.memory", "4g") \
    .config("spark.executor.memory", "4g") \
    .config("spark.executor.cores", "4") \
    .master("local[*]") \
    .getOrCreate()

# ===== DATA INGESTION =====
# Load transaction data (partitioned by date for efficiency)
orders_df = spark.read \
    .option("basePath", "/data/orders") \
    .parquet("/data/orders/year=2024/month=*")

# Load dimension tables
customers_df = spark.read.parquet("/data/customers")
products_df = spark.read.parquet("/data/products")
returns_df = spark.read.parquet("/data/returns")

# Schema inspection
print("Orders Schema:")
orders_df.printSchema()
# output:
# root
#  |-- order_id: long
#  |-- customer_id: long
#  |-- product_id: long
#  |-- quantity: integer
#  |-- order_amount: decimal(10,2)
#  |-- order_date: timestamp
#  |-- region: string
#  |-- payment_method: string

# ===== DATA CLEANING & PREPARATION =====
# Handle null values and data quality
orders_clean = orders_df \
    .filter(col("order_amount") > 0) \
    .filter(col("quantity") > 0) \
    .filter(col("order_date").isNotNull()) \
    .dropDuplicates(["order_id"]) \
    .na.fill({"payment_method": "Unknown"})

# Join with dimension tables using broadcast for small tables
customers_broadcast = broadcast(customers_df)
products_broadcast = broadcast(products_df)

enriched_orders = orders_clean \
    .join(customers_broadcast, "customer_id", "left") \
    .join(products_broadcast, "product_id", "left") \
    .select(
        "order_id", "customer_id", "product_id", 
        "quantity", "order_amount", "order_date", 
        "region", "customer_segment", "product_category", 
        "product_name", "payment_method"
    )

# Cache enriched data (will be reused multiple times)
enriched_orders.cache()
total_orders = enriched_orders.count()
print(f"Total orders processed: {total_orders}")

# ===== REVENUE ANALYSIS BY REGION =====
regional_analysis = enriched_orders \
    .groupBy("region", "product_category") \
    .agg(
        sum("order_amount").alias("total_revenue"),
        count("order_id").alias("order_count"),
        avg("order_amount").alias("avg_order_value"),
        countDistinct("customer_id").alias("unique_customers"),
        max("order_amount").alias("max_order_value"),
        min("order_amount").alias("min_order_value")
    ) \
    .withColumn(
        "revenue_percentage",
        (col("total_revenue") / sum("total_revenue").over(Window.partitionBy())) * 100
    ) \
    .orderBy(col("total_revenue").desc())

print("\n=== REGIONAL REVENUE ANALYSIS ===")
regional_analysis.show()

# ===== TIME-BASED TREND ANALYSIS =====
date_format_expr = date_format(col("order_date"), "yyyy-MM")

monthly_trends = enriched_orders \
    .withColumn("year_month", date_format_expr) \
    .groupBy("year_month", "region") \
    .agg(
        sum("order_amount").alias("monthly_revenue"),
        count("order_id").alias("order_count"),
        countDistinct("customer_id").alias("unique_customers")
    ) \
    .orderBy("year_month")

# Calculate month-over-month growth
window_spec = Window.partitionBy("region").orderBy("year_month")
monthly_growth = monthly_trends \
    .withColumn(
        "previous_revenue",
        lag("monthly_revenue").over(window_spec)
    ) \
    .withColumn(
        "growth_rate",
        ((col("monthly_revenue") - col("previous_revenue")) / col("previous_revenue") * 100)
    )

print("\n=== MONTHLY TRENDS WITH GROWTH RATE ===")
monthly_growth.filter(col("growth_rate").isNotNull()).show()

# ===== CUSTOMER SEGMENTATION ANALYSIS =====
# Create customer metrics for segmentation
customer_metrics = enriched_orders \
    .groupBy("customer_id", "customer_segment") \
    .agg(
        count("order_id").alias("purchase_frequency"),
        sum("order_amount").alias("lifetime_value"),
        avg("order_amount").alias("avg_order_value"),
        max(col("order_date")).alias("last_purchase_date")
    )

# Calculate days since last purchase
customer_metrics = customer_metrics.withColumn(
    "days_since_last_purchase",
    (unix_timestamp(lit(datetime.now())) - unix_timestamp(col("last_purchase_date"))) / 86400
)

# Segment customers using K-means clustering
indexer = StringIndexer(inputCol="customer_segment", outputCol="segment_idx")
assembler = VectorAssembler(
    inputCols=["purchase_frequency", "lifetime_value", "avg_order_value", "days_since_last_purchase"],
    outputCol="features"
)
kmeans = KMeans(k=4, seed=42)

segments = indexer.fit(customer_metrics) \
    .transform(customer_metrics) \
    .pipe(lambda df: assembler.transform(df)) \
    .pipe(lambda df: kmeans.fit(df).transform(df))

print("\n=== CUSTOMER SEGMENTS ===")
segments.select("customer_id", "lifetime_value", "prediction").show()

# ===== TOP PRODUCTS ANALYSIS =====
top_products = enriched_orders \
    .groupBy("product_id", "product_name", "product_category") \
    .agg(
        count("order_id").alias("times_purchased"),
        sum("quantity").alias("total_quantity_sold"),
        sum("order_amount").alias("total_revenue"),
        avg("order_amount").alias("avg_transaction_value"),
        countDistinct("customer_id").alias("unique_customers")
    ) \
    .filter(col("total_revenue") > 1000)  # Min revenue threshold

# Rank products by revenue
window_rank = Window.orderBy(col("total_revenue").desc())
top_products_ranked = top_products.withColumn(
    "revenue_rank",
    row_number().over(window_rank)
).filter(col("revenue_rank") <= 20)

print("\n=== TOP 20 PRODUCTS BY REVENUE ===")
top_products_ranked.show()

# ===== ANOMALY DETECTION (Fraud/Unusual Transactions) =====
# Calculate statistics for anomaly detection
stats = enriched_orders.agg(
    avg("order_amount").alias("avg_amount"),
    stddev("order_amount").alias("stddev_amount"),
    max("quantity").alias("max_qty"),
    avg("quantity").alias("avg_qty")
).collect()[0]

anomaly_threshold = stats["avg_amount"] + (3 * stats["stddev_amount"])

anomalies = enriched_orders \
    .filter(
        (col("order_amount") > anomaly_threshold) |
        (col("quantity") > stats["max_qty"] * 0.9)
    ) \
    .select(
        "order_id", "customer_id", "order_amount", "quantity", 
        "order_date", "region", "payment_method"
    )

print(f"\n=== DETECTED ANOMALIES (High-value or Suspicious Orders) ===")
print(f"Anomaly threshold: ${anomaly_threshold:.2f}")
anomalies.show()

# ===== RETURN ANALYSIS =====
# Join with returns data to analyze return patterns
orders_with_returns = enriched_orders.alias("o") \
    .join(
        returns_df.alias("r"),
        (col("o.order_id") == col("r.order_id")),
        "left"
    ) \
    .select(
        col("o.*"),
        col("r.return_id"),
        col("r.return_reason"),
        col("r.return_date")
    )

return_analysis = orders_with_returns \
    .filter(col("return_id").isNotNull()) \
    .groupBy("product_category", "return_reason") \
    .agg(
        count("return_id").alias("return_count"),
        count("order_id").alias("returned_orders")
    ) \
    .withColumn("return_rate", col("return_count") / col("returned_orders"))

print("\n=== RETURN ANALYSIS BY CATEGORY ===")
return_analysis.show()

# ===== COHORT ANALYSIS =====
# Analyze customer behavior by signup cohort
cohort_analysis = enriched_orders \
    .withColumn("order_month", date_format(col("order_date"), "yyyy-MM")) \
    .withColumn("cohort_month", date_format(col("customer_signup_date"), "yyyy-MM")) \
    .groupBy("cohort_month", "order_month", "customer_segment") \
    .agg(
        count("order_id").alias("orders"),
        sum("order_amount").alias("revenue"),
        countDistinct("customer_id").alias("active_customers")
    ) \
    .orderBy("cohort_month", "order_month")

print("\n=== COHORT RETENTION ANALYSIS ===")
cohort_analysis.show()

# ===== WRITE RESULTS TO STORAGE =====
# Save analysis results in efficient format
regional_analysis.write.mode("overwrite").parquet("/output/regional_analysis")
top_products_ranked.write.mode("overwrite").parquet("/output/top_products")
anomalies.write.mode("overwrite").parquet("/output/anomalies")
monthly_growth.write.mode("overwrite").parquet("/output/monthly_trends")

# Create summary report
summary_report = f"""
E-COMMERCE ANALYTICS REPORT
============================
Report Date: {datetime.now()}
Total Orders Processed: {total_orders}
Date Range: {enriched_orders.agg(min("order_date"), max("order_date")).collect()[0]}

Key Metrics:
- Total Revenue: ${enriched_orders.agg(sum("order_amount")).collect()[0][0]:,.2f}
- Average Order Value: ${enriched_orders.agg(avg("order_amount")).collect()[0][0]:,.2f}
- Unique Customers: {enriched_orders.select(countDistinct("customer_id")).collect()[0][0]}
- Regions: {enriched_orders.select(countDistinct("region")).collect()[0][0]}
- Product Categories: {enriched_orders.select(countDistinct("product_category")).collect()[0][0]}

Anomalies Detected: {anomalies.count()}
Returns Processed: {orders_with_returns.filter(col("return_id").isNotNull()).count()}
"""

print(summary_report)

# Stop Spark session
spark.stop()
```

