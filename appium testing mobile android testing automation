// Abstract Page Object for platform-agnostic testing
public abstract class BasePage {
    protected WebDriver driver;
    protected WebDriverWait wait;

    protected abstract By getLoginButtonLocator();
    protected abstract By getEmailInputLocator();
    protected abstract By getPasswordInputLocator();

    public void login(String email, String password) {
        driver.findElement(getEmailInputLocator()).sendKeys(email);
        driver.findElement(getPasswordInputLocator()).sendKeys(password);
        driver.findElement(getLoginButtonLocator()).click();
    }
}

// Android implementation
public class AndroidLoginPage extends BasePage {
    @Override
    protected By getLoginButtonLocator() {
        return AppiumBy.id("com.app:id/login_button");
    }

    @Override
    protected By getEmailInputLocator() {
        return AppiumBy.id("com.app:id/email_input");
    }

    @Override
    protected By getPasswordInputLocator() {
        return AppiumBy.id("com.app:id/password_input");
    }
}

// iOS implementation
public class iOSLoginPage extends BasePage {
    @Override
    protected By getLoginButtonLocator() {
        return AppiumBy.accessibilityId("LoginButton");
    }

    @Override
    protected By getEmailInputLocator() {
        return AppiumBy.iOSNsPredicateString("type == 'XCUIElementTypeTextField'");
    }

    @Override
    protected By getPasswordInputLocator() {
        return AppiumBy.iOSNsPredicateString("type == 'XCUIElementTypeSecureTextField'");
    }
}

