        button.click();

        // Wait for operation to complete
        try {
            Thread.sleep(3000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        // Get final CPU stats
        Map<String, Object> cpuStatsAfter = getPerformanceData("cpuinfo");

        // Log results
        System.out.println("CPU Before: " + cpuStatsBefore);
