        Map<String, Object> memBefore = getMemoryInfo();
        long initialMemory = ((Number) memBefore.get("nativeHeap")).longValue();

        // Perform scrolling
        for (int i = 0; i < 10; i++) {
            driver.executeScript("mobile: scrollGesture", ImmutableMap.of(
                "direction", "down",
                "percent", 0.75
            ));
        }

        // Get final memory
        Map<String, Object> memAfter = getMemoryInfo();
        long finalMemory = ((Number) memAfter.get("nativeHeap")).longValue();

        // Verify reasonable memory increase
        long increase = finalMemory - initialMemory;
        assertTrue(increase < 100, "Memory increase should be < 100 MB");
    }

    @Test
    public void testFPSPerformance() {
