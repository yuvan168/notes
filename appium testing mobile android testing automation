public class DynamicContentTest {
    private WebDriver driver;
    private WebDriverWait wait;

    @Test
    public void testDynamicListLoading() {
        // Theory: Wait for specific condition, not arbitrary time
        
        // ❌ BAD: Thread.sleep(5000);
        
        // ✅ GOOD: Explicit wait with condition
        wait.until(driver -> {
            List<WebElement> items = driver.findElements(AppiumBy.id("list_item"));
            return items.size() > 10; // Wait until 10 items loaded
        });

        List<WebElement> items = driver.findElements(AppiumBy.id("list_item"));
        assertEquals(10, items.size());
    }

    @Test
    public void testCustomWaitCondition() {
        // Wait for element to reach stable state
        wait.until((ExpectedCondition<Boolean>) driver -> {
            try {
                WebElement statusText = driver.findElement(AppiumBy.id("status"));
                return statusText.getText().equals("Ready");
            } catch (NoSuchElementException e) {
                return false;
            }
        });
    }

    @Test
    public void testElementClickability() {
        // Wait for element to be clickable (visible AND enabled)
        WebElement button = wait.until(
            ExpectedConditions.elementToBeClickable(AppiumBy.id("submit_button"))
        );
        button.click();
    }

    @Test
    public void testStaleElementHandling() {
        try {
            WebElement item = driver.findElement(AppiumBy.id("item"));
            item.click();
        } catch (StaleElementReferenceException e) {
            // Element became stale, retry
            WebElement item = driver.findElement(AppiumBy.id("item"));
            item.click();
        }
    }
}
