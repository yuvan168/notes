## Mobile Gestures

### Theory

Mobile gestures are user interactions unique to mobile devices like tap, swipe, pinch, etc.

### Tap Gesture

```java
// Simple tap
WebElement element = driver.findElement(AppiumBy.id("button_id"));
driver.executeScript("mobile: tap", ImmutableMap.of(
    "x", element.getLocation().x,
    "y", element.getLocation().y
));

// Or using W3C Actions
new Actions(driver)
    .tap(element)
    .perform();

// Multi-tap (double tap)
PointerInput pointer = new PointerInput(PointerInput.Kind.TOUCH, "finger");
Sequence tap = new Sequence(pointer, 1);
tap.addAction(pointer.createPointerMove(Duration.ZERO, PointerInput.Origin.viewport(), 100, 200));
tap.addAction(pointer.createPointerDown(PointerInput.MouseButton.LEFT.asArg()));
tap.addAction(pointer.createPointerUp(PointerInput.MouseButton.LEFT.asArg()));
tap.addAction(pointer.createPointerDown(PointerInput.MouseButton.LEFT.asArg()));
tap.addAction(pointer.createPointerUp(PointerInput.MouseButton.LEFT.asArg()));
driver.perform(Collections.singletonList(tap));
```

### Swipe Gesture

```java
// Swipe left
driver.executeScript("mobile: swipeGesture", ImmutableMap.of(
    "left", 100,
    "top", 100,
    "width", 200,
    "height", 200,
    "direction", "left",
    "percent", 0.75
));

// Swipe right
driver.executeScript("mobile: swipeGesture", ImmutableMap.of(
    "left", 100,
    "top", 100,
    "width", 200,
    "height", 200,
    "direction", "right",
    "percent", 0.75
));

// Swipe up
driver.executeScript("mobile: swipeGesture", ImmutableMap.of(
    "left", 100,
    "top", 100,
    "width", 200,
    "height", 200,
    "direction", "up",
    "percent", 0.75
));

// Swipe down
driver.executeScript("mobile: swipeGesture", ImmutableMap.of(
    "left", 100,
    "top", 100,
    "width", 200,
    "height", 200,
    "direction", "down",
    "percent", 0.75
));

// Using W3C Actions
PointerInput pointer = new PointerInput(PointerInput.Kind.TOUCH, "finger");
Sequence swipe = new Sequence(pointer, 1);
swipe.addAction(pointer.createPointerMove(Duration.ZERO, PointerInput.Origin.viewport(), 100, 100));
swipe.addAction(pointer.createPointerDown(PointerInput.MouseButton.LEFT.asArg()));
swipe.addAction(pointer.createPointerMove(Duration.ofMillis(500), PointerInput.Origin.viewport(), 500, 100));
swipe.addAction(pointer.createPointerUp(PointerInput.MouseButton.LEFT.asArg()));
driver.perform(Collections.singletonList(swipe));
```

### Pinch & Zoom

```java
// Pinch gesture (zoom out)
driver.executeScript("mobile: pinchGesture", ImmutableMap.of(
    "scale", 0.5,      // Scale factor (0.5 = zoom out)
    "velocity", 1.0
));

// Zoom gesture (zoom in)
driver.executeScript("mobile: pinchGesture", ImmutableMap.of(
    "scale", 2.0,      // Scale factor (2.0 = zoom in)
    "velocity", 1.0
));

// Using W3C Actions for pinch
PointerInput finger1 = new PointerInput(PointerInput.Kind.TOUCH, "finger1");
PointerInput finger2 = new PointerInput(PointerInput.Kind.TOUCH, "finger2");

Sequence pinch = new Sequence(finger1, 1);
pinch.addAction(finger1.createPointerMove(Duration.ZERO, PointerInput.Origin.viewport(), 100, 100));
pinch.addAction(finger1.createPointerDown(PointerInput.MouseButton.LEFT.asArg()));
pinch.addAction(finger1.createPointerMove(Duration.ofMillis(500), PointerInput.Origin.viewport(), 50, 50));
pinch.addAction(finger1.createPointerUp(PointerInput.MouseButton.LEFT.asArg()));

Sequence pinch2 = new Sequence(finger2, 1);
pinch2.addAction(finger2.createPointerMove(Duration.ZERO, PointerInput.Origin.viewport(), 300, 300));
pinch2.addAction(finger2.createPointerDown(PointerInput.MouseButton.LEFT.asArg()));
pinch2.addAction(finger2.createPointerMove(Duration.ofMillis(500), PointerInput.Origin.viewport(), 350, 350));
pinch2.addAction(finger2.createPointerUp(PointerInput.MouseButton.LEFT.asArg()));

driver.perform(Arrays.asList(pinch, pinch2));
```

