**Q1: Design a test for secure login handling 2FA and session timeout.**

**Answer:**

```java
public class BankingLoginTest {
    private AndroidDriver driver;
    private WebDriverWait wait;

    @Before
    public void setUp() throws MalformedURLException {
        UiAutomator2Options options = new UiAutomator2Options()
            .setDeviceName("emulator-5554")
            .setPlatformName("Android")
            .setApp(System.getProperty("user.dir") + "/app/banking.apk")
            .setAutoGrantPermissions(true);

        driver = new AndroidDriver(new URL("http://127.0.0.1:4723"), options);
        wait = new WebDriverWait(driver, Duration.ofSeconds(20));
    }

    @Test
    public void testSecureLoginWith2FA() {
        // Step 1: Verify login screen
        WebElement emailField = wait.until(
            ExpectedConditions.presenceOfElementLocated(AppiumBy.id("email_input"))
        );
        assertTrue(emailField.isDisplayed());

        // Step 2: Enter credentials
        emailField.sendKeys("user@bank.com");
        WebElement passwordField = driver.findElement(AppiumBy.id("password_input"));
        passwordField.sendKeys("SecurePassword123!");

        // Step 3: Verify password field is masked
        assertEquals("password", passwordField.getAttribute("type"));

        // Step 4: Click login
        driver.findElement(AppiumBy.id("login_button")).click();

        // Step 5: Wait for 2FA screen
        WebElement otpInput = wait.until(
            ExpectedConditions.presenceOfElementLocated(AppiumBy.id("otp_input"))
        );

        // Step 6: Enter OTP
        String otp = getOTPFromTestData();
        enterOTPWithDelay(otpInput, otp);

        // Step 7: Verify successful login
        WebElement homeScreen = wait.until(
            ExpectedConditions.presenceOfElementLocated(AppiumBy.id("home_screen"))
        );
        assertTrue(homeScreen.isDisplayed());
    }

    @Test
    public void testSessionTimeoutHandling() {
        performLogin("user@bank.com", "SecurePassword123!", "123456");

        // Background app - simulate session expiry
        ((AndroidDriver) driver).runAppInBackground(Duration.ofSeconds(10));
        driver.activateApp("com.bank.mobile");

        // Verify logged out after timeout
        WebElement loginButton = wait.until(
            ExpectedConditions.presenceOfElementLocated(AppiumBy.id("login_button"))
        );
        assertTrue(loginButton.isDisplayed());
    }

    private void performLogin(String email, String password, String otp) {
        driver.findElement(AppiumBy.id("email_input")).sendKeys(email);
        driver.findElement(AppiumBy.id("password_input")).sendKeys(password);
        driver.findElement(AppiumBy.id("login_button")).click();

        WebElement otpInput = wait.until(
            ExpectedConditions.presenceOfElementLocated(AppiumBy.id("otp_input"))
        );
        enterOTPWithDelay(otpInput, otp);
    }

    private void enterOTPWithDelay(WebElement otpInput, String otp) {
        // Theory: Enter character by character to simulate real user input
        for (char c : otp.toCharArray()) {
            otpInput.sendKeys(String.valueOf(c));
            try { Thread.sleep(100); } catch (InterruptedException e) { }
        }
        driver.findElement(AppiumBy.id("submit_otp")).click();
    }

    private String getOTPFromTestData() { return "123456"; }

    @After
    public void tearDown() {
        if (driver != null) driver.quit();
    }
}
