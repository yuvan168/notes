## Best Practices & Patterns

### Page Object Model (POM)

**POM Theory:**
Page Object Model is a design pattern that creates an object repository for web elements. It improves maintainability and reduces code duplication.

**Implementation:**
```java
// BasePage class
public class BasePage {
    protected AndroidDriver driver;
    protected WebDriverWait wait;

    public BasePage(AndroidDriver driver) {
        this.driver = driver;
        this.wait = new WebDriverWait(driver, Duration.ofSeconds(10));
    }

    protected WebElement find(By locator) {
        return wait.until(ExpectedConditions.presenceOfElementLocated(locator));
    }

    protected void click(By locator) {
        wait.until(ExpectedConditions.elementToBeClickable(locator)).click();
    }

    protected void type(By locator, String text) {
        find(locator).sendKeys(text);
    }

    protected String getText(By locator) {
        return find(locator).getText();
    }
}

// LoginPage class
public class LoginPage extends BasePage {
    private final By emailField = AppiumBy.id("email_input");
    private final By passwordField = AppiumBy.id("password_input");
    private final By loginButton = AppiumBy.id("login_button");
    private final By errorMessage = AppiumBy.id("error_message");

    public LoginPage(AndroidDriver driver) {
        super(driver);
    }

    public void enterEmail(String email) {
        type(emailField, email);
    }

    public void enterPassword(String password) {
        type(passwordField, password);
    }

    public void clickLogin() {
        click(loginButton);
    }

    public String getErrorMessage() {
        return getText(errorMessage);
    }

    public void login(String email, String password) {
        enterEmail(email);
        enterPassword(password);
        clickLogin();
    }
}

// Test class using POM
public class LoginTest {
    private AndroidDriver driver;
    private LoginPage loginPage;

    @Before
    public void setUp() throws MalformedURLException {
        // Initialize driver
        loginPage = new LoginPage(driver);
    }

    @Test
