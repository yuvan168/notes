        // Assert CPU usage within acceptable range
        double cpuUsage = (double) cpuStatsAfter.get("usage");
        assertTrue("CPU usage should be < 80%", cpuUsage < 80);
    }

    @Test
    public void testMemoryPerformance() {
        // Get initial memory
        Map<String, Object> memBefore = getPerformanceData("memoryinfo");
        double initialMemory = (double) memBefore.get("nativeHeap");

        // Perform memory-intensive operation
        for (int i = 0; i < 5; i++) {
            WebElement item = driver.findElement(AppiumBy.id("large_image_item_" + i));
            ((JavascriptExecutor) driver).executeScript("mobile: scroll", ImmutableMap.of(
                "direction", "down"
            ));
        }

        // Get final memory
        Map<String, Object> memAfter = getPerformanceData("memoryinfo");
        double finalMemory = (double) memAfter.get("nativeHeap");

        // Calculate memory increase
        double memoryIncrease = finalMemory - initialMemory;
        System.out.println("Memory increase: " + memoryIncrease + " MB");

        // Assert memory increase is reasonable
        assertTrue("Memory increase should be < 100 MB", memoryIncrease < 100);
    }

    @Test
    public void testFPSPerformance() {
        // Get FPS stats during animation
        Map<String, Object> fpsStats = getPerformanceData("gfxinfo");

        double droppedFrames = (double) fpsStats.get("droppedFrames");
        double totalFrames = (double) fpsStats.get("totalFrames");
        double fps = totalFrames - droppedFrames;

        System.out.println("Total Frames: " + totalFrames);
        System.out.println("Dropped Frames: " + droppedFrames);
        System.out.println("FPS: " + fps);

        // Assert FPS is acceptable (>= 30 FPS minimum)
        assertTrue("FPS should be >= 30", fps >= 30);
    }

    @SuppressWarnings("unchecked")
    private Map<String, Object> getPerformanceData(String dataType) {
