    }

    protected void scrollDown(int times) {
        for (int i = 0; i < times; i++) {
            driver.executeScript("mobile: scrollGesture", ImmutableMap.of(
                "left", 100,
                "top", 100,
                "width", 200,
                "height", 500,
                "direction", "down",
                "percent", 0.75
            ));
        }
    }
}

