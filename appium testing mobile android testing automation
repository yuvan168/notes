// App information
options.setApp("/path/to/app.ipa");               // App path
options.setBundleId("com.example.app");           // Bundle ID

// Optional capabilities
options.setXcodeOrgId("DEVELOPER_ID");            // Developer ID
options.setXcodeSigningId("iPhone Developer");    // Signing ID
options.setAutoGrantPermissions(true);            // Auto grant permissions
options.setWdaLocalPort(8100);                    // WebDriverAgent port
options.setSimulatorTraceDir("/path/to/trace");   // Performance trace
