### Q15: Design a dependency injection container.

**Answer:**
```csharp
public interface IServiceProvider
{
    T Resolve<T>();
}

public class ServiceContainer : IServiceProvider
{
    private readonly Dictionary<Type, Func<object>> services = new();
    
    public void Register<T, TImpl>(bool singleton = false) where TImpl : T, new()
    {
        if (singleton)
        {
            var instance = new TImpl();
            services[typeof(T)] = () => instance;
        }
        else
        {
            services[typeof(T)] = () => new TImpl();
        }
    }
    
    public void Register<T>(Func<T> factory)
    {
        services[typeof(T)] = () => factory();
    }
    
    public T Resolve<T>()
    {
        if (services.TryGetValue(typeof(T), out var factory))
            return (T)factory();
        throw new InvalidOperationException($"Type {typeof(T).Name} not registered");
    }
}

// Usage
var container = new ServiceContainer();
container.Register<IRepository, UserRepository>(singleton: true);
container.Register<ILogger>(() => new ConsoleLogger());

IRepository repo = container.Resolve<IRepository>();
ILogger logger = container.Resolve<ILogger>();
```

