public async Task ProcessLargeFileAsync(string filePath, int batchSize = 1000)
{
    var batch = new List<string>(batchSize);
    
    using (var reader = new StreamReader(filePath))
    {
        string line;
        while ((line = await reader.ReadLineAsync()) != null)
        {
            batch.Add(line);
            
