### 3. Recursive Methods

```csharp
// Calculate factorial
public int Factorial(int n)
{
    if (n <= 1)
        return 1;
    return n * Factorial(n - 1);
}

// Tree traversal
public void PrintTree(TreeNode node)
{
    if (node == null)
        return;
    
    Console.WriteLine(node.Value);
    PrintTree(node.Left);
    PrintTree(node.Right);
}

// Fibonacci
public int Fibonacci(int n)
{
    if (n <= 1)
        return n;
    return Fibonacci(n - 1) + Fibonacci(n - 2);
}
```

