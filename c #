```csharp
public class ResilientHttpClient
{
    private readonly HttpClient httpClient;
    private const int MaxRetries = 3;
    
    public async Task<T> GetWithRetryAsync<T>(string url)
    {
        int retryCount = 0;
        
        while (retryCount < MaxRetries)
        {
            try
            {
                var response = await httpClient.GetAsync(url);
                response.EnsureSuccessStatusCode();
                
                var content = await response.Content.ReadAsStringAsync();
                return JsonConvert.DeserializeObject<T>(content);
            }
            catch (HttpRequestException ex) when (retryCount < MaxRetries - 1)
            {
                retryCount++;
                var delayMs = (int)Math.Pow(2, retryCount) * 1000;  // Exponential backoff
                await Task.Delay(delayMs);
                Console.WriteLine($"Retry attempt {retryCount} after {delayMs}ms");
            }
        }
        
        throw new HttpRequestException($"Failed after {MaxRetries} attempts");
    }
}
```

**Circuit Breaker Pattern:**
```csharp
public class CircuitBreaker
{
    private int failureCount = 0;
    private int threshold = 5;
    private CircuitState state = CircuitState.Closed;
    
    public async Task<T> ExecuteAsync<T>(Func<Task<T>> operation)
    {
        if (state == CircuitState.Open)
            throw new InvalidOperationException("Circuit breaker is open");
        
        try
        {
            var result = await operation();
            failureCount = 0;
            return result;
        }
        catch (Exception ex)
        {
            failureCount++;
            if (failureCount >= threshold)
                state = CircuitState.Open;
            throw;
        }
    }
}

public enum CircuitState { Closed, Open, HalfOpen }
```

