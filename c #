// Theory: Demonstrate proper resource management
public class DatabaseConnection : IDisposable
{
    private IntPtr handle;
    private bool disposed = false;
    
    public DatabaseConnection(string connectionString)
    {
        // Allocate unmanaged resource (simulated)
        handle = AllocateNativeResource(connectionString);
    }
    
    public void ExecuteQuery(string query)
    {
        if (disposed)
            throw new ObjectDisposedException("DatabaseConnection");
        
        Console.WriteLine($"Executing: {query}");
    }
    
    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);  // Tell GC not to run finalizer
    }
    
    protected virtual void Dispose(bool disposing)
    {
        if (!disposed)
        {
            if (disposing)
            {
                // Clean up managed resources
                Console.WriteLine("Cleaning up managed resources");
            }
            
            // Always clean up unmanaged resources
            if (handle != IntPtr.Zero)
            {
                FreeNativeResource(handle);
                handle = IntPtr.Zero;
            }
            
            disposed = true;
        }
    }
    
    ~DatabaseConnection()
    {
        Dispose(false);  // Finalizer safety net
    }
    
    private IntPtr AllocateNativeResource(string connectionString)
    {
        // Simulate allocating unmanaged memory
        return Marshal.AllocHGlobal(1024);
    }
    
    private void FreeNativeResource(IntPtr ptr)
    {
        // Simulate freeing unmanaged memory
        Marshal.FreeHGlobal(ptr);
    }
}

