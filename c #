```csharp
// Theory: Generic cache interface
public interface ICache<T>
{
    T Get(string key);
    void Set(string key, T value, TimeSpan? expiration = null);
    void Remove(string key);
    bool TryGet(string key, out T value);
}

// Theory: In-memory cache with expiration
public class MemoryCacheProvider<T> : ICache<T>
{
    private class CacheEntry
    {
        public T Value { get; set; }
        public DateTime? ExpirationTime { get; set; }
    }
    
    private readonly Dictionary<string, CacheEntry> cache = new();
    private readonly object lockObject = new();
    
    public T Get(string key)
    {
        if (TryGet(key, out var value))
            return value;
        
        throw new KeyNotFoundException($"Cache key '{key}' not found");
    }
    
    public void Set(string key, T value, TimeSpan? expiration = null)
    {
        lock (lockObject)
        {
            cache[key] = new CacheEntry
            {
                Value = value,
                ExpirationTime = expiration.HasValue 
                    ? DateTime.UtcNow.Add(expiration.Value)
                    : null
            };
        }
    }
    
    public void Remove(string key)
    {
        lock (lockObject)
        {
            cache.Remove(key);
        }
    }
    
    public bool TryGet(string key, out T value)
    {
        lock (lockObject)
        {
            if (cache.TryGetValue(key, out var entry))
            {
                // Theory: Check expiration
                if (entry.ExpirationTime.HasValue && 
                    DateTime.UtcNow > entry.ExpirationTime.Value)
                {
                    cache.Remove(key);
                    value = default;
                    return false;
                }
                
                value = entry.Value;
                return true;
            }
            
            value = default;
            return false;
        }
    }
}

