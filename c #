### Q14: How would you handle large file processing efficiently?

**Answer:**
```csharp
public async Task ProcessLargeFileAsync(string filePath, int batchSize = 1000)
{
    var batch = new List<string>(batchSize);
    
    using (var reader = new StreamReader(filePath))
    {
        string line;
        while ((line = await reader.ReadLineAsync()) != null)
        {
            batch.Add(line);
            
            if (batch.Count >= batchSize)
            {
                await ProcessBatchAsync(batch);
                batch.Clear();
            }
        }
        
        if (batch.Count > 0)
            await ProcessBatchAsync(batch);
    }
}

private async Task ProcessBatchAsync(List<string> batch)
{
    var tasks = batch.Select(line => ProcessLineAsync(line));
    await Task.WhenAll(tasks);
}

private async Task ProcessLineAsync(string line)
{
    // Simulate processing
    await Task.Delay(10);
    Console.WriteLine($"Processed: {line}");
}
```

