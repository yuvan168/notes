    private readonly ICache<User> userCache;
    private readonly ICache<List<User>> listCache;
    
    public CachedUserRepository(
        IUserRepository innerRepository,
        ICache<User> userCache,
        ICache<List<User>> listCache)
    {
        this.innerRepository = innerRepository;
        this.userCache = userCache;
        this.listCache = listCache;
    }
    
    public async Task<User> GetByIdAsync(int userId)
    {
        // Theory: Try cache first
        string cacheKey = $"user:{userId}";
        
        if (userCache.TryGet(cacheKey, out var cachedUser))
        {
            Console.WriteLine($"[CACHE HIT] User {userId}");
            return cachedUser;
        }
        
        // Theory: Cache miss - fetch from source
        Console.WriteLine($"[CACHE MISS] User {userId}");
        var user = await innerRepository.GetByIdAsync(userId);
        
        // Theory: Store in cache for next time
        if (user != null)
            userCache.Set(cacheKey, user, TimeSpan.FromMinutes(5));
        
        return user;
    }
    
    public async Task<List<User>> GetAllAsync()
    {
        string cacheKey = "users:all";
        
        if (listCache.TryGet(cacheKey, out var cachedUsers))
        {
            Console.WriteLine("[CACHE HIT] All users");
            return cachedUsers;
        }
        
        Console.WriteLine("[CACHE MISS] All users");
        var users = await innerRepository.GetAllAsync();
        listCache.Set(cacheKey, users, TimeSpan.FromMinutes(10));
        
        return users;
    }
}

