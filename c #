    public Order CreateOrder(ShoppingCart cart, string deliveryAddress)
    {
        // Theory: Validate cart before creating order
        if (!cart.Items.Any())
            throw new InvalidOperationException("Cart is empty");
        
        // Theory: Check inventory availability
        foreach (var item in cart.Items)
        {
            if (!inventoryService.IsAvailable(item.ProductId, item.Quantity))
                throw new InvalidOperationException(
                    $"Insufficient stock for {item.Product.Name}");
        }
        
        // Theory: Create order from cart
        var order = new Order
        {
            OrderId = orders.Count + 1,
            CustomerId = "CUST-001", // Would come from user context
            Items = new List<CartItem>(cart.Items),
            TotalAmount = cart.GetTotal(),
            Status = OrderStatus.Pending,
            OrderDate = DateTime.Now,
            DeliveryAddress = deliveryAddress
        };
        
        // Theory: Update inventory
        foreach (var item in order.Items)
        {
            inventoryService.ReduceStock(item.ProductId, item.Quantity);
        }
        
        orders.Add(order);
        
        // Theory: Send notification asynchronously
        notificationService.SendOrderConfirmation(order);
        
        return order;
    }
    
    public Order GetOrder(int orderId)
    {
        return orders.FirstOrDefault(o => o.OrderId == orderId)
            ?? throw new KeyNotFoundException($"Order {orderId} not found");
    }
    
    public List<Order> GetCustomerOrders(string customerId)
    {
        return orders
            .Where(o => o.CustomerId == customerId)
            .OrderByDescending(o => o.OrderDate)
            .ToList();
    }
    
    public bool CancelOrder(int orderId)
    {
        var order = GetOrder(orderId);
        
        // Theory: Can only cancel pending orders
        if (order.Status != OrderStatus.Pending)
            return false;
        
        order.Status = OrderStatus.Cancelled;
        
        // Theory: Restore inventory on cancellation
        foreach (var item in order.Items)
        {
            inventoryService.RestoreStock(item.ProductId, item.Quantity);
        }
        
        notificationService.SendOrderCancellation(order);
        return true;
    }
    
    public bool UpdateOrderStatus(int orderId, OrderStatus status)
    {
        var order = GetOrder(orderId);
        order.Status = status;
        
        if (status == OrderStatus.Shipped)
            order.ShippedDate = DateTime.Now;
        else if (status == OrderStatus.Delivered)
            order.DeliveredDate = DateTime.Now;
        
        notificationService.SendStatusUpdate(order, status);
        return true;
    }
