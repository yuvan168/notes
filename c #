### Q12: How would you implement caching in an application?

**Answer:**
```csharp
public interface ICache
{
    void Set<T>(string key, T value, TimeSpan expiration);
    T Get<T>(string key);
    void Remove(string key);
}

public class MemoryCache : ICache
{
    private readonly Dictionary<string, CacheItem> cache = new();
    
    private class CacheItem
    {
        public object Value { get; set; }
        public DateTime ExpirationTime { get; set; }
    }
    
    public void Set<T>(string key, T value, TimeSpan expiration)
    {
        cache[key] = new CacheItem
        {
            Value = value,
            ExpirationTime = DateTime.UtcNow.Add(expiration)
        };
    }
    
    public T Get<T>(string key)
    {
        if (cache.TryGetValue(key, out var item))
        {
            if (DateTime.UtcNow < item.ExpirationTime)
                return (T)item.Value;
            else
                cache.Remove(key);
        }
        throw new KeyNotFoundException();
    }
    
    public void Remove(string key)
    {
        cache.Remove(key);
    }
}

// Usage
var cache = new MemoryCache();
cache.Set("user:1", new User { Id = 1, Name = "John" }, TimeSpan.FromMinutes(5));
User user = cache.Get<User>("user:1");
```

