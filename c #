// Theory: Retry policy
public class RetryPolicy
{
    public int MaxRetries { get; set; } = 3;
    public TimeSpan InitialDelay { get; set; } = TimeSpan.FromSeconds(1);
    public double BackoffMultiplier { get; set; } = 2.0;
}

// Theory: Circuit breaker states
public enum CircuitBreakerState
{
    Closed,      // Normal operation
    Open,        // Failing, reject requests
    HalfOpen     // Testing if recovered
}

// Theory: Resilient HTTP client
public class ResilientHttpClient
{
    private readonly HttpClient httpClient;
    private readonly RetryPolicy retryPolicy;
    private CircuitBreakerState state = CircuitBreakerState.Closed;
    private int failureCount = 0;
    private DateTime lastFailureTime = DateTime.MinValue;
    private const int FailureThreshold = 5;
    private const int OpenTimeout = 30; // seconds
    
    public ResilientHttpClient(RetryPolicy retryPolicy = null)
    {
        httpClient = new HttpClient();
        this.retryPolicy = retryPolicy ?? new RetryPolicy();
    }
    
    public async Task<T> GetAsync<T>(string url)
    {
        // Theory: Check circuit breaker state
        if (state == CircuitBreakerState.Open)
        {
            if ((DateTime.UtcNow - lastFailureTime).TotalSeconds > OpenTimeout)
            {
                Console.WriteLine("[CIRCUIT] Transitioning to Half-Open");
                state = CircuitBreakerState.HalfOpen;
            }
            else
            {
                throw new InvalidOperationException(
                    "Circuit breaker is open - service unavailable");
            }
        }
        
        int attempt = 0;
        while (attempt < retryPolicy.MaxRetries)
        {
            try
            {
                // Theory: Execute request
                var response = await httpClient.GetAsync(url);
                
                if (response.IsSuccessStatusCode)
                {
                    // Theory: Reset failure count on success
                    failureCount = 0;
                    if (state == CircuitBreakerState.HalfOpen)
                    {
                        Console.WriteLine("[CIRCUIT] Recovering - back to Closed");
                        state = CircuitBreakerState.Closed;
                    }
                    
                    var content = await response.Content.ReadAsStringAsync();
                    return JsonSerializer.Deserialize<T>(content);
                }
                else if ((int)response.StatusCode >= 500)
                {
                    // Theory: Retry on server errors
                    throw new HttpRequestException(
                        $"Server error: {response.StatusCode}");
                }
                else
                {
                    // Theory: Don't retry on client errors
                    throw new HttpRequestException(
                        $"Client error: {response.StatusCode}");
                }
            }
            catch (HttpRequestException ex) when (attempt < retryPolicy.MaxRetries - 1)
            {
                attempt++;
                
                // Theory: Exponential backoff
                var delay = retryPolicy.InitialDelay
                    .Multiply(Math.Pow(retryPolicy.BackoffMultiplier, attempt - 1));
                
                Console.WriteLine(
                    $"Attempt {attempt} failed. Retrying in {delay.TotalSeconds}s...");
                
                await Task.Delay(delay);
            }
            catch (HttpRequestException ex)
            {
                // Theory: All retries exhausted
                failureCount++;
                lastFailureTime = DateTime.UtcNow;
                
                if (failureCount >= FailureThreshold)
                {
                    Console.WriteLine("[CIRCUIT] Opening circuit after failures");
                    state = CircuitBreakerState.Open;
                }
                
                throw;
            }
        }
        
        throw new InvalidOperationException("Max retries exceeded");
    }
}

