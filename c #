// Theory: Generic CSV reader for type-safe parsing
public interface ICsvImporter<T>
{
    List<T> ImportFromFile(string filePath);
    List<ImportError> GetErrors();
}

public class ImportError
{
    public int LineNumber { get; set; }
    public string ErrorMessage { get; set; }
    public string Data { get; set; }
}

public class CsvImporter<T> : ICsvImporter<T> where T : new()
{
    private readonly List<ImportError> errors = new();
    private readonly IValidator<T> validator;
    
    public CsvImporter(IValidator<T> validator)
    {
        this.validator = validator;
    }
    
    public List<T> ImportFromFile(string filePath)
    {
        errors.Clear();
        var results = new List<T>();
        
        // Theory: Stream processing for memory efficiency
        using (var reader = new StreamReader(filePath))
        {
            string line;
            int lineNumber = 0;
            bool isHeader = true;
            
            while ((line = reader.ReadLine()) != null)
            {
                lineNumber++;
                
                // Skip header
                if (isHeader)
                {
                    isHeader = false;
                    continue;
                }
                
                try
                {
                    var item = ParseLine(line);
                    
                    // Theory: Validate before adding
                    if (validator.Validate(item, out var validationErrors))
                    {
                        results.Add(item);
                    }
                    else
                    {
                        // Theory: Track validation errors
                        foreach (var error in validationErrors)
                        {
                            errors.Add(new ImportError
                            {
                                LineNumber = lineNumber,
                                ErrorMessage = error,
                                Data = line
                            });
                        }
                    }
                }
                catch (Exception ex)
                {
                    // Theory: Graceful error handling, continue processing
                    errors.Add(new ImportError
                    {
                        LineNumber = lineNumber,
                        ErrorMessage = ex.Message,
                        Data = line
                    });
                }
            }
        }
        
        return results;
    }
    
    private T ParseLine(string line)
    {
        var parts = line.Split(',');
        // Theory: Reflection to map CSV to object
        var item = new T();
        var properties = typeof(T).GetProperties();
        
        for (int i = 0; i < parts.Length && i < properties.Length; i++)
        {
            var prop = properties[i];
            var value = parts[i].Trim();
            
            // Theory: Type conversion with error handling
            try
            {
                if (prop.PropertyType == typeof(int))
                    prop.SetValue(item, int.Parse(value));
                else if (prop.PropertyType == typeof(decimal))
                    prop.SetValue(item, decimal.Parse(value));
                else if (prop.PropertyType == typeof(DateTime))
                    prop.SetValue(item, DateTime.Parse(value));
                else
                    prop.SetValue(item, value);
            }
            catch (FormatException)
            {
                throw new FormatException(
                    $"Cannot convert '{value}' to {prop.PropertyType.Name}");
            }
        }
        
        return item;
    }
    
    public List<ImportError> GetErrors() => errors;
}

