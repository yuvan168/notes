end

# recipes/security.rb
# Harden WordPress installation

# Disable vulnerable plugins
%w[hello duplicator].each do |plugin|
  execute "disable-#{plugin}" do
    command "cd #{node['wordpress']['document_root']} && wp plugin delete #{plugin} --allow-root"
    ignore_failure true
