docker_image 'myapp' do
  repo 'registry.example.com/myapp'
  tag node['docker']['app_version']
  action :pull
end

docker_container 'myapp' do
  repo 'myapp'
  tag node['docker']['app_version']
  port "#{node['docker']['app_port']}:8080"
  env [
    "DATABASE_URL=#{node['docker']['db_url']}",
    "REDIS_URL=#{node['docker']['redis_url']}",
    "LOG_LEVEL=#{node['docker']['log_level']}"
  ]
  volumes [
    '/var/log/myapp:/var/log/app',
    '/var/data:/data'
  ]
  restart_policy 'always'
  action :run
end

# Health check
ruby_block 'verify_container' do
  block do
    require 'net/http'
    require 'uri'
    
    sleep 5 # Wait for container to start
    
    3.times do |attempt|
      begin
        response = Net::HTTP.get_response(
          URI("http://localhost:#{node['docker']['app_port']}/health")
        )
        if response.code == '200'
          Chef::Log.info('Container health check passed')
          break
        end
      rescue => e
        Chef::Log.warn("Health check attempt #{attempt + 1} failed: #{e.message}")
        sleep 2 if attempt < 2
      end
    end
  end
end

# Monitoring
file '/etc/logrotate.d/docker-app' do
  content <<-EOH
/var/log/myapp/*.log {
  daily
  rotate 7
  compress
  missingok
  notifempty
  create 0640 nobody nobody
  sharedscripts
}
  EOH
end

# Prometheus monitoring
cookbook_file '/etc/prometheus/targets/docker-app.json' do
  source 'prometheus/docker-app.json'
  owner 'prometheus'
  group 'prometheus'
  mode '0644'
  notifies :reload, 'service[prometheus]', :delayed
end
