## Security Implementation

### Secrets Management

```ruby
# Cookbook: secrets
# recipes/default.rb

# Using Chef Vault for encrypted secrets
data_bag_item = Chef::EncryptedDataBagItem.load(
  'secrets',
  'database_credentials'
)

# Create config with secrets
template '/etc/app/database.yml' do
  source 'database.yml.erb'
  variables(
    db_password: data_bag_item['password'],
    db_user: data_bag_item['username']
  )
  mode '0600'
  owner 'app'
  group 'app'
  sensitive true # Don't log this
end

# Alternatively: Use HashiCorp Vault
ruby_block 'fetch_from_vault' do
  block do
    require 'http'
    
    # Authenticate with Vault
    auth_response = HTTP.post(
      'http://vault.example.com:8200/v1/auth/approle/login',
      json: {
        role_id: node['vault']['role_id'],
        secret_id: node['vault']['secret_id']
      }
    ).parse
    
    token = auth_response['auth']['client_token']
    
    # Get secret
    secret_response = HTTP.auth("Bearer #{token}")
      .get('http://vault.example.com:8200/v1/secret/data/app')
      .parse
    
    # Store in node attributes (encrypted)
    node.override['secrets']['api_key'] = secret_response['data']['api_key']
  end
  action :nothing
  subscribes :run, 'ruby_block[verify_vault_connection]', :immediately
end
```

