DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-FROM-ACCOUNT      PIC 9(10).
01 WS-TO-ACCOUNT        PIC 9(10).
01 WS-AMOUNT            PIC 9(9)V99.
01 WS-FROM-BALANCE      PIC 9(9)V99.
01 WS-TO-BALANCE        PIC 9(9)V99.
01 WS-RESP              PIC S9(8) COMP.

PROCEDURE DIVISION.

MAIN-PROCESS.
    PERFORM GET-TRANSFER-REQUEST.
    PERFORM VALIDATE-ACCOUNTS.
    PERFORM CHECK-SUFFICIENT-BALANCE.
    PERFORM EXECUTE-TRANSFER.
    PERFORM SEND-CONFIRMATION.
    PERFORM CLEANUP.
    STOP RUN.

GET-TRANSFER-REQUEST.
    EXEC CICS RECEIVE MAP('TRNMAP')
        MAPSET('TRNSET')
        INTO(TRANSFER-AREA)
        NOTAUTH
            PERFORM AUTH-ERROR
        END-NOTAUTH
    END-EXEC.

VALIDATE-ACCOUNTS.
    * Validate from account
    EXEC CICS READ
        DATASET('ACCOUNTS')
        INTO(FROM-ACCOUNT-RECORD)
        RIDFLD(WS-FROM-ACCOUNT)
        NOT-FOUND
            MOVE 'From account not found' TO ERROR-MSG
            PERFORM ERROR-HANDLING
        END-NOT-FOUND
    END-EXEC.
    
    * Validate to account
    EXEC CICS READ
        DATASET('ACCOUNTS')
        INTO(TO-ACCOUNT-RECORD)
        RIDFLD(WS-TO-ACCOUNT)
        NOT-FOUND
            MOVE 'To account not found' TO ERROR-MSG
            PERFORM ERROR-HANDLING
        END-NOT-FOUND
    END-EXEC.

CHECK-SUFFICIENT-BALANCE.
    IF FROM-ACCOUNT-BALANCE < WS-AMOUNT
        MOVE 'Insufficient balance' TO ERROR-MSG
        PERFORM ERROR-HANDLING
    END-IF.

EXECUTE-TRANSFER.
    * Debit from account
    SUBTRACT WS-AMOUNT FROM FROM-ACCOUNT-BALANCE.
    
    * Credit to account
    ADD WS-AMOUNT TO TO-ACCOUNT-BALANCE.
    
    * Write updated records
    EXEC CICS UPDATE
        DATASET('ACCOUNTS')
        FROM(FROM-ACCOUNT-RECORD)
        RIDFLD(WS-FROM-ACCOUNT)
    END-EXEC.
    
    EXEC CICS UPDATE
        DATASET('ACCOUNTS')
        FROM(TO-ACCOUNT-RECORD)
        RIDFLD(WS-TO-ACCOUNT)
    END-EXEC.
    
    * Commit transaction
    EXEC CICS SYNCPOINT
    END-EXEC.
    
    * Log transaction
    PERFORM LOG-TRANSACTION.

SEND-CONFIRMATION.
    MOVE 'Transfer successful' TO SUCCESS-MSG.
    EXEC CICS SEND MAP('CONFIRMATION')
        MAPSET('TRNSET')
        FROM(CONFIRMATION-AREA)
        ERASE
    END-EXEC.

CLEANUP.
    EXEC CICS RETURN
    END-EXEC.

ERROR-HANDLING.
    EXEC CICS ROLLBACK
    END-EXEC.
    EXEC CICS SEND TEXT
        FROM(ERROR-MSG)
        LENGTH(50)
        ERASE
    END-EXEC.
    EXEC CICS RETURN
    END-EXEC.

AUTH-ERROR.
    MOVE 'Not authorized for this transaction' 
        TO ERROR-MSG.
    PERFORM ERROR-HANDLING.
```

