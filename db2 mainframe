## SQL Fundamentals

### SELECT Statement

```sql
-- Basic SELECT
SELECT CUST_ID, NAME, PHONE
FROM CUSTOMER
WHERE CITY = 'New York'
ORDER BY NAME;

-- SELECT with JOIN
SELECT 
    C.CUST_ID, 
    C.NAME, 
    O.ORDER_ID, 
    O.ORDER_DATE
FROM CUSTOMER C
INNER JOIN ORDER O
    ON C.CUST_ID = O.CUST_ID
WHERE O.ORDER_DATE >= CURRENT_DATE - 30 DAYS
ORDER BY O.ORDER_DATE DESC;

-- SELECT with Aggregation
SELECT 
    CITY, 
    COUNT(*) AS CUSTOMER_COUNT,
    AVG(CREDIT_LIMIT) AS AVG_LIMIT
FROM CUSTOMER
GROUP BY CITY
HAVING COUNT(*) > 10
ORDER BY CUSTOMER_COUNT DESC;

-- SELECT with Subquery
SELECT C.CUST_ID, C.NAME
FROM CUSTOMER C
WHERE C.CUST_ID IN (
    SELECT CUST_ID
    FROM ORDER
    WHERE ORDER_DATE >= CURRENT_DATE - 365 DAYS
)
ORDER BY C.NAME;
```

### INSERT Statement

```sql
-- Single row INSERT
INSERT INTO CUSTOMER
    (CUST_ID, NAME, PHONE, EMAIL, CITY)
VALUES
    (100004, 'Alice', '555-04', 'alice@email.com', 'Boston');

-- Multiple row INSERT
INSERT INTO CUSTOMER
    (CUST_ID, NAME, PHONE, EMAIL, CITY)
VALUES
    (100005, 'Charlie', '555-05', 'charlie@email.com', 'Denver'),
    (100006, 'David', '555-06', 'david@email.com', 'Houston'),
    (100007, 'Emma', '555-07', 'emma@email.com', 'Phoenix');

-- INSERT from SELECT
INSERT INTO CUSTOMER_ARCHIVE
SELECT *
FROM CUSTOMER
WHERE INACTIVE_DATE < CURRENT_DATE - 365 DAYS;
```

### UPDATE Statement

```sql
-- Single column UPDATE
UPDATE CUSTOMER
SET PHONE = '555-99'
WHERE CUST_ID = 100001;

-- Multiple column UPDATE
UPDATE CUSTOMER
SET 
    PHONE = '555-99',
    EMAIL = 'newemail@example.com',
    LAST_UPDATE_DATE = CURRENT_TIMESTAMP
WHERE CUST_ID = 100001;

-- UPDATE with JOIN
UPDATE CUSTOMER C
SET CREDIT_LIMIT = 25000
WHERE CUST_ID IN (
    SELECT CUST_ID
    FROM ORDER
    GROUP BY CUST_ID
    HAVING SUM(ORDER_AMOUNT) > 100000
);
```

### DELETE Statement

```sql
-- Simple DELETE
DELETE FROM CUSTOMER
WHERE CUST_ID = 100001;

-- DELETE with WHERE clause
DELETE FROM ORDER
WHERE ORDER_DATE < CURRENT_DATE - 365 DAYS;

-- DELETE from table based on another
DELETE FROM CUSTOMER C
WHERE NOT EXISTS (
    SELECT 1
    FROM ORDER O
    WHERE O.CUST_ID = C.CUST_ID
);
```

