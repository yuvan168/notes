```sql
-- Find all recipients eligible for increased benefits
SELECT 
    R.RECIPIENT_ID,
    R.NAME,
    R.BIRTH_DATE,
    P.CLAIM_ID,
    P.BENEFIT_TYPE,
    CURRENT_BENEFIT_AMOUNT,
    PROPOSED_INCREASE
FROM RECIPIENT R
INNER JOIN BENEFIT_CLAIM P 
    ON R.RECIPIENT_ID = P.RECIPIENT_ID
WHERE 
    -- Age requirement
    YEAR(CURRENT_DATE) - YEAR(R.BIRTH_DATE) >= 62
    AND P.STATUS = 'ACTIVE'
    -- Income threshold
    AND R.ANNUAL_INCOME < 20000
    -- No recent claim increase (12 months)
    AND NOT EXISTS (
        SELECT 1
        FROM PAYMENT_HISTORY PH
        WHERE PH.RECIPIENT_ID = R.RECIPIENT_ID
          AND PH.PAYMENT_DATE >= CURRENT_DATE - 365 DAYS
          AND PH.PAYMENT_TYPE = 'INCREASE'
    )
    -- Verification complete
    AND P.VERIFICATION_STATUS = 'COMPLETE'
ORDER BY R.RECIPIENT_ID;
