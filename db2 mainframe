### Schema Design: Banking Database

```sql
-- Core Tables
CREATE TABLE CUSTOMER (
    CUST_ID BIGINT PRIMARY KEY,
    NAME VARCHAR(50) NOT NULL,
    SSN CHAR(9) UNIQUE,
    ADDRESS VARCHAR(100),
    PHONE CHAR(12),
    EMAIL VARCHAR(50),
    CREATION_DATE DATE,
    LAST_LOGIN TIMESTAMP
);

CREATE TABLE ACCOUNT (
    ACCOUNT_ID BIGINT PRIMARY KEY,
    CUST_ID BIGINT NOT NULL,
    ACCOUNT_TYPE CHAR(3),  -- SAV, CHK, MM
    BALANCE DECIMAL(15,2) NOT NULL,
    CREDIT_LIMIT DECIMAL(15,2),
    OPEN_DATE DATE,
    STATUS CHAR(1),  -- A=Active, I=Inactive, C=Closed
    FOREIGN KEY (CUST_ID) REFERENCES CUSTOMER
);

CREATE TABLE TRANSACTION_LOG (
    TRANS_ID BIGINT PRIMARY KEY,
    ACCOUNT_ID BIGINT NOT NULL,
    TRANS_DATE TIMESTAMP NOT NULL,
    TRANS_TYPE CHAR(1),  -- D=Debit, C=Credit
    AMOUNT DECIMAL(15,2),
    DESCRIPTION VARCHAR(100),
    NEW_BALANCE DECIMAL(15,2),
    STATUS CHAR(1),  -- P=Pending, C=Complete, R=Reversed
    FOREIGN KEY (ACCOUNT_ID) REFERENCES ACCOUNT
);

CREATE TABLE BALANCE_HISTORY (
    HISTORY_ID BIGINT PRIMARY KEY,
    ACCOUNT_ID BIGINT NOT NULL,
    SNAPSHOT_DATE DATE,
    OPENING_BALANCE DECIMAL(15,2),
    CLOSING_BALANCE DECIMAL(15,2),
    TOTAL_DEBITS DECIMAL(15,2),
    TOTAL_CREDITS DECIMAL(15,2),
    FOREIGN KEY (ACCOUNT_ID) REFERENCES ACCOUNT
);

-- Indexes for Performance
CREATE UNIQUE INDEX IX_ACCOUNT_ID 
    ON ACCOUNT(ACCOUNT_ID);
CREATE INDEX IX_ACCOUNT_CUST 
    ON ACCOUNT(CUST_ID);
CREATE INDEX IX_TRANS_ACCOUNT 
    ON TRANSACTION_LOG(ACCOUNT_ID);
CREATE INDEX IX_TRANS_DATE 
    ON TRANSACTION_LOG(TRANS_DATE);
CREATE INDEX IX_TRANS_STATUS 
    ON TRANSACTION_LOG(STATUS);
CREATE INDEX IX_BALANCE_DATE 
    ON BALANCE_HISTORY(SNAPSHOT_DATE);
```

### Code Example: Money Transfer with DB2

```cobol
IDENTIFICATION DIVISION.
PROGRAM-ID. BANK-TRANSFER.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-FROM-ACCOUNT      PIC 9(15).
01 WS-TO-ACCOUNT        PIC 9(15).
01 WS-AMOUNT            PIC 9(13)V99.
01 WS-FROM-BALANCE      PIC 9(13)V99.
01 WS-TO-BALANCE        PIC 9(13)V99.
01 WS-TRANS-ID          PIC 9(15).
01 WS-TIMESTAMP         PIC X(26).

PROCEDURE DIVISION.

PROCESS-TRANSFER.
    PERFORM GET-TRANSFER-REQUEST.
    PERFORM READ-FROM-ACCOUNT.
    PERFORM VALIDATE-BALANCE.
    PERFORM READ-TO-ACCOUNT.
    PERFORM EXECUTE-TRANSFER.
    PERFORM SAVE-TRANSACTION-LOG.
    PERFORM SEND-CONFIRMATION.
    STOP RUN.

GET-TRANSFER-REQUEST.
    EXEC CICS RECEIVE MAP('TRNMAP')
        MAPSET('TRNSET')
        INTO(TRANSFER-REQUEST)
    END-EXEC.

READ-FROM-ACCOUNT.
    EXEC CICS EXEC SQL
        SELECT BALANCE
        INTO :WS-FROM-BALANCE
        FROM ACCOUNT
        WHERE ACCOUNT_ID = :WS-FROM-ACCOUNT
        WITH UR  (Uncommitted Read - for validation)
    END-EXEC.

VALIDATE-BALANCE.
    IF WS-FROM-BALANCE < WS-AMOUNT
        MOVE 'Insufficient balance' TO ERROR-MSG
        PERFORM SEND-ERROR
    END-IF.

READ-TO-ACCOUNT.
    EXEC CICS EXEC SQL
        SELECT BALANCE
        INTO :WS-TO-BALANCE
        FROM ACCOUNT
        WHERE ACCOUNT_ID = :WS-TO-ACCOUNT
        WITH UR
    END-EXEC.

EXECUTE-TRANSFER.
    * Within a transaction for atomicity
    EXEC CICS EXEC SQL
        UPDATE ACCOUNT
        SET BALANCE = BALANCE - :WS-AMOUNT
        WHERE ACCOUNT_ID = :WS-FROM-ACCOUNT
    END-EXEC.
    
    EXEC CICS EXEC SQL
        UPDATE ACCOUNT
        SET BALANCE = BALANCE + :WS-AMOUNT
        WHERE ACCOUNT_ID = :WS-TO-ACCOUNT
    END-EXEC.
    
    * Commit both updates atomically
    EXEC CICS SYNCPOINT
    END-EXEC.

SAVE-TRANSACTION-LOG.
    * Generate transaction ID
    CALL 'GET-NEXT-TRANS-ID' USING WS-TRANS-ID.
    MOVE FUNCTION CURRENT-TIMESTAMP TO WS-TIMESTAMP.
    
    * Log debit (from account)
    EXEC CICS EXEC SQL
        INSERT INTO TRANSACTION_LOG
        (TRANS_ID, ACCOUNT_ID, TRANS_DATE, TRANS_TYPE,
         AMOUNT, NEW_BALANCE, STATUS)
        VALUES
        (:WS-TRANS-ID, :WS-FROM-ACCOUNT, :WS-TIMESTAMP,
         'D', :WS-AMOUNT, 
         :WS-FROM-BALANCE - :WS-AMOUNT, 'C')
    END-EXEC.
    
    * Log credit (to account)
    EXEC CICS EXEC SQL
        INSERT INTO TRANSACTION_LOG
        (TRANS_ID, ACCOUNT_ID, TRANS_DATE, TRANS_TYPE,
         AMOUNT, NEW_BALANCE, STATUS)
        VALUES
        (:WS-TRANS-ID, :WS-TO-ACCOUNT, :WS-TIMESTAMP,
         'C', :WS-AMOUNT,
         :WS-TO-BALANCE + :WS-AMOUNT, 'C')
    END-EXEC.

SEND-CONFIRMATION.
    MOVE 'Transfer successful' TO SUCCESS-MSG.
    MOVE WS-TRANS-ID TO CONFIRMATION-ID.
    MOVE WS-TIMESTAMP TO CONFIRMATION-TIME.
    
    EXEC CICS SEND MAP('CONFIRMATION')
        MAPSET('TRNSET')
        FROM(CONFIRMATION-AREA)
        ERASE
    END-EXEC.

SEND-ERROR.
    EXEC CICS ROLLBACK
    END-EXEC.
    EXEC CICS SEND TEXT
        FROM(ERROR-MSG)
        LENGTH(50)
        ERASE
    END-EXEC.
    EXEC CICS RETURN
    END-EXEC.
```

