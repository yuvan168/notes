```

### environments.yaml
```yaml
production:
  - name: "production"
    env-url: "PROD_DT_URL"      # Environment variable
    env-token-name: "PROD_DT_TOKEN"  # Environment variable
staging:
  - name: "staging"
    env-url: "STAGING_DT_URL"
    env-token-name: "STAGING_DT_TOKEN"
