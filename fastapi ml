# FASTAPI - Same Blog API
from fastapi import FastAPI, Depends, HTTPException
from sqlalchemy import create_engine
from sqlalchemy.orm import Session
from pydantic import BaseModel, Field

app = FastAPI()

# Models (SQLAlchemy)
class PostDB(Base):
    __tablename__ = "posts"
    id = Column(Integer, primary_key=True)
    title = Column(String(100))
    content = Column(Text)

# Schemas (Pydantic)
class PostCreate(BaseModel):
    title: str = Field(..., min_length=1, max_length=100)
    content: str = None

class PostResponse(BaseModel):
    id: int
    title: str
    content: str
    
    class Config:
        from_attributes = True

# Database dependency
def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

# Endpoints
@app.get("/api/posts", response_model=list[PostResponse])
async def list_posts(
    skip: int = Query(0, ge=0),
    limit: int = Query(10, ge=1, le=100),
    db: Session = Depends(get_db)
):
    # Validation automatic
    # Pagination params validated
    posts = db.query(PostDB).offset(skip).limit(limit).all()
    return posts

@app.post("/api/posts", response_model=PostResponse, status_code=201)
async def create_post(
    post: PostCreate,
    db: Session = Depends(get_db)
):
    # Validation automatic
    # Type checking automatic
    # Docs automatic
    db_post = PostDB(**post.dict())
    db.add(db_post)
    db.commit()
    db.refresh(db_post)
    return db_post

# Error handling automatic (422 for validation errors)
# Auth middleware available
# Docs at /docs (OpenAPI/Swagger)
# Everything structured, modern, fast
```

