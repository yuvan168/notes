## 💉 Dependency Injection

### Basic Dependencies

```python
from fastapi import FastAPI, Depends

app = FastAPI()

# Dependency function
def get_query_param(q: str = None):
    return {"q": q}

# Use dependency
@app.get("/items/")
def read_items(common: dict = Depends(get_query_param)):
    return common

# Dependency can be another dependency
def get_database_session():
    # Open connection
    db = open_db()
    try:
        yield db
    finally:
        # Close connection
        db.close()

@app.get("/items/")
def list_items(db = Depends(get_database_session)):
    items = db.query(Item).all()
    return items

# Class dependency
class CommonParams:
    def __init__(self, skip: int = 0, limit: int = 10):
        self.skip = skip
        self.limit = limit

@app.get("/items/")
def read_items(commons: CommonParams = Depends()):
    return {"skip": commons.skip, "limit": commons.limit}

# Dependency with body
from pydantic import BaseModel

class Credentials(BaseModel):
    username: str
    password: str

def verify_credentials(creds: Credentials):
    if creds.username != "admin" or creds.password != "secret":
        raise ValueError("Invalid credentials")
    return creds

@app.post("/login/")
def login(verified: Credentials = Depends(verify_credentials)):
    return {"message": f"Welcome {verified.username}"}
```

