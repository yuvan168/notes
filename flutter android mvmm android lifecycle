## Practical Applications & Real-World Usage

### Application 1: E-commerce Shopping Cart

**Theory:** Shopping cart requires real-time DOM updates, event handling, and data persistence without page reload using client-side state management.

**Process Flow:**
```
User Click → Validate Item → Update Internal State → 
Persist to Storage → Render DOM → Provide Feedback
```

**Complete Implementation:**

```javascript
class CartManager {
    constructor() {
        this.cart = JSON.parse(localStorage.getItem('cart')) || [];
        this.init();
    }

    init() {
        // Add to cart button click handler with event delegation
        $(document).on('click', '.add-to-cart', (e) => {
            e.preventDefault();
            const productId = $(e.target).data('product-id');
            const productName = $(e.target).data('product-name');
            const price = parseFloat($(e.target).data('price'));
            
            this.addItem({ id: productId, name: productName, price: price });
        });

        // Quantity change with real-time update
        $(document).on('change', '.cart-quantity', (e) => {
            const $row = $(e.target).closest('tr');
            const itemId = $row.data('item-id');
            const newQty = parseInt($(e.target).val());
            
            this.updateQuantity(itemId, newQty);
        });

        // Remove item
        $(document).on('click', '.remove-item', (e) => {
            const $row = $(e.target).closest('tr');
            const itemId = $row.data('item-id');
            
            this.removeItem(itemId);
        });
    }

    addItem(product) {
        const existing = this.cart.find(item => item.id === product.id);
        
        if (existing) {
            existing.quantity += 1;
        } else {
            this.cart.push({ ...product, quantity: 1 });
        }
        
        this.persist();
        this.renderCart();
        this.notify(`${product.name} added to cart!`);
    }

    updateQuantity(itemId, quantity) {
        if (quantity <= 0) {
            this.removeItem(itemId);
            return;
        }
        
        const item = this.cart.find(i => i.id === itemId);
        if (item) {
            item.quantity = quantity;
            this.persist();
            this.renderCart();
        }
    }

    removeItem(itemId) {
        this.cart = this.cart.filter(item => item.id !== itemId);
        this.persist();
        this.renderCart();
    }

    persist() {
        localStorage.setItem('cart', JSON.stringify(this.cart));
    }

    renderCart() {
        const $tbody = $('#cart-items tbody');
        $tbody.empty();
        let total = 0;

        this.cart.forEach(item => {
            const subtotal = item.price * item.quantity;
            total += subtotal;

            const $row = $(`
                <tr data-item-id="${item.id}">
                    <td>${item.name}</td>
                    <td>$${item.price.toFixed(2)}</td>
                    <td><input type="number" class="cart-quantity" value="${item.quantity}" min="1"></td>
                    <td>$${subtotal.toFixed(2)}</td>
                    <td><button class="btn btn-sm btn-danger remove-item">Remove</button></td>
                </tr>
            `);
            $tbody.append($row);
        });

        $('#cart-total').text(total.toFixed(2));
        $('#item-count').text(this.cart.length);
    }

    notify(message) {
        const $notif = $(`<div class="alert alert-success alert-dismissible">${message}</div>`);
        $('#notifications').append($notif);
        setTimeout(() => $notif.fadeOut(300, function() { $(this).remove(); }), 3000);
    }
}

$(document).ready(function() {
    new CartManager();
});
```

**Theory Explanation:**
- **Event Delegation**: `.on()` with dynamic selectors handles items added after page load
- **Data Attributes**: Stores product info in `data-*` attributes
- **localStorage**: Persists cart across sessions without backend
- **Efficient Rendering**: Rebuilds only what changed
- **User Feedback**: Toast notifications confirm actions

