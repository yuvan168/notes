**Q11: Design a Chat Application with Real-time Messaging.**

**Requirements:**
- Send/receive messages in real-time
- User online status
- Message delivery status
- Typing indicator

**Solution (Firebase Firestore):**
```dart
class ChatViewModel extends ChangeNotifier {
  final FirebaseFirestore _firestore = FirebaseFirestore.instance;
  final String _currentUserId = FirebaseAuth.instance.currentUser!.uid;

  List<Message> _messages = [];
  String _typingUser = '';
  bool _isTyping = false;

  List<Message> get messages => _messages;
  String get typingUser => _typingUser;

  void initialize(String chatRoomId) {
    // Listen to messages
    _firestore
        .collection('chat_rooms')
        .doc(chatRoomId)
        .collection('messages')
        .orderBy('timestamp', descending: true)
        .snapshots()
        .listen((snapshot) {
      _messages = snapshot.docs
          .map((doc) => Message.fromJson(doc.data()))
          .toList();
      notifyListeners();
    });

    // Listen to typing indicator
    _firestore
        .collection('chat_rooms')
        .doc(chatRoomId)
        .snapshots()
        .listen((doc) {
      _typingUser = doc.get('typing_user') ?? '';
      notifyListeners();
    });

    // Set user online
    updateUserStatus(chatRoomId, true);
  }

  Future<void> sendMessage(String chatRoomId, String content) async {
    final message = Message(
      id: _firestore.collection('messages').doc().id,
      senderId: _currentUserId,
      content: content,
      timestamp: DateTime.now(),
      status: MessageStatus.sent,
    );

    try {
      await _firestore
          .collection('chat_rooms')
          .doc(chatRoomId)
          .collection('messages')
          .doc(message.id)
          .set(message.toJson());

      // Update last message
      await _firestore
          .collection('chat_rooms')
          .doc(chatRoomId)
          .update({
        'last_message': content,
        'last_message_timestamp': FieldValue.serverTimestamp(),
      });
    } catch (e) {
      print('Error sending message: $e');
    }
  }

  void setTyping(String chatRoomId, bool isTyping) {
    _firestore
        .collection('chat_rooms')
        .doc(chatRoomId)
        .update({'typing_user': isTyping ? _currentUserId : ''});
  }

  Future<void> updateUserStatus(String chatRoomId, bool isOnline) async {
    await _firestore
        .collection('users')
        .doc(_currentUserId)
        .update({'is_online': isOnline, 'last_seen': DateTime.now()});
  }
}

// Message Model
class Message {
  final String id;
  final String senderId;
  final String content;
  final DateTime timestamp;
  final MessageStatus status;

  Message({
    required this.id,
    required this.senderId,
    required this.content,
    required this.timestamp,
    required this.status,
  });

  Map<String, dynamic> toJson() => {
        'id': id,
        'senderId': senderId,
        'content': content,
        'timestamp': timestamp,
        'status': status.name,
      };

  factory Message.fromJson(Map<String, dynamic> json) => Message(
        id: json['id'],
        senderId: json['senderId'],
        content: json['content'],
        timestamp: (json['timestamp'] as Timestamp).toDate(),
        status: MessageStatus.values.byName(json['status']),
      );
}

enum MessageStatus { sent, delivered, read }
