### Application 2: Real-time Form Validation

**Theory:** Provides instant feedback on form fields, improving user experience and reducing submission errors.

**Process Flow:**
```
Field Input → Validate Against Rules → Show/Hide Error → 
Update UI State → Track Form Validity
```

**Implementation:**

```javascript
class FormValidator {
    constructor(formSelector) {
        this.$form = $(formSelector);
        this.rules = {};
        this.init();
    }

    init() {
        // Real-time validation on input
        this.$form.on('change blur keyup', 'input, textarea, select', (e) => {
            const $field = $(e.target);
            const fieldName = $field.attr('name');
            this.validateField($field, fieldName);
        });

        // Prevent invalid submission
        this.$form.on('submit', (e) => {
            if (!this.validateForm()) {
                e.preventDefault();
            }
        });
    }

    addRule(fieldName, validationRules) {
        this.rules[fieldName] = validationRules;
    }

    validateField($field, fieldName) {
        const rules = this.rules[fieldName];
        if (!rules) return true;

        const value = $field.val().trim();
        const $errorDiv = $field.closest('.form-group').find('.error-message');

        for (const rule of rules) {
            const result = rule.validate(value);
            
            if (!result.valid) {
                $field.addClass('is-invalid').removeClass('is-valid');
                $errorDiv.text(result.message).show();
                return false;
            }
        }

        $field.removeClass('is-invalid').addClass('is-valid');
        $errorDiv.hide();
        return true;
    }

    validateForm() {
        let isValid = true;
        this.$form.find('input, textarea, select').each((index, field) => {
            const $field = $(field);
            if (!this.validateField($field, $field.attr('name'))) {
                isValid = false;
            }
        });
        return isValid;
    }
}

// Usage
$(document).ready(function() {
    const validator = new FormValidator('#registrationForm');

    validator.addRule('email', [
        {
            validate: (value) => ({
                valid: value.length > 0,
                message: 'Email is required'
            })
        },
        {
            validate: (value) => ({
                valid: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value),
                message: 'Email format is invalid'
            })
        }
    ]);

    validator.addRule('password', [
        {
            validate: (value) => ({
                valid: value.length >= 8,
                message: 'Password must be at least 8 characters'
            })
        }
    ]);
});
```

**Theory Explanation:**
- **Regex Validation**: Pattern matching for email, password strength
- **Real-time Feedback**: Validates on keystroke, change, blur events
- **CSS Classes**: Visual states (is-valid, is-invalid) guide users
- **Efficient Checking**: Only validates relevant fields
- **User Experience**: Early error detection prevents frustration

