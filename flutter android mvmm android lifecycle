### Application 5: File Upload with Progress Tracking

**Theory:** HTML5 File API combined with FormData for multipart uploads with progress visualization.

**Implementation:**

```javascript
class FileUploader {
    constructor(options = {}) {
        this.inputSelector = options.inputSelector || '#file-input';
        this.dropZone = options.dropZone || '#drop-zone';
        this.uploadUrl = options.uploadUrl || '/api/upload';
        this.maxSize = options.maxSize || 5 * 1024 * 1024;
        this.allowedTypes = options.allowedTypes || ['image/jpeg', 'image/png'];
        
        this.init();
    }

    init() {
        const $input = $(this.inputSelector);
        const $zone = $(this.dropZone);

        $input.on('change', (e) => this.handleFiles(e.target.files));

        $zone.on('dragover dragenter', (e) => {
            e.preventDefault();
            $zone.addClass('drag-over');
        });

        $zone.on('dragleave drop', (e) => {
            e.preventDefault();
            $zone.removeClass('drag-over');
        });

        $zone.on('drop', (e) => this.handleFiles(e.originalEvent.dataTransfer.files));
    }

    handleFiles(files) {
        $.each(files, (i, file) => {
            if (this.validateFile(file)) {
                this.uploadFile(file);
            }
        });
    }

    validateFile(file) {
        if (!this.allowedTypes.includes(file.type)) {
            this.showError('File type not allowed');
            return false;
        }
        if (file.size > this.maxSize) {
            this.showError('File too large');
            return false;
        }
        return true;
    }

    uploadFile(file) {
        const formData = new FormData();
        formData.append('file', file);
        const uploadId = 'upload-' + Date.now();
        const $progress = this.createProgressElement(uploadId, file.name);

        $.ajax({
            url: this.uploadUrl,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            
            xhr: () => {
                const xhr = new XMLHttpRequest();
                xhr.upload.addEventListener('progress', (e) => {
                    if (e.lengthComputable) {
                        const percent = (e.loaded / e.total) * 100;
                        this.updateProgress($progress, percent);
                    }
                });
                return xhr;
            },

            success: () => {
                this.updateProgress($progress, 100);
                $progress.find('.status').text('✓ Done').addClass('text-success');
                this.showSuccess(`${file.name} uploaded!`);
            },

            error: () => {
                $progress.find('.status').text('✗ Failed').addClass('text-danger');
            }
        });
    }

    createProgressElement(id, name) {
        const $el = $(`
            <div class="upload-item" id="${id}">
                <div>${name}</div>
                <div class="progress">
                    <div class="progress-bar" style="width: 0%"></div>
                </div>
                <span class="status">Uploading...</span>
            </div>
        `);
        $('#uploads').append($el);
        return $el;
