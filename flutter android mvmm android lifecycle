**Q10: How would you implement offline functionality with caching?**

A:
```dart
// Theory: Cache remote data locally, fallback to cache when offline

class CachedProductRepository {
  final RemoteDataSource remote;
  final LocalDataSource local;
  final ConnectivityService connectivity;

  Future<List<Product>> getProducts() async {
    try {
      // Check connectivity
      final isOnline = await connectivity.isOnline();

      if (isOnline) {
        // Fetch from remote
        final products = await remote.getProducts();
        
        // Cache locally
        await local.saveProducts(products);
        
        return products;
      } else {
        // Use cached data
        return await local.getProducts();
      }
    } catch (e) {
      // Error on remote, fallback to cache
      return await local.getProducts();
    }
  }
}

// Connectivity Service
class ConnectivityService {
  Future<bool> isOnline() async {
    final connectivityResult = await (Connectivity().checkConnectivity());
    return connectivityResult != ConnectivityResult.none;
  }
}

// Local Data Source (using Hive)
class LocalDataSource {
  Future<void> saveProducts(List<Product> products) async {
    final box = Hive.box('products');
    await box.putAll({
      'products': products.map((p) => p.toJson()).toList(),
      'timestamp': DateTime.now().toIso8601String(),
    });
  }

  Future<List<Product>> getProducts() async {
    final box = Hive.box('products');
    final data = box.get('products') as List?;
    return (data ?? [])
        .map((json) => Product.fromJson(json))
        .toList();
  }
}
