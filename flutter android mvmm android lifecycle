initModule();  // Now 2 click handlers
initModule();  // Now 3 click handlers

// Result: Click handler fires multiple times!

// ✅ Solution 1: Remove old handlers first
function initModule() {
    $('button').off('click', handleClick);  // Remove old
    $('button').on('click', handleClick);   // Add new
}

// ✅ Solution 2: Use event namespacing
function initModule() {
    $('button').on('click.myModule', handleClick);
}

function destroyModule() {
    $('button').off('click.myModule');  // Remove only our handlers
}

// ✅ Solution 3: Init only once with flag
let moduleInitialized = false;
function initModule() {
    if (moduleInitialized) return;
    
    $('button').on('click', handleClick);
    moduleInitialized = true;
}
```

