## jQuery Advanced Design Patterns

### Pattern 1: Module Pattern with jQuery

**Use Case:** Organize code into reusable, encapsulated modules

```javascript
const MyApp = (function() {
    'use strict';

    // Private variables
    const cache = {};
    let config = { timeout: 5000 };

    // Private functions
    function cacheResponse(key, data) {
        cache[key] = data;
    }

    function getCached(key) {
        return cache[key];
    }

    // Public API
    return {
        init: function(options) {
            config = $.extend(config, options);
            this.bindEvents();
        },

        bindEvents: function() {
            $(document).on('click', '.search-btn', function() {
                MyApp.search($('.search-input').val());
            });
        },

        search: function(query) {
            if (getCached(query)) {
                return $.when(getCached(query));
            }

            return $.ajax({
                url: '/api/search',
                data: { q: query },
                timeout: config.timeout
            }).done(function(data) {
                cacheResponse(query, data);
            });
        }
    };
}());

// Initialize once
MyApp.init({ timeout: 10000 });

// Usage
MyApp.search('jquery').done(function(results) {
    console.log(results);
});
```

### Pattern 2: Observer Pattern

**Use Case:** Decouple components through event-based communication

```javascript
// Custom event emitter
const EventBus = {
    events: {},
    
    subscribe: function(event, callback) {
        if (!this.events[event]) {
            this.events[event] = [];
        }
        this.events[event].push(callback);
    },
    
    publish: function(event, data) {
        if (this.events[event]) {
            this.events[event].forEach(function(callback) {
                callback(data);
            });
        }
    }
};

// Component 1: User List
const UserList = {
    init: function() {
        EventBus.subscribe('user:selected', this.onUserSelected.bind(this));
    },
    
    onUserSelected: function(user) {
        console.log('List received:', user);
        // Update list
    }
};

// Component 2: User Details
const UserDetails = {
    init: function() {
        $(document).on('click', '.user', function() {
            const user = { id: 1, name: 'John' };
            EventBus.publish('user:selected', user);
        });
    }
};

// Or use jQuery's custom events
$(document).on('click', '.user', function(e) {
    const user = { id: 1, name: 'John' };
    $(document).trigger('user:selected', [user]);
});

$(document).on('user:selected', function(e, user) {
    console.log('Selected:', user);
});
```

### Pattern 3: Mixin Pattern

**Use Case:** Add methods to jQuery objects dynamically

```javascript
// Create mixins
const ValidationMixin = {
    validate: function() {
        this.each(function() {
            const $field = $(this);
            const value = $field.val();
            if (!value) {
                $field.addClass('error');
            }
        });
        return this;  // Chainable
    },
    
    clearErrors: function() {
        this.removeClass('error');
        return this;
    }
};

const StyleMixin = {
    highlight: function() {
        this.addClass('highlighted');
        return this;
    },
    
    dim: function() {
        this.addClass('dimmed');
        return this;
    }
};

// Apply mixins
$.extend($.fn, ValidationMixin, StyleMixin);

// Now all jQuery objects have these methods
$('.form-field')
    .validate()
    .highlight()
    .clearErrors()
    .dim();
```

### Pattern 4: Namespace Pattern

**Use Case:** Prevent global namespace pollution

```javascript
// Create namespace
window.MyApp = window.MyApp || {};
window.MyApp.Modules = {};
window.MyApp.Config = {};

// Add modules to namespace
window.MyApp.Modules.Cart = {
