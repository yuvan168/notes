## Event Handling

### Event Basics

```javascript
// Traditional on() method
$('.button').on('click', function(event) {
    console.log('Clicked!');
    console.log(event.type);    // 'click'
    console.log(event.target);  // Element that triggered
    console.log(this);          // Element (same as target usually)
});

// Multiple events
$('.input').on('click focus blur', function() {
    console.log('Event fired');
});

// Event object methods
event.preventDefault()          // Cancel default action
event.stopPropagation()        // Stop event bubbling
event.stopImmediatePropagation()  // Stop all handlers
event.which                     // Key code (deprecated)
event.key                       // Key name

// Shorthand methods (for common events)
$('.button').click(function() { })
$('.button').dblclick(function() { })
$('input').focus(function() { })
$('input').blur(function() { })
$('input').change(function() { })
$('form').submit(function() { })
$(document).keydown(function(e) { })
$(window).resize(function() { })
```

### Event Delegation

```javascript
// Static elements
$('.button').on('click', function() {
    console.log('Button clicked');
});

// Dynamic elements - use delegation
$('.container').on('click', '.button', function() {
    console.log('Button clicked (works for dynamic elements)');
});

// How it works:
// 1. Event handler attached to .container
// 2. When click occurs, check if target matches '.button'
// 3. If match, call handler

// Theory: Why delegation is important
// Static event: Only works for elements existing at page load
// Delegated: Works for dynamically added elements too

// Performance: Fewer handlers
// $('button').on('click', fn)  // If 1000 buttons, 1000 handlers
// $(document).on('click', 'button', fn)  // Just 1 handler

// Example: Dynamic list
$('#myList').on('click', 'li', function() {
    $(this).remove();
});

// Adding new list items later still works!
const $newItem = $('<li>Item 4</li>');
$('#myList').append($newItem);
// Clicking it still triggers the handler
```

### Removing Event Handlers

```javascript
// Remove all handlers
$('.button').off('click')

// Remove specific handler
const handler = function() { };
$('.button').on('click', handler);
$('.button').off('click', handler);

// Remove all event types
$('.button').off()

// Remove delegated handler
$('.container').off('click', '.button')

// One-time handler
$('.button').one('click', function() {
    console.log('Fires only once');
});
```

### Event Object Deep Dive

```javascript
$(document).on('click', function(event) {
    // Event properties
    event.type                  // 'click'
    event.target                // Element that triggered
    event.currentTarget         // Element handler attached to
    event.timeStamp             // Time event occurred
    
    // Keyboard specific
    event.which                 // Key code
    event.key                   // Key name ('Enter', 'ArrowUp', etc.)
    event.shiftKey              // Shift pressed?
    event.ctrlKey               // Control pressed?
    event.altKey                // Alt pressed?
    event.metaKey               // Command/Windows key?
    
    // Mouse specific
    event.pageX                 // X relative to document
    event.pageY                 // Y relative to document
    event.screenX               // X relative to screen
    event.screenY               // Y relative to screen
    event.clientX               // X relative to viewport
    event.clientY               // Y relative to viewport
    
    // Methods
    event.preventDefault()      // Stop default behavior
    event.stopPropagation()     // Stop bubbling
    event.stopImmediatePropagation()  // Stop all handlers
});

// Example: Keyboard handling
$(document).on('keydown', function(e) {
    if (e.key === 'Enter') {
        // Enter pressed
    }
    if (e.ctrlKey && e.key === 's') {
        e.preventDefault();
        // Ctrl+S pressed
    }
});
```

