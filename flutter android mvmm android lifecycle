### Pattern 5: Singleton Pattern

**Use Case:** Ensure only one instance exists globally

```javascript
// Singleton logger
const Logger = (function() {
    let instance;
    
    function createInstance() {
        return {
            logs: [],
            
            log: function(message) {
                this.logs.push(message);
                console.log('[LOG]', message);
            },
            
            error: function(message) {
                this.logs.push('ERROR: ' + message);
                console.error('[ERROR]', message);
            },
            
            getLogs: function() {
                return this.logs;
            }
        };
    }
    
    return {
        getInstance: function() {
            if (!instance) {
                instance = createInstance();
            }
            return instance;
        }
    };
}());

// Same instance everywhere
const log1 = Logger.getInstance();
const log2 = Logger.getInstance();

log1.log('Message 1');
log2.log('Message 2');

console.log(log1 === log2);  // true - same instance
console.log(log1.getLogs()); // Both messages
```

