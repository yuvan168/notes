### Application 4: Live Dashboard with Real-time Updates

**Theory:** Polling or WebSocket connection fetches fresh data periodically, updating metrics and charts without page refresh.

**Implementation:**

```javascript
class LiveDashboard {
    constructor(options = {}) {
        this.refreshInterval = options.refreshInterval || 5000;
        this.dataUrl = options.dataUrl || '/api/dashboard';
        this.pollingTimer = null;
        
        this.init();
    }

    init() {
        this.loadData();
        this.startPolling();

        // Stop polling when tab hidden
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                this.stopPolling();
            } else {
                this.startPolling();
                this.loadData();
            }
        });
    }

    loadData() {
        $.ajax({
            url: this.dataUrl,
            dataType: 'json',
            timeout: 5000,
            success: (data) => this.updateDashboard(data),
            error: () => this.showError()
        });
    }

    updateDashboard(data) {
        this.updateMetric('#total-users', data.totalUsers);
        this.updateMetric('#revenue', data.totalRevenue, '$');
        this.updateActivityFeed(data.recentActivity);
        $('#last-updated').text(new Date().toLocaleTimeString());
    }

    updateMetric($selector, newValue, prefix = '') {
        const $el = $($selector);
        const oldValue = parseInt($el.text().replace(/\D/g, ''));
        
        if (oldValue !== newValue) {
            $el
                .animate({ color: '#4CAF50' }, 300)
                .text(prefix + newValue.toLocaleString())
                .animate({ color: '#000' }, 300);
        }
    }

    updateActivityFeed(activities) {
        const $feed = $('#activity-feed');
        activities.slice(0, 5).forEach(activity => {
            if (!$(`[data-id="${activity.id}"]`).length) {
                const $item = $(`<div data-id="${activity.id}">${activity.text}</div>`);
                $feed.prepend($item).hide().slideDown(300);
            }
        });
    }

    startPolling() {
        if (this.pollingTimer) return;
        this.pollingTimer = setInterval(() => this.loadData(), this.refreshInterval);
    }

    stopPolling() {
        clearInterval(this.pollingTimer);
        this.pollingTimer = null;
    }

    showError() {
        $('#status').text('Offline').addClass('text-danger');
    }

    destroy() {
        this.stopPolling();
    }
}

$(document).ready(function() {
    const dashboard = new LiveDashboard({ refreshInterval: 5000 });
    $(window).on('beforeunload', () => dashboard.destroy());
});
```

**Theory Explanation:**
- **Polling Pattern**: Regular AJAX requests fetch fresh data
- **Resource Efficiency**: Stops polling when tab hidden
- **Debouncing**: Flag prevents simultaneous requests
- **Visual Feedback**: Animations show data changes
- **Memory Management**: Limits feed items to prevent bloat

