    .done(function(data) {
        console.log('Success:', data);  // If successful
    })
    .fail(function(error) {
        console.log('Error:', error);   // If failed
    })
    .always(function() {
        console.log('Done (success or fail)');  // Always runs
    });

// Create custom Deferred for complex workflows
function loadUserAndPosts(userId) {
    const deferred = $.Deferred();
    
    $.get('/api/users/' + userId).done(function(user) {
        $.get('/api/users/' + userId + '/posts').done(function(posts) {
            deferred.resolve({ user, posts });
        }).fail(function(error) {
            deferred.reject(error);
        });
    }).fail(function(error) {
        deferred.reject(error);
    });
    
    return deferred.promise();
}

// Usage
loadUserAndPosts(1)
    .done(function(data) {
        console.log('User:', data.user);
        console.log('Posts:', data.posts);
    })
    .fail(function(error) {
        console.error('Failed to load:', error);
    });

// Wait for multiple async operations
$.when(
    $.get('/api/users'),
    $.get('/api/posts'),
    $.get('/api/comments')
).done(function(users, posts, comments) {
    console.log('All loaded:', users, posts, comments);
}).fail(function(error) {
    console.error('At least one failed:', error);
});
