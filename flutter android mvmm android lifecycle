import 'package:cloud_firestore/cloud_firestore.dart';

class DatabaseService {
  final FirebaseFirestore _db = FirebaseFirestore.instance;

  // Add document
  Future<void> addUser(String id, String name, String email) async {
    await _db.collection('users').doc(id).set({
      'name': name,
      'email': email,
      'createdAt': Timestamp.now(),
    });
  }

  // Read single document
  Future<Map<String, dynamic>?> getUser(String id) async {
    final doc = await _db.collection('users').doc(id).get();
    return doc.data();
  }

  // Read collection
  Future<List<Map<String, dynamic>>> getAllUsers() async {
    final docs = await _db.collection('users').get();
    return docs.docs.map((doc) => doc.data()).toList();
  }

  // Stream collection
  Stream<List<Map<String, dynamic>>> getUsersStream() {
    return _db.collection('users').snapshots().map((snapshot) {
      return snapshot.docs.map((doc) => doc.data()).toList();
    });
  }

  // Update document
  Future<void> updateUser(String id, String name) async {
    await _db.collection('users').doc(id).update({'name': name});
  }

  // Delete document
  Future<void> deleteUser(String id) async {
    await _db.collection('users').doc(id).delete();
  }

  // Query
  Future<List<Map<String, dynamic>>> searchUsers(String name) async {
    final docs = await _db
        .collection('users')
        .where('name', isEqualTo: name)
        .get();
    return docs.docs.map((doc) => doc.data()).toList();
  }
