### Pattern 2: State Management with jQuery

**Theory:** Managing application state without frameworks requires discipline and patterns.

```javascript
// State Management Pattern
const AppState = {
    _state: {
        user: null,
        isLoading: false,
        data: []
    },

    // Observer pattern for state changes
    _observers: [],

    subscribe(callback) {
        this._observers.push(callback);
    },

    setState(key, value) {
        const oldValue = this._state[key];
        
        if (oldValue !== value) {
            this._state[key] = value;
            
            // Notify all observers
            this._observers.forEach(callback => {
                callback(key, value, oldValue);
            });
        }
    },

    getState(key) {
        return this._state[key];
    }
};

// Subscribe to state changes
AppState.subscribe((key, newValue, oldValue) => {
    console.log(`State changed: ${key} = ${newValue}`);
});

// UI reacts to state changes
$(document).ready(function() {
    AppState.subscribe(function(key, newValue) {
        if (key === 'isLoading') {
            if (newValue) {
                $('#loader').show();
            } else {
                $('#loader').hide();
            }
        }
        
        if (key === 'user') {
            if (newValue) {
                $('#user-info').text(newValue.name).show();
            } else {
