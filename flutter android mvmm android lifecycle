### Intermediate Level Questions

**Q5: Explain the Widget Lifecycle in detail.**

A:
```
initState() → Called once, initialize state
    ↓
didChangeDependencies() → Dependencies changed
    ↓
build() → Render UI (multiple times)
    ↓
setState() → State changed, trigger rebuild
    ↓
didUpdateWidget() → Parent widget changed
    ↓
deactivate() → Widget being removed
    ↓
dispose() → Cleanup and destroy
```

**Practical Implementation:**
```dart
class LifecycleDemo extends StatefulWidget {
  @override
  State<LifecycleDemo> createState() => _LifecycleDemoState();
}

class _LifecycleDemoState extends State<LifecycleDemo> {
  late StreamSubscription _subscription;

  @override
  void initState() {
    super.initState();
    print('1. initState - Initialize resources');
    _subscription = someStream().listen((value) {
      print('Stream value: $value');
    });
  }

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    print('2. didChangeDependencies - Dependencies changed');
  }

  @override
  void didUpdateWidget(LifecycleDemo oldWidget) {
    super.didUpdateWidget(oldWidget);
    print('3. didUpdateWidget - Parent widget changed');
  }

  @override
  void dispose() {
    print('4. dispose - Cleanup resources');
    _subscription.cancel();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    print('5. build - Render UI');
    return Scaffold(
      appBar: AppBar(title: const Text('Lifecycle')),
      body: const Center(child: Text('Lifecycle Demo')),
    );
  }
}
