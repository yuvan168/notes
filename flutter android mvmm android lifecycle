// Pattern 2: Custom Deferred
function loadUserData(userId) {
    const deferred = $.Deferred();
    
    $.get('/api/users/' + userId)
        .done(function(user) {
            $.get('/api/posts/' + user.id)
                .done(function(posts) {
                    deferred.resolve({ user, posts });
                })
                .fail(function(error) {
                    deferred.reject(error);
                });
        });
    
    return deferred.promise();
}

