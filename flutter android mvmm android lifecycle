### Q12: Design a jQuery plugin

**Question:** Create a reusable, flexible plugin with options and methods

**Answer:**
```javascript
// Professional Plugin Pattern

;(function($) {
    'use strict';

    const PluginName = 'myCarousel';
    const defaults = {
        speed: 500,
        autoplay: true,
        interval: 3000,
        onNext: null
    };

    function Plugin(element, options) {
        this.element = element;
        this.$element = $(element);
        this.options = $.extend({}, defaults, options);
        this.currentIndex = 0;
        this.init();
    }

    Plugin.prototype.init = function() {
        this.$slides = this.$element.find('.slide');
        this.slideCount = this.$slides.length;
        this.bindEvents();
        if (this.options.autoplay) {
            this.startAutoplay();
        }
    };

    Plugin.prototype.bindEvents = function() {
        this.$element.on('click', '.next', $.proxy(this.next, this));
    };

    Plugin.prototype.next = function(e) {
        if (e) e.preventDefault();
        this.currentIndex = (this.currentIndex + 1) % this.slideCount;
        this.slide();
        if (typeof this.options.onNext === 'function') {
            this.options.onNext.call(this.element, this.currentIndex);
        }
    };

    Plugin.prototype.slide = function() {
        this.$slides.fadeOut(this.options.speed);
        this.$slides.eq(this.currentIndex).fadeIn(this.options.speed);
    };

    Plugin.prototype.destroy = function() {
        this.$element.off();
        this.$element.removeData(PluginName);
    };

    // jQuery plugin definition
    $.fn[PluginName] = function(options) {
        if (typeof options === 'string') {
            const method = options;
            const args = Array.prototype.slice.call(arguments, 1);
            let returnValue;
            
            this.each(function() {
                const instance = $.data(this, PluginName);
                if (instance && typeof instance[method] === 'function') {
                    returnValue = instance[method].apply(instance, args);
                }
            });
            
            return returnValue !== undefined ? returnValue : this;
        }

        return this.each(function() {
            if (!$.data(this, PluginName)) {
                const instance = new Plugin(this, options);
                $.data(this, PluginName, instance);
            }
        });
    };

}(jQuery));

// Usage:
$('#carousel').myCarousel({
    speed: 300,
    autoplay: true,
    interval: 4000,
    onNext: function(index) {
        console.log('Slide:', index);
    }
});

// Call methods:
$('#carousel').myCarousel('next');
$('#carousel').myCarousel('destroy');

// Benefits:
// ✓ Namespace prevents conflicts
// ✓ Options provide flexibility
// ✓ Methods callable with string syntax
// ✓ Proper data storage
// ✓ Clean cleanup
```

