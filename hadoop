### Application 2: Fraud Detection in Financial Transactions

**Use Case:** Analyze transaction patterns to identify suspicious behavior

```java
public class FraudDetection {
    
    public static class Transaction {
        private String accountId;
        private long amount;
        private String country;
        private long timestamp;
    }
    
    public static class TransactionMapper 
            extends Mapper<LongWritable, Text, Text, Text> {
        
        private static final long LARGE_AMOUNT = 100000; // $100,000
        private static final long SHORT_TIMESPAN = 300000; // 5 minutes
        
        @Override
        protected void map(LongWritable key, Text value, Context context)
                throws IOException, InterruptedException {
            
            // accountId,amount,country,timestamp
            String[] fields = value.toString().split(",");
            String accountId = fields[0];
            long amount = Long.parseLong(fields[1]);
            String country = fields[2];
            long timestamp = Long.parseLong(fields[3]);
            
            // Flag suspicious transactions
            if (amount > LARGE_AMOUNT) {
                context.write(
                    new Text(accountId), 
                    new Text("LARGE_AMOUNT," + amount + "," + country)
                );
            }
            
            // Emit all transactions for pattern analysis
            context.write(
                new Text(accountId),
                new Text("TRANSACTION," + amount + "," + country + "," + timestamp)
            );
        }
    }
    
    public static class FraudReducer 
            extends Reducer<Text, Text, Text, Text> {
        
        @Override
        protected void reduce(Text key, Iterable<Text> values, Context context)
                throws IOException, InterruptedException {
            
            java.util.List<String> transactions = new java.util.ArrayList<>();
            int largeTransactions = 0;
            java.util.Set<String> countries = new java.util.HashSet<>();
            
            for (Text val : values) {
                String line = val.toString();
                transactions.add(line);
                
                if (line.startsWith("LARGE_AMOUNT")) {
                    largeTransactions++;
                } else if (line.startsWith("TRANSACTION")) {
                    String[] parts = line.split(",");
                    if (parts.length > 2) {
                        countries.add(parts[2]);
                    }
                }
            }
            
            // Flag if multiple countries in short timespan
            boolean isSuspicious = false;
            if (largeTransactions > 2) {
                isSuspicious = true;
            }
            if (countries.size() > 3) {
                isSuspicious = true;
            }
            
            if (isSuspicious) {
                context.write(
                    key,
                    new Text("SUSPICIOUS: " + largeTransactions + 
                            " large trans, " + countries.size() + " countries")
                );
            }
        }
    }
}
```

**Process:**
1. Analyze transaction patterns per account
2. Identify large transactions
3. Detect multiple countries in short timeframe
4. Flag suspicious accounts for review

