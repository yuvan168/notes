### Complete Example: Customer Purchase Analysis

#### Scenario
Process customer purchase data to find:
1. Total purchase amount per customer
2. Average purchase value
3. Number of purchases per customer

#### Input Data Format
```
customer_id,product_id,amount,date
C001,P123,150.50,2025-01-15
C002,P456,75.25,2025-01-15
C001,P789,200.00,2025-01-16
C003,P123,150.50,2025-01-16
```

#### Step 1: Write MapReduce Job

```java
import org.apache.hadoop.conf.Configuration;
import org.apache.hadoop.fs.Path;
import org.apache.hadoop.io.*;
import org.apache.hadoop.mapreduce.*;
import org.apache.hadoop.mapreduce.lib.input.FileInputFormat;
import org.apache.hadoop.mapreduce.lib.output.FileOutputFormat;
import org.apache.hadoop.util.GenericOptionsParser;

public class CustomerPurchaseAnalysis {
    
    // Custom Writable to hold purchase statistics
    public static class PurchaseStats implements Writable {
        private long totalAmount;
        private long count;
        
        public PurchaseStats() {
            this.totalAmount = 0;
            this.count = 0;
        }
        
        public PurchaseStats(long totalAmount, long count) {
            this.totalAmount = totalAmount;
            this.count = count;
        }
        
        @Override
        public void write(DataOutput out) throws IOException {
            out.writeLong(totalAmount);
            out.writeLong(count);
        }
        
        @Override
        public void readFields(DataInput in) throws IOException {
            totalAmount = in.readLong();
            count = in.readLong();
        }
        
        @Override
        public String toString() {
            return "TotalAmount=" + totalAmount + ",Count=" + count + 
                   ",Average=" + (totalAmount / count);
        }
    }
    
    // Mapper: Extract customer and amount
    public static class PurchaseMapper 
            extends Mapper<LongWritable, Text, Text, PurchaseStats> {
        
        private static final int CUSTOMER_ID_INDEX = 0;
        private static final int AMOUNT_INDEX = 2;
        
        @Override
        protected void map(LongWritable key, Text value, Context context)
                throws IOException, InterruptedException {
            
            String line = value.toString();
            
            // Skip header line
            if (line.startsWith("customer_id")) {
                return;
            }
            
            try {
                String[] fields = line.split(",");
                
                if (fields.length < 3) {
                    context.getCounter("ERROR", "INVALID_FORMAT").increment(1);
                    return;
                }
                
                String customerId = fields[CUSTOMER_ID_INDEX];
                long amount = (long) Double.parseDouble(fields[AMOUNT_INDEX]);
                
                // Emit (customerId, PurchaseStats(amount, 1))
                PurchaseStats stats = new PurchaseStats(amount, 1);
                context.write(new Text(customerId), stats);
                context.getCounter("INPUT", "VALID_RECORDS").increment(1);
                
            } catch (NumberFormatException e) {
                context.getCounter("ERROR", "PARSE_ERROR").increment(1);
            } catch (Exception e) {
                context.getCounter("ERROR", "UNEXPECTED").increment(1);
            }
        }
    }
    
    // Combiner: Local aggregation on mapper output
    public static class PurchaseCombiner 
            extends Reducer<Text, PurchaseStats, Text, PurchaseStats> {
        
        @Override
        protected void reduce(Text key, Iterable<PurchaseStats> values, Context context)
                throws IOException, InterruptedException {
            
            long totalAmount = 0;
            long count = 0;
            
            for (PurchaseStats stat : values) {
                totalAmount += stat.totalAmount;
                count += stat.count;
            }
            
            context.write(key, new PurchaseStats(totalAmount, count));
        }
    }
    
    // Reducer: Final aggregation
    public static class PurchaseReducer 
            extends Reducer<Text, PurchaseStats, Text, PurchaseStats> {
        
        @Override
        protected void reduce(Text key, Iterable<PurchaseStats> values, Context context)
                throws IOException, InterruptedException {
            
            long totalAmount = 0;
            long count = 0;
            
            for (PurchaseStats stat : values) {
                totalAmount += stat.totalAmount;
                count += stat.count;
            }
            
            context.write(key, new PurchaseStats(totalAmount, count));
        }
    }
    
    // Driver: Job configuration and submission
    public static void main(String[] args) throws Exception {
        
        if (args.length != 2) {
            System.err.println("Usage: CustomerPurchaseAnalysis <input> <output>");
            System.exit(1);
        }
        
        Configuration conf = new Configuration();
        
        Job job = Job.getInstance(conf, "Customer Purchase Analysis");
        
        // Set JAR
        job.setJarByClass(CustomerPurchaseAnalysis.class);
        
        // Set Mapper, Combiner, Reducer
        job.setMapperClass(PurchaseMapper.class);
        job.setCombinerClass(PurchaseCombiner.class);
        job.setReducerClass(PurchaseReducer.class);
        
        // Set output types
        job.setOutputKeyClass(Text.class);
        job.setOutputValueClass(PurchaseStats.class);
        
        // Set input and output paths
        FileInputFormat.addInputPath(job, new Path(args[0]));
        FileOutputFormat.setOutputPath(job, new Path(args[1]));
        
        // Print job info
        System.out.println("Job Name: " + job.getJobName());
        System.out.println("Mapper: " + job.getMapperClass().getName());
        System.out.println("Reducer: " + job.getReducerClass().getName());
        
        // Submit and wait for completion
        boolean success = job.waitForCompletion(true);
        
        if (success) {
            System.out.println("\n=== Job Completed Successfully ===");
            System.out.println("Valid Records: " + 
                job.getCounters().findCounter("INPUT", "VALID_RECORDS").getValue());
            System.out.println("Parse Errors: " + 
                job.getCounters().findCounter("ERROR", "PARSE_ERROR").getValue());
        }
        
        System.exit(success ? 0 : 1);
    }
}
```

