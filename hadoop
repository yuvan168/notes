### Counters for Monitoring

```java
// Use counters to track processing
public static class CountingMapper extends Mapper<LongWritable, Text, Text, IntWritable> {
    
    enum InputRecord {
        TOTAL, VALID, INVALID, MALFORMED
    }
    
    @Override
    protected void map(LongWritable key, Text value, Context context)
            throws IOException, InterruptedException {
        
        context.getCounter(InputRecord.TOTAL).increment(1);
        
        String line = value.toString();
        try {
            if (isValid(line)) {
                context.getCounter(InputRecord.VALID).increment(1);
                // Process
            } else {
                context.getCounter(InputRecord.INVALID).increment(1);
            }
        } catch (Exception e) {
            context.getCounter(InputRecord.MALFORMED).increment(1);
        }
    }
}
```

