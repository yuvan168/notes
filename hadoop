```java
public class WebLogAnalyzer {
    
    // Log format: timestamp, ip, url, status_code, bytes, referrer
    // 2025-01-15 10:15:30 192.168.1.1 /api/users 200 1024 mozilla
    
    public static class LogParser {
        private String timestamp;
        private String ip;
        private String url;
        private int statusCode;
        private long bytes;
        
        public static LogParser parse(String line) {
            String[] fields = line.split(" ");
            LogParser parser = new LogParser();
            try {
                parser.timestamp = fields[0];
                parser.ip = fields[2];
                parser.url = fields[3];
                parser.statusCode = Integer.parseInt(fields[4]);
                parser.bytes = Long.parseLong(fields[5]);
                return parser;
            } catch (Exception e) {
                return null;
            }
        }
    }
    
    public static class StatusCodeMapper 
            extends Mapper<LongWritable, Text, Text, IntWritable> {
        
        private final static IntWritable one = new IntWritable(1);
        
        @Override
        protected void map(LongWritable key, Text value, Context context)
                throws IOException, InterruptedException {
            
            LogParser log = LogParser.parse(value.toString());
            if (log != null) {
                String statusKey = log.statusCode + " " + 
                    getStatusMessage(log.statusCode);
                context.write(new Text(statusKey), one);
            }
        }
        
        private String getStatusMessage(int code) {
            switch (code / 100) {
                case 2: return "SUCCESS";
                case 3: return "REDIRECT";
                case 4: return "CLIENT_ERROR";
                case 5: return "SERVER_ERROR";
                default: return "OTHER";
            }
        }
    }
    
    public static class CountReducer 
            extends Reducer<Text, IntWritable, Text, IntWritable> {
        
        @Override
        protected void reduce(Text key, Iterable<IntWritable> values, Context context)
                throws IOException, InterruptedException {
            
            int sum = 0;
            for (IntWritable val : values) {
                sum += val.get();
            }
            context.write(key, new IntWritable(sum));
        }
    }
}
```

**Process:**
1. Parse web logs from multiple servers
2. Extract HTTP status codes
3. Count occurrences of each status
4. Identify error rates and traffic patterns

