```java
public class ProductRecommendation {
    
    // Data: customerId, productId, category, rating, purchaseDate
    
    public static class CategoryMapper 
            extends Mapper<LongWritable, Text, Text, Text> {
        
        @Override
        protected void map(LongWritable key, Text value, Context context)
                throws IOException, InterruptedException {
            
            String[] fields = value.toString().split(",");
            String customerId = fields[0];
            String category = fields[2];
            double rating = Double.parseDouble(fields[3]);
            
            // Emit (category, customerId) for customers interested in category
            if (rating >= 4.0) { // Only positive ratings
                context.write(new Text(category), new Text(customerId));
            }
        }
    }
    
    public static class CoOccurrenceMapper 
            extends Mapper<LongWritable, Text, Text, IntWritable> {
        
        @Override
        protected void map(LongWritable key, Text value, Context context)
                throws IOException, InterruptedException {
            
            // Input from previous job: category, customer list
            String[] parts = value.toString().split("\t");
            if (parts.length == 2) {
                String category = parts[0];
                String[] customers = parts[1].split(",");
                
                // Emit all pairs of customers in same category
                for (int i = 0; i < customers.length; i++) {
                    for (int j = i + 1; j < customers.length; j++) {
                        String pair = customers[i] + "-" + customers[j];
                        context.write(new Text(pair), new IntWritable(1));
                    }
                }
            }
        }
    }
    
    public static class CoOccurrenceReducer 
            extends Reducer<Text, IntWritable, Text, IntWritable> {
        
        @Override
        protected void reduce(Text key, Iterable<IntWritable> values, Context context)
                throws IOException, InterruptedException {
            
            int count = 0;
            for (IntWritable val : values) {
                count += val.get();
            }
            
            // Only output if customers have multiple shared interests
            if (count >= 2) {
                context.write(key, new IntWritable(count));
            }
        }
    }
}
