## Best Practices

### Code Quality

```java
// GOOD: Proper error handling
public static class SafeMapper extends Mapper<LongWritable, Text, Text, IntWritable> {
    
    private static final Logger LOG = LoggerFactory.getLogger(SafeMapper.class);
    
    @Override
    protected void map(LongWritable key, Text value, Context context)
            throws IOException, InterruptedException {
        
        try {
            String line = value.toString();
            if (line == null || line.isEmpty()) {
                context.getCounter("INPUT", "EMPTY_LINES").increment(1);
                return;
            }
            
            String[] fields = line.split("\t");
            if (fields.length < 2) {
                context.getCounter("INPUT", "INVALID_FORMAT").increment(1);
                LOG.warn("Invalid format at offset " + key);
                return;
            }
            
            String word = fields[0];
            int count = Integer.parseInt(fields[1]);
            
            context.write(new Text(word), new IntWritable(count));
            context.getCounter("INPUT", "VALID_RECORDS").increment(1);
            
        } catch (NumberFormatException e) {
            context.getCounter("ERROR", "PARSE_ERROR").increment(1);
            LOG.error("Parse error at key " + key, e);
        } catch (Exception e) {
            context.getCounter("ERROR", "UNEXPECTED_ERROR").increment(1);
            LOG.error("Unexpected error", e);
        }
    }
}
```

