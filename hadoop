### MapReduce Job Optimization

```java
// Performance-tuned MapReduce job
public class OptimizedJob {
    
    public static void configureJob(Job job, Configuration conf) {
        
        // Memory settings
        conf.setInt("mapreduce.map.memory.mb", 1024);
        conf.setInt("mapreduce.reduce.memory.mb", 2048);
        conf.set("mapreduce.map.java.opts", "-Xmx800m");
        conf.set("mapreduce.reduce.java.opts", "-Xmx1600m");
        
        // Mapper optimization
        conf.setInt("mapreduce.task.io.sort.mb", 256); // Sort buffer
        conf.setFloat("mapreduce.map.sort.spill.percent", 0.8);
        
        // Reducer optimization
        conf.setInt("mapreduce.reduce.shuffle.parallelcopies", 8);
        conf.setInt("mapreduce.reduce.shuffle.input.buffer.percent", 0.7);
        conf.setInt("mapreduce.reduce.shuffle.merge.percent", 0.66);
        
        // Speculative execution
        conf.setBoolean("mapreduce.map.speculative", false);
        conf.setBoolean("mapreduce.reduce.speculative", false);
        
        // Compression
        conf.set("mapreduce.map.output.compress", "true");
        conf.set("mapreduce.map.output.compress.codec", 
            "org.apache.hadoop.hive.ql.io.RCFile$RCFileOutputFormat");
        
        job.setConfiguration(conf);
    }
}
