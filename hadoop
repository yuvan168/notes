            out.writeUTF(name);
            out.writeInt(age);
        }
        
        @Override
        public void readFields(DataInput in) throws IOException {
            name = in.readUTF();
            age = in.readInt();
        }
    }
    
    // Comparable Writable (for sorting)
    public static class IntPair implements WritableComparable<IntPair> {
        
        private int first;
        private int second;
        
