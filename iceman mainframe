### Code Example: Growth Analysis Script

```cobol
IDENTIFICATION DIVISION.
PROGRAM-ID. SPACE-GROWTH-ANALYSIS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-VOLUME-ID         PIC X(6).
01 WS-CURRENT-USAGE     PIC 9(9).
01 WS-PREVIOUS-USAGE    PIC 9(9).
01 WS-GROWTH-RATE       PIC 9V9(2).
01 WS-MONTHS-TO-FULL    PIC 9(3).
01 WS-FORECAST-DATE     PIC 9(8).

PROCEDURE DIVISION.

ANALYZE-GROWTH.
    PERFORM GET-CURRENT-METRICS.
    PERFORM GET-HISTORICAL-DATA.
    PERFORM CALCULATE-GROWTH-RATE.
    PERFORM FORECAST-EXHAUSTION.
    PERFORM GENERATE-REPORT.
    PERFORM SEND-ALERT-IF-NEEDED.
    STOP RUN.

GET-CURRENT-METRICS.
    EXEC ICEMAN ANALYZE
        VOL(WS-VOLUME-ID)
        DETAIL-SUMMARY
        INTO(ANALYSIS-RESULT)
    END-EXEC.
    
    MOVE ANALYSIS-RESULT-USED-SPACE TO WS-CURRENT-USAGE.

GET-HISTORICAL-DATA.
    * Read previous month usage from dataset
    EXEC CICS READ
        DATASET('SPACE-HISTORY')
        INTO(HISTORY-RECORD)
        RIDFLD(VOLUME-MONTH-KEY)
    END-EXEC.
    
    MOVE HISTORY-USAGE TO WS-PREVIOUS-USAGE.

CALCULATE-GROWTH-RATE.
    COMPUTE WS-GROWTH-RATE = 
        (WS-CURRENT-USAGE - WS-PREVIOUS-USAGE) / 
        WS-PREVIOUS-USAGE.

FORECAST-EXHAUSTION.
    * Calculate months until full (100%)
    DECLARE VARS FOR CALCULATION
    
    COMPUTE CURRENT-PERCENT = 
        (WS-CURRENT-USAGE / TOTAL-CAPACITY) * 100.
    
    COMPUTE AVAILABLE-PERCENT = 100 - CURRENT-PERCENT.
    
    COMPUTE WS-MONTHS-TO-FULL =
        AVAILABLE-PERCENT / 
        (WS-GROWTH-RATE * 100).
    
    * Calculate forecast date
    CALL 'ADD-MONTHS'
        USING CURRENT-DATE 
              WS-MONTHS-TO-FULL
              WS-FORECAST-DATE.

GENERATE-REPORT.
    DISPLAY '===== SPACE GROWTH ANALYSIS ====='.
    DISPLAY 'Volume: ' WS-VOLUME-ID.
    DISPLAY 'Current Usage: ' WS-CURRENT-USAGE 'GB'.
    DISPLAY 'Growth Rate: ' WS-GROWTH-RATE '%/month'.
    DISPLAY 'Capacity Full: ' WS-FORECAST-DATE.
    DISPLAY 'Action Required By: ' 
        (WS-FORECAST-DATE - 60 days).

SEND-ALERT-IF-NEEDED.
    IF WS-MONTHS-TO-FULL < 3
        EXEC ICEMAN ALERT
            SEVERITY(CRITICAL)
            MESSAGE('Volume exhaustion forecast')
            RECIPIENT('STORAGE-TEAM')
            CONTACT-METHOD(EMAIL)
        END-EXEC
    END-IF.
