        context.createProducer().send(queue, message);
    }
    
    // Object Message
    public void sendObjectMessage(Serializable obj) {
        ObjectMessage message = context.createObjectMessage(obj);
        context.createProducer().send(queue, message);
    }
    
    // Map Message (key-value pairs)
    public void sendMapMessage(Map<String, Object> data) {
        MapMessage message = context.createMapMessage();
        data.forEach((key, value) -> {
            try {
                message.setObject(key, value);
            } catch (JMSException e) {
                e.printStackTrace();
            }
        });
        context.createProducer().send(queue, message);
    }
    
    // Bytes Message (binary data)
    public void sendBytesMessage(byte[] data) {
        BytesMessage message = context.createBytesMessage();
        try {
            message.writeBytes(data);
        } catch (JMSException e) {
            e.printStackTrace();
        }
        context.createProducer().send(queue, message);
    }
}
