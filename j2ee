    "SELECT DISTINCT o FROM Order o " +
    "JOIN FETCH o.items " +
    "WHERE o.status = :status",
    Order.class
).setParameter("status", "PENDING").getResultList();

// Bad: Loading all data
List<users> = entityManager.createQuery(
    "SELECT u FROM User u"
).getResultList(); // Loads potentially 1 million users

// Good: Pagination
List<users> = entityManager.createQuery(
    "SELECT u FROM User u",
    User.class
)
.setFirstResult(0)
.setMaxResults(10)
.getResultList(); // Loads only 10 users
