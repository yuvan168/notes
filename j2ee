28. **How do you optimize database queries in J2EE applications?**
    - **Best practices:** Indexing, caching, connection pooling, lazy loading

    ```java
    // Good query practices
    @Stateless
    public class OptimizedUserService {
        
        @Inject
        private EntityManager em;
        
        // 1. Use named queries for reusability
        @Entity
        @NamedQuery(
            name = "User.findByEmail",
            query = "SELECT u FROM User u WHERE u.email = :email"
        )
        public class User {
            // ...
        }
        
        // 2. Use database indexes
        @Entity
        @Table(indexes = {
            @Index(name = "idx_email", columnList = "email", unique = true),
            @Index(name = "idx_status", columnList = "status")
        })
        public class UserIndexed {
            @Column(unique = true)
            private String email;
            
            private String status;
        }
        
        // 3. Select only needed columns
        public List<UserDTO> getUsersWithProjection() {
            return em.createQuery(
                "SELECT NEW com.example.UserDTO(u.id, u.name, u.email) " +
                "FROM User u",
                UserDTO.class
            ).getResultList();
        }
        
        // 4. Use pagination
        public List<User> getUsersPaginated(int page, int size) {
            return em.createQuery(
                "SELECT u FROM User u ORDER BY u.id",
                User.class
            )
            .setFirstResult((page - 1) * size)
            .setMaxResults(size)
            .getResultList();
        }
        
        // 5. Lazy load relationships
        @OneToMany(fetch = FetchType.LAZY)
        private List<Order> orders;
        
        // 6. Use batch size for better performance
        @OneToMany(fetch = FetchType.LAZY)
        @BatchSize(size = 20)
        private List<Address> addresses;
        
        // 7. Use prepared statements (parameterized queries)
        public User findUserSafe(String email) {
            return em.createQuery(
                "SELECT u FROM User u WHERE u.email = :email",
                User.class
            )
            .setParameter("email", email)
            .getSingleResult();
        }
    }
    
    // DTO for projection
    public class UserDTO {
        private int id;
        private String name;
        private String email;
        
        public UserDTO(int id, String name, String email) {
            this.id = id;
            this.name = name;
            this.email = email;
        }
    }
