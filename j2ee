### JDBC Basics

#### Theory of Database Connectivity

JDBC (Java Database Connectivity) provides a standardized interface for Java applications to interact with relational databases. The JDBC architecture follows a driver-based model that abstracts database-specific details:

```
Application
    ↓
JDBC API (java.sql.*)
    ↓
JDBC Driver Manager
    ↓
Database Specific Driver (MySQL, PostgreSQL, Oracle)
    ↓
Database
```

#### JDBC Driver Types

| Type | How it works | Use Case |
|------|-------------|----------|
| Type 1 | JDBC-ODBC Bridge | Legacy applications |
| Type 2 | Native Driver | System-level access |
| Type 3 | Network Protocol | Application/Database separation |
| Type 4 | Direct Protocol (Pure Java) | Most common, no native libs needed |

#### Basic JDBC Operations

```java
import java.sql.*;

public class UserDAOJDBC {
    
    private String jdbcUrl = "jdbc:mysql://localhost:3306/mydb";
    private String username = "root";
    private String password = "password";
    private String driverClassName = "com.mysql.cj.jdbc.Driver";
    
    // 1. Load Driver (optional in modern JDBC)
    public void loadDriver() {
        try {
            Class.forName(driverClassName);
            System.out.println("Driver loaded successfully");
        } catch (ClassNotFoundException e) {
            throw new RuntimeException("Driver not found", e);
        }
    }
    
    // 2. Create Connection
    public Connection getConnection() throws SQLException {
        return DriverManager.getConnection(jdbcUrl, username, password);
    }
    
    // 3. Query Execution
    public User getUserById(int id) throws SQLException {
        String sql = "SELECT * FROM users WHERE id = ?";
        
        try (Connection conn = getConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {
            
            pstmt.setInt(1, id);
            
            try (ResultSet rs = pstmt.executeQuery()) {
                if (rs.next()) {
                    User user = new User();
                    user.setId(rs.getInt("id"));
                    user.setName(rs.getString("name"));
                    user.setEmail(rs.getString("email"));
                    user.setAge(rs.getInt("age"));
                    user.setCreatedAt(rs.getTimestamp("created_at"));
                    return user;
                }
            }
        }
        return null;
    }
    
    // 4. Insert Operation
    public int insertUser(User user) throws SQLException {
        String sql = "INSERT INTO users (name, email, age) VALUES (?, ?, ?)";
        
        try (Connection conn = getConnection();
             PreparedStatement pstmt = 
                conn.prepareStatement(sql, Statement.RETURN_GENERATED_KEYS)) {
            
            pstmt.setString(1, user.getName());
            pstmt.setString(2, user.getEmail());
            pstmt.setInt(3, user.getAge());
            
            int affectedRows = pstmt.executeUpdate();
            
            // Get auto-generated ID
            try (ResultSet rs = pstmt.getGeneratedKeys()) {
                if (rs.next()) {
                    return rs.getInt(1);
                }
            }
            
            return affectedRows;
        }
    }
    
    // 5. Update Operation
    public boolean updateUser(User user) throws SQLException {
        String sql = "UPDATE users SET name = ?, email = ?, age = ? " +
                     "WHERE id = ?";
        
        try (Connection conn = getConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {
            
            pstmt.setString(1, user.getName());
            pstmt.setString(2, user.getEmail());
            pstmt.setInt(3, user.getAge());
            pstmt.setInt(4, user.getId());
            
            int affectedRows = pstmt.executeUpdate();
            return affectedRows > 0;
        }
    }
    
    // 6. Delete Operation
    public boolean deleteUser(int id) throws SQLException {
        String sql = "DELETE FROM users WHERE id = ?";
        
        try (Connection conn = getConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {
            
            pstmt.setInt(1, id);
            int affectedRows = pstmt.executeUpdate();
            return affectedRows > 0;
        }
    }
    
    // 7. Batch Operations
    public void insertBatchUsers(List<User> users) throws SQLException {
        String sql = "INSERT INTO users (name, email, age) VALUES (?, ?, ?)";
        
        try (Connection conn = getConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {
            
            for (User user : users) {
                pstmt.setString(1, user.getName());
                pstmt.setString(2, user.getEmail());
                pstmt.setInt(3, user.getAge());
                pstmt.addBatch();
            }
            
            int[] results = pstmt.executeBatch();
            System.out.println("Inserted: " + results.length + " rows");
        }
    }
    
    // 8. CallableStatement (Stored Procedures)
    public int getUserCount() throws SQLException {
        String sql = "{call get_user_count(?)}";
        
        try (Connection conn = getConnection();
             CallableStatement cstmt = conn.prepareCall(sql)) {
            
            cstmt.registerOutParameter(1, Types.INTEGER);
            cstmt.execute();
            
            return cstmt.getInt(1);
        }
    }
}
```

#### ResultSet Scrolling and Concurrency

```java
public class AdvancedJDBC {
    
    // Scrollable ResultSet
    public List<User> getScrollableUsers() throws SQLException {
        String sql = "SELECT * FROM users";
        
        Connection conn = getConnection();
        PreparedStatement pstmt = conn.prepareStatement(
            sql,
            ResultSet.TYPE_SCROLL_INSENSITIVE, // Can scroll
            ResultSet.CONCUR_READ_ONLY          // Read-only
        );
        
        ResultSet rs = pstmt.executeQuery();
        List<User> users = new ArrayList<>();
        
        // Scroll to end
        rs.last();
        System.out.println("Total rows: " + rs.getRow());
        
        // Go back to beginning
        rs.beforeFirst();
        
        while (rs.next()) {
            User user = mapUser(rs);
            users.add(user);
        }
        
        rs.close();
        pstmt.close();
        conn.close();
        
        return users;
    }
    
    // Updatable ResultSet
    public void updateViaResultSet(int userId, String newName) 
            throws SQLException {
        
        String sql = "SELECT * FROM users WHERE id = ?";
        
        Connection conn = getConnection();
        PreparedStatement pstmt = conn.prepareStatement(
            sql,
            ResultSet.TYPE_SCROLL_SENSITIVE,  // Sensitive to changes
            ResultSet.CONCUR_UPDATABLE        // Can update
        );
        
        pstmt.setInt(1, userId);
        ResultSet rs = pstmt.executeQuery();
        
        if (rs.next()) {
            rs.updateString("name", newName);
            rs.updateRow(); // Write changes to database
        }
        
        rs.close();
        pstmt.close();
        conn.close();
    }
}
