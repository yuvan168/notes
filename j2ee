    ```java
    // Secure REST API Implementation
    @Path("/api/orders")
    @Produces(MediaType.APPLICATION_JSON)
    @Consumes(MediaType.APPLICATION_JSON)
    public class SecureOrderResource {
        
        @Inject
        private OrderService orderService;
        
        @Inject
        private SecurityContext securityContext;
        
        // Require authentication and ADMIN role
        @GET
        @RolesAllowed("ADMIN")
        public Response getAllOrders() {
            logAccess("getAllOrders");
            List<Order> orders = orderService.getAllOrders();
            return Response.ok(orders).build();
        }
        
        // User can only see their own orders
        @GET
        @Path("/{id}")
        @RolesAllowed({"USER", "ADMIN"})
        public Response getOrder(@PathParam("id") int id) {
            
            Principal principal = securityContext.getUserPrincipal();
            if (principal == null) {
                return Response.status(Response.Status.UNAUTHORIZED).build();
            }
            
            Order order = orderService.getOrder(id);
            
            // Check ownership
            if (!order.getUserId().equals(principal.getName()) && 
                !securityContext.isUserInRole("ADMIN")) {
                return Response.status(Response.Status.FORBIDDEN).build();
            }
            
            logAccess("getOrder:" + id);
            return Response.ok(order).build();
        }
        
        // Create with HTTPS only
        @POST
        @RolesAllowed("USER")
        public Response createOrder(Order order, @Context HttpServletRequest req) {
            
            // Ensure HTTPS
            if (!req.isSecure()) {
                return Response
                    .status(Response.Status.BAD_REQUEST)
                    .entity("HTTPS required")
                    .build();
            }
            
            // Get authenticated user
            String userId = securityContext.getUserPrincipal().getName();
            order.setUserId(userId);
            order.setCreatedAt(new Date());
            
            // Validate input
            try {
                validateOrder(order);
            } catch (ValidationException e) {
                return Response
                    .status(Response.Status.BAD_REQUEST)
                    .entity(e.getMessage())
                    .build();
            }
            
            Order created = orderService.createOrder(order);
            logAccess("createOrder:" + created.getId());
            
            return Response
                .status(Response.Status.CREATED)
                .entity(created)
                .build();
        }
        
        private void validateOrder(Order order) throws ValidationException {
            if (order.getAmount() == null || order.getAmount() <= 0) {
                throw new ValidationException("Invalid amount");
            }
            if (order.getItemId() <= 0) {
                throw new ValidationException("Invalid item");
            }
        }
        
        private void logAccess(String action) {
            String username = securityContext.getUserPrincipal().getName();
            // Log to audit trail
        }
    }
    
    // Input sanitization
    public class InputValidator {
        
        public String sanitize(String input) {
            if (input == null) {
                return null;
            }
            return input.replaceAll("[^a-zA-Z0-9\\s]", "");
        }
        
        public boolean isValidEmail(String email) {
            return email.matches("^[A-Za-z0-9+_.-]+@(.+)$");
        }
    }
    
    // Security filter
    @WebFilter(urlPatterns = "/api/*")
    public class SecurityFilter implements Filter {
        
        @Override
        public void doFilter(ServletRequest request, ServletResponse response, 
                            FilterChain chain) throws IOException, ServletException {
            
            HttpServletRequest httpRequest = (HttpServletRequest) request;
            HttpServletResponse httpResponse = (HttpServletResponse) response;
            
            // Check HTTPS
            if (!httpRequest.isSecure() && 
                !httpRequest.getServerName().equals("localhost")) {
                httpResponse.sendError(HttpServletResponse.SC_FORBIDDEN, 
                    "HTTPS required");
                return;
            }
            
            // Check authentication token
            String token = getToken(httpRequest);
            if (!isValidToken(token)) {
                httpResponse.sendError(HttpServletResponse.SC_UNAUTHORIZED);
                return;
            }
            
            // Add security headers
            httpResponse.setHeader("X-Content-Type-Options", "nosniff");
            httpResponse.setHeader("X-Frame-Options", "DENY");
            httpResponse.setHeader("X-XSS-Protection", "1; mode=block");
            httpResponse.setHeader("Strict-Transport-Security", 
                "max-age=31536000; includeSubDomains");
            
            chain.doFilter(request, response);
        }
        
        private String getToken(HttpServletRequest request) {
            String header = request.getHeader("Authorization");
            return header != null && header.startsWith("Bearer ") 
                ? header.substring(7) 
                : null;
        }
        
        private boolean isValidToken(String token) {
            // Validate JWT or session token
            return token != null && !token.isEmpty();
        }
    }
