#### Transaction Management

```java
public class TransactionExample {
    
    // Automatic Commit (default)
    public void simpleTransaction() throws SQLException {
        try (Connection conn = DataSourceManager.getConnection()) {
            // By default, autoCommit = true
            // Each statement is committed immediately
            
            String insertSQL = "INSERT INTO users (name, email) VALUES (?, ?)";
            PreparedStatement pstmt = conn.prepareStatement(insertSQL);
            
            pstmt.setString(1, "John");
            pstmt.setString(2, "john@example.com");
            pstmt.executeUpdate(); // Committed immediately
            
            pstmt.close();
        }
    }
    
    // Manual Transaction Control
    public void transferMoney(int fromAccount, int toAccount, 
                             double amount) throws SQLException {
        Connection conn = null;
        try {
            conn = DataSourceManager.getConnection();
            conn.setAutoCommit(false); // Disable auto-commit
            
            // Debit from source
            String debitSQL = "UPDATE accounts SET balance = balance - ? " +
                             "WHERE id = ?";
            PreparedStatement debitStmt = conn.prepareStatement(debitSQL);
            debitStmt.setDouble(1, amount);
            debitStmt.setInt(2, fromAccount);
            debitStmt.executeUpdate();
            debitStmt.close();
            
            // Credit to destination
            String creditSQL = "UPDATE accounts SET balance = balance + ? " +
                              "WHERE id = ?";
            PreparedStatement creditStmt = conn.prepareStatement(creditSQL);
            creditStmt.setDouble(1, amount);
            creditStmt.setInt(2, toAccount);
            creditStmt.executeUpdate();
            creditStmt.close();
            
            // Log transaction
            String logSQL = "INSERT INTO transactions (from_account, " +
                           "to_account, amount) VALUES (?, ?, ?)";
            PreparedStatement logStmt = conn.prepareStatement(logSQL);
            logStmt.setInt(1, fromAccount);
            logStmt.setInt(2, toAccount);
            logStmt.setDouble(3, amount);
            logStmt.executeUpdate();
            logStmt.close();
            
            // Commit if all successful
            conn.commit();
            System.out.println("Transaction committed successfully");
            
        } catch (SQLException e) {
            if (conn != null) {
                try {
                    conn.rollback(); // Undo all changes
                    System.out.println("Transaction rolled back");
                } catch (SQLException ex) {
                    ex.printStackTrace();
                }
            }
            throw e;
        } finally {
            if (conn != null) {
                try {
                    conn.setAutoCommit(true); // Reset
                    conn.close();
                } catch (SQLException e) {
                    e.printStackTrace();
                }
            }
        }
    }
    
    // Savepoints (nested transactions)
    public void complexTransaction() throws SQLException {
        try (Connection conn = DataSourceManager.getConnection()) {
            conn.setAutoCommit(false);
            
            // Insert user
            String insertUser = "INSERT INTO users (name) VALUES (?)";
            PreparedStatement pstmt1 = conn.prepareStatement(insertUser);
            pstmt1.setString(1, "Jane");
            pstmt1.executeUpdate();
            
            // Create savepoint
            Savepoint savepoint1 = conn.setSavepoint("sp1");
            
            try {
                // Update user (might fail)
                String updateUser = "UPDATE users SET age = ? WHERE name = ?";
                PreparedStatement pstmt2 = conn.prepareStatement(updateUser);
                pstmt2.setInt(1, 25);
                pstmt2.setString(2, "Jane");
                pstmt2.executeUpdate();
                
                // Another savepoint
                Savepoint savepoint2 = conn.setSavepoint("sp2");
                
                // Risky operation
                riskyDatabaseOperation(conn);
                
            } catch (Exception e) {
                // Rollback to savepoint, not entire transaction
                conn.rollback(savepoint1);
                System.out.println("Rolled back to savepoint1");
            }
            
            conn.commit();
        }
    }
}
```

**Keypoints for JDBC:**
- Standard API for database access in Java
- Four driver types: JDBC-ODBC, Native, Network Protocol, Pure Java (Type 4 preferred)
- Three main interfaces: Connection, Statement, ResultSet
- PreparedStatement prevents SQL injection
- Connection pooling improves performance
- Try-with-resources for automatic resource cleanup
- Transaction control: autoCommit, commit, rollback
- Batch operations for bulk insert/update
- CallableStatement for stored procedures
- ResultSet types: FORWARD_ONLY, SCROLL_INSENSITIVE, SCROLL_SENSITIVE
- Concurrency: READ_ONLY, UPDATABLE
- Savepoints for nested transactions

