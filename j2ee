### Request-Reply Pattern

```java
// Client sends request and waits for reply
@Stateless
public class RequestReplyClient {
    
    @Inject
    private JMSContext context;
    
    @Resource(lookup = "java:/jms/queue/RequestQueue")
    private Queue requestQueue;
    
    public String sendRequestAndWaitForReply(String request) 
            throws JMSException {
        
        // Create temporary queue for replies
        TemporaryQueue replyQueue = context.createTemporaryQueue();
        
        // Send request with reply address
        TextMessage message = context.createTextMessage(request);
        message.setJMSReplyTo(replyQueue);
        message.setJMSCorrelationID(UUID.randomUUID().toString());
        
        context.createProducer().send(requestQueue, message);
        
        System.out.println("Request sent, waiting for reply...");
        
        // Wait for reply (timeout 30 seconds)
        String reply = context.createConsumer(replyQueue)
            .receiveBody(String.class, 30000);
        
        return reply;
    }
}

// Server receives request and sends reply
@MessageDriven(
    activationConfig = {
        @ActivationConfigProperty(
            propertyName = "destinationType",
            propertyValue = "javax.jms.Queue"
        ),
        @ActivationConfigProperty(
            propertyName = "destination",
            propertyValue = "java:/jms/queue/RequestQueue"
        )
    }
)
public class RequestReplyServer implements MessageListener {
    
    @Override
    public void onMessage(Message message) {
        try {
            if (message instanceof TextMessage) {
                TextMessage request = (TextMessage) message;
                String requestData = request.getText();
                
                System.out.println("Request received: " + requestData);
                
                // Process request
                String response = processRequest(requestData);
                
                // Send reply
                Queue replyTo = (Queue) message.getJMSReplyTo();
                
                TextMessage reply = context.createTextMessage(response);
                reply.setJMSCorrelationID(message.getJMSCorrelationID());
                
                context.createProducer().send(replyTo, reply);
                
                System.out.println("Reply sent");
            }
        } catch (JMSException e) {
            e.printStackTrace();
        }
    }
    
    private String processRequest(String request) {
        return "Processed: " + request;
    }
}
```

