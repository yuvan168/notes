### 3. Data Processing Pipeline

**Theory:** Kotlin sequences and collections enable efficient data transformation. Use sequences for lazy evaluation on large datasets.

**Complete Example:**

```kotlin
// Data models
data class Product(
    val id: Int,
    val name: String,
    val price: Double,
    val category: String,
    val stock: Int
)

data class Sale(
    val productId: Int,
    val quantity: Int,
    val timestamp: Long
)

data class Report(
    val category: String,
    val totalRevenue: Double,
    val unitsSold: Int,
    val avgPrice: Double
)

// Process sales data
class SalesAnalytics(
    private val products: List<Product>,
    private val sales: List<Sale>
) {
    fun generateReport(): List<Report> {
        return sales
            .asSequence()
            .mapNotNull { sale ->
                // Find product, or skip if not found
                products.find { it.id == sale.productId }?.let { product ->
                    Pair(product, sale)
                }
            }
            .filter { (_, sale) -> sale.quantity > 0 }
            .groupBy { (product, _) -> product.category }
            .map { (category, items) ->
                val totalRevenue = items.sumOf { (product, sale) ->
                    product.price * sale.quantity
                }
                val unitsSold = items.sumOf { (_, sale) -> sale.quantity }
                val avgPrice = items.map { (product, _) -> product.price }.average()
                
                Report(
                    category = category,
                    totalRevenue = totalRevenue,
                    unitsSold = unitsSold,
                    avgPrice = avgPrice
                )
            }
            .toList()
    }
    
    fun topProductsByRevenue(limit: Int = 10): List<Pair<String, Double>> {
        return sales
            .asSequence()
            .mapNotNull { sale ->
                products.find { it.id == sale.productId }?.let { product ->
                    Pair(product.name, product.price * sale.quantity)
                }
            }
            .groupBy { it.first }
            .mapValues { (_, items) -> items.sumOf { it.second } }
            .toList()
            .sortedByDescending { it.second }
            .take(limit)
    }
}

// Usage
val products = listOf(
    Product(1, "Laptop", 999.99, "Electronics", 10),
    Product(2, "Mouse", 29.99, "Electronics", 50),
    Product(3, "Desk", 199.99, "Furniture", 5)
)

val sales = listOf(
    Sale(1, 2, System.currentTimeMillis()),
    Sale(2, 10, System.currentTimeMillis()),
    Sale(3, 1, System.currentTimeMillis()),
    Sale(1, 1, System.currentTimeMillis())
)

val analytics = SalesAnalytics(products, sales)
val report = analytics.generateReport()
val topProducts = analytics.topProductsByRevenue(5)

report.forEach {
    println("${it.category}: \$${it.totalRevenue} (${it.unitsSold} units)")
}
```

**Why This Approach:**
- **Sequences**: Lazy evaluation = memory efficient
- **mapNotNull**: Skip invalid data gracefully
- **groupBy**: Natural data aggregation
- **sumOf**: Aggregate calculations in one pass

