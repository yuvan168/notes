## Functions

### 1. Function Basics

```kotlin
// Basic function
fun add(a: Int, b: Int): Int {
    return a + b
}

// Expression function (single expression)
fun multiply(a: Int, b: Int): Int = a * b

// Inferred return type
fun subtract(a: Int, b: Int) = a - b
```

**Parameters:**
```kotlin
// Required parameters
fun greet(name: String) {}

// Default parameters
fun greet(name: String = "Guest") {}
greet()                // Uses default: "Guest"
greet("Alice")         // Uses provided: "Alice"

// Named arguments
greet(name = "Bob")
add(a = 5, b = 3)
```

### 2. Variable Arguments (varargs)

```kotlin
fun sum(vararg numbers: Int): Int {
    var total = 0
    for (num in numbers) {
        total += num
    }
    return total
}

sum(1, 2, 3, 4, 5)           // 15
sum(10, 20)                  // 30

// Spread operator to pass array as varargs
val nums = intArrayOf(1, 2, 3)
sum(*nums)                   // Unpacks array
```

### 3. Lambda Functions

**Basic Lambda:**
```kotlin
// Simple lambda
val add: (Int, Int) -> Int = { a, b -> a + b }
add(5, 3)  // 8

// Lambda with no parameters
val greet: () -> String = { "Hello, Kotlin!" }
greet()    // "Hello, Kotlin!"

// Lambda with one parameter
val square: (Int) -> Int = { x -> x * x }
square(5)  // 25

// Implicit parameter 'it'
val square2: (Int) -> Int = { it * it }
```

**Trailing Lambda:**
```kotlin
fun process(action: (String) -> Unit) {
    action("Processing...")
}

// If lambda is last parameter, can be outside parentheses
process({ msg -> println(msg) })
process { msg -> println(msg) }  // Preferred syntax
```

### 4. Higher-Order Functions

```kotlin
// Function that returns a function
fun makeMultiplier(factor: Int): (Int) -> Int {
    return { x -> x * factor }
}

val double = makeMultiplier(2)
double(5)                      // 10
double(10)                     // 20

// Function as parameter
fun applyTwice(f: (Int) -> Int, x: Int): Int {
    return f(f(x))
}

val square = { x: Int -> x * x }
applyTwice(square, 3)          // (3*3)*3*3 = 81
```

### 5. Function Types

```kotlin
// No parameters, no return
fun type1(): () -> Unit = { println("Hello") }

// One parameter, one return
fun type2(): (Int) -> Int = { x -> x * 2 }

// Multiple parameters
fun type3(): (Int, Int) -> Int = { a, b -> a + b }

// Named function parameters (for clarity)
fun process(operation: (input: String) -> String) {
    val result = operation("Kotlin")
    println(result)
}
```

### 6. Inline Functions

```kotlin
inline fun <T> measure(block: () -> T): T {
    val start = System.currentTimeMillis()
    val result = block()
    val time = System.currentTimeMillis() - start
    println("Time: ${time}ms")
    return result
}

measure {
    // This code is inlined, no function call overhead
    Thread.sleep(100)
}
```

### 7. Recursive Functions

```kotlin
fun factorial(n: Int): Int {
    return if (n <= 1) 1 else n * factorial(n - 1)
}

// Tail-recursive (optimized by compiler)
tailrec fun factorialTail(n: Int, acc: Int = 1): Int {
    return if (n <= 1) acc else factorialTail(n - 1, n * acc)
}

factorial(5)       // 120
factorialTail(5)   // 120 (more efficient)
```

