### 4. Building a Database Service

**Theory:** Database services handle CRUD operations with proper error handling and transaction management. Kotlin's nullable types make handling missing data clean.

**Complete Implementation:**

```kotlin
// Connection manager
class DatabaseConnection(private val url: String) : AutoCloseable {
    private var connection: Connection? = null
    
    fun connect() {
        connection = DriverManager.getConnection(url)
    }
    
    fun <T> execute(block: (Connection) -> T): Result<T> {
        return try {
            val conn = connection ?: throw Exception("Not connected")
            Result.success(block(conn))
        } catch (e: Exception) {
            Result.failure(e)
        }
    }
    
    override fun close() {
        connection?.close()
        connection = null
    }
}

// DAO (Data Access Object)
class UserDao(private val db: DatabaseConnection) {
    fun findAll(): List<User> {
        return db.execute { conn ->
            val stmt = conn.createStatement()
            val rs = stmt.executeQuery("SELECT * FROM users")
            
            buildList {
                while (rs.next()) {
                    add(User(
                        id = rs.getInt("id"),
                        email = rs.getString("email"),
                        password = rs.getString("password")
                    ))
                }
            }
        }.getOrElse { emptyList() }
    }
    
    fun findById(id: Int): User? {
        return db.execute { conn ->
            val stmt = conn.prepareStatement("SELECT * FROM users WHERE id = ?")
            stmt.setInt(1, id)
            val rs = stmt.executeQuery()
            
            if (rs.next()) {
                User(
                    id = rs.getInt("id"),
                    email = rs.getString("email"),
                    password = rs.getString("password")
                )
            } else null
        }.getOrNull()
    }
    
    fun insert(user: User): Result<Unit> {
        return db.execute { conn ->
            val stmt = conn.prepareStatement(
                "INSERT INTO users (email, password) VALUES (?, ?)"
            )
            stmt.setString(1, user.email)
            stmt.setString(2, user.password)
            stmt.executeUpdate()
        }.map { }  // Convert to Result<Unit>
    }
    
    fun update(user: User): Result<Boolean> {
        return db.execute { conn ->
            val stmt = conn.prepareStatement(
                "UPDATE users SET email = ?, password = ? WHERE id = ?"
            )
            stmt.setString(1, user.email)
            stmt.setString(2, user.password)
            stmt.setInt(3, user.id)
            stmt.executeUpdate() > 0
        }
    }
    
    fun delete(id: Int): Result<Boolean> {
        return db.execute { conn ->
            val stmt = conn.prepareStatement("DELETE FROM users WHERE id = ?")
            stmt.setInt(1, id)
            stmt.executeUpdate() > 0
        }
    }
}

// Service layer
class UserService(private val userDao: UserDao) {
    fun authenticate(email: String, password: String): Result<User> {
        return try {
            val user = userDao.findAll()
                .find { it.email == email && it.password == password }
                ?: return Result.failure(Exception("Invalid credentials"))
            
            Result.success(user)
        } catch (e: Exception) {
            Result.failure(e)
        }
    }
    
    fun registerUser(email: String, password: String): Result<Unit> {
        // Validate
        if (!isValidEmail(email)) {
            return Result.failure(Exception("Invalid email format"))
        }
        if (password.length < 8) {
            return Result.failure(Exception("Password must be 8+ characters"))
        }
        
        // Check if already exists
        val existing = userDao.findAll().any { it.email == email }
        if (existing) {
            return Result.failure(Exception("Email already registered"))
        }
        
        // Create user
        val newUser = User(
            id = (userDao.findAll().maxOfOrNull { it.id } ?: 0) + 1,
            email = email,
            password = password  // In production: use bcrypt!
        )
        
        return userDao.insert(newUser)
    }
    
    private fun isValidEmail(email: String): Boolean {
        return email.contains("@") && email.contains(".")
    }
}

// Usage
fun main() {
    DatabaseConnection("jdbc:sqlite:users.db").use { db ->
        db.connect()
        val userDao = UserDao(db)
        val userService = UserService(userDao)
        
        // Register new user
        val registerResult = userService.registerUser("alice@example.com", "password123")
        when {
            registerResult.isSuccess -> println("User registered successfully")
            registerResult.isFailure -> println("Registration failed: ${registerResult.exceptionOrNull()?.message}")
        }
        
        // Authenticate
        val authResult = userService.authenticate("alice@example.com", "password123")
        authResult.onSuccess { user ->
            println("Welcome, ${user.email}")
        }.onFailure { error ->
            println("Authentication failed: ${error.message}")
        }
    }
}
```

**Key Patterns:**
- **Result type**: Safe error handling without exceptions
- **AutoCloseable**: Automatic resource cleanup
- **DAO pattern**: Separation of data access logic
- **Service layer**: Business logic and validation

