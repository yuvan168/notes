## Collections & Sequences

### 1. Lists

```kotlin
// Read-only list
val numbers: List<Int> = listOf(1, 2, 3, 4, 5)
val empty: List<Int> = emptyList()

// Mutable list
val mutableNumbers: MutableList<Int> = mutableListOf(1, 2, 3)
mutableNumbers.add(4)
mutableNumbers.remove(1)
mutableNumbers[0] = 10             // Update by index

// ArrayList
val arrayList = ArrayList<String>()
arrayList.add("Kotlin")

// Access
println(numbers[0])                // 1
println(numbers.first())           // 1
println(numbers.last())            // 5
println(numbers.get(2))            // 3
```

### 2. Sets

```kotlin
// Read-only set
val colors: Set<String> = setOf("Red", "Green", "Blue")
val empty: Set<Int> = emptySet()

// Mutable set
val mutableColors: MutableSet<String> = mutableSetOf("Red", "Green")
mutableColors.add("Blue")
mutableColors.remove("Red")

// LinkedHashSet (maintains insertion order)
val linkedSet: LinkedHashSet<Int> = linkedSetOf(1, 2, 3)

// Unique elements
val numbers = listOf(1, 2, 2, 3, 3, 3)
val unique = numbers.toSet()       // {1, 2, 3}
```

### 3. Maps

```kotlin
// Read-only map
val map: Map<String, Int> = mapOf("a" to 1, "b" to 2, "c" to 3)

// Mutable map
val mutableMap: MutableMap<String, Int> = mutableMapOf()
mutableMap["a"] = 1
mutableMap["b"] = 2
mutableMap.put("c", 3)

// Access
println(map["a"])                  // 1
println(map.getOrDefault("x", -1)) // -1
println(map.containsKey("a"))      // true
println(map.values)                // [1, 2, 3]
println(map.keys)                  // [a, b, c]

// Iteration
for ((key, value) in map) {
    println("$key -> $value")
}

// Transform
val pairs: List<Pair<String, Int>> = map.toList()
```

### 4. Collection Operations

**Filtering:**
```kotlin
val numbers = listOf(1, 2, 3, 4, 5)

val even = numbers.filter { it % 2 == 0 }          // [2, 4]
val firstEven = numbers.find { it % 2 == 0 }       // 2
val hasOdd = numbers.any { it % 2 == 1 }           // true
val allPositive = numbers.all { it > 0 }           // true
val none = numbers.none { it < 0 }                 // true
```

**Mapping:**
```kotlin
val numbers = listOf(1, 2, 3, 4, 5)

val doubled = numbers.map { it * 2 }               // [2, 4, 6, 8, 10]
val strings = numbers.map { it.toString() }       // ["1", "2", "3", "4", "5"]
val flattened = listOf(listOf(1, 2), listOf(3, 4)).flatMap { it }  // [1, 2, 3, 4]
```

**Sorting:**
```kotlin
val numbers = listOf(3, 1, 4, 1, 5)

val sorted = numbers.sorted()                      // [1, 1, 3, 4, 5]
val reversed = numbers.sortedDescending()          // [5, 4, 3, 1, 1]
val custom = numbers.sortedWith(compareBy { it })

// Mutable sort
val list = mutableListOf(3, 1, 4, 1, 5)
list.sort()                                        // [1, 1, 3, 4, 5]
list.sortDescending()
list.sortWith(compareBy { it })
```

**Grouping:**
```kotlin
val numbers = listOf(1, 2, 3, 4, 5, 6)

val grouped = numbers.groupBy { it % 2 }          // {1=[1,3,5], 0=[2,4,6]}
val chunks = numbers.chunked(2)                   // [[1,2], [3,4], [5,6]]
```

**Reduction:**
```kotlin
val numbers = listOf(1, 2, 3, 4, 5)

val sum = numbers.sum()                           // 15
val product = numbers.fold(1) { acc, value -> acc * value }  // 120
val result = numbers.reduce { acc, value -> acc + value }    // 15
```

### 5. Sequences

```kotlin
// Lazy evaluation (not immediately computed)
val sequence: Sequence<Int> = sequenceOf(1, 2, 3, 4, 5)

val lazy = sequence
    .filter { println("filtering $it"); it % 2 == 0 }
    .map { println("mapping $it"); it * 2 }
    .toList()                                      // Now executed

// More efficient for large datasets
val range = (1..1000000).asSequence()
val result = range
    .filter { it % 2 == 0 }
    .map { it * it }
    .take(10)
    .toList()                                      // Only computes what's needed
```

