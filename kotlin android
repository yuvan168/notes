### 6. File Processing Pipeline

**Theory:** Processing large files efficiently requires lazy evaluation and proper resource management. Use sequences and streaming for memory efficiency.

**Complete Example:**

```kotlin
// Log entry model
data class LogEntry(
    val level: String,
    val timestamp: Long,
    val message: String,
    val source: String
)

// Log parser
class LogParser {
    fun parseLine(line: String): LogEntry? {
        return try {
            val parts = line.split(" | ")
            if (parts.size < 4) return null
            
            LogEntry(
                level = parts[0],
                timestamp = parts[1].toLong(),
                message = parts[2],
                source = parts[3]
            )
        } catch (e: Exception) {
            null
        }
    }
}

// Log analyzer
class LogAnalyzer(private val filePath: String) {
    private val parser = LogParser()
    
    // Lazy sequence for large files
    private fun readLogs(): Sequence<LogEntry> {
        return File(filePath).useLines { lines ->
            lines
                .mapNotNull { parser.parseLine(it) }
                .toList()
                .asSequence()
        }
    }
    
    fun countByLevel(): Map<String, Int> {
        return readLogs()
            .groupBy { it.level }
            .mapValues { it.value.size }
    }
    
    fun filterByLevel(level: String): List<LogEntry> {
        return readLogs()
            .filter { it.level == level }
            .toList()
    }
    
    fun findErrors(): List<LogEntry> {
        return readLogs()
            .filter { it.level == "ERROR" }
            .sortedByDescending { it.timestamp }
            .take(100)
            .toList()
    }
    
    fun analyzeBySource(): Map<String, LogAnalysis> {
        return readLogs()
            .groupBy { it.source }
            .mapValues { (_, logs) ->
                LogAnalysis(
                    source = logs.first().source,
                    totalEntries = logs.size,
                    errorCount = logs.count { it.level == "ERROR" },
                    warningCount = logs.count { it.level == "WARN" },
                    lastTimestamp = logs.maxOf { it.timestamp }
                )
            }
    }
    
    fun streamToOutput(outputPath: String) {
        File(outputPath).bufferedWriter().use { writer ->
            readLogs()
                .filter { it.level == "ERROR" || it.level == "WARN" }
                .forEach { log ->
                    writer.write("${log.timestamp} | ${log.level} | ${log.message}\n")
                }
        }
    }
}

data class LogAnalysis(
    val source: String,
    val totalEntries: Int,
    val errorCount: Int,
    val warningCount: Int,
    val lastTimestamp: Long
)

// Usage
fun main() {
    val analyzer = LogAnalyzer("app.log")
    
    // Count by level
    val counts = analyzer.countByLevel()
    counts.forEach { (level, count) ->
        println("$level: $count")
    }
    
    // Recent errors
    val errors = analyzer.findErrors()
    errors.forEach { println(it) }
    
    // Analysis by source
    val analysis = analyzer.analyzeBySource()
    analysis.forEach { (source, stats) ->
        println("$source: ${stats.errorCount} errors, ${stats.warningCount} warnings")
    }
    
    // Export filtered logs
    analyzer.streamToOutput("errors.log")
}
```

**Performance Benefits:**
- **Sequences**: Process large files without loading all in memory
- **useLines**: Automatic file closing
- **mapNotNull**: Skip invalid entries efficiently
- **Streaming**: Process as you read

