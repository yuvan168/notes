## Coroutines

### 1. Introduction to Coroutines

```kotlin
// Traditional callback-based async
fun fetchDataCallback(callback: (String) -> Unit) {
    Thread {
        Thread.sleep(1000)
        callback("Data loaded")
    }.start()
}

fetchDataCallback { data -> println(data) }

// With coroutines (much cleaner)
suspend fun fetchData(): String {
    delay(1000)
    return "Data loaded"
}
```

### 2. Coroutine Scope & Launch

```kotlin
import kotlinx.coroutines.*

fun main() = runBlocking {
    // runBlocking creates coroutine and blocks thread
    println("Start")
    
    launch {
        delay(1000)
        println("World!")
    }
    
    println("Hello")
}
// Output:
// Start
// Hello
// World!
```

### 3. Async/Await

```kotlin
fun main() = runBlocking {
    val deferred = async {
        delay(1000)
        "Result"
    }
    
    val result = deferred.await()  // Wait for result
    println(result)
}

