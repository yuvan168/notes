## Object-Oriented Programming

### 1. Classes

**Basic Class:**
```kotlin
class Person {
    var name: String = "Unknown"
    var age: Int = 0
    
    fun greet() {
        println("Hello, my name is $name")
    }
}

// Create instance (no 'new' keyword)
val person = Person()
person.name = "Alice"
person.age = 25
person.greet()     // "Hello, my name is Alice"
```

**Primary Constructor:**
```kotlin
// Constructor parameters become properties
class Person(val name: String, var age: Int) {
    init {
        println("Person created: $name, age $age")
    }
    
    fun greet() {
        println("Hello, I'm $name, age $age")
    }
}

// Usage
val person = Person("Bob", 30)     // Prints init block
person.greet()
// person.name = "Charlie"         // ERROR: val is immutable
person.age = 31                     // OK: var is mutable
```

**Secondary Constructor:**
```kotlin
class Person(val name: String) {
    var age: Int = 0
    
    constructor(name: String, age: Int) : this(name) {
        this.age = age
    }
}

val p1 = Person("Alice")
val p2 = Person("Bob", 30)
```

**Visibility Modifiers:**
```kotlin
class MyClass {
    public val publicVar = 1        // Visible everywhere (default)
    internal val internalVar = 2    // Visible in same module
    protected val protectedVar = 3  // Visible in subclasses
    private val privateVar = 4      // Visible only in this class
}
```

### 2. Properties & Getters/Setters

```kotlin
class User {
    // Backing field (private, auto-generated)
    var name: String = "Unknown"
        get() = field.uppercase()
        set(value) {
            if (value.isNotEmpty()) {
                field = value
            }
        }
    
    // Read-only property
    val displayName: String
        get() = name.uppercase()
    
    // Lazy property (computed once)
    val description: String by lazy {
        println("Computing description...")
        "User: $name"
    }
}

val user = User()
user.name = "alice"
println(user.name)          // "ALICE" (getter applies)
println(user.displayName)   // "ALICE"
```

### 3. Data Classes

**Simplify classes with auto-generated methods:**
```kotlin
data class Person(val name: String, val age: Int)

// Auto-generated:
// - equals() / hashCode()
// - toString() -> Person(name=Alice, age=25)
// - copy() for creating modified copies
// - destructuring

val p1 = Person("Alice", 25)
val p2 = Person("Alice", 25)
println(p1 == p2)               // true (structural equality)
println(p1.toString())          // Person(name=Alice, age=25)

// Copy with modifications
val p3 = p1.copy(age = 26)      // Person(name=Alice, age=26)

// Destructuring
val (name, age) = p1
println("$name is $age")        // Alice is 25
```

### 4. Enum Classes

```kotlin
enum class Direction {
    NORTH, SOUTH, EAST, WEST
}

enum class Color(val hex: String) {
    RED("#FF0000"),
    GREEN("#00FF00"),
    BLUE("#0000FF")
}

fun navigate(direction: Direction) {
    when (direction) {
        Direction.NORTH -> println("Going north")
        Direction.SOUTH -> println("Going south")
        Direction.EAST -> println("Going east")
        Direction.WEST -> println("Going west")
    }
}

navigate(Direction.NORTH)
println(Color.RED.hex)          // #FF0000
```

### 5. Sealed Classes

```kotlin
sealed class Result {
    data class Success(val data: String) : Result()
    data class Error(val exception: Exception) : Result()
    object Loading : Result()
}

fun handleResult(result: Result) {
    when (result) {
        is Result.Success -> println("Success: ${result.data}")
        is Result.Error -> println("Error: ${result.exception}")
        is Result.Loading -> println("Loading...")
    }
}

handleResult(Result.Success("Data loaded"))
```

### 6. Inheritance

```kotlin
// Base class
open class Animal(val name: String) {
    open fun sound() {
        println("Some sound")
    }
}

// Subclass
class Dog(name: String) : Animal(name) {
    override fun sound() {
        println("$name barks: Woof!")
    }
}

// Usage
val dog: Animal = Dog("Rex")
dog.sound()        // Rex barks: Woof!

// Abstract class
abstract class Vehicle(val brand: String) {
    abstract fun start()
    
    fun stop() {
        println("Vehicle stopped")
    }
}

class Car(brand: String) : Vehicle(brand) {
    override fun start() {
        println("$brand car engine started")
    }
}
```

### 7. Interfaces

```kotlin
interface Drawable {
    fun draw()
    fun describe() {
        println("Something drawable")
    }
}

interface Resizable {
    fun resize(size: Int)
}

class Circle : Drawable, Resizable {
    override fun draw() {
        println("Drawing circle")
    }
    
    override fun resize(size: Int) {
        println("Circle resized to $size")
    }
}

val circle: Drawable = Circle()
circle.draw()
circle.describe()
```

