### 5. Real-Time Chat Application

**Theory:** Chat apps require real-time data synchronization using channels and coroutines for concurrent message handling.

**Complete Implementation:**

```kotlin
// Message model
data class Message(
    val id: String = UUID.randomUUID().toString(),
    val sender: String,
    val content: String,
    val timestamp: Long = System.currentTimeMillis()
)

// Chat room
class ChatRoom(val name: String) {
    private val messages = mutableListOf<Message>()
    private val messageChannel = Channel<Message>(capacity = 100)
    private val subscribers = mutableListOf<(Message) -> Unit>()
    
    suspend fun publishMessage(sender: String, content: String) {
        val message = Message(sender = sender, content = content)
        messages.add(message)
        messageChannel.send(message)
        notifySubscribers(message)
    }
    
    fun subscribe(listener: (Message) -> Unit) {
        subscribers.add(listener)
    }
    
    private fun notifySubscribers(message: Message) {
        subscribers.forEach { it(message) }
    }
    
    suspend fun getMessageHistory(): List<Message> = messages.toList()
    
    suspend fun listenForMessages(block: suspend (Message) -> Unit) {
        for (message in messageChannel) {
            block(message)
        }
    }
}

// Chat server
class ChatServer {
    private val chatRooms = mutableMapOf<String, ChatRoom>()
    
    fun createRoom(roomName: String): ChatRoom {
        val room = ChatRoom(roomName)
        chatRooms[roomName] = room
        return room
    }
    
    fun getRoom(roomName: String): ChatRoom? = chatRooms[roomName]
    
    fun listRooms(): List<String> = chatRooms.keys.toList()
}

// User client
class ChatClient(
    val username: String,
    private val chatRoom: ChatRoom
) {
    private val scope = CoroutineScope(Dispatchers.IO + Job())
    
    fun sendMessage(content: String) {
        scope.launch {
            chatRoom.publishMessage(username, content)
        }
    }
    
    fun startListening() {
        scope.launch {
            chatRoom.listenForMessages { message ->
                displayMessage(message)
            }
        }
    }
    
    fun loadHistory() {
        scope.launch {
            val history = chatRoom.getMessageHistory()
            history.forEach { displayMessage(it) }
        }
    }
    
    private fun displayMessage(message: Message) {
        val time = SimpleDateFormat("HH:mm:ss").format(Date(message.timestamp))
        println("[$time] ${message.sender}: ${message.content}")
    }
    
    fun disconnect() {
        scope.cancel()
    }
}

// Demo
fun main() = runBlocking {
    val server = ChatServer()
    val generalRoom = server.createRoom("general")
    
    // Create clients
    val alice = ChatClient("Alice", generalRoom)
    val bob = ChatClient("Bob", generalRoom)
    
    // Start listening
    alice.startListening()
    bob.startListening()
    
    // Load history
    alice.loadHistory()
    bob.loadHistory()
    
    // Send messages
    alice.sendMessage("Hello everyone!")
    delay(100)
    bob.sendMessage("Hi Alice!")
    delay(100)
    alice.sendMessage("How are you?")
    
    delay(500)
    alice.disconnect()
    bob.disconnect()
}
```

**Key Concepts:**
- **Channels**: Concurrent message passing
- **Coroutines**: Non-blocking concurrent operations
- **Subscribers pattern**: Real-time updates
- **Scope management**: Clean resource cleanup

