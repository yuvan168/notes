## Advanced Features

### 1. Generics

**Generic Classes:**
```kotlin
class Box<T> {
    var content: T? = null
    
    fun put(item: T) {
        content = item
    }
    
    fun get(): T? = content
}

val intBox = Box<Int>()
intBox.put(42)
println(intBox.get())           // 42

val stringBox: Box<String> = Box()
stringBox.put("Hello")
println(stringBox.get())        // Hello
```

**Generic Functions:**
```kotlin
fun <T> printItem(item: T) {
    println("Item: $item")
}

fun <T : Comparable<T>> findMax(a: T, b: T): T {
    return if (a > b) a else b
}

printItem(42)
printItem("Hello")
findMax(10, 20)                 // 20
findMax("Apple", "Zebra")       // Zebra
```

**Type Bounds:**
```kotlin
// Upper bound
fun <T : Number> processNumber(num: T) {
    println(num.toDouble())
}

// Multiple bounds
fun <T> process(item: T) where T : Comparable<T>, T : Number {
    println(item)
}
```

### 2. Scope Functions

**let:**
```kotlin
val name: String? = "Kotlin"
name?.let {
    println("Length: ${it.length}")  // Executed only if not null
}
```

**apply:**
```kotlin
val person = Person("Alice", 25).apply {
    age = 26
    println("Modified: $name, age $age")
}
```

**also:**
```kotlin
val list = mutableListOf(1, 2, 3)
    .also { println("Created list: $it") }
    .also { it.add(4) }
```

**with:**
```kotlin
val person = Person("Alice", 25)
with(person) {
    println("Name: $name, Age: $age")  // Can access properties directly
}
```

**run:**
```kotlin
val result = person.run {
    println("Name: $name")
    "Result: $name, $age"              // Returns the result
}
```

### 3. Destructuring

```kotlin
data class Point(val x: Int, val y: Int)

val point = Point(10, 20)
val (x, y) = point
println("x=$x, y=$y")

// In loops
data class Person(val name: String, val age: Int)
val people = listOf(
    Person("Alice", 25),
    Person("Bob", 30)
)

for ((name, age) in people) {
    println("$name is $age")
}

// In function parameters
fun describe((x, y): Point) = "Point at ($x, $y)"
```

