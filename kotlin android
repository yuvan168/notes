// Conditional extension
fun String?.isNullOrBlank(): Boolean {
    return this == null || this.isBlank()
}

val empty: String? = null
empty.isNullOrBlank()  // true

// Extension properties
val String.lastChar: Char
    get() = this[this.length - 1]

"Kotlin".lastChar  // 'n'

// Scope extensions using 'receiver'
class Html {
    fun body(init: Body.() -> Unit) = Body().apply(init)
}

class Body {
    fun p(text: String) = println(text)
}

// Usage - HTML DSL
html {
    body {
        p("Hello")
        p("World")
    }
}

// Practical: JSON builder
class JsonBuilder {
    private val properties = mutableMapOf<String, Any>()
    
    infix fun String.to(value: Any) {
        properties[this] = value
    }
    
    fun build() = properties
}

val json = JsonBuilder().apply {
    "name" to "Alice"
    "age" to 25
}.build()

// Best practices
// ✓ GOOD: Clear, specific purpose
fun String.toTitleCase(): String = this.split(" ")
    .map { it.replaceFirstChar { c -> c.uppercase() } }
    .joinToString(" ")

// ✗ BAD: Too generic, confusing
fun String.process(): String = /* ? */

// ✗ BAD: Too many extensions on same class
fun String.doThis() {}
fun String.doThat() {}
fun String.doAnother() {}
```

**Interview Tip:**
- "Extension functions extend classes without inheritance"
- "Use for utility functions on existing classes"
- "Common in Kotlin stdlib: String.toInt(), List.filter(), etc."
