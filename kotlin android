## Common Interview Scenarios

### 14. Building a Practical Service

**Scenario:** "Build a user service with validation, database access, and error handling."

```kotlin
// Models
data class User(val id: Int, val email: String, val name: String)
data class CreateUserRequest(val email: String, val name: String)

// Database access
class UserRepository {
    private val db = mutableMapOf<Int, User>()
    private var nextId = 1
    
    fun findById(id: Int) = db[id]
    fun findByEmail(email: String) = db.values.find { it.email == email }
    fun findAll() = db.values.toList()
    
    fun save(user: User) {
        db[user.id] = user
    }
    
    fun delete(id: Int) = db.remove(id) != null
}

// Validation
sealed class ValidationError {
    data class InvalidEmail(val message: String) : ValidationError()
    data class InvalidName(val message: String) : ValidationError()
    data class UserAlreadyExists(val email: String) : ValidationError()
}

// Service
class UserService(private val repository: UserRepository) {
    fun createUser(request: CreateUserRequest): Result<User> {
        // Validate
        val emailError = validateEmail(request.email)
        if (emailError != null) {
            return Result.failure(Exception(emailError.message))
        }
        
        val nameError = validateName(request.name)
        if (nameError != null) {
            return Result.failure(Exception(nameError.message))
        }
        
        // Check existing
        val existing = repository.findByEmail(request.email)
        if (existing != null) {
            return Result.failure(Exception("User already exists"))
        }
        
        // Create
        val user = User(
            id = System.currentTimeMillis().toInt(),
            email = request.email,
            name = request.name
        )
        
        return try {
            repository.save(user)
            Result.success(user)
        } catch (e: Exception) {
            Result.failure(Exception("Failed to save user"))
        }
    }
    
    fun getUser(id: Int): Result<User> {
        return repository.findById(id)?.let { Result.success(it) }
            ?: Result.failure(Exception("User not found"))
    }
    
    fun listUsers(): List<User> = repository.findAll()
    
    private fun validateEmail(email: String): ValidationError.InvalidEmail? {
        return if (!email.contains("@")) {
            ValidationError.InvalidEmail("Invalid email format")
        } else null
    }
    
    private fun validateName(name: String): ValidationError.InvalidName? {
        return if (name.isEmpty()) {
            ValidationError.InvalidName("Name cannot be empty")
        } else if (name.length < 2) {
            ValidationError.InvalidName("Name must be at least 2 characters")
        } else null
    }
}

// Usage
fun main() {
    val repository = UserRepository()
    val service = UserService(repository)
    
    val result = service.createUser(CreateUserRequest("alice@example.com", "Alice"))
    result
        .onSuccess { println("Created user: $it") }
        .onFailure { println("Error: ${it.message}") }
    
    service.listUsers().forEach { println(it) }
}
```

