## Extension Functions & DSLs

### 1. Extension Functions

```kotlin
// Add function to String class without inheritance
fun String.isVowel(): Boolean {
    return this.lowercase() in setOf("a", "e", "i", "o", "u")
}

"a".isVowel()                      // true
"x".isVowel()                      // false

// Extension with parameter
fun String.repeat(times: Int): String {
    return this.repeat(times)
}

"ha".repeat(3)                     // "hahaha"

// Extension on Int
fun Int.isEven(): Boolean {
    return this % 2 == 0
}

5.isEven()                         // false
4.isEven()                         // true

// Extension properties
val String.lastChar: Char
    get() = this[this.length - 1]

"Kotlin".lastChar                  // 'n'
```

### 2. Extension Functions on Collections

```kotlin
fun <T> List<T>.second(): T? {
    return if (size > 1) this[1] else null
}

listOf(1, 2, 3).second()           // 2
listOf(1).second()                 // null

// Chain extensions
fun <T> List<T>.penultimate(): T? {
    return if (size > 1) this[size - 2] else null
}

listOf(1, 2, 3, 4, 5).penultimate() // 4
```

### 3. Domain-Specific Languages (DSLs)

**HTML DSL Example:**
```kotlin
fun html(block: HtmlBuilder.() -> Unit): String {
    val builder = HtmlBuilder()
    builder.block()
    return builder.build()
}

class HtmlBuilder {
    private val elements = mutableListOf<String>()
    
    fun div(content: String) {
        elements.add("<div>$content</div>")
    }
    
    fun p(content: String) {
        elements.add("<p>$content</p>")
    }
    
    fun build() = elements.joinToString("\n")
}

// Usage
val page = html {
    div("Hello")
    p("This is a paragraph")
}
```

**Configuration DSL Example:**
```kotlin
class ServerConfig {
    var port: Int = 8080
    var host: String = "localhost"
    val endpoints = mutableListOf<String>()
    
    fun endpoint(path: String) {
        endpoints.add(path)
    }
}

fun server(block: ServerConfig.() -> Unit): ServerConfig {
    val config = ServerConfig()
    config.block()
    return config
}

// Usage
val config = server {
    port = 9000
    host = "0.0.0.0"
    endpoint("/api/users")
    endpoint("/api/products")
}
```

