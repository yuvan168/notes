    'spent': np.random.uniform(50, 500, 500),
    'visits': np.random.randint(1, 20, 500),
    'region': np.random.choice(['North', 'South', 'East', 'West'], 500),
    'premium': np.random.choice([True, False], 500)
})

fig, ax = plt.subplots(figsize=(10, 6))
colors = ['#1f77b4' if x else '#ff7f0e' for x in customer_data['premium']]
ax.scatter(customer_data['visits'], customer_data['spent'], 
          c=colors, alpha=0.5, s=50)

ax.set_xlabel('Number of Visits')
ax.set_ylabel('Amount Spent ($)')
ax.set_title('Customer Spending vs Visits (Scatter)', fontsize=14)

# Add legend
from matplotlib.patches import Patch
legend_elements = [Patch(facecolor='#1f77b4', label='Regular'),
                  Patch(facecolor='#ff7f0e', label='Premium')]
ax.legend(handles=legend_elements)
ax.grid(True, alpha=0.3)
plt.tight_layout()
```

**Decision Guide:**

| Aspect | Heatmap | Scatter |
|--------|---------|---------|
| Data Type | 2D matrix, aggregated | Individual points, continuous |
| Number of Points | 100s-1000s | 10s-1000s |
| Outlier Visibility | Low | High |
| Pattern Detection | Easy (color patterns) | Easy (point clusters) |
| Exact Value Reading | Easy (with annotations) | Harder |
| Correlation Visibility | Easy for matrices | Shows relationship direction |
| Categorical Data | Works well | Needs hue/style encoding |

