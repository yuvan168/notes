ax.scatter(x, y, marker='s')       # square
ax.scatter(x, y, marker='^')       # triangle
ax.scatter(x, y, marker='*')       # star

# Combined
ax.scatter(x, y, s=sizes, c=colors, alpha=0.6, cmap='plasma', marker='s')
```

