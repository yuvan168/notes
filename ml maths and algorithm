    y_min, y_max = X[:, 1].min() - 1, X[:, 1].max() + 1
    xx, yy = np.meshgrid(np.arange(x_min, x_max, h),
                         np.arange(y_min, y_max, h))
    
    Z = svm.decision_function(np.c_[xx.ravel(), yy.ravel()])
    Z = Z.reshape(xx.shape)
    
    # Plot
    ax.contourf(xx, yy, Z, levels=20, cmap='RdBu', alpha=0.3)
    ax.contour(xx, yy, Z, levels=[0], linewidths=2, colors='black')  # Decision boundary
    ax.contour(xx, yy, Z, levels=[-1, 1], linewidths=1, colors='red', linestyles='dashed')  # Margins
    
    ax.scatter(X[:, 0], X[:, 1], c=y, cmap='RdBu', edgecolors='k')
    ax.scatter(svm.support_vectors_[:, 0], svm.support_vectors_[:, 1],
              s=100, facecolors='none', edgecolors='green', linewidths=2)
    
    ax.set_title(f'C={C} (SV: {len(svm.support_vectors_)})')
    ax.set_xlim([x_min, x_max])
    ax.set_ylim([y_min, y_max])

