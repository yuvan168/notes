## 🏗️ Building Decision Trees

### ID3 Algorithm (Iterative Dichotomizer 3)

**Steps:**
```
1. Start with entire dataset
2. For each feature:
   - Calculate information gain
3. Choose feature with highest IG
4. Split dataset on that feature
5. Recursively repeat for each subset
6. Stop when: Pure node or max depth
```

**Pseudocode:**
```
function BuildTree(S, Features):
    if all samples in S same class:
        return Leaf(class)
    if Features is empty:
        return Leaf(majority class)
    
    best_feature = None
    best_gain = 0
    
    for each feature in Features:
        gain = InformationGain(S, feature)
        if gain > best_gain:
            best_gain = gain
            best_feature = feature
    
    for each value v of best_feature:
        S_v = {samples with best_feature = v}
        subtree = BuildTree(S_v, Features - {best_feature})
    
    return DecisionNode(best_feature, subtrees)
```

### Implementation from Scratch

```python
class Node:
    def __init__(self, feature=None, threshold=None, left=None, right=None, value=None):
        self.feature = feature        # Index of feature to split
        self.threshold = threshold    # Threshold value for split
        self.left = left              # Left subtree
        self.right = right            # Right subtree
        self.value = value            # Class value if leaf

class DecisionTree:
    def __init__(self, max_depth=None, min_samples_split=2):
        self.max_depth = max_depth
        self.min_samples_split = min_samples_split
        self.root = None
    
    def fit(self, X, y):
        self.root = self._build_tree(X, y, depth=0)
        return self
    
    def _build_tree(self, X, y, depth):
        n_samples, n_features = X.shape
        n_classes = len(np.unique(y))
        
        # Stopping criteria
        if (depth >= self.max_depth if self.max_depth else False) or \
           n_samples < self.min_samples_split or \
           n_classes == 1:
            leaf_value = np.bincount(y).argmax()
            return Node(value=leaf_value)
        
        best_gain = 0
        best_feature = None
        best_threshold = None
        
        # Find best split
        for feature in range(n_features):
            thresholds = np.unique(X[:, feature])
            
            for threshold in thresholds:
                # Split
                left_mask = X[:, feature] <= threshold
                right_mask = ~left_mask
                
                if np.sum(left_mask) == 0 or np.sum(right_mask) == 0:
                    continue
                
                # Information gain
                parent_entropy = self._entropy(y)
                left_entropy = self._entropy(y[left_mask])
                right_entropy = self._entropy(y[right_mask])
                
                weighted_entropy = (np.sum(left_mask) * left_entropy + 
                                   np.sum(right_mask) * right_entropy) / n_samples
                
                gain = parent_entropy - weighted_entropy
                
                if gain > best_gain:
                    best_gain = gain
                    best_feature = feature
                    best_threshold = threshold
        
        if best_feature is None:
            leaf_value = np.bincount(y).argmax()
            return Node(value=leaf_value)
        
        # Recurse
        left_mask = X[:, best_feature] <= best_threshold
        right_mask = ~left_mask
        
        left = self._build_tree(X[left_mask], y[left_mask], depth + 1)
        right = self._build_tree(X[right_mask], y[right_mask], depth + 1)
        
        return Node(feature=best_feature, threshold=best_threshold, 
                   left=left, right=right)
    
    def _entropy(self, y):
        proportions = np.bincount(y) / len(y)
        return -np.sum(proportions * np.log2(proportions + 1e-10))
    
    def predict(self, X):
        return np.array([self._traverse_tree(x, self.root) for x in X])
    
    def _traverse_tree(self, x, node):
        if node.value is not None:
            return node.value
        
        if x[node.feature] <= node.threshold:
            return self._traverse_tree(x, node.left)
        else:
            return self._traverse_tree(x, node.right)

# Example
X = np.array([[2.5], [3.2], [5.1], [6.8], [3.0], [5.5]])
y = np.array([0, 0, 1, 1, 0, 1])

tree = DecisionTree(max_depth=3)
tree.fit(X, y)
predictions = tree.predict(X)
```

