# Spam classification
emails = [
    ("Buy now! Free money!", 1),      # spam
    ("Meeting tomorrow at 2pm", 0),   # ham
    ("You won a prize!", 1),          # spam
    ("Project update attached", 0),   # ham
]

# Vectorize
vectorizer = CountVectorizer()
X = vectorizer.fit_transform([e[0] for e in emails])
y = [e[1] for e in emails]

# Train
nb = MultinomialNB(alpha=1.0)  # Laplace smoothing
nb.fit(X, y)

# Predict
test_email = vectorizer.transform(["Free prize!"])
pred = nb.predict(test_email)[0]
proba = nb.predict_proba(test_email)[0]

print(f"Prediction: {'Spam' if pred==1 else 'Ham'}")
print(f"Probability: {proba[1]:.2%}")  # ~98% spam

# Without smoothing (α=0): Risk of zero probability
# With smoothing: Robust to unseen words
```

