**Q29: Implement gradient descent optimization.**

A: Optimization algorithm for ML models.

```python
def gradient_descent(X, y, learning_rate=0.01, iterations=1000):
    """Simple linear regression with gradient descent"""
    m = len(y)
    # Initialize weights
    w = np.zeros(X.shape[1])
    b = 0
    
    for i in range(iterations):
        # Predictions
        y_pred = X @ w + b
        
        # Error
        error = y_pred - y
        
        # Gradients
        dw = (2/m) * X.T @ error
        db = (2/m) * np.sum(error)
        
        # Update weights
        w -= learning_rate * dw
        b -= learning_rate * db
        
        # Print loss
        if i % 100 == 0:
            mse = np.mean(error ** 2)
            print(f"Iteration {i}: MSE = {mse:.4f}")
    
    return w, b

