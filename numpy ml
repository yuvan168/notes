# Euclidean distance
X = np.array([[0, 0], [3, 4], [1, 1]])
distances = np.sqrt(np.sum(X**2, axis=1))  # [0. 5. 1.41]

# Pairwise distances
A = np.array([[0, 0], [1, 1]])
B = np.array([[3, 4], [5, 12]])
distances = np.sqrt(((A[:, None, :] - B[None, :, :]) ** 2).sum(axis=2))
