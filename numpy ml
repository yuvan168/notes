# Cosine similarity
def cosine_similarity(X):
    norms = np.linalg.norm(X, axis=1, keepdims=True)
    normalized = X / norms
    return normalized @ normalized.T

X = np.array([[1, 0, 0], [1, 1, 0], [1, 1, 1]])
sim = cosine_similarity(X)
```

