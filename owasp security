# SECURE LOGIN IMPLEMENTATION
import bcrypt
from datetime import datetime, timedelta

@app.route('/login', methods=['POST'])
def login():
    username = request.form.get('username')
    password = request.form.get('password')
    
    user = User.query.filter_by(username=username).first()
    
    # CHECK 1: Account lockout
    if user and user.is_locked_out():
        return "Account locked. Try again in 30 minutes.", 429
    
    # CHECK 2: Rate limiting (per IP)
    if is_rate_limited(request.remote_addr):
        return "Too many attempts. Try again later.", 429
    
    # CHECK 3: Credential verification
    if not user or not bcrypt.checkpw(password.encode(), user.password_hash):
        log_failed_attempt(username, request.remote_addr)
        
        # Lock account after 5 failures
        recent_failures = count_recent_failures(username, minutes=15)
        if recent_failures >= 5:
            user.lock_account(duration_minutes=30)
            return "Account locked.", 429
        
        return "Invalid credentials", 401
    
    # CHECK 4: MFA required
    if user.mfa_enabled:
        session['pending_user_id'] = user.id
        return redirect('/mfa-verify')
    
    # CHECK 5: Secure session
    session.clear()
    session['user_id'] = user.id
    session['session_token'] = secrets.token_hex(32)
    session['user_ip'] = request.remote_addr
    session.permanent = True
    
    return redirect('/dashboard')
