@app.route('/api/orders/<order_id>', methods=['GET', 'PATCH'])
def order_detail(order_id):
    current_user = get_current_user()
    
    if not current_user:
        return "Unauthorized", 401
    
    order = Order.query.get(order_id)
    
    # CRITICAL: Verify user owns this order
    if order.user_id != current_user.id:
        return "Forbidden", 403  # Not your order!
    
    if request.method == 'GET':
        return order.to_json()
    
    if request.method == 'PATCH':
        # Additional check: Only user can modify, not admin
        # Prices set by admin, not user
        if current_user.role == 'user':
            allowed_fields = ['quantity']  # User can only change quantity
        else:
            allowed_fields = ['price', 'quantity', 'status']
        
        data = request.json
        for field in data:
            if field not in allowed_fields:
                return f"Cannot modify {field}", 403
        
        for field in allowed_fields:
            if field in data:
                setattr(order, field, data[field])
        
        db.session.commit()
        return "Updated", 200
