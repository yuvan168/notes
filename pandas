**Q30: Create a comprehensive data validation report.**

A: Build data quality assessment:

```python
def data_validation_report(df):
    """Generate comprehensive validation report"""
    report = {}
    
    # Shape
    report['Shape'] = df.shape
    
    # Data types
    report['Data Types'] = df.dtypes.to_dict()
    
    # Missing values
    missing = df.isnull().sum()
    report['Missing'] = missing[missing > 0].to_dict()
    
    # Duplicates
    report['Duplicate Rows'] = df.duplicated().sum()
    
    # Numeric summary
    report['Numeric Summary'] = df.describe().T.to_dict()
    
    # Categorical summary
    for col in df.select_dtypes(include='object'):
        report[f'{col} Unique'] = df[col].nunique()
        report[f'{col} Mode'] = df[col].mode().values[0]
    
    # Outliers (by IQR)
    for col in df.select_dtypes(include='number'):
        Q1, Q3 = df[col].quantile([0.25, 0.75])
        IQR = Q3 - Q1
        outliers = len(df[(df[col] < Q1 - 1.5*IQR) | 
                         (df[col] > Q3 + 1.5*IQR)])
        report[f'{col} Outliers'] = outliers
    
    return report

# Usage
report = data_validation_report(df)
for key, value in report.items():
    print(f"{key}: {value}")
```

