### CONCEPT 5: Page Object Model (POM) - Test Architecture

**Theory:**
Page Object Model encapsulates page structure and behavior into reusable classes. This separates test logic from UI implementation.

```
Benefits of POM:

Before POM:
┌────────────────────────────────────┐
│ Test code scattered               │
│ - Selectors hardcoded             │
│ - Logic duplicated                │
│ - Maintenance nightmare           │
└────────────────────────────────────┘

After POM:
┌──────────────────────────┐
│ Page Objects             │
│ - Encapsulate selectors  │
│ - Centralize logic       │
│ - Easy to maintain       │
└──────────────────────────┘
        │
        ▼
┌──────────────────────────┐
│ Test Code                │
│ - Clear intent           │
│ - No selectors           │
│ - Reusable               │
└──────────────────────────┘
```

**Practical Example:**

```javascript
// ❌ WITHOUT POM - Problematic
test('Bad: Login without POM', async ({ page }) => {
    await page.goto('https://example.com/login');
    await page.fill('input[id="user-email"]', 'user@example.com');
    await page.fill('input[type="password"]', 'password');
    await page.click('button.btn.btn-primary');
    await page.waitForURL('/dashboard');
    await expect(page.locator('.welcome-header')).toContainText('Welcome');
});

test('Bad: Another login test - duplicates code', async ({ page }) => {
    await page.goto('https://example.com/login');
    await page.fill('input[id="user-email"]', 'admin@example.com');
    await page.fill('input[type="password"]', 'adminpass');
    await page.click('button.btn.btn-primary');
    await page.waitForURL('/dashboard');
});

// Problem: If selector changes, need to update all tests!

// ✅ WITH POM - Best Practice
export class LoginPage {
    constructor(page) {
        this.page = page;
        
        // Centralize all selectors
        this.emailInput = page.locator('input[id="user-email"]');
        this.passwordInput = page.locator('input[type="password"]');
        this.submitButton = page.locator('button.btn.btn-primary');
        this.errorMessage = page.locator('.error-message');
    }

    async goto() {
        await this.page.goto('/login');
        await this.page.waitForLoadState('networkidle');
    }

    async login(email, password) {
        await this.emailInput.fill(email);
        await this.passwordInput.fill(password);
        await this.submitButton.click();
    }

    async getErrorMessage() {
        return await this.errorMessage.textContent();
    }

    async isErrorVisible() {
        return await this.errorMessage.isVisible();
    }
}

export class DashboardPage {
    constructor(page) {
        this.page = page;
        this.welcomeHeader = page.locator('.welcome-header');
        this.logoutButton = page.locator('button:has-text("Logout")');
    }

    async isLoaded() {
        return await this.welcomeHeader.isVisible();
    }

    async getWelcomeText() {
        return await this.welcomeHeader.textContent();
    }

    async logout() {
        await this.logoutButton.click();
    }
}

// Clean test code
test('Good: Login with POM', async ({ page }) => {
    const loginPage = new LoginPage(page);
    const dashboardPage = new DashboardPage(page);

    await loginPage.goto();
    await loginPage.login('user@example.com', 'password');

    await expect(dashboardPage.welcomeHeader).toContainText('Welcome');
});

// Reuse POM across multiple tests
test('Invalid credentials', async ({ page }) => {
    const loginPage = new LoginPage(page);

    await loginPage.goto();
    await loginPage.login('user@example.com', 'wrongpass');

    const error = await loginPage.getErrorMessage();
    expect(error).toContain('Invalid credentials');
});

// If selector changes, update in ONE place
// Example: Change from input[id="user-email"] to input[name="email"]
// Update only in LoginPage class constructor:
//   this.emailInput = page.locator('input[name="email"]');
// All tests automatically use new selector!

// POM with Helper Methods
export class BasePage {
    constructor(page) {
        this.page = page;
    }

    async getTitle() {
        return await this.page.title();
    }

    async getCurrentURL() {
        return this.page.url();
    }

    async waitForElement(locator) {
        await locator.waitFor({ state: 'visible' });
    }
}

export class CheckoutPage extends BasePage {
    constructor(page) {
        super(page);
        this.productItems = page.locator('[data-testid="product-item"]');
        this.addToCartButton = page.locator('button:has-text("Add to Cart")');
        this.proceedButton = page.locator('button:has-text("Proceed")');
    }

    async addProductToCart(productName) {
        const product = this.productItems.filter({ hasText: productName });
        await product.locator(this.addToCartButton).click();
    }

    async proceedToCheckout() {
        await this.proceedButton.click();
        await this.waitForElement(page.locator('[data-testid="checkout-form"]'));
    }
}

// Test using POM with inheritance
test('Checkout flow', async ({ page }) => {
    const checkout = new CheckoutPage(page);
    
    await checkout.goto();
    await checkout.addProductToCart('Laptop');
    await checkout.proceedToCheckout();
    
    const url = await checkout.getCurrentURL();
    expect(url).toContain('/checkout');
});
```

