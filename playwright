### CONCEPT 4: Fixtures - Reusable Setup & Teardown

**Theory:**
Fixtures provide reusable setup and teardown code for tests. They encapsulate test infrastructure and reduce code duplication.

```
Fixture Lifecycle:

Test Starts
    │
    ▼
Fixture Setup
    │
    ├─ Initialize resources
    ├─ Set up data
    ├─ Configure state
    │
    ▼
Test Runs
    │
    ├─ Uses fixture resources
    ├─ Performs assertions
    │
    ▼
Fixture Teardown
    │
    ├─ Cleanup resources
    ├─ Reset state
    └─ Close connections

Result: Clean, isolated test environment
```

**Practical Example:**

```javascript
// Basic fixture
import { test as base, expect } from '@playwright/test';

const test = base.extend({
    // Authenticated page fixture
    authenticatedPage: async ({ page }, use) => {
        // Setup: Login
        await page.goto('/login');
        await page.fill('input[name="email"]', 'user@example.com');
        await page.fill('input[name="password"]', 'password');
        await page.click('button[type="submit"]');
        await page.waitForURL('/dashboard');

        // Provide page to test
        await use(page);

        // Teardown: Logout
        await page.goto('/logout');
    }
});

// Use the fixture
test('Authenticated user sees dashboard', async ({ authenticatedPage }) => {
    // No login needed! Fixture handles it
    await expect(authenticatedPage.locator('h1')).toContainText('Dashboard');
});

// Advanced fixture with data
const test2 = base.extend({
    userData: async ({}, use) => {
        const user = {
            id: 123,
            email: 'test@example.com',
            name: 'Test User',
            role: 'admin'
        };

        // Setup: Could create user in DB
        console.log(`Creating user: ${user.email}`);

        await use(user);

        // Teardown: Could delete user from DB
        console.log(`Deleting user: ${user.email}`);
    }
});

test2('User properties', async ({ userData }) => {
    expect(userData.role).toBe('admin');
});

// Fixture with database
const test3 = base.extend({
    db: async ({}, use) => {
        // Setup: Connect to database
        const db = await connectDatabase();
        await db.connect();

        await use(db);

        // Teardown: Close connection
        await db.close();
    }
});

test3('Database operations', async ({ db, page }) => {
    // Insert test data
    const user = await db.users.create({
        email: 'test@example.com',
        name: 'Test'
    });

    // Test app with data
    await page.goto(`/users/${user.id}`);
    await expect(page.locator('h1')).toContainText('Test');
});

// Multiple fixtures
const test4 = base.extend({
    authPage: async ({ page }, use) => {
        await page.goto('/login');
        await page.fill('input[name="email"]', 'user@example.com');
        await page.fill('input[name="password"]', 'password');
        await page.click('button[type="submit"]');
        await use(page);
    },

    api: async ({}, use) => {
        const api = {
            async getUsers() {
                const response = await fetch('/api/users');
                return response.json();
            }
        };
        await use(api);
    }
});

test4('Combined fixtures', async ({ authPage, api }) => {
    const users = await api.getUsers();
    expect(users.length).toBeGreaterThan(0);
});

// Conditional fixture
const test5 = base.extend({
    browser: async ({ browser }, use) => {
        const actualBrowser = browser;
        await use(actualBrowser);
    },

    specialPage: async ({ browser }, use) => {
        let page;

        if (process.env.SLOW_CONNECTION) {
            // Create context with throttled network
            const context = await browser.newContext();
            page = await context.newPage();
            await page.route('**/*', route => {
                setTimeout(() => route.continue(), 1000);
            });
        } else {
            page = await browser.newPage();
        }

        await use(page);
        await page.close();
    }
});

test5('Works with special page', async ({ specialPage }) => {
    await specialPage.goto('https://example.com');
});
```

