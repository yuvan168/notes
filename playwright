### CONCEPT 10: Debugging & Troubleshooting

**Theory:**
Debugging is an essential skill for test automation. Understanding different debugging techniques helps resolve issues quickly.

```
Debugging Approach:

1. Error Message
   └─ Read full error message

2. Visual Inspection
   └─ Screenshot, video, trace

3. Selector Verification
   └─ Check if element exists, is visible

4. Timing Analysis
   └─ Check if enough wait time

5. Isolation
   └─ Run test alone, check for dependencies

6. Browser Tools
   └─ DevTools, network monitoring

7. Logs
   └─ Console logs, test logs
```

**Practical Example:**

```javascript
// Debug Mode
// npx playwright test --debug

// Inspect Mode (open DevTools)
// npx playwright test --debug-on-failure

// Slow Motion (easy to see what's happening)
export default defineConfig({
    use: {
        slowMo: 1000,  // Slow down by 1 second
    }
});

// Headed Mode (see browser)
// npx playwright test --headed

// Console Logging
test('Debug with logs', async ({ page }) => {
    console.log('Starting test');

    await page.goto('https://example.com');
    console.log('Navigated to homepage');

    const title = await page.title();
    console.log(`Page title: ${title}`);

    // Check element
    const button = page.locator('button');
    const exists = await button.isVisible();
    console.log(`Button visible: ${exists}`);
});

// Trace Debugging (run: npx playwright show-trace trace.zip)
test('Detailed trace', async ({ page }) => {
    await page.context().tracing.start({
        screenshots: true,
        snapshots: true
    });

    await page.goto('https://example.com');
    await page.click('button');

    await page.context().tracing.stop({
        path: 'trace.zip'
    });
});

// Page Events for Debugging
test('Monitor page events', async ({ page }) => {
    // Log all console messages
    page.on('console', msg => {
        console.log(`Browser console: ${msg.text()}`);
    });

    // Log all errors
    page.on('pageerror', exception => {
        console.log(`Browser error: ${exception}`);
    });

    // Log all requests
    page.on('request', request => {
        console.log(`Request: ${request.method()} ${request.url()}`);
    });

    // Log all responses
    page.on('response', response => {
        console.log(`Response: ${response.status()} ${response.url()}`);
    });

    await page.goto('https://example.com');
});

// Selector Debugging
test('Debug selector issues', async ({ page }) => {
    // Check if element exists
    const exists = await page.locator('button').count() > 0;
    console.log(`Button exists: ${exists}`);

    // Check if visible
    const visible = await page.locator('button').isVisible();
    console.log(`Button visible: ${visible}`);

    // Get element info
    const box = await page.locator('button').boundingBox();
    console.log(`Button location: ${JSON.stringify(box)}`);

    // Get HTML
    const html = await page.locator('button').innerHTML();
    console.log(`Button HTML: ${html}`);

    // Get all matching elements
    const buttons = await page.locator('button').all();
    console.log(`Found ${buttons.length} buttons`);
});

// Timing Debugging
test('Debug timing issues', async ({ page }) => {
    const startTime = Date.now();

    await page.goto('https://example.com');
    console.log(`Navigation took: ${Date.now() - startTime}ms`);

    const clickStart = Date.now();
    await page.click('button');
    console.log(`Click took: ${Date.now() - clickStart}ms`);

    // Check network timing
    page.on('requestfinished', request => {
        const timing = request.timing();
        const duration = timing.responseEnd - timing.requestStart;
        if (duration > 1000) {
            console.log(`Slow request: ${request.url()} (${duration}ms)`);
        }
    });
});

// Conditional Debugging
test('Debug on failure', async ({ page }, testInfo) => {
    try {
        await page.goto('https://example.com');
        await expect(page.locator('[data-testid="status"]')).toContainText('Ready');
    } catch (e) {
        // Take screenshot on failure
        const screenshotPath = testInfo.outputPath('failure.png');
        await page.screenshot({ path: screenshotPath });
        console.log(`Screenshot saved: ${screenshotPath}`);

        // Print page content
        const html = await page.content();
        console.log(`Page HTML:\n${html}`);

        throw e;
    }
});

// Interactive Debugging with Browser
test.only('Interactive debug (this test runs in debug mode)', async ({ page }) => {
    await page.pause();  // Pauses here, open DevTools

    await page.goto('https://example.com');
    await page.pause();  // Pause again

    await page.click('button');
    // When paused, you can type in console, inspect elements, etc.
});
```

