### CONCEPT 3: Network Interception & Mocking

**Theory:**
Network interception allows you to intercept, mock, and modify network requests and responses. This is crucial for testing error scenarios and API interactions.

```
Network Flow:

Browser Request
      │
      ▼
┌──────────────────────────┐
│ Playwright Interception  │
│ - Can abort              │
│ - Can modify             │
│ - Can mock response      │
└──────────────────────────┘
      │
      ├─ Continue to server
      ├─ Return custom response
      └─ Abort request


Mock Response Flow:

page.route() → Intercept → Decide → Fulfill/Continue/Abort
```

**Practical Example:**

```javascript
// Mock successful API response
test('Handle successful API', async ({ page }) => {
    await page.route('**/api/users', route => {
        route.fulfill({
            status: 200,
            contentType: 'application/json',
            body: JSON.stringify([
                { id: 1, name: 'Alice' },
                { id: 2, name: 'Bob' }
            ])
        });
    });

    await page.goto('/users');
    const users = page.locator('[data-testid="user"]');
    await expect(users).toHaveCount(2);
});

// Mock error API response
test('Handle API error', async ({ page }) => {
    await page.route('**/api/login', route => {
        route.fulfill({
            status: 401,
            body: JSON.stringify({ error: 'Unauthorized' })
        });
    });

    await page.goto('/login');
    await page.fill('input[name="email"]', 'user@example.com');
    await page.fill('input[name="password"]', 'wrong');
    await page.click('button[type="submit"]');

    await expect(page.locator('[data-testid="error"]'))
        .toContainText('Unauthorized');
});

// Block specific requests
test('Block images', async ({ page }) => {
    await page.route('**/*.{png,jpg,jpeg}', route => {
        route.abort();  // Block image loading
    });

    await page.goto('https://example.com');
    // Page loads faster without images
});

// Modify request
test('Modify request', async ({ page }) => {
    await page.route('**/api/data', route => {
        const request = route.request();
        route.continue({
            headers: {
                ...request.headers(),
                'Custom-Header': 'my-value'
            }
        });
    });

    await page.goto('https://example.com');
});

// Chain multiple mocks
test('Multiple API mocks', async ({ page }) => {
    // Mock 1: Login API
    await page.route('**/api/login', route => {
        route.fulfill({
            status: 200,
            body: JSON.stringify({ token: 'abc123' })
        });
    });

    // Mock 2: Dashboard API
    await page.route('**/api/dashboard', route => {
        route.fulfill({
            status: 200,
            body: JSON.stringify({ widgets: [1, 2, 3] })
        });
    });

    // Mock 3: Analytics API (just continue)
    await page.route('**/api/analytics/**', route => {
        route.continue();  // Allow this request
    });

    await page.goto('/login');
    // Tests with multiple mocked endpoints
});

// Remove mock
test('Temporary mock', async ({ page }) => {
    const handler = route => {
        route.fulfill({ status: 200, body: '{}' });
    };

    await page.route('**/api/data', handler);
    // Mocking active

    await page.unroute('**/api/data', handler);
    // Mocking removed, requests go to real server
});

// Monitor requests
test('Monitor requests', async ({ page }) => {
    const requests = [];

    page.on('request', request => {
        requests.push({
            url: request.url(),
            method: request.method(),
            time: new Date()
        });
    });

    await page.goto('https://example.com');
    console.log(`Total requests: ${requests.length}`);
});

// Performance: Check slow requests
test('Monitor performance', async ({ page }) => {
    page.on('requestfinished', request => {
        const duration = request.timing().responseEnd - request.timing().requestStart;
        if (duration > 1000) {
            console.log(`Slow request: ${request.url()} (${duration}ms)`);
        }
    });

    await page.goto('https://example.com');
});
```

