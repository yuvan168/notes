### CONCEPT 6: Assertions & Validation Patterns

**Theory:**
Assertions verify that the application behaves as expected. Different assertion types serve different purposes.

```
Assertion Types:

Visibility Assertions:
├─ toBeVisible() - Element is in viewport
├─ toBeHidden() - Element not visible
├─ toBeAttached() - Element in DOM
└─ toBeDetached() - Element not in DOM

Content Assertions:
├─ toContainText() - Contains substring
├─ toHaveText() - Exact text match
├─ toHaveAttribute() - Attribute value
└─ toHaveClass() - CSS class

State Assertions:
├─ toBeEnabled() - Element clickable
├─ toBeDisabled() - Element disabled
├─ toBeChecked() - Checkbox checked
└─ toHaveValue() - Input value

Navigation Assertions:
├─ toHaveURL() - Current URL
├─ toHaveTitle() - Page title
└─ (Custom) - Any condition
```

**Practical Example:**

```javascript
// Visibility Assertions
test('Visibility assertions', async ({ page }) => {
    // Element is visible
    await expect(page.locator('button')).toBeVisible();

    // Element is hidden
    await expect(page.locator('.modal')).toBeHidden();

    // Element is in DOM but not visible
    await expect(page.locator('.off-screen')).toBeAttached();

    // Element not in DOM
    await expect(page.locator('.deleted-element')).toBeDetached();
});

// Content Assertions
test('Content assertions', async ({ page }) => {
    // Contains text (substring)
    await expect(page.locator('h1')).toContainText('Welcome');

    // Exact text match
    await expect(page.locator('button')).toHaveText('Click Here');

    // Attribute value
    await expect(page.locator('input')).toHaveAttribute('type', 'email');

    // CSS class
    await expect(page.locator('button')).toHaveClass('active');

    // Multiple assertions
    await expect(page.locator('input')).toHaveAttribute('required', '');
    await expect(page.locator('input')).toHaveAttribute('minlength', '5');
});

// State Assertions
test('State assertions', async ({ page }) => {
    // Button is enabled
    await expect(page.locator('button')).toBeEnabled();

    // Button is disabled
    await expect(page.locator('button')).toBeDisabled();

    // Checkbox is checked
    await expect(page.locator('input[type="checkbox"]')).toBeChecked();

    // Input has value
    await expect(page.locator('input')).toHaveValue('text');

    // Count elements
    await expect(page.locator('li')).toHaveCount(5);
});

// Navigation Assertions
test('Navigation assertions', async ({ page }) => {
    // Check URL
    await page.goto('/login');
    await page.fill('input[name="email"]', 'user@example.com');
    await page.fill('input[name="password"]', 'password');
    await page.click('button[type="submit"]');

    // URL changed
    await expect(page).toHaveURL('/dashboard');

    // URL matches pattern
    await expect(page).toHaveURL(/\/dashboard/);

    // Page title
    await expect(page).toHaveTitle('Dashboard');
});

// Soft Assertions - Continue on failure
test('Soft assertions', async ({ page }) => {
    // Soft assertion - doesn't stop test
    await expect.soft(page.locator('h1')).toContainText('Welcome');

    // Soft assertion - doesn't stop test
    await expect.soft(page.locator('h2')).toContainText('Subtitle');

    // This runs even if previous assertions fail
    await page.click('button');
});

// Custom Assertions
test('Custom assertions', async ({ page }) => {
    // Assert element color
    const color = await page.locator('button')
        .evaluate(el => window.getComputedStyle(el).color);
    expect(color).toBe('rgb(255, 0, 0)');

    // Assert multiple elements
    const buttons = page.locator('button');
    const count = await buttons.count();
    expect(count).toBeGreaterThan(0);
    expect(count).toBeLessThan(10);

    // Assert async condition
    await expect(async () => {
        const text = await page.locator('[data-testid="status"]').textContent();
        expect(text).toContain('Complete');
    }).toPass();
});

// Wait & Assert Pattern
test('Wait and assert', async ({ page }) => {
    // Assertion with built-in wait
    // Waits up to 30s for success message to appear
    await expect(page.locator('[data-testid="success"]'))
        .toContainText('Operation successful');

    // Custom timeout
    await expect(page.locator('[data-testid="loading"]'))
        .toBeVisible({ timeout: 5000 });

    // Negative assertion
    await expect(page.locator('[data-testid="error"]'))
        .not.toBeVisible();
});

// Multi-step Assertions
test('Complex assertion flow', async ({ page }) => {
    // Arrange
    const form = page.locator('form');
    const submitButton = form.locator('button[type="submit"]');

    // Assert initial state
    await expect(submitButton).toBeDisabled();

    // Act: Fill form
    await form.locator('input[name="email"]').fill('user@example.com');
    await form.locator('input[name="password"]').fill('password');

    // Assert button enabled after input
    await expect(submitButton).toBeEnabled();

    // Act: Submit
    await submitButton.click();

    // Assert redirect
    await expect(page).toHaveURL('/dashboard');

    // Assert success message
    await expect(page.locator('[data-testid="welcome"]'))
        .toContainText('Welcome back');
});
