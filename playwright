### CONCEPT 8: Context & Cookies Management

**Theory:**
Contexts represent separate browser sessions with independent cookies, storage, and state. This allows testing multiple users simultaneously.

```
Browser Architecture:

Browser
  ├─ Context 1 (User A)
  │  ├─ Cookies (session_id: abc123)
  │  ├─ Storage (localStorage, sessionStorage)
  │  └─ Pages (1, 2, 3)
  │
  ├─ Context 2 (User B)
  │  ├─ Cookies (session_id: xyz789)
  │  ├─ Storage (independent)
  │  └─ Pages (1, 2)
  │
  └─ Context 3 (Admin)
     ├─ Cookies (session_id: admin999)
     ├─ Storage (independent)
     └─ Pages (1)

Each context is completely isolated!
```

**Practical Example:**

```javascript
// Multiple Contexts - Multiple Users
test('Two users simultaneously', async ({ browser }) => {
    // User A context
    const contextA = await browser.newContext();
    const pageA = await contextA.newPage();

    // User B context
    const contextB = await browser.newContext();
    const pageB = await contextB.newPage();

    // Both users can interact simultaneously
    await pageA.goto('/chat');
    await pageB.goto('/chat');

    // User A sends message
    await pageA.fill('input[name="message"]', 'Hello from User A');
    await pageA.click('button[type="send"]');

    // User B should see message
    await pageB.waitForTimeout(500);  // Wait for message to arrive
    await expect(pageB.locator('text=Hello from User A')).toBeVisible();

    // Cleanup
    await contextA.close();
    await contextB.close();
});

// Cookie Management
test('Cookie persistence', async ({ page }) => {
    // Login
    await page.goto('/login');
    await page.fill('input[name="email"]', 'user@example.com');
    await page.fill('input[name="password"]', 'password');
    await page.click('button[type="submit"]');
    await page.waitForURL('/dashboard');

    // Get cookies after login
    const cookies = await page.context().cookies();
    console.log('Session cookie:', cookies.find(c => c.name === 'session_id'));

    // Close and reopen
    await page.close();
    const newContext = await page.context().browser().newContext({
        storageState: { cookies }
    });
    const newPage = await newContext.newPage();

    // Should be logged in without credentials
    await newPage.goto('/dashboard');
    await expect(newPage.locator('h1')).toContainText('Dashboard');

    await newContext.close();
});

// Storage State
test('Save and restore auth state', async ({ browser }) => {
    // Scenario 1: Setup state
    const authContext = await browser.newContext();
    const authPage = await authContext.newPage();

    // Authenticate
    await authPage.goto('/login');
    await authPage.fill('input[name="email"]', 'user@example.com');
    await authPage.fill('input[name="password"]', 'password');
    await authPage.click('button[type="submit"]');
    await authPage.waitForURL('/dashboard');

    // Save state
    const authState = await authContext.storageState();
    await authContext.close();

    // Scenario 2: Use saved state
    const testContext = await browser.newContext({ storageState: authState });
    const testPage = await testContext.newPage();

    // Direct access to protected page (no login needed)
    await testPage.goto('/dashboard');
    await expect(testPage.locator('h1')).toContainText('Dashboard');

    await testContext.close();
});

// LocalStorage & SessionStorage
test('Storage management', async ({ page }) => {
    await page.goto('https://example.com');

    // Set localStorage
    await page.evaluate(() => {
        localStorage.setItem('user_preference', 'dark_mode');
        localStorage.setItem('language', 'en');
    });

    // Get localStorage
    const preference = await page.evaluate(() => {
        return localStorage.getItem('user_preference');
    });
    expect(preference).toBe('dark_mode');

    // Clear storage
    await page.evaluate(() => {
        localStorage.clear();
        sessionStorage.clear();
    });

    // Verify cleared
    const isEmpty = await page.evaluate(() => {
        return localStorage.length === 0;
    });
    expect(isEmpty).toBe(true);
});

// Context with Custom Headers
test('Custom headers', async ({ browser }) => {
    const context = await browser.newContext({
        extraHTTPHeaders: {
            'Authorization': 'Bearer token123',
            'Custom-Header': 'value'
        }
    });

    const page = await context.newPage();
    
    // All requests include custom headers
    await page.goto('https://example.com');

    await context.close();
});

// Context with Viewport
test('Different viewports', async ({ browser }) => {
    // Desktop
    const desktopContext = await browser.newContext({
        viewport: { width: 1920, height: 1080 }
    });

    // Mobile
    const mobileContext = await browser.newContext({
        viewport: { width: 375, height: 667 }
    });

    // Test responsive behavior
    const desktopPage = await desktopContext.newPage();
    const mobilePage = await mobileContext.newPage();

    await desktopPage.goto('https://example.com');
    await mobilePage.goto('https://example.com');

    // Compare layouts
    const desktopNav = await desktopPage.locator('nav').isVisible();
    const mobileNav = await mobilePage.locator('nav').isVisible();

    console.log(`Desktop nav visible: ${desktopNav}`);
    console.log(`Mobile nav visible: ${mobileNav}`);

    await desktopContext.close();
    await mobileContext.close();
});

// Offline Mode
test('Offline handling', async ({ browser }) => {
    const context = await browser.newContext({
        offline: true
    });

    const page = await context.newPage();

    // Try to load page offline
    try {
        await page.goto('https://example.com');
    } catch (e) {
        console.log('Expected error offline:', e.message);
    }

    // Go online
    await context.setOffline(false);

    // Now works
    await page.goto('https://example.com');
    await expect(page.locator('h1')).toBeVisible();

    await context.close();
});
```

