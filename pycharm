Refactored:
```

```python
from typing import List, Dict

def process_users(users: List[Dict]) -> List[Dict]:
    """Filter active adult users and extract key fields."""
    return [_user_to_dict(u) for u in users if _is_active_adult(u)]

def _is_active_adult(user: Dict) -> bool:
    """Check if user is adult and active."""
    return user.get('age', 0) > 18 and user.get('status') == 'active'

def _user_to_dict(user: Dict) -> Dict:
    """Extract user info into new dict."""
    return {
        'id': user['id'],
        'name': user['name'],
        'email': user['email']
    }
