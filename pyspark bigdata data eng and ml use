## SQL & DataFrame Operations

### Spark SQL

```python
# Create temp view
df.createOrReplaceTempView("employees")
df.createGlobalTempView("global_employees")

# Query using SQL
result = spark.sql("""
    SELECT name, age, salary
    FROM employees
    WHERE age > 30
    ORDER BY salary DESC
""")
result.show()

# Join in SQL
spark.sql("""
    SELECT e.name, d.dept_name
    FROM employees e
    JOIN departments d ON e.dept_id = d.dept_id
    WHERE e.salary > 50000
""").show()

# Aggregate in SQL
spark.sql("""
    SELECT age, COUNT(*) as count, AVG(salary) as avg_salary
    FROM employees
    GROUP BY age
    HAVING COUNT(*) > 1
    ORDER BY age
""").show()
```

### Using Functions

```python
from pyspark.sql.functions import *

# String functions
df.select(
    upper(col("name")).alias("name_upper"),
    lower(col("name")).alias("name_lower"),
    length(col("name")).alias("name_length"),
    substring(col("name"), 1, 3).alias("first_3_chars"),
    concat(col("name"), lit(" - "), col("age")).alias("combined"),
    trim(col("name")).alias("trimmed"),
    replace(col("name"), "John", "Jon").alias("replaced")
).show()

# Math functions
df.select(
    round(col("salary"), 2),
    abs(col("salary")),
    ceil(col("age")),
    floor(col("age")),
    sqrt(col("salary")),
    pow(col("salary"), 2)
).show()

# Date functions
df.select(
    current_date(),
    current_timestamp(),
    date_add(current_date(), 7),
    datediff(current_date(), col("hire_date")),
    year(col("hire_date")),
    month(col("hire_date")),
    dayofmonth(col("hire_date"))
).show()

# Window functions
from pyspark.sql import Window
window_spec = Window.partitionBy("department").orderBy("salary")
df.select(
    col("name"),
    col("salary"),
    row_number().over(window_spec).alias("rank"),
    rank().over(window_spec).alias("rank_with_ties"),
    dense_rank().over(window_spec).alias("dense_rank"),
    lag(col("salary"), 1).over(window_spec).alias("prev_salary"),
    lead(col("salary"), 1).over(window_spec).alias("next_salary")
).show()

# Conditional functions
df.select(
    col("name"),
    when(col("age") > 30, "Senior").when(col("age") > 25, "Mid").otherwise("Junior").alias("level"),
    coalesce(col("bonus"), lit(0)).alias("bonus_default"),
    case().when(col("salary") > 60000, "High").when(col("salary") > 50000, "Medium").otherwise("Low").alias("salary_range")
).show()
```

