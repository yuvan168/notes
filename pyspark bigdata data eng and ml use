**Q30: How to integrate Spark with machine learning?**

A: ML pipeline with Spark.

\\\python
from pyspark.ml import Pipeline
from pyspark.ml.feature import StringIndexer, OneHotEncoder, VectorAssembler
from pyspark.ml.classification import LogisticRegression

# Read data
df = spark.read.csv("data.csv", header=True, inferSchema=True)

# Feature engineering
indexer = StringIndexer(inputCol="category", outputCol="category_idx")
encoder = OneHotEncoder(inputCol="category_idx", outputCol="category_encoded")
assembler = VectorAssembler(
    inputCols=["age", "salary", "category_encoded"],
    outputCol="features"
)

# Model
model = LogisticRegression(featuresCol="features", labelCol="target")

# Pipeline
pipeline = Pipeline(stages=[indexer, encoder, assembler, model])

# Train
fitted_model = pipeline.fit(df)

# Predict
predictions = fitted_model.transform(df)
predictions.show()
