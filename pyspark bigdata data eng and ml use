# Method 1: Salting
from pyspark.sql.functions import rand, lit

salted = df.withColumn("salt", (rand() * 10).cast("int"))
result = salted.groupBy("key", "salt").agg(...)

# Method 2: Filter high-cardinality keys
high_keys = df.groupBy("key").count().filter("count > 1000000")
df_filtered = df.join(broadcast(high_keys), on="key")
result = df_filtered.groupBy("key").agg(...)

# Method 3: Repartition before groupBy
df = df.repartition(500, col("key"))
result = df.groupBy("key").agg(...)

# Method 4: Use aggregateByKey (RDD)
from pyspark.sql.functions import col
rdd = df.rdd.map(lambda r: (r.key, r.value))
result = rdd.aggregateByKey(0, 
    lambda acc, val: acc + val,  # add to accumulator
    lambda acc1, acc2: acc1 + acc2)  # merge accumulators
