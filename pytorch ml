        self.pos_embedding = nn.Parameter(torch.randn(1, num_patches + 1, d_model))
        self.cls_token = nn.Parameter(torch.randn(1, 1, d_model))
        
        self.transformer = TransformerBlock(d_model, num_heads, d_model * 4)
        self.fc_out = nn.Linear(d_model, num_classes)
    
    def forward(self, x):
        # Reshape to patches
        patches = x.view(x.size(0), -1, 3 * 16 * 16)
        
        # Embed patches
        embeddings = self.patch_embedding(patches)
        
        # Add cls token
        cls_tokens = self.cls_token.expand(x.size(0), -1, -1)
        embeddings = torch.cat([cls_tokens, embeddings], dim=1)
        
        # Add position encoding
        embeddings = embeddings + self.pos_embedding
        
        # Pass through transformer
        output = self.transformer(embeddings)
        
        # Use cls token for classification
        return self.fc_out(output[:, 0])
```

#### 2. Contrastive Learning (SimCLR)
```python
# Learn representations by bringing similar samples close
class SimCLR(nn.Module):
    def forward(self, x_i, x_j):
        z_i = self.encoder(x_i)
        z_j = self.encoder(x_j)
        
        # Normalize projections
        z_i = F.normalize(z_i, p=2, dim=1)
        z_j = F.normalize(z_j, p=2, dim=1)
        
        # Compute similarity
        logits = z_i @ z_j.T / 0.07  # Temperature
        
        # NT-Xent loss (normalized temperature-scaled cross entropy)
        return logits

def nt_xent_loss(logits):
    # InfoNCE loss
    n = logits.size(0)
    labels = torch.eye(n)
    return -torch.sum(labels * F.log_softmax(logits, dim=1)) / n
```

#### 3. Few-Shot Learning (Meta-Learning)
```python
# Model-Agnostic Meta-Learning (MAML)
class MAML(nn.Module):
    def __init__(self, model, inner_lr=0.01, outer_lr=0.001):
        super().__init__()
        self.model = model
        self.inner_lr = inner_lr
        self.outer_lr = outer_lr
        self.outer_optimizer = optim.Adam(self.model.parameters(), lr=outer_lr)
    
    def inner_loop(self, support_x, support_y, query_x, query_y):
        # Clone model for inner loop
        inner_model = self.model  # In practice, use deepcopy
        inner_optimizer = optim.SGD(inner_model.parameters(), lr=self.inner_lr)
        
        # Inner loop: few gradient steps on support set
        for _ in range(5):
            support_pred = inner_model(support_x)
            loss = F.cross_entropy(support_pred, support_y)
            inner_optimizer.zero_grad()
            loss.backward()
            inner_optimizer.step()
        
        # Evaluate on query set
        query_pred = inner_model(query_x)
        query_loss = F.cross_entropy(query_pred, query_y)
        
        return query_loss
    
    def outer_loop(self, tasks):
        # Meta-gradient across tasks
        meta_loss = 0
        for support_x, support_y, query_x, query_y in tasks:
            task_loss = self.inner_loop(support_x, support_y, query_x, query_y)
            meta_loss += task_loss
        
        meta_loss /= len(tasks)
        self.outer_optimizer.zero_grad()
        meta_loss.backward()
        self.outer_optimizer.step()
```

