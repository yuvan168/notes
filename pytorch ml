## Debugging & Performance

### Q24: How do you profile PyTorch code?
**A:** Use PyTorch profiler to identify bottlenecks:

```python
import torch
import torch.nn as nn
from torch.profiler import profile, record_function, ProfilerActivity

model = nn.Linear(1000, 1000)

# Profiling
with profile(
    activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA],
    record_shapes=True,
    profile_memory=True
) as prof:
    x = torch.randn(100, 1000)
    with record_function("model_inference"):
        output = model(x)

# Print results
print(prof.key_averages().table(sort_by="cpu_time_total", row_limit=10))

# For timing specific code
import time

start = time.time()
# Code to profile
output = model(x)
end = time.time()
print(f"Time: {end - start:.4f}s")

# Using torch.cuda timing
if torch.cuda.is_available():
    torch.cuda.synchronize()
    start = torch.cuda.Event(enable_timing=True)
    end = torch.cuda.Event(enable_timing=True)
    
    start.record()
    output = model(x)
    end.record()
    
    torch.cuda.synchronize()
    print(f"GPU Time: {start.elapsed_time(end):.4f}ms")
```

### Q25: How do you detect and fix out-of-memory (OOM) errors?
**A:** Common strategies for handling OOM:

```python
import torch
import torch.nn as nn

# 1. Reduce batch size
batch_size = 32  # Try smaller value if OOM

# 2. Use gradient accumulation
accumulation_steps = 4
for i, (X, y) in enumerate(dataloader):
    output = model(X)
    loss = criterion(output, y) / accumulation_steps
    loss.backward()
    
    if (i + 1) % accumulation_steps == 0:
        optimizer.step()
        optimizer.zero_grad()

# 3. Use mixed precision training
from torch.cuda.amp import autocast, GradScaler

scaler = GradScaler()

for X, y in dataloader:
    with autocast():  # Reduces memory usage
        output = model(X)
        loss = criterion(output, y)
    
    scaler.scale(loss).backward()
    scaler.step(optimizer)
    scaler.update()
    optimizer.zero_grad()

# 4. Enable checkpointing (trade computation for memory)
from torch.utils.checkpoint import checkpoint

# In model
class Model(nn.Module):
    def forward(self, x):
        x = checkpoint(self.layer1, x)  # Recompute in backward
        x = self.layer2(x)
        return x

