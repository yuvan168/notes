## Advanced Architectures

### Q20: How do you implement a CNN for image classification?
**A:** CNNs use convolutional layers for feature extraction:

```python
import torch
import torch.nn as nn

class CNN(nn.Module):
    def __init__(self):
        super(CNN, self).__init__()
        self.conv1 = nn.Conv2d(3, 32, kernel_size=3, padding=1)  # 3 input channels, 32 output
        self.pool = nn.MaxPool2d(2, 2)
        self.conv2 = nn.Conv2d(32, 64, kernel_size=3, padding=1)
        self.fc1 = nn.Linear(64 * 8 * 8, 128)
        self.fc2 = nn.Linear(128, 10)
    
    def forward(self, x):
        # Input: (batch_size, 3, 32, 32)
        x = self.pool(torch.relu(self.conv1(x)))  # (batch, 32, 16, 16)
        x = self.pool(torch.relu(self.conv2(x)))  # (batch, 64, 8, 8)
        x = x.view(x.size(0), -1)  # Flatten: (batch, 64*8*8)
        x = torch.relu(self.fc1(x))
        x = self.fc2(x)
        return x

# Parameters:
# Conv2d(in_channels, out_channels, kernel_size, padding, stride)
# - in_channels: input feature maps
# - out_channels: output feature maps
# - kernel_size: size of convolutional kernel
# - padding: adds zeros around input
# - stride: movement step of kernel
```

### Q21: How do you implement an RNN/LSTM?
**A:** RNNs process sequential data:

```python
import torch
import torch.nn as nn

class LSTMModel(nn.Module):
    def __init__(self, input_size, hidden_size, num_layers, output_size):
        super(LSTMModel, self).__init__()
        self.lstm = nn.LSTM(input_size, hidden_size, num_layers, 
                           batch_first=True)
        self.fc = nn.Linear(hidden_size, output_size)
    
    def forward(self, x):
        # x shape: (batch_size, sequence_length, input_size)
        lstm_out, (h_n, c_n) = self.lstm(x)
        # lstm_out: (batch_size, seq_length, hidden_size)
        # h_n: (num_layers, batch_size, hidden_size)
        
        # Use last output
        last_output = lstm_out[:, -1, :]  # (batch_size, hidden_size)
        out = self.fc(last_output)
        return out

# Usage
model = LSTMModel(input_size=10, hidden_size=50, num_layers=2, output_size=1)
x = torch.randn(32, 20, 10)  # (batch, sequence_length, input_size)
output = model(x)

# GRU alternative (simpler than LSTM)
model = nn.GRU(input_size=10, hidden_size=50, num_layers=2, 
              batch_first=True)
```

