## Generative Models

### Variational Autoencoders (VAE) - Theory

**Idea**: Learn a latent representation that's normally distributed and generative.

**Objective**: Minimize reconstruction loss + KL divergence:
$$\mathcal{L} = ||x - \tilde{x}||^2 + D_{KL}(q(z|x) || p(z))$$

```python
class VAE(nn.Module):
    def __init__(self, input_dim, latent_dim):
        super().__init__()
        
        # Encoder: input -> latent distribution
        self.encoder = nn.Sequential(
            nn.Linear(input_dim, 256),
            nn.ReLU(),
            nn.Linear(256, 128),
            nn.ReLU()
        )
        
        # Latent distribution parameters
        self.fc_mu = nn.Linear(128, latent_dim)
        self.fc_logvar = nn.Linear(128, latent_dim)
        
        # Decoder: latent -> reconstruction
        self.decoder = nn.Sequential(
            nn.Linear(latent_dim, 128),
            nn.ReLU(),
            nn.Linear(128, 256),
            nn.ReLU(),
            nn.Linear(256, input_dim),
            nn.Sigmoid()
        )
    
    def encode(self, x):
        h = self.encoder(x)
        mu = self.fc_mu(h)
        logvar = self.fc_logvar(h)
        return mu, logvar
    
    def sample_latent(self, mu, logvar):
        std = torch.exp(0.5 * logvar)
        eps = torch.randn_like(std)
        z = mu + eps * std
        return z
    
    def decode(self, z):
        return self.decoder(z)
    
    def forward(self, x):
        mu, logvar = self.encode(x)
        z = self.sample_latent(mu, logvar)
        recon_x = self.decode(z)
        return recon_x, mu, logvar

def vae_loss(recon_x, x, mu, logvar, beta=1.0):
    # Reconstruction loss
    BCE = F.binary_cross_entropy(recon_x, x, reduction='sum')
    
    # KL divergence
    KLD = -0.5 * torch.sum(1 + logvar - mu.pow(2) - logvar.exp())
    
    # Total loss (beta controls reconstruction vs regularization trade-off)
    return BCE + beta * KLD
```

### Generative Adversarial Networks (GAN) - Theory

**Idea**: Train generator and discriminator in competition.

**Generator**: Learns to create realistic samples from noise
**Discriminator**: Learns to distinguish real from fake

**Objective**:
$$\min_G \max_D \mathbb{E}_{x \sim p_{data}}[\log D(x)] + \mathbb{E}_{z \sim p_z}[\log(1 - D(G(z)))]$$

```python
class Generator(nn.Module):
    def __init__(self, latent_dim):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(latent_dim, 128),
            nn.ReLU(),
            nn.Linear(128, 256),
            nn.ReLU(),
            nn.Linear(256, 784),
            nn.Tanh()
        )
    
    def forward(self, z):
        return self.net(z)

class Discriminator(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(784, 256),
            nn.LeakyReLU(0.2),
            nn.Linear(256, 128),
            nn.LeakyReLU(0.2),
            nn.Linear(128, 1),
            nn.Sigmoid()
        )
    
    def forward(self, x):
        return self.net(x)

# Training loop
G = Generator(latent_dim=100)
D = Discriminator()
opt_g = optim.Adam(G.parameters(), lr=0.0002, betas=(0.5, 0.999))
opt_d = optim.Adam(D.parameters(), lr=0.0002, betas=(0.5, 0.999))

for batch_x in dataloader:
    # Train discriminator
    real_output = D(batch_x)
    z = torch.randn(batch_x.size(0), 100)
    fake_x = G(z)
    fake_output = D(fake_x.detach())
    
    d_loss = -torch.log(real_output + 1e-8).mean() - torch.log(1 - fake_output + 1e-8).mean()
    opt_d.zero_grad()
    d_loss.backward()
    opt_d.step()
    
    # Train generator
    fake_output = D(fake_x)
    g_loss = -torch.log(fake_output + 1e-8).mean()
    opt_g.zero_grad()
    g_loss.backward()
    opt_g.step()
```

