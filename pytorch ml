### Q29: How do you implement attention mechanism?
**A:** Basic attention implementation:

```python
import torch
import torch.nn as nn

class Attention(nn.Module):
    def __init__(self, hidden_size):
        super(Attention, self).__init__()
        self.attention = nn.Linear(hidden_size * 2, 1)
    
    def forward(self, query, keys):
        # query: (batch, hidden_size)
        # keys: (batch, seq_len, hidden_size)
        
        # Expand query to match keys shape
        query = query.unsqueeze(1)  # (batch, 1, hidden_size)
        
        # Compute attention scores
        # Concatenate query with each key
        combined = torch.cat([query.expand_as(keys), keys], dim=2)
        scores = self.attention(combined)  # (batch, seq_len, 1)
        
        # Apply softmax
        weights = torch.softmax(scores.squeeze(2), dim=1)  # (batch, seq_len)
        
        # Apply weights to keys
        context = (weights.unsqueeze(2) * keys).sum(dim=1)  # (batch, hidden_size)
        
        return context, weights

# Multi-head attention (simplified)
class MultiHeadAttention(nn.Module):
    def __init__(self, hidden_size, num_heads):
        super(MultiHeadAttention, self).__init__()
        self.hidden_size = hidden_size
        self.num_heads = num_heads
        self.head_dim = hidden_size // num_heads
        
        self.query = nn.Linear(hidden_size, hidden_size)
        self.key = nn.Linear(hidden_size, hidden_size)
        self.value = nn.Linear(hidden_size, hidden_size)
        self.fc_out = nn.Linear(hidden_size, hidden_size)
    
    def forward(self, query, key, value):
        Q = self.query(query)
        K = self.key(key)
        V = self.value(value)
        
        # Reshape for multi-head
        batch_size = Q.shape[0]
        Q = Q.view(batch_size, -1, self.num_heads, self.head_dim).transpose(1, 2)
        K = K.view(batch_size, -1, self.num_heads, self.head_dim).transpose(1, 2)
        V = V.view(batch_size, -1, self.num_heads, self.head_dim).transpose(1, 2)
        
        # Attention
        scores = torch.matmul(Q, K.transpose(-2, -1)) / (self.head_dim ** 0.5)
        attention = torch.softmax(scores, dim=-1)
        context = torch.matmul(attention, V)
        
        # Concatenate heads
        context = context.transpose(1, 2).contiguous()
        context = context.view(batch_size, -1, self.hidden_size)
        
        output = self.fc_out(context)
        return output
```

### Q30: How do you implement custom loss functions?
**A:** Create custom loss functions by extending `nn.Module`:

```python
import torch
import torch.nn as nn

# Simple custom loss
class CustomMSELoss(nn.Module):
    def __init__(self):
        super(CustomMSELoss, self).__init__()
    
    def forward(self, predictions, targets):
        diff = predictions - targets
        return torch.mean(diff ** 2)

# Weighted loss
class WeightedBCELoss(nn.Module):
    def __init__(self, pos_weight=1.0):
        super(WeightedBCELoss, self).__init__()
        self.pos_weight = pos_weight
    
    def forward(self, predictions, targets):
        # predictions: (batch,), targets: (batch,)
        bce = nn.functional.binary_cross_entropy(predictions, targets, reduction='none')
        weights = targets * self.pos_weight + (1 - targets)
        return (bce * weights).mean()

# Multi-task loss
class MultiTaskLoss(nn.Module):
    def __init__(self, task_weights=None):
        super(MultiTaskLoss, self).__init__()
        self.task_weights = task_weights or [1.0, 1.0]
    
    def forward(self, outputs, targets):
        loss1 = nn.functional.mse_loss(outputs[0], targets[0])
        loss2 = nn.functional.cross_entropy(outputs[1], targets[1])
        return self.task_weights[0] * loss1 + self.task_weights[1] * loss2

# Usage
criterion = CustomMSELoss()
loss = criterion(predictions, targets)
```

