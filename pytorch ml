## Neural Networks

### Q12: What is `nn.Module` and how do you create a custom layer?
**A:** `nn.Module` is the base class for all neural network modules in PyTorch.

```python
import torch
import torch.nn as nn

# Custom Layer
class CustomLayer(nn.Module):
    def __init__(self, in_features, out_features):
        super(CustomLayer, self).__init__()
        self.linear = nn.Linear(in_features, out_features)
        self.activation = nn.ReLU()
    
    def forward(self, x):
        x = self.linear(x)
        x = self.activation(x)
        return x

# Custom Complex Layer with multiple operations
class ResidualBlock(nn.Module):
    def __init__(self, channels):
        super(ResidualBlock, self).__init__()
        self.conv1 = nn.Conv2d(channels, channels, 3, padding=1)
        self.conv2 = nn.Conv2d(channels, channels, 3, padding=1)
        self.relu = nn.ReLU()
    
    def forward(self, x):
        residual = x
        out = self.relu(self.conv1(x))
        out = self.conv2(out)
        out = out + residual  # Skip connection
        out = self.relu(out)
        return out

# Usage
layer = CustomLayer(10, 5)
x = torch.randn(32, 10)
output = layer(x)
```

### Q13: What's the difference between `nn.Sequential` and creating a custom module?
**A:** `nn.Sequential` is simple but less flexible; custom modules offer more control.

```python
import torch
import torch.nn as nn

# Sequential: simple, linear flow
model1 = nn.Sequential(
    nn.Linear(10, 20),
    nn.ReLU(),
    nn.Linear(20, 5)
)

# Custom Module: flexible control
class CustomModel(nn.Module):
    def __init__(self):
        super(CustomModel, self).__init__()
        self.fc1 = nn.Linear(10, 20)
        self.fc2 = nn.Linear(20, 5)
    
    def forward(self, x):
        x = self.fc1(x)
        x = torch.relu(x)
        
        # Can add conditional logic
        if x.sum() > 0:
            x = x * 2  # Dynamic behavior
        
        x = self.fc2(x)
        return x

# Advantages of custom:
# - Conditional execution
# - Multiple inputs/outputs
# - Skip connections
# - Dynamic architecture
```

### Q14: How do you freeze and unfreeze parameters?
**A:** Control which parameters get gradient updates:

```python
import torch
import torch.nn as nn

model = nn.Sequential(
    nn.Linear(10, 20),
    nn.ReLU(),
    nn.Linear(20, 5)
)

# Freeze all parameters
for param in model.parameters():
    param.requires_grad = False

# Unfreeze specific layers
model[2].weight.requires_grad = True  # Unfreeze last layer
model[2].bias.requires_grad = True

# Freeze by name
for name, param in model.named_parameters():
    if 'layer2' in name:
        param.requires_grad = False

# Only optimize trainable parameters
optimizer = torch.optim.Adam(
    [p for p in model.parameters() if p.requires_grad]
)
```

### Q15: What is dropout and why is it important?
**A:** Dropout randomly deactivates neurons during training to prevent overfitting.

```python
import torch
import torch.nn as nn

class NetworkWithDropout(nn.Module):
    def __init__(self, dropout_rate=0.5):
        super(NetworkWithDropout, self).__init__()
        self.fc1 = nn.Linear(10, 20)
        self.dropout1 = nn.Dropout(dropout_rate)
        self.fc2 = nn.Linear(20, 5)
        self.dropout2 = nn.Dropout(dropout_rate)
    
    def forward(self, x):
        x = self.fc1(x)
        x = torch.relu(x)
        x = self.dropout1(x)  # Active during training, inactive during eval
        
        x = self.fc2(x)
        x = self.dropout2(x)
        return x

model = NetworkWithDropout()

# Training mode (dropout active)
model.train()
output1 = model(torch.randn(32, 10))

# Evaluation mode (dropout inactive)
model.eval()
with torch.no_grad():
    output2 = model(torch.randn(32, 10))

# Key points:
# - Dropout is applied with probability p
# - Remaining neurons are scaled by 1/(1-p)
# - Must use model.train() and model.eval()
```

