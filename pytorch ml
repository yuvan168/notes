## Autograd & Backpropagation

### Automatic Differentiation

#### Basic Concept
```python
import torch

# Tensors with requires_grad=True track operations
x = torch.randn(3, requires_grad=True)
y = torch.randn(3, requires_grad=True)

# Computational graph
z = x * y
s = z.sum()

print(s.requires_grad)  # True
print(s.grad_fn)  # Function that created s
```

#### Backward Pass
```python
# Enable gradient tracking
x = torch.tensor([2.0, 3.0], requires_grad=True)

# Forward pass
y = x ** 2
z = y.sum()

# Backward pass
z.backward()

# Access gradients
print(x.grad)  # [4.0, 6.0] (derivative of x^2 is 2x)

# Gradient is accumulated
z.backward()
print(x.grad)  # [8.0, 12.0] (accumulated gradients)
```

#### Manual Gradient Calculation
```python
x = torch.tensor([2.0, 3.0], requires_grad=True)

# Backward with custom gradient
z = (x ** 2).sum()
z.backward()

print(x.grad)  # [4.0, 6.0]

# Alternative: specify target gradient
x.grad = None
z = (x ** 2).sum()
z.backward(torch.tensor(1.0))
print(x.grad)  # [4.0, 6.0]
```

#### Detaching from Computation Graph
```python
x = torch.randn(3, requires_grad=True)

# Detach tensor (stops gradient flow)
y = (x ** 2).detach()

z = y.sum()
z.backward()  # No gradient for x because y is detached
print(x.grad)  # None

# With no_grad context
with torch.no_grad():
    y = x ** 2
    print(y.requires_grad)  # False

# Using inference_mode (more efficient)
with torch.inference_mode():
    y = x ** 2
```

#### Custom Autograd Functions
```python
class CustomFunction(torch.autograd.Function):
    @staticmethod
    def forward(ctx, x):
        # Save tensor for backward
        ctx.save_for_backward(x)
        return x ** 2
    
    @staticmethod
    def backward(ctx, grad_output):
        x, = ctx.saved_tensors
        return 2 * x * grad_output

# Using custom function
x = torch.randn(3, requires_grad=True)
y = CustomFunction.apply(x)
z = y.sum()
z.backward()
print(x.grad)  # [2*x[0], 2*x[1], 2*x[2]]
```

