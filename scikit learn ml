    X, y, test_size=0.2, random_state=42, stratify=y  # Stratified for imbalance
)

# 3. BUILD PIPELINE (preprocessing + model)
pipeline = Pipeline([
    ('scaler', StandardScaler()),          # Scale all features
    ('model', RandomForestClassifier(
        n_estimators=100,
        max_depth=10,
        min_samples_split=5,
        random_state=42,
        n_jobs=-1
    ))
])

# 4. INITIAL CROSS-VALIDATION (baseline)
cv_results = cross_validate(
    pipeline, X_train, y_train,
    cv=5,
    scoring={'accuracy': 'accuracy', 'roc_auc': 'roc_auc', 'f1': 'f1'}
)
print(f"Baseline CV Results:")
for metric in ['accuracy', 'roc_auc', 'f1']:
    key = f'test_{metric}'
    print(f"  {metric}: {cv_results[key].mean():.3f} (+/- {cv_results[key].std():.3f})")

# 5. HYPERPARAMETER TUNING
param_grid = {
    'model__n_estimators': [50, 100, 200],
    'model__max_depth': [5, 10, 15, None],
    'model__min_samples_split': [2, 5, 10],
}

grid_search = GridSearchCV(
    pipeline,
    param_grid,
    cv=5,
    scoring='roc_auc',    # Use most important metric
    n_jobs=-1,
    verbose=1
)

grid_search.fit(X_train, y_train)

print(f"\nBest Parameters: {grid_search.best_params_}")
print(f"Best CV AUC: {grid_search.best_score_:.3f}")

# 6. EVALUATE ON TEST SET (only once!)
best_model = grid_search.best_estimator_
y_pred = best_model.predict(X_test)
y_proba = best_model.predict_proba(X_test)[:, 1]

print(f"\nTest Set Performance:")
print(f"  Accuracy: {(y_pred == y_test).mean():.3f}")
print(f"  ROC-AUC: {roc_auc_score(y_test, y_proba):.3f}")

print("\nClassification Report:")
print(classification_report(y_test, y_pred))

# 7. FEATURE IMPORTANCE
feature_importance = best_model.named_steps['model'].feature_importances_
top_features_idx = np.argsort(feature_importance)[-10:]
print(f"\nTop 10 Important Features:")
