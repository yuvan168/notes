print(f"RF F1: {rf_scores.mean():.3f}")

# Gradient Boosting
gb = GradientBoostingClassifier(n_estimators=100, learning_rate=0.1, random_state=42)
gb_scores = cross_val_score(gb, X, y, cv=5, scoring='f1_weighted')
print(f"GB F1: {gb_scores.mean():.3f}")

# Decision:
# ✓ Use RF: Baseline, speed matters, good performance enough
# ✓ Use GB: Accuracy critical, time available, need best performance
```

