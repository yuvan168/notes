### Custom Transformers

**Theory**: Create custom transformers following scikit-learn API for specialized preprocessing.

**Anatomy of a Transformer**:
```python
from sklearn.base import BaseEstimator, TransformerMixin

class CustomTransformer(BaseEstimator, TransformerMixin):
    def __init__(self, param1=value1):        # Constructor: set parameters
        self.param1 = param1                   # Store as instance variables
    
    def fit(self, X, y=None):                  # Learn from training data
        # Compute statistics/parameters during fit
        self.statistic_ = X.mean()             # Store with trailing underscore
        return self                            # Return self for chaining
    
    def transform(self, X):                    # Apply transformation
        # Use learned statistics from fit()
        return X - self.statistic_
```

**Why Custom Transformers**:
- Integrate domain-specific transformations
- Maintain consistency with scikit-learn API
- Use in pipelines and GridSearchCV
- Prevent data leakage (fit learns from train only)

**Code Explanation**:

```python
from sklearn.base import BaseEstimator, TransformerMixin
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import cross_val_score
import numpy as np

# Custom transformer: Log transformation
class LogTransformer(BaseEstimator, TransformerMixin):
    def __init__(self, offset=1):
        # offset: added to avoid log(0)
        self.offset = offset
    
    def fit(self, X, y=None):
        # No parameters to learn for log transform
        # Just validate data
        return self
    
    def transform(self, X):
        # Apply log transformation
        # offset prevents log(0) = -inf
        return np.log(X + self.offset)

# Test custom transformer
log_transformer = LogTransformer(offset=1)
X_log = log_transformer.fit_transform(np.array([10, 100, 1000]))
print(X_log)  # [2.39, 4.61, 6.91]

# Custom transformer: Relative frequency encoding
class FrequencyEncoder(BaseEstimator, TransformerMixin):
    def __init__(self, min_frequency=0.01):
        # min_frequency: categories below this become 'rare'
        self.min_frequency = min_frequency
    
    def fit(self, X, y=None):
        # Learn category frequencies during fit
        # X is assumed to be categorical column
        value_counts = pd.Series(X.flatten()).value_counts(normalize=True)
        # Keep categories with frequency >= min_frequency
        self.frequent_categories_ = value_counts[
            value_counts >= self.min_frequency
        ].index.tolist()
        return self
    
    def transform(self, X):
        # Replace rare categories with 'rare'
        X_copy = X.copy()
        mask = ~X.isin(self.frequent_categories_)
        X_copy[mask] = 'rare'
        return X_copy

# Custom transformer: Polynomial features with selection
class PolynomialFeatureSelector(BaseEstimator, TransformerMixin):
    def __init__(self, degree=2, top_k=None):
        self.degree = degree
        self.top_k = top_k
    
    def fit(self, X, y=None):
        # No fitting needed for polynomial features
        return self
    
    def transform(self, X):
        # Create polynomial features
        if self.degree == 2:
            poly_X = np.hstack([
                X,  # Original features
                X ** 2,  # Squared features
                X[:, [0]] * X[:, [1]] if X.shape[1] > 1 else np.array([]).reshape(-1, 1)
                # Interaction terms if multiple features
            ])
        
        # Select top k features if specified
        if self.top_k and poly_X.shape[1] > self.top_k:
            # Simple variance-based selection
            variances = poly_X.var(axis=0)
            top_indices = np.argsort(variances)[-self.top_k:]
            poly_X = poly_X[:, top_indices]
        
        return poly_X

# Using custom transformers in pipeline
pipeline = Pipeline([
    ('log_transform', LogTransformer(offset=1)),
    ('scaler', StandardScaler()),
    ('poly', PolynomialFeatureSelector(degree=2, top_k=10)),
    ('model', LogisticRegression(max_iter=1000))
])

# Fit and evaluate (custom transformer automatically used)
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)
pipeline.fit(X_train, y_train)
y_pred = pipeline.predict(X_test)

# GridSearchCV with custom parameters
from sklearn.model_selection import GridSearchCV

param_grid = {
    'log_transform__offset': [0.5, 1, 1.5],  # Search offset parameter
    'poly__degree': [1, 2],  # Search polynomial degree
    'model__C': [0.1, 1, 10]  # Search model parameter
}

grid_search = GridSearchCV(pipeline, param_grid, cv=5)
grid_search.fit(X_train, y_train)
print(f"Best offset: {grid_search.best_params_['log_transform__offset']}")
print(f"Best degree: {grid_search.best_params_['poly__degree']}")

# Real-world example: Text length transformer
class TextLengthTransformer(BaseEstimator, TransformerMixin):
    def fit(self, X, y=None):
        return self
    
    def transform(self, X):
        # Extract text length as feature
        return np.array([
            [len(text), len(text.split())]  # character count, word count
            for text in X
        ]).reshape(-1, 1) if len(X) > 0 else np.array([]).reshape(-1, 2)

# Real-world example: Cyclical feature transformer
class CyclicalFeatureTransformer(BaseEstimator, TransformerMixin):
    def __init__(self, period=365):
        # period: e.g., 365 for day of year, 24 for hour of day
        self.period = period
    
    def fit(self, X, y=None):
        return self
    
    def transform(self, X):
        # Convert cyclical to (sin, cos) representation
        X_sin = np.sin(2 * np.pi * X / self.period)
        X_cos = np.cos(2 * np.pi * X / self.period)
        return np.hstack([X_sin, X_cos])
        # Why sin/cos: Preserves circular nature (day 364 close to day 1)

# Usage in pipeline
pipeline = Pipeline([
    ('cyclical', CyclicalFeatureTransformer(period=365)),
    ('scaler', StandardScaler()),
    ('model', LogisticRegression())
])

pipeline.fit(X_train, y_train)
y_pred = pipeline.predict(X_test)
```

**Best Practices**:
```python
# ✅ DO: Follow scikit-learn conventions
class GoodTransformer(BaseEstimator, TransformerMixin):
    def fit(self, X, y=None):
        self.statistics_ = X.mean()  # Store learned params with trailing underscore
        return self  # Return self for method chaining
    
    def transform(self, X):
        return X - self.statistics_

# ❌ DON'T: Break conventions
class BadTransformer:  # Missing BaseEstimator, TransformerMixin
    def fit(self, X, y=None):
        self.stat = X.mean()  # No trailing underscore (parameter vs learned)
        # Doesn't return self (breaks chaining)

# ✅ DO: Validate inputs
def transform(self, X):
    if not hasattr(self, 'statistics_'):
        raise ValueError("fit() must be called before transform()")
    return X - self.statistics_

# ✅ DO: Handle edge cases
def fit(self, X, y=None):
    X = np.asarray(X)  # Convert to numpy array
    if X.shape[0] == 0:
        raise ValueError("X has 0 samples")
    self.statistics_ = X.mean()
    return self
