X_imputed = imputer.fit_transform(X)

# Considerations:
# - Mean/Median: Simple, fast, good for MCAR data
# - KNN: Preserves relationships, slower, more computationally expensive
# - Deletion: Only if <5% missing and MCAR
# - Forward/Backward fill: For time series
