X_train, X_val, y_train, y_val = train_test_split(X_temp, y_temp, 
                                                 test_size=0.25,
                                                 random_state=42)

# Key principles:
# 1. Stratify for imbalanced classification
# 2. Always set random_state for reproducibility
# 3. Split before preprocessing (avoid data leakage)
# 4. Never fit preprocessor on test data

# Correct workflow:
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)  # Use train statistics

