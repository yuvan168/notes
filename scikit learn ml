## Advanced Topics

### Custom Estimators

**Theory**: Create custom estimators following scikit-learn API standards.

**Why Build Custom Estimators**:
- Domain-specific algorithms
- Proprietary methods
- Integration with existing scikit-learn ecosystem (pipelines, GridSearchCV)

**Requirements**: Inherit from `BaseEstimator` and `RegressorMixin` (or `ClassifierMixin`)

**Code Explanation**:

```python
from sklearn.base import BaseEstimator, RegressorMixin, ClassifierMixin
import numpy as np
from sklearn.model_selection import cross_val_score

# Custom Regressor: Weighted Average (baseline comparison)
class WeightedAverageRegressor(BaseEstimator, RegressorMixin):
    def __init__(self, weight_power=1.0):
        self.weight_power = weight_power  # Parameter
    
    def fit(self, X, y):
        # Learn weighted average during fit
        # Weights based on distance to centroid
        self.centroid_ = X.mean(axis=0)
        
        # Compute weights (points closer to centroid get higher weight)
        distances = np.linalg.norm(X - self.centroid_, axis=1)
        self.weights_ = 1.0 / (distances ** self.weight_power + 1e-8)
        self.weights_ /= self.weights_.sum()  # Normalize to sum to 1
        
        # Compute weighted average
        self.mean_ = np.average(y, weights=self.weights_)
        return self
    
    def predict(self, X):
        # All predictions are the weighted average
        return np.full(len(X), self.mean_)
    
    def get_params(self, deep=True):
        # Required for GridSearchCV
        return {'weight_power': self.weight_power}
    
    def set_params(self, **params):
        # Required for GridSearchCV
        for key, value in params.items():
            setattr(self, key, value)
        return self

# Usage
X_train = np.random.randn(100, 5)
y_train = 2 * X_train[:, 0] + 3 * X_train[:, 1] + np.random.randn(100)

model = WeightedAverageRegressor(weight_power=1.0)
model.fit(X_train, y_train)

X_test = np.random.randn(20, 5)
y_pred = model.predict(X_test)

# Works with cross-validation
scores = cross_val_score(model, X_train, y_train, cv=5, scoring='r2')
print(f"CV R² Score: {scores.mean():.3f}")

# Custom Classifier: Simple Rule-Based
class SimpleRuleClassifier(BaseEstimator, ClassifierMixin):
    def __init__(self, threshold=0.5):
        self.threshold = threshold
    
    def fit(self, X, y):
        # Learn mean and std for each feature
        self.means_ = X.mean(axis=0)
        self.stds_ = X.std(axis=0)
        return self
    
    def predict(self, X):
        # Normalize and sum features
        normalized = (X - self.means_) / (self.stds_ + 1e-8)
        scores = normalized.mean(axis=1)
        return (scores > self.threshold).astype(int)
    
    def predict_proba(self, X):
        # Needed for probability estimates
        from scipy.special import expit  # Sigmoid function
        normalized = (X - self.means_) / (self.stds_ + 1e-8)
        scores = normalized.mean(axis=1)
        proba_positive = expit(scores)  # Apply sigmoid
        return np.vstack([1 - proba_positive, proba_positive]).T

clf = SimpleRuleClassifier(threshold=0.0)
clf.fit(X_train, y_train > 0)
y_pred = clf.predict(X_test)
y_proba = clf.predict_proba(X_test)

# Using in Pipeline
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler

pipeline = Pipeline([
    ('scaler', StandardScaler()),
    ('model', WeightedAverageRegressor(weight_power=1.5))
])

# GridSearchCV on custom parameter
from sklearn.model_selection import GridSearchCV

param_grid = {'model__weight_power': [0.5, 1.0, 1.5, 2.0]}
grid_search = GridSearchCV(pipeline, param_grid, cv=5)
grid_search.fit(X_train, y_train)

print(f"Best weight_power: {grid_search.best_params_['model__weight_power']}")
print(f"Best CV score: {grid_search.best_score_:.3f}")

# Best Practices for Custom Estimators:
# 1. Inherit from correct base class (Estimator, Regressor, Classifier)
# 2. Store learned parameters with trailing underscore
# 3. Implement get_params() and set_params() for GridSearchCV
# 4. Implement fit() returning self for chaining
# 5. Raise appropriate errors for invalid inputs
```

