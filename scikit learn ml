**2. Estimator, Transformer, Predictor API**
```python
# All follow same pattern
class MyEstimator:
    def __init__(self, param1=value1):        # Set hyperparameters
        self.param1 = param1
    
    def fit(self, X, y=None):                  # Learn from data
        self.learned_param_ = compute(X, y)   # Store with underscore
        return self                             # Return self for chaining
    
    def transform(self, X):                    # Apply learned transformation
        return X - self.learned_param_         # [Transformers only]
    
    def predict(self, X):                      # Make predictions
        return decision_function(X)            # [Predictors only]
    
    def get_params(self, deep=True):           # For GridSearchCV
        return {'param1': self.param1}
    
    def set_params(self, **params):            # For GridSearchCV
        for k, v in params.items(): setattr(self, k, v)
        return self
```

