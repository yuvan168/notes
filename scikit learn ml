## Pipeline Best Practices

```python
# ✅ DO
from sklearn.pipeline import Pipeline

# 1. All transformations in pipeline
pipeline = Pipeline([
    ('imputer', SimpleImputer()),      # Handle missing
    ('scaler', StandardScaler()),      # Scale features
    ('selector', SelectKBest(k=10)),   # Select features
    ('model', LogisticRegression())    # Train model
])

# 2. Fit on train only
pipeline.fit(X_train, y_train)

# 3. Use same pipeline for test
y_pred = pipeline.predict(X_test)

# 4. Use in GridSearchCV
GridSearchCV(pipeline, param_grid, cv=5)

# 5. Access steps by name
scaler = pipeline.named_steps['scaler']

# ❌ DON'T
# Fit transformations separately
scaler = StandardScaler()
scaler.fit(X)  # Fit on all data (data leakage!)
X_scaled = scaler.transform(X)
X_train, X_test = train_test_split(X_scaled)  # Too late!

# Train model without transformations
model.fit(X_raw, y)  # Features not scaled

# Apply different transformations to train/test
X_train_scaled = StandardScaler().fit_transform(X_train)
X_test_scaled = MinMaxScaler().fit_transform(X_test)  # Different scalers!
