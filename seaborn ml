           y=sales_data.groupby('product')['sales'].mean().sort_values().index,
           x=sales_data.groupby('product')['sales'].mean().sort_values().values,
           ax=ax)
ax.set_title('Solution 2: Horizontal Bars (All Categories)')
ax.set_xlabel('Average Sales')
plt.tight_layout()

# Solution 3: Faceted plots by region
