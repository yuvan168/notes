```splunk
# How many systems have similar activity?
index=main EventCode=4688 earliest=-2h
| search CommandLine contains "encrypt" OR CommandLine contains "crypt"
| stats dc(dest) as infected_systems by sourcetype
| table infected_systems

# Check for shared network drives affected
index=main EventCode=4656 ObjectType="File"
  ObjectName="\\*\*\?" earliest=-1h
| search Status="Success"
| stats count by ObjectName

# Identify patient zero
index=main EventCode=4688 earliest=-24h
| search CommandLine="*psexec*" OR source_ip="203.0.113.99"
