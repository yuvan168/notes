public class InsertionSort {

 

    static void insertionSort(int arr[], int n) {

 

        for (int i = 1; i < n; i++) {

 

            int j = i;

 

            while (j > 0 && arr[j - 1] > arr[j]) {

 

                // swap

                int temp = arr[j - 1];

                arr[j - 1] = arr[j];

                arr[j] = temp;

 

                j--;

            }

