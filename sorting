class Solution {

    public int[] quickSort(int[] nums) {
        quick(nums, 0, nums.length - 1);
        return nums;
    }

    public static void quick(int[] nums, int low, int high) {
        if (low < high) {
            int pIndex = partition(nums, low, high);
            quick(nums, low, pIndex - 1);
            quick(nums, pIndex + 1, high);
        }
    }

    public static int partition(int[] nums, int low, int high) {
        int pivot = nums[low];
        int i = low;
        int j = high;

        while (i < j) {

            while (i <= high - 1 && nums[i] <= pivot) {
                i++;
            }

            while (j >= low + 1 && nums[j] > pivot) {
                j--;
            }

            if (i < j) {
                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;
            }
        }

        // place pivot at correct position
        int temp = nums[low];
        nums[low] = nums[j];
        nums[j] = temp;

        return j;
    }
}


