**17. How do you implement pagination in Spring Boot?**

**Answer:**
Pagination retrieves data in smaller chunks rather than all at once:

```java
// Repository with pagination
@Repository
public interface UserRepository extends JpaRepository<User, Long> {
    Page<User> findByNameContaining(String name, Pageable pageable);
    Page<User> findByStatus(String status, Pageable pageable);
}

// Service with pagination
@Service
public class UserService {
    
    @Autowired
    private UserRepository userRepository;
    
    public Page<UserDTO> getAllUsers(int page, int size, String sortBy) {
        // Create pageable object
        Pageable pageable = PageRequest.of(
            page,                                    // Page number (0-indexed)
            size,                                    // Items per page
            Sort.by(sortBy).descending()            // Sorting
        );
        
        // Query with pagination
        Page<User> users = userRepository.findAll(pageable);
        
        // Map to DTO
        return users.map(this::convertToDTO);
    }
    
    public Page<UserDTO> searchUsers(String name, int page, int size) {
        Pageable pageable = PageRequest.of(page, size);
        
        return userRepository.findByNameContaining(name, pageable)
                .map(this::convertToDTO);
    }
    
    private UserDTO convertToDTO(User user) {
        return new UserDTO(user.getId(), user.getName(), user.getEmail());
    }
}

// Controller with pagination
@RestController
@RequestMapping("/api/users")
public class UserController {
    
    @Autowired
    private UserService userService;
    
    @GetMapping
    public ResponseEntity<Page<UserDTO>> getAllUsers(
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "10") int size,
            @RequestParam(defaultValue = "id") String sortBy) {
        
        Page<UserDTO> users = userService.getAllUsers(page, size, sortBy);
        return ResponseEntity.ok(users);
    }
}

// Client usage:
