/**
 * Q60: NEON NUMBER
 * Sum of digits of square of the number equals the number
 * Input: Integer N
 * Output: "Neon" or "Not Neon"
 * Example: 9 → 9^2=81 → 8+1=9 → Neon
 */
class NeonNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sq = n * n;
        int sum = 0;
        while (sq > 0) {
            sum += sq % 10;
            sq /= 10;
        }
        System.out.println(sum == n ? "Neon" : "Not Neon");
        sc.close();
    }
}

/**
 * Q61: HARSHAD (NIVEN) NUMBER
 * Number divisible by sum of its digits
 * Input: Integer N
 * Output: "Harshad" or "Not Harshad"
 * Example: 18 → 1+8=9 → 18/9=2 → Harshad
 */
class HarshadNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n, sum = 0;
        while (temp > 0) {
            sum += temp % 10;
            temp /= 10;
        }
        System.out.println(n % sum == 0 ? "Harshad" : "Not Harshad");
        sc.close();
    }
}

/**
 * Q62: SMITH NUMBER
 * Sum of digits of the number equals sum of digits of its prime factors
 * Input: Integer N
 * Output: "Smith" or "Not Smith"
 * Example: 22 → digits: 2+2=4; prime factors: 2×11 → 2+1+1=4 → Smith
 */
class SmithNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        if (isPrime(n)) {
            System.out.println("Not Smith"); // primes are not smith numbers
            sc.close();
            return;
        }

        int digitSum = sumOfDigits(n);
        int primeFactorDigitSum = 0;
        int temp = n;
        for (int i = 2; i <= temp; i++) {
            while (temp % i == 0) {
                primeFactorDigitSum += sumOfDigits(i);
                temp /= i;
            }
        }
        System.out.println(digitSum == primeFactorDigitSum ? "Smith" : "Not Smith");
        sc.close();
    }

    static int sumOfDigits(int n) {
        int sum = 0;
        while (n > 0) { sum += n % 10; n /= 10; }
        return sum;
    }

    static boolean isPrime(int n) {
        if (n <= 1) return false;
        for (int i = 2; i * i <= n; i++)
            if (n % i == 0) return false;
        return true;
    }
}

/**
 * Q63: HAPPY NUMBER
 * Replace number by sum of squares of digits, repeat.
 * If it reaches 1, it's happy. If it loops, not happy.
 * Input: Integer N
 * Output: "Happy" or "Not Happy"
 * Example: 19 → 1²+9²=82 → 64+4=68 → 36+64=100 → 1 → Happy
 */
class HappyNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        HashSet<Integer> seen = new HashSet<>();
        while (n != 1 && !seen.contains(n)) {
            seen.add(n);
            int sum = 0;
            while (n > 0) {
                int d = n % 10;
                sum += d * d;
                n /= 10;
            }
            n = sum;
        }
        System.out.println(n == 1 ? "Happy" : "Not Happy");
        sc.close();
    }
}

/**
 * Q64: ABUNDANT NUMBER
 * Sum of proper divisors > number
 * Input: Integer N
 * Output: "Abundant" or "Not Abundant"
 * Example: 12 → 1+2+3+4+6=16 > 12 → Abundant
 */
class AbundantNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum = 0;
        for (int i = 1; i <= n / 2; i++) {
            if (n % i == 0) sum += i;
        }
        System.out.println(sum > n ? "Abundant" : "Not Abundant");
        sc.close();
    }
}


