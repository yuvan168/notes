/**
 * Q37: MATRIX MULTIPLICATION
 * Past Year: TCS NQT 2024
 * Input: M1 rows/cols, matrix1, M2 rows/cols, matrix2
 * Output: Product matrix
 */
class MatrixMultiply {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int r1 = sc.nextInt(), c1 = sc.nextInt();
        int[][] a = new int[r1][c1];
        for (int i = 0; i < r1; i++)
            for (int j = 0; j < c1; j++)
                a[i][j] = sc.nextInt();

        int r2 = sc.nextInt(), c2 = sc.nextInt();
        int[][] b = new int[r2][c2];
        for (int i = 0; i < r2; i++)
            for (int j = 0; j < c2; j++)
                b[i][j] = sc.nextInt();

        if (c1 != r2) {
            System.out.println("Multiplication not possible");
        } else {
            int[][] result = new int[r1][c2];
            for (int i = 0; i < r1; i++)
                for (int j = 0; j < c2; j++)
                    for (int k = 0; k < c1; k++)
                        result[i][j] += a[i][k] * b[k][j];

            for (int i = 0; i < r1; i++) {
                for (int j = 0; j < c2; j++) {
                    if (j > 0) System.out.print(" ");
                    System.out.print(result[i][j]);
                }
                System.out.println();
            }
        }
        sc.close();
    }
}

/**
 * Q38: SPIRAL MATRIX PRINT
 * Past Year: TCS NQT 2025
 * Input: N (NxN matrix), then elements
 * Output: Elements in spiral order
 */
class SpiralMatrix {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[][] mat = new int[n][n];
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                mat[i][j] = sc.nextInt();

        int top = 0, bottom = n - 1, left = 0, right = n - 1;
        StringBuilder sb = new StringBuilder();
        while (top <= bottom && left <= right) {
            for (int i = left; i <= right; i++) {
                if (sb.length() > 0) sb.append(" ");
                sb.append(mat[top][i]);
            }
            top++;
            for (int i = top; i <= bottom; i++) {
                if (sb.length() > 0) sb.append(" ");
                sb.append(mat[i][right]);
            }
            right--;
            if (top <= bottom) {
                for (int i = right; i >= left; i--) {
                    if (sb.length() > 0) sb.append(" ");
                    sb.append(mat[bottom][i]);
                }
                bottom--;
            }
            if (left <= right) {
                for (int i = bottom; i >= top; i--) {
                    if (sb.length() > 0) sb.append(" ");
                    sb.append(mat[i][left]);
                }
                left++;
            }
        }
        System.out.println(sb.toString());
        sc.close();
    }
}


