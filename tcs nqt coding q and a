/**
 * Q21: SECOND LARGEST ELEMENT IN ARRAY
 * Past Year: TCS NQT 2022, 2023, 2024
 * Input: N (size), then N elements
 * Output: Second largest element
 */
class SecondLargest {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) arr[i] = sc.nextInt();

        int first = Integer.MIN_VALUE, second = Integer.MIN_VALUE;
        for (int x : arr) {
            if (x > first) {
                second = first;
                first = x;
            } else if (x > second && x != first) {
                second = x;
            }
        }
        if (second == Integer.MIN_VALUE)
            System.out.println("No second largest");
        else
            System.out.println(second);
        sc.close();
    }
}

/**
 * Q22: ROTATE ARRAY BY K POSITIONS (LEFT ROTATION)
 * Past Year: TCS NQT 2023, 2024
 * Input: N (size), K (positions), then N elements
 * Output: Rotated array
 * Example: [1,2,3,4,5] K=2 → [3,4,5,1,2]
 */
class RotateArray {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int k = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) arr[i] = sc.nextInt();

        k = k % n; // handle k > n
        reverse(arr, 0, k - 1);
        reverse(arr, k, n - 1);
        reverse(arr, 0, n - 1);

        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++) {
            if (i > 0) sb.append(" ");
            sb.append(arr[i]);
        }
        System.out.println(sb.toString());
        sc.close();
    }

    static void reverse(int[] arr, int l, int r) {
        while (l < r) {
            int temp = arr[l];
            arr[l] = arr[r];
            arr[r] = temp;
            l++;
            r--;
        }
    }
}

