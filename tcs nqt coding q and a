/**
 * Q39: POWER OF A NUMBER WITHOUT Math.pow
 * Past Year: TCS NQT 2023
 * Input: base, exponent
 * Output: base^exponent
 * Approach: Fast exponentiation O(log n)
 */
class PowerCalculation {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long base = sc.nextLong();
        long exp = sc.nextLong();
        boolean negative = exp < 0;
        exp = Math.abs(exp);

        long result = 1;
        long b = base;
        while (exp > 0) {
            if (exp % 2 == 1) result *= b;
            b *= b;
            exp /= 2;
        }
        if (negative) {
            System.out.println("1/" + result);
        } else {
            System.out.println(result);
        }
        sc.close();
    }
}

