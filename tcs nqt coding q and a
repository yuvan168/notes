/**
 * Q8: SUM OF DIGITS UNTIL SINGLE DIGIT (Digital Root)
 * Past Year: TCS NQT 2023
 * Input: Integer N
 * Output: Single digit sum
 * Example: 9875 → 9+8+7+5=29 → 2+9=11 → 1+1=2
 */
class DigitalRoot {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        n = Math.abs(n);
        while (n >= 10) {
            int sum = 0;
            while (n > 0) {
                sum += n % 10;
                n /= 10;
            }
            n = sum;
        }
        System.out.println(n);
        sc.close();
    }
}

/**
 * Q9: COUNT PRIME NUMBERS IN A RANGE
 * Past Year: TCS NQT 2024
 * Input: Two integers L and R
 * Output: Count of primes between L and R (inclusive)
 */
class PrimesInRange {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int l = sc.nextInt();
        int r = sc.nextInt();
        int count = 0;
        for (int num = l; num <= r; num++) {
            if (isPrime(num)) count++;
        }
        System.out.println(count);
        sc.close();
    }

    static boolean isPrime(int n) {
        if (n <= 1) return false;
        if (n <= 3) return true;
        if (n % 2 == 0 || n % 3 == 0) return false;
        for (int i = 5; i * i <= n; i += 6) {
            if (n % i == 0 || n % (i + 2) == 0) return false;
        }
        return true;
    }
}

/**
 * Q10: PERFECT NUMBER CHECK
 * Past Year: TCS NQT 2023
 * A number equals the sum of its proper divisors
 * Input: Integer N
 * Output: "Perfect" or "Not Perfect"
 * Example: 28 = 1+2+4+7+14 = 28 → Perfect
 */
class PerfectNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum = 0;
        for (int i = 1; i <= n / 2; i++) {
            if (n % i == 0) sum += i;
        }
        System.out.println(sum == n && n > 0 ? "Perfect" : "Not Perfect");
        sc.close();
    }
}


