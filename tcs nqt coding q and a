}

/**
 * Q4: GCD AND LCM OF TWO NUMBERS
 * Past Year: TCS NQT 2022, 2024
 * Input: Two integers A and B
 * Output: GCD and LCM
 */
class GcdLcm {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();

        int gcd = gcd(a, b);
        long lcm = (long) a / gcd * b; // avoid overflow

        System.out.println("GCD=" + gcd);
        System.out.println("LCM=" + lcm);
        sc.close();
    }

    static int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}

/**
 * Q5: ARMSTRONG NUMBER
 * Past Year: TCS NQT 2021, 2023
 * A number where sum of cubes of digits equals the number
 * Input: Integer N
 * Output: "Armstrong" or "Not Armstrong"
 * Example: 153 = 1^3 + 5^3 + 3^3 = 153 → Armstrong
 */
class ArmstrongNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int original = n;
        int digits = String.valueOf(Math.abs(n)).length();
        int sum = 0;
        int temp = Math.abs(n);

        while (temp > 0) {
            int d = temp % 10;
            sum += Math.pow(d, digits);
            temp /= 10;
        }
        System.out.println(sum == Math.abs(original) ? "Armstrong" : "Not Armstrong");
        sc.close();
    }
}

