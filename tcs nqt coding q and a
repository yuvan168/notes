 * Input: N, then N elements
 * Output: Elements sorted by frequency (higher freq first), if tie—smaller element first
 * Example: [1,1,2,2,2,3] → [2,2,2,1,1,3]
 */
class SortByFrequency {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        Map<Integer, Integer> freq = new LinkedHashMap<>();
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
            freq.put(arr[i], freq.getOrDefault(arr[i], 0) + 1);
        }

        List<int[]> entries = new ArrayList<>();
        for (Map.Entry<Integer, Integer> e : freq.entrySet()) {
            entries.add(new int[]{e.getKey(), e.getValue()});
        }
        // Sort: higher frequency first, then smaller value first
        entries.sort((a, b) -> {
            if (b[1] != a[1]) return b[1] - a[1];
            return a[0] - b[0];
        });

        StringBuilder sb = new StringBuilder();
        for (int[] e : entries) {
            for (int i = 0; i < e[1]; i++) {
                if (sb.length() > 0) sb.append(" ");
                sb.append(e[0]);
            }
        }
        System.out.println(sb.toString());
        sc.close();
    }
}


