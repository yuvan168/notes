/**
 * Q45: LONGEST PALINDROMIC SUBSTRING
 * Past Year: TCS NQT 2025
 * Input: A string
 * Output: Longest palindromic substring
 */
class LongestPalinSubstring {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        if (s.length() <= 1) {
            System.out.println(s);
            sc.close();
            return;
        }
        int start = 0, maxLen = 1;
        for (int i = 0; i < s.length(); i++) {
            // Odd length palindromes
            int l = i, r = i;
            while (l >= 0 && r < s.length() && s.charAt(l) == s.charAt(r)) {
                if (r - l + 1 > maxLen) {
                    start = l;
                    maxLen = r - l + 1;
                }
                l--;
                r++;
            }
            // Even length palindromes
            l = i;
            r = i + 1;
            while (l >= 0 && r < s.length() && s.charAt(l) == s.charAt(r)) {
                if (r - l + 1 > maxLen) {
                    start = l;
                    maxLen = r - l + 1;
                }
                l--;
                r++;
            }
        }
        System.out.println(s.substring(start, start + maxLen));
        sc.close();
    }
}

/**
 * Q46: CHECK BALANCED PARENTHESES
 * Past Year: TCS NQT 2024
 * Input: String with (){}[]
 * Output: "Balanced" or "Not Balanced"
 */
class BalancedParentheses {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        Stack<Character> stack = new Stack<>();
        boolean balanced = true;
        for (char c : s.toCharArray()) {
            if (c == '(' || c == '{' || c == '[') {
                stack.push(c);
            } else if (c == ')' || c == '}' || c == ']') {
                if (stack.isEmpty()) {
                    balanced = false;
                    break;
                }
                char top = stack.pop();
                if ((c == ')' && top != '(') ||
                    (c == '}' && top != '{') ||
                    (c == ']' && top != '[')) {
                    balanced = false;
                    break;
                }
            }
        }
        if (!stack.isEmpty()) balanced = false;
        System.out.println(balanced ? "Balanced" : "Not Balanced");
        sc.close();
    }
}

/**
 * Q47: NEXT GREATER ELEMENT
 * Past Year: TCS NQT 2025
 * Input: N, then N elements
 * Output: For each element, print the next greater element (-1 if none)
