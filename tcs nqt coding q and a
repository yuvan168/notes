/**
 * EXACT Q: TCS NQT 2024 — Slot 3
 * Find if a number is a Strong Number
 * A Strong Number: sum of factorial of digits equals the number
 * Example: 145 = 1! + 4! + 5! = 1 + 24 + 120 = 145
 * Input: Integer N
 * Output: "Strong" or "Not Strong"
 */
class StrongNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n, sum = 0;
        while (temp > 0) {
            int d = temp % 10;
            sum += factorial(d);
            temp /= 10;
        }
        System.out.println(sum == n ? "Strong" : "Not Strong");
        sc.close();
    }

    static int factorial(int n) {
        int f = 1;
        for (int i = 2; i <= n; i++) f *= i;
        return f;
    }
}

/**
 * EXACT Q: TCS NQT 2022 — Slot 1
 * Given N numbers via command line args, print the sum of
 * all prime numbers among them
 * Input: Numbers as args or via Scanner
 * Output: Sum of prime numbers
 */
class SumOfPrimes {
    public static void main(String[] args) {
        int sum = 0;
        if (args.length > 0) {
            for (String arg : args) {
                int num = Integer.parseInt(arg);
                if (isPrime(num)) sum += num;
            }
        } else {
            Scanner sc = new Scanner(System.in);
            int n = sc.nextInt();
            for (int i = 0; i < n; i++) {
                int num = sc.nextInt();
                if (isPrime(num)) sum += num;
            }
            sc.close();
        }
        System.out.println(sum);
    }

    static boolean isPrime(int n) {
        if (n <= 1) return false;
        if (n <= 3) return true;
        if (n % 2 == 0 || n % 3 == 0) return false;
        for (int i = 5; i * i <= n; i += 6) {
            if (n % i == 0 || n % (i + 2) == 0) return false;
        }
        return true;
    }
}

/**
 * EXACT Q: TCS NQT 2022 — Slot 2
 * Replace every element of the array with the product of
 * every other element (without using division)
 * Input: N, then N elements
 * Output: Product array
 * Example: [1,2,3,4] → [24,12,8,6]
 */
class ProductArray {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) arr[i] = sc.nextInt();

        int[] left = new int[n];
        int[] right = new int[n];
        int[] result = new int[n];

        left[0] = 1;
        for (int i = 1; i < n; i++) left[i] = left[i - 1] * arr[i - 1];

        right[n - 1] = 1;
        for (int i = n - 2; i >= 0; i--) right[i] = right[i + 1] * arr[i + 1];

        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++) {
            if (i > 0) sb.append(" ");
            sb.append(left[i] * right[i]);
        }
        System.out.println(sb.toString());
        sc.close();
    }
}

/**
 * EXACT Q: TCS NQT 2025 — Slot 1
 * Given a string of digits, find the largest and smallest
 * numbers that can be formed using those digits
 * Input: String of digits e.g., "38290"
 * Output:
 * Largest: 98320
 * Smallest: 20389
 */
class LargestSmallestFromDigits {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine().trim();
        char[] digits = s.toCharArray();
        Arrays.sort(digits);

        // Smallest: sorted ascending (handle leading zeros)
        StringBuilder smallest = new StringBuilder(new String(digits));
        // If there are leading zeros, swap first zero with first non-zero
        if (smallest.charAt(0) == '0' && smallest.length() > 1) {
            for (int i = 1; i < smallest.length(); i++) {
                if (smallest.charAt(i) != '0') {
                    char temp = smallest.charAt(0);
                    smallest.setCharAt(0, smallest.charAt(i));
                    smallest.setCharAt(i, temp);
                    break;
                }
            }
        }

        // Largest: sorted descending
        StringBuilder largest = new StringBuilder(new String(digits)).reverse();

        System.out.println("Largest: " + largest.toString());
        System.out.println("Smallest: " + smallest.toString());
        sc.close();
    }
}

/**
 * EXACT Q: TCS NQT 2025 — Slot 2
 * Implement Sieve of Eratosthenes to find all primes up to N
 * Input: Integer N
 * Output: All primes up to N
 */
class SieveOfEratosthenes {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        boolean[] isPrime = new boolean[n + 1];
        Arrays.fill(isPrime, true);
        isPrime[0] = false;
        if (n >= 1) isPrime[1] = false;

        for (int i = 2; i * i <= n; i++) {
            if (isPrime[i]) {
                for (int j = i * i; j <= n; j += i) {
                    isPrime[j] = false;
                }
            }
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 2; i <= n; i++) {
            if (isPrime[i]) {
                if (sb.length() > 0) sb.append(" ");
                sb.append(i);
            }
        }
        System.out.println(sb.toString());
        sc.close();
    }
}

/**
 * EXACT Q: TCS NQT 2025 — Slot 3
 * Given a sorted array, remove duplicates in-place
 * and print the unique elements
 * Input: N, then N sorted elements
 * Output: Unique elements
 * Example: [1,1,2,2,3,4,4,5] → [1,2,3,4,5]
 */
class RemoveSortedDuplicates {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) arr[i] = sc.nextInt();

        if (n == 0) {
            System.out.println();
            sc.close();
            return;
        }

        int j = 0;
        for (int i = 1; i < n; i++) {
            if (arr[i] != arr[j]) {
                arr[++j] = arr[i];
            }
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i <= j; i++) {
            if (i > 0) sb.append(" ");
            sb.append(arr[i]);
        }
        System.out.println(sb.toString());
        sc.close();
    }
}


