/**
 * Q1: REVERSE A NUMBER
 * Past Year: TCS NQT 2022, 2023
 * Input: A single integer N
 * Output: Reverse of N
 * Example: Input: 12345 → Output: 54321
 */
class ReverseNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int rev = 0;
        int temp = n;
        // Handle negative numbers
        boolean isNegative = n < 0;
        if (isNegative) temp = -temp;

        while (temp > 0) {
            rev = rev * 10 + temp % 10;
            temp /= 10;
        }
        if (isNegative) rev = -rev;
        System.out.println(rev);
        sc.close();
    }
}

/**
 * Q2: CHECK PRIME NUMBER
 * Past Year: TCS NQT 2021, 2023, 2024
 * Input: A single integer N
 * Output: "Prime" or "Not Prime"
 */
class CheckPrime {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        boolean isPrime = true;
        if (n <= 1) {
            isPrime = false;
        } else {
            for (int i = 2; i <= Math.sqrt(n); i++) {
                if (n % i == 0) {
                    isPrime = false;
                    break;
                }
            }
        }
        System.out.println(isPrime ? "Prime" : "Not Prime");
        sc.close();
    }
}

/**
 * Q3: FACTORIAL OF A NUMBER
 * Past Year: TCS NQT 2022
 * Input: Integer N (0 <= N <= 20)
