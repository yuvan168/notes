## Training & Optimization

### Custom Training Loop

```python
import tensorflow as tf

model = keras.Sequential([
    layers.Dense(128, activation='relu', input_shape=(784,)),
    layers.Dense(10, activation='softmax')
])

optimizer = keras.optimizers.Adam(learning_rate=0.001)
loss_fn = keras.losses.SparseCategoricalCrossentropy()

# Training step
@tf.function  # Compiles graph for performance
def train_step(x, y):
    with tf.GradientTape() as tape:
        logits = model(x, training=True)
        loss_value = loss_fn(y, logits)
    
    grads = tape.gradient(loss_value, model.trainable_weights)
    optimizer.apply_gradients(zip(grads, model.trainable_weights))
    
    return loss_value

# Training loop
train_dataset = tf.data.Dataset.from_tensor_slices((X_train, y_train)).batch(32)

for epoch in range(epochs):
    for x_batch, y_batch in train_dataset:
        loss = train_step(x_batch, y_batch)
    
    print(f"Epoch {epoch}, Loss: {loss:.4f}")
```

### Learning Rate Scheduling

```python
# Step decay
lr_schedule = keras.optimizers.schedules.ExponentialDecay(
    initial_learning_rate=0.1,
    decay_steps=100000,
    decay_rate=0.96
)

optimizer = keras.optimizers.SGD(learning_rate=lr_schedule)

# Piecewise constant decay
boundaries = [100000, 200000]
values = [0.1, 0.05, 0.01]
lr_schedule = keras.optimizers.schedules.PiecewiseConstantDecay(
    boundaries, values
)

# Cosine decay
lr_schedule = keras.optimizers.schedules.CosineDecay(
    initial_learning_rate=0.1,
    decay_steps=1000
)

# Callback for learning rate scheduling
def lr_scheduler(epoch, lr):
    if epoch > 10:
        return lr * tf.math.exp(-0.1)
    return lr

callback = keras.callbacks.LearningRateScheduler(lr_scheduler)
model.fit(X_train, y_train, epochs=20, callbacks=[callback])
```

