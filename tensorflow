## Advanced Architectures

### ResNet: Residual Networks

**Problem**: Deep networks suffer from vanishing gradients and degradation problem.

**Solution**: Residual connections (skip connections) allow gradients to flow directly.

**Block formulation**:
$$y = F(x) + x$$

where $F(x)$ is the residual mapping.

```python
class ResidualBlock(tf.keras.layers.Layer):
    def __init__(self, filters):
        super(ResidualBlock, self).__init__()
        self.conv1 = tf.keras.layers.Conv2D(filters, 3, padding='same')
        self.bn1 = tf.keras.layers.BatchNormalization()
        self.conv2 = tf.keras.layers.Conv2D(filters, 3, padding='same')
        self.bn2 = tf.keras.layers.BatchNormalization()
    
    def call(self, inputs, training=None):
        # Residual path
        residual = inputs
        
        # Main path
        x = self.conv1(inputs)
        x = self.bn1(x, training=training)
        x = tf.nn.relu(x)
        
        x = self.conv2(x)
        x = self.bn2(x, training=training)
        
        # Combine residual
        x = x + residual
        return tf.nn.relu(x)

# Bottleneck block (1x1 -> 3x3 -> 1x1)
class BottleneckBlock(tf.keras.layers.Layer):
    def __init__(self, filters):
        super().__init__()
        reduced = filters // 4
        
        self.conv1 = tf.keras.layers.Conv2D(reduced, 1)
        self.bn1 = tf.keras.layers.BatchNormalization()
        
        self.conv2 = tf.keras.layers.Conv2D(reduced, 3, padding='same')
        self.bn2 = tf.keras.layers.BatchNormalization()
        
        self.conv3 = tf.keras.layers.Conv2D(filters, 1)
        self.bn3 = tf.keras.layers.BatchNormalization()
        
        # Projection shortcut if dimension mismatch
        self.shortcut_conv = tf.keras.layers.Conv2D(filters, 1) if reduced != filters else None
    
    def call(self, inputs, training=None):
        residual = inputs
        if self.shortcut_conv:
            residual = self.shortcut_conv(residual)
        
        x = self.conv1(inputs)
        x = self.bn1(x, training=training)
        x = tf.nn.relu(x)
        
        x = self.conv2(x)
        x = self.bn2(x, training=training)
        x = tf.nn.relu(x)
        
        x = self.conv3(x)
        x = self.bn3(x, training=training)
        
        return tf.nn.relu(x + residual)
```

### DenseNet: Dense Connections

**Idea**: Connect each layer to all previous layers (dense connections).

**Advantage**: Better feature reuse, fewer parameters than ResNet.

```python
class DenseBlock(tf.keras.layers.Layer):
    def __init__(self, num_layers, growth_rate):
        super().__init__()
        self.layers_list = []
        for _ in range(num_layers):
            self.layers_list.append(self._create_layer(growth_rate))
    
    def _create_layer(self, growth_rate):
        return tf.keras.Sequential([
            tf.keras.layers.BatchNormalization(),
            tf.keras.layers.ReLU(),
            tf.keras.layers.Conv2D(growth_rate * 4, 1, padding='same'),
            tf.keras.layers.BatchNormalization(),
            tf.keras.layers.ReLU(),
            tf.keras.layers.Conv2D(growth_rate, 3, padding='same'),
        ])
    
    def call(self, inputs, training=None):
        concat_list = [inputs]
        
        for layer in self.layers_list:
            x = layer(inputs, training=training)
            concat_list.append(x)
            inputs = tf.concat(concat_list, axis=-1)  # Concatenate all
        
        return inputs
```

