### Custom Metrics
```python
class CustomMetric(keras.metrics.Metric):
    def __init__(self, name='custom_metric', **kwargs):
        super(CustomMetric, self).__init__(name=name, **kwargs)
        self.value = self.add_weight(name='value', initializer='zeros')
    
    def update_state(self, y_true, y_pred, sample_weight=None):
        matches = tf.equal(tf.argmax(y_true, axis=1), tf.argmax(y_pred, axis=1))
        self.value.assign_add(tf.reduce_sum(tf.cast(matches, tf.float32)))
    
    def result(self):
        return self.value
    
    def reset_state(self):
        self.value.assign(0)

model.compile(metrics=[CustomMetric()])
```

