### Q21: How do you implement gradient accumulation?
**A:** Accumulate gradients over multiple batches:

```python
import tensorflow as tf
from tensorflow import keras

model = keras.Sequential([...])
optimizer = keras.optimizers.Adam()
loss_fn = keras.losses.SparseCategoricalCrossentropy()

accumulation_steps = 4

@tf.function
def train_step(x, y):
    with tf.GradientTape() as tape:
        logits = model(x, training=True)
        loss = loss_fn(y, logits) / accumulation_steps  # Normalize
    
    gradients = tape.gradient(loss, model.trainable_weights)
    return gradients, loss * accumulation_steps

# Training
for epoch in range(10):
    accumulated_gradients = None
    
    for step, (x_batch, y_batch) in enumerate(train_dataset):
        gradients, loss = train_step(x_batch, y_batch)
        
        # Accumulate gradients
        if accumulated_gradients is None:
            accumulated_gradients = gradients
        else:
            accumulated_gradients = [
                ag + g for ag, g in zip(accumulated_gradients, gradients)
            ]
        
        # Apply accumulated gradients
        if (step + 1) % accumulation_steps == 0:
            optimizer.apply_gradients(
                zip(accumulated_gradients, model.trainable_weights)
            )
            accumulated_gradients = None
```

