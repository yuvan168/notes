### ETL Process

```apex
// ETL (Extract, Transform, Load) Service
public class ETLService {
    
    /**
     * Extract data from source
     */
    public static List<Map<String, Object>> extractData(String source) {
        List<Map<String, Object>> data = new List<Map<String, Object>>();
        
        if (source == 'DATABASE') {
            List<Account> accounts = [SELECT Id, Name, Type, Industry FROM Account LIMIT 1000];
            for (Account acc : accounts) {
                Map<String, Object> row = new Map<String, Object>();
                row.put('id', acc.Id);
                row.put('name', acc.Name);
                row.put('type', acc.Type);
                row.put('industry', acc.Industry);
                data.add(row);
            }
        }
        
        return data;
    }
    
    /**
     * Transform data
     */
    public static List<Map<String, Object>> transformData(List<Map<String, Object>> rawData) {
        List<Map<String, Object>> transformedData = new List<Map<String, Object>>();
        
        for (Map<String, Object> row : rawData) {
            Map<String, Object> transformed = new Map<String, Object>();
            
            // Apply transformation rules
            transformed.put('name', ((String) row.get('name')).toUpperCase());
            transformed.put('type', normalizeType((String) row.get('type')));
            transformed.put('industry', normalizeIndustry((String) row.get('industry')));
            
            transformedData.add(transformed);
        }
        
        return transformedData;
    }
    
    /**
     * Load data to target
     */
    public static void loadData(List<Map<String, Object>> data) {
        List<Account> accountsToUpdate = new List<Account>();
        
        for (Map<String, Object> row : data) {
            Account acc = new Account();
            acc.Name = (String) row.get('name');
            acc.Type = (String) row.get('type');
            acc.Industry = (String) row.get('industry');
            accountsToUpdate.add(acc);
        }
        
        insert accountsToUpdate;
    }
    
    private static String normalizeType(String type) {
        // Normalize type value
        return type != null ? type.trim() : '';
    }
    
    private static String normalizeIndustry(String industry) {
        // Normalize industry value
        return industry != null ? industry.trim() : '';
    }
}
