**Types of Caching:**

```
Client-Side Cache:
├─ Browser cache: Cache static assets (CSS, JS, images)
├─ Application cache: Store frequently accessed data in memory
├─ TTL: Time-to-live before refresh
└─ Use case: User roles, classifications (rarely change)

Example:
```python
from functools import lru_cache
import requests
from datetime import datetime, timedelta

class CachedVaultAccess:
    def __init__(self, api_url, token):
        self.api_url = api_url
        self.token = token
        self.user_roles_cache = {}
        self.cache_expiry = {}
    
    def get_user_roles(self, user_id, use_cache=True):
        """Get user roles with caching"""
        
        # Check cache
        if use_cache and user_id in self.user_roles_cache:
            if datetime.now() < self.cache_expiry.get(user_id, datetime.min):
                return self.user_roles_cache[user_id]
        
        # Fetch fresh data
        response = requests.get(
            f"{self.api_url}/api/v22/users/{user_id}/roles",
            headers={'Authorization': f'Bearer {self.token}'}
        )
        
        roles = response.json()['roles']
        
        # Cache for 1 hour
        self.user_roles_cache[user_id] = roles
        self.cache_expiry[user_id] = datetime.now() + timedelta(hours=1)
        
        return roles
