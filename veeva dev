```apex
// HIPAA Compliant Data Handling
public with sharing class HIPAACompliantDataHandler {
    
    /**
     * Encrypt sensitive PHI data
     */
    public static String encryptPHI(String sensitiveData) {
        // Use Salesforce encryption
        Blob blobData = Blob.valueOf(sensitiveData);
        Blob encryptedData = Crypto.encryptWithManagedIV(
            'AES256', 
            Crypto.generateAesKey(256), 
            blobData
        );
        return EncodingUtil.base64Encode(encryptedData);
    }
    
    /**
     * Decrypt sensitive PHI data
     */
    public static String decryptPHI(String encryptedData) {
        Blob decodedData = EncodingUtil.base64Decode(encryptedData);
        Blob decryptedData = Crypto.decryptWithManagedIV(
            'AES256', 
            Crypto.generateAesKey(256), 
            decodedData
        );
        return decryptedData.toString();
    }
    
