// Veeva Vault Integration with CRM
public class VaultCRMIntegration {
    
    // Sync document from Vault to CRM
    public static void syncDocumentToCRM(String vaultDocId, String crmRecordId) {
        try {
            // Call Vault API to fetch document metadata
            HttpRequest vaultReq = new HttpRequest();
            vaultReq.setEndpoint('https://vaultdev.veevavault.com/api/v21.0/objects/documents/' + vaultDocId);
            vaultReq.setMethod('GET');
            vaultReq.setHeader('Authorization', 'Bearer ' + getVaultSessionId());
            
            Http http = new Http();
            HttpResponse vaultRes = http.send(vaultReq);
            
            if (vaultRes.getStatusCode() == 200) {
                Map<String, Object> docData = (Map<String, Object>) 
                    JSON.deserializeUntyped(vaultRes.getBody());
                
                // Create attachment in CRM
                Attachment att = new Attachment();
                att.ParentId = crmRecordId;
                att.Name = (String) docData.get('name');
                att.Description = 'Synced from Veeva Vault';
                
                insert att;
                System.debug('Document synced to CRM attachment');
            }
        } catch (Exception e) {
            System.debug('Error syncing document: ' + e.getMessage());
        }
    }
    
    private static String getVaultSessionId() {
        // Implementation to get session ID
        return 'session_id_here';
