// Batch Processing in Veeva
public class VeevaBatchProcessor implements Database.Batchable<sObject> {
    
    // Start method
    public Database.QueryLocator start(Database.BatchableContext context) {
        String query = 'SELECT Id, Name, BillingCity FROM Account WHERE Type = \'Customer\'';
        return Database.getQueryLocator(query);
    }
    
    // Execute method - Process records in batches (200 limit)
    public void execute(Database.BatchableContext context, List<SObject> scope) {
        List<Account> accountsToUpdate = new List<Account>();
        
        for (SObject record : scope) {
            Account acc = (Account) record;
            acc.BillingCity = 'Updated City';
            accountsToUpdate.add(acc);
        }
        
        update accountsToUpdate;
    }
    
    // Finish method
    public void finish(Database.BatchableContext context) {
        System.debug('Batch processing completed');
        
        // Send email notification
        AsyncApexJob job = [SELECT Status, NumberOfErrors 
                           FROM AsyncApexJob 
                           WHERE Id = :context.getJobId()];
    }
}

