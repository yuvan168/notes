```

**Step 2: Batch Upload**
```
Batch Upload Vault Configuration:

Documents to upload: 5,600 files
Strategy: Batch in groups of 100

Script Example (Python):
import requests
import os
import json
from pathlib import Path

class VaultUploader:
    def __init__(self, vault_url, api_token):
        self.vault_url = vault_url
        self.headers = {
            'Authorization': f'Bearer {api_token}',
            'Content-Type': 'application/json'
        }
    
    def upload_batch(self, document_dir, batch_size=100):
        documents = list(Path(document_dir).glob('*.pdf'))
        
        for i in range(0, len(documents), batch_size):
            batch = documents[i:i+batch_size]
            self.process_batch(batch)
            print(f"Uploaded batch {i//batch_size + 1} of {len(documents)//batch_size + 1}")
    
    def process_batch(self, documents):
        for doc_path in documents:
            metadata = self.extract_metadata(doc_path)
            self.upload_document(doc_path, metadata)
    
    def upload_document(self, file_path, metadata):
        with open(file_path, 'rb') as f:
            files = {'file': f}
            
            # Prepare metadata
            data = {
                'filename__v': Path(file_path).name,
                'classification__v': metadata['classification'],
                'therapeutic_area__v': metadata['therapeutic_area'],
                'product_name__v': metadata['product_name']
            }
            
            response = requests.post(
                f"{self.vault_url}/api/v22/objects/documents",
                headers=self.headers,
                files=files,
                data=data
            )
            
            if response.status_code != 200:
                print(f"Error uploading {file_path}: {response.text}")
            else:
                print(f"Successfully uploaded {Path(file_path).name}")
    
    def extract_metadata(self, file_path):
        # Extract from filename or metadata file
        filename = Path(file_path).stem
        parts = filename.split('_')
        
        return {
            'classification': parts[0],  # e.g., 'Regulatory'
            'therapeutic_area': parts[1],  # e.g., 'Oncology'
            'product_name': parts[2]  # e.g., 'DrugX'
        }

# Usage
uploader = VaultUploader('https://vault.veeva.com', 'your_token')
uploader.upload_batch('/path/to/documents')
```

