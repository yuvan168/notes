        List<Account> batch = new List<Account>();
        
        for (Account acc : accounts) {
            batch.add(acc);
            if (batch.size() == 200) {
                batchedLists.add(batch);
                batch = new List<Account>();
            }
        }
        
        if (!batch.isEmpty()) {
            batchedLists.add(batch);
        }
    }
    
