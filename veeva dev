### Example 1: Complete Document Upload Solution

```python
import requests
import json
import logging
import time
from pathlib import Path
from datetime import datetime
from typing import Dict, List, Optional

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class VaultDocumentManager:
    """Manages document operations with Veeva Vault"""
    
    def __init__(self, vault_url: str, api_token: str, account_id: str):
        self.vault_url = vault_url
        self.api_token = api_token
        self.account_id = account_id
        self.session = self._create_session()
    
    def _create_session(self) -> requests.Session:
        """Create requests session with auth headers"""
        session = requests.Session()
        session.headers.update({
            'Authorization': f'Bearer {self.api_token}',
            'X-Veeva-Account-ID': self.account_id,
            'Content-Type': 'application/json'
        })
        return session
    
    def upload_document(self, 
                       file_path: str,
                       metadata: Dict[str, str]) -> Optional[str]:
        """Upload single document with metadata"""
        
        try:
            with open(file_path, 'rb') as file:
                files = {'file': file}
                data = metadata
                
                response = self.session.post(
                    f"{self.vault_url}/api/v22/objects/documents",
                    files=files,
                    data=data
                )
                
                if response.status_code == 200:
                    doc_id = response.json()['id']
                    logger.info(f"Successfully uploaded: {Path(file_path).name} (ID: {doc_id})")
                    return doc_id
                else:
                    logger.error(f"Upload failed: {response.text}")
                    return None
                    
        except Exception as e:
            logger.error(f"Error uploading {file_path}: {str(e)}")
            return None
    
    def batch_upload(self, 
                    documents: List[tuple],
                    batch_size: int = 10,
                    delay: float = 0.5) -> Dict:
        """
        Batch upload multiple documents
        Args:
            documents: List of (filepath, metadata) tuples
            batch_size: Number of docs per batch
            delay: Seconds between requests
        """
        
        results = {
            'successful': 0,
            'failed': 0,
            'documents': []
        }
        
        for i, (file_path, metadata) in enumerate(documents):
            doc_id = self.upload_document(file_path, metadata)
            
            if doc_id:
                results['successful'] += 1
                results['documents'].append({
                    'filename': Path(file_path).name,
                    'id': doc_id,
                    'status': 'SUCCESS'
                })
            else:
                results['failed'] += 1
                results['documents'].append({
                    'filename': Path(file_path).name,
                    'status': 'FAILED'
                })
            
            # Rate limiting
            if (i + 1) % batch_size == 0:
                logger.info(f"Batch complete: {i + 1} documents processed")
                time.sleep(delay)
        
        return results
    
    def get_document(self, doc_id: str) -> Optional[Dict]:
        """Retrieve document details"""
        
        response = self.session.get(
            f"{self.vault_url}/api/v22/objects/documents/{doc_id}"
        )
        
        if response.status_code == 200:
            return response.json()
        else:
            logger.error(f"Failed to get document {doc_id}: {response.text}")
            return None
    
    def update_document_metadata(self, 
                                doc_id: str,
                                metadata: Dict[str, str]) -> bool:
        """Update document metadata"""
        
        response = self.session.put(
            f"{self.vault_url}/api/v22/objects/documents/{doc_id}",
            json=metadata
        )
        
        if response.status_code == 200:
            logger.info(f"Updated metadata for document {doc_id}")
            return True
        else:
            logger.error(f"Failed to update document {doc_id}: {response.text}")
            return False
    
    def query_documents(self, query: str) -> List[Dict]:
        """Execute VQL query"""
        
        response = self.session.post(
            f"{self.vault_url}/api/v22/query",
            json={"query": query}
        )
        
        if response.status_code == 200:
            return response.json().get('data', [])
        else:
            logger.error(f"Query failed: {response.text}")
            return []
    
    def transition_workflow(self, 
                           doc_id: str,
                           next_state: str) -> bool:
        """Transition document through workflow"""
        
        response = self.session.post(
            f"{self.vault_url}/api/v22/objects/documents/{doc_id}/workflow",
            json={"lifecycle__v": next_state}
        )
        
        if response.status_code == 200:
            logger.info(f"Transitioned document {doc_id} to {next_state}")
            return True
        else:
            logger.error(f"Workflow transition failed: {response.text}")
            return False


# Usage Example
if __name__ == "__main__":
    # Initialize
    manager = VaultDocumentManager(
        vault_url="https://veeva.vault.com",
        api_token="YOUR_API_TOKEN",
        account_id="ACCOUNT_ID"
    )
    
    # Example 1: Upload single document
    metadata = {
        'filename__v': 'FDA_Submission.pdf',
        'classification__v': 'Regulatory',
        'therapeutic_area__v': 'Oncology',
        'product_name__v': 'DrugX'
    }
    doc_id = manager.upload_document('/path/to/FDA_Submission.pdf', metadata)
    
    # Example 2: Query documents
    query = "SELECT id, name__v FROM documents WHERE classification__v = 'Regulatory'"
    results = manager.query_documents(query)
    print(f"Found {len(results)} regulatory documents")
    
    # Example 3: Transition workflow
    if doc_id:
        manager.transition_workflow(doc_id, 'In Review')
```

### Example 2: CRM Call Logging Integration

```python
import requests
import json
from datetime import datetime
from typing import Dict, List, Optional

class CRMCallManager:
    """Manages CRM call logging and tracking"""
    
    def __init__(self, crm_url: str, api_token: str):
        self.crm_url = crm_url
        self.api_token = api_token
        self.headers = {
            'Authorization': f'Bearer {api_token}',
            'Content-Type': 'application/json'
        }
    
    def create_call_record(self, call_data: Dict) -> Optional[str]:
        """Create new call record"""
        
        payload = {
            'account_id': call_data['account_id'],
            'call_date': call_data.get('call_date', datetime.now().isoformat()),
            'duration_minutes': call_data['duration_minutes'],
            'call_objective': call_data['call_objective'],
            'attendees': call_data['attendees'],
            'call_summary': call_data.get('call_summary', ''),
            'next_steps': call_data.get('next_steps', ''),
            'rep_id': call_data['rep_id']
        }
        
        response = requests.post(
            f"{self.crm_url}/api/v2/calls",
            headers=self.headers,
            json=payload
        )
        
        if response.status_code == 200:
            return response.json()['id']
        else:
            print(f"Error creating call: {response.text}")
            return None
    
    def log_call_batch(self, calls: List[Dict]) -> Dict:
        """Log multiple calls efficiently"""
        
        results = {'successful': 0, 'failed': 0, 'calls': []}
        
        for call_data in calls:
            call_id = self.create_call_record(call_data)
            
            if call_id:
                results['successful'] += 1
                results['calls'].append({
                    'account': call_data['account_id'],
                    'id': call_id,
                    'status': 'LOGGED'
                })
            else:
                results['failed'] += 1
                results['calls'].append({
                    'account': call_data['account_id'],
                    'status': 'FAILED'
                })
        
        return results
    
    def get_account_activity(self, account_id: str) -> List[Dict]:
        """Get all calls for an account"""
        
        response = requests.get(
            f"{self.crm_url}/api/v2/accounts/{account_id}/calls",
            headers=self.headers
        )
        
        if response.status_code == 200:
            return response.json()['data']
        else:
            print(f"Error fetching account activity: {response.text}")
            return []
    
    def generate_rep_report(self, rep_id: str, month: int, year: int) -> Dict:
        """Generate monthly activity report for rep"""
        
        query = f"""
        SELECT id, account_id, call_date, duration_minutes, call_objective
        FROM calls
        WHERE rep_id = '{rep_id}'
        AND MONTH(call_date) = {month}
        AND YEAR(call_date) = {year}
        """
        
        response = requests.post(
            f"{self.crm_url}/api/v2/query",
            headers=self.headers,
            json={'query': query}
        )
        
        if response.status_code == 200:
            calls = response.json()['data']
            
            # Calculate metrics
            total_calls = len(calls)
            total_minutes = sum(c['duration_minutes'] for c in calls)
            avg_duration = total_minutes / total_calls if total_calls > 0 else 0
            
            return {
                'rep_id': rep_id,
                'month': month,
                'year': year,
                'total_calls': total_calls,
                'total_minutes': total_minutes,
                'average_duration': avg_duration,
                'calls': calls
            }
        else:
            return {'error': response.text}


# Usage
crm_manager = CRMCallManager('https://crm.veeva.com', 'YOUR_TOKEN')

# Log a call
call = {
    'account_id': 'ACC123',
    'rep_id': 'REP456',
