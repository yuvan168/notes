```apex
// 21 CFR Part 11 Compliant Record Management
public class CFRPart11Compliance {
    
    /**
     * Create audit trail for regulated records
     */
    public static void createAuditTrail(String recordId, String action, String details) {
        Audit_Trail__c trail = new Audit_Trail__c();
        trail.Record_Id__c = recordId;
        trail.Action__c = action;
        trail.Details__c = details;
        trail.User_Id__c = UserInfo.getUserId();
        trail.Timestamp__c = DateTime.now();
        trail.Digital_Signature__c = generateDigitalSignature(details);
        insert trail;
    }
    
    /**
     * Generate digital signature
     */
    private static String generateDigitalSignature(String data) {
        Blob signature = Crypto.generateHmac(
            'HmacSHA256',
            Blob.valueOf(data),
            Blob.valueOf('secret_key')
        );
        return EncodingUtil.base64Encode(signature);
    }
    
    /**
     * Validate record integrity
     */
    public static Boolean validateRecordIntegrity(String recordId) {
        Audit_Trail__c trail = [SELECT Digital_Signature__c, Details__c 
                               FROM Audit_Trail__c 
                               WHERE Record_Id__c = :recordId 
                               LIMIT 1];
        
        String computedSignature = generateDigitalSignature(trail.Details__c);
        return computedSignature == trail.Digital_Signature__c;
    }
}
