## Development Best Practices

### 1. Error Handling & Resilience

**Pattern: Graceful Error Handling**

```python
import requests
import time
import logging
from typing import Optional, Dict, Any

logger = logging.getLogger(__name__)

class ResilientVaultClient:
    """Vault API client with error handling and retry logic"""
    
    MAX_RETRIES = 3
    RETRY_DELAY = 1  # seconds
    EXPONENTIAL_BACKOFF = 2
    
    def __init__(self, vault_url: str, api_token: str):
        self.vault_url = vault_url
        self.api_token = api_token
    
    def call_api(self, 
                 method: str, 
                 endpoint: str, 
                 data: Optional[Dict] = None,
                 retries: int = 0) -> Optional[Dict[str, Any]]:
        """
        Make API call with retry logic and error handling
        """
        
        headers = {
            'Authorization': f'Bearer {self.api_token}',
            'Content-Type': 'application/json'
        }
        
        url = f"{self.vault_url}{endpoint}"
        
        try:
            # Make request
            if method.upper() == 'GET':
                response = requests.get(url, headers=headers, timeout=30)
            elif method.upper() == 'POST':
                response = requests.post(url, headers=headers, json=data, timeout=30)
            else:
                raise ValueError(f"Unsupported method: {method}")
            
            # Handle response status codes
            if response.status_code == 200:
                return response.json()
            
            elif response.status_code == 401:
                # Authentication error - don't retry
                logger.error("Authentication failed. Check API token.")
                return None
            
            elif response.status_code == 403:
                # Permission denied - don't retry
                logger.error("Permission denied. Check user permissions.")
                return None
            
            elif response.status_code == 429:
                # Rate limited - retry with exponential backoff
                if retries < self.MAX_RETRIES:
                    wait_time = self.RETRY_DELAY * (self.EXPONENTIAL_BACKOFF ** retries)
                    logger.warning(f"Rate limited. Retrying in {wait_time}s...")
                    time.sleep(wait_time)
                    return self.call_api(method, endpoint, data, retries + 1)
                else:
                    logger.error("Max retries exceeded for rate limit")
                    return None
            
            elif response.status_code in [500, 502, 503, 504]:
                # Server error - retry
                if retries < self.MAX_RETRIES:
                    wait_time = self.RETRY_DELAY * (self.EXPONENTIAL_BACKOFF ** retries)
                    logger.warning(f"Server error. Retrying in {wait_time}s...")
                    time.sleep(wait_time)
                    return self.call_api(method, endpoint, data, retries + 1)
                else:
                    logger.error(f"Server error after {self.MAX_RETRIES} retries")
                    return None
            
            elif response.status_code == 400:
                # Bad request - client error, don't retry
                logger.error(f"Bad request: {response.json()}")
                return None
            
            else:
                logger.error(f"Unexpected status code: {response.status_code}")
                return None
        
        except requests.Timeout:
            # Timeout - retry
            if retries < self.MAX_RETRIES:
                wait_time = self.RETRY_DELAY * (self.EXPONENTIAL_BACKOFF ** retries)
                logger.warning(f"Request timeout. Retrying in {wait_time}s...")
                time.sleep(wait_time)
                return self.call_api(method, endpoint, data, retries + 1)
            else:
                logger.error("Max retries exceeded for timeout")
                return None
        
        except Exception as e:
            logger.error(f"Unexpected error: {str(e)}")
            return None
    
    def get_documents(self) -> Optional[Dict]:
        """Example: Get documents with error handling"""
        return self.call_api('GET', '/api/v22/objects/documents')
    
    def create_document(self, file_path: str, metadata: Dict) -> Optional[str]:
        """Example: Create document with error handling"""
        result = self.call_api('POST', '/api/v22/objects/documents', 
                              data={'file': file_path, **metadata})
        return result['id'] if result else None


# Usage
client = ResilientVaultClient('https://vault.veeva.com', 'token')
docs = client.get_documents()
```

